#!/bin/busybox sh
# /init of the 6.12 boot image's ramdisk (tools/mainline/mkboot.sh).
#
# It starts the USB gadget (ttyGS0 + NCM, the same as the 4.14 ramdisk's)
# and, with titan.root on the command line (mkboot.sh DEBIAN=1), mounts
# Debian's root read-only and switch_roots to systemd, which checks and
# remounts it read-write. The gadget stays up and Debian configures usb0.
#
# Without titan.root, or when the root cannot be mounted, it stays in a
# rescue mode: a short report of what the kernel found in the kernel log
# (and on the screen console), telnet on 172.16.42.1 and a shell on ttyGS0.
# It stays up once a host configures the gadget, or when no cable is in
# (for tests over Wi-Fi); with a cable and no host it returns to LK's
# fastboot after 90 s (`reboot-bootloader` does the same by hand), and
# without a USB device controller after 120 s. Nothing here writes to the
# UFS.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t configfs configfs /sys/kernel/config
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts

log() { echo "init: $*" > /dev/kmsg; }

# Restart to LK's fastboot; reboot(2) can block in a reboot notifier, and
# sysrq b restarts without them
to_fastboot() {
	sync
	reboot-bootloader &
	sleep 15
	log "reboot-bootloader did not reboot; sysrq b"
	echo b > /proc/sysrq-trigger
}

# A read can block in a driver for good, where timeout(1) can't stop it,
# so the copy runs in the background and is given up after 5 s
logfile() {
	cat "$2" > /tmp/lf 2>&1 &
	n=0
	while kill -0 $! 2>/dev/null; do
		n=$((n + 1))
		[ $n -gt 50 ] && { log "$1: stuck reading $2"; return; }
		usleep 100000
	done
	while IFS= read -r l; do log "$1: $l"; done < /tmp/lf
}

# Rescue mode's report, the summary last so that it stays on the screen
report() {
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	log "kernel: $(uname -a)"
	logfile cmdline /proc/cmdline
	log "cpus online: $(cat /sys/devices/system/cpu/online), $(sed -n 's/^MemTotal: *//p' /proc/meminfo)"
	logfile partitions /proc/partitions
	logfile deferred /sys/kernel/debug/devices_deferred
	dmesg | grep -iE " (error|failed|fail|timeout)\b" | grep -vE 'init:|ufshcd' |
		tail -n 8 > /tmp/err
	logfile err /tmp/err
	# devices a platform driver bound (the driver directories' symlinks other than module)
	for e in /sys/bus/platform/drivers/*/*; do
		[ -L "$e" ] && [ "${e##*/}" != module ] && echo "$e"
	done > /tmp/bound
	log "summary: udc [$(ls /sys/class/udc 2>/dev/null)] rtc [$(ls /sys/class/rtc 2>/dev/null)]"
	log "summary: $(ls /sys/class/regulator 2>/dev/null | wc -l) regulators, $(wc -l < /tmp/bound) bound"
	log "summary: input [$(sed -n 's/^N: Name=//p' /proc/bus/input/devices 2>/dev/null | tr '\n' ' ')]"
}

# The USB PHY's 26 MHz reference gate (apmixedsys 0x20 bit 4, set = on),
# which the tree's PHY nodes don't name: if the device controller did not
# probe, open it and bind the controller again
if [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ -e /sys/bus/platform/devices/11201000.usb ]; then
	a=$(devmem 0x1000c020 32)
	devmem 0x1000c020 32 $((a | 0x10))
	echo 11201000.usb > /sys/bus/platform/drivers/mtu3/bind 2>/dev/null &
	sleep 3
	log "usb retry: apmixed 0x20 was $a, now $(devmem 0x1000c020 32), udc [$(ls /sys/class/udc 2>/dev/null)]"
fi

udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$udc" ]; then
	report
	log "no USB device controller; waiting 120 s, then rebooting to fastboot"
	sleep 120
	to_fastboot
fi

g=/sys/kernel/config/usb_gadget/g1
mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409 \
	$g/functions/acm.usb0 $g/functions/ncm.usb0
echo 0x1d6b > $g/idVendor	# Linux Foundation
echo 0x0104 > $g/idProduct	# Multifunction composite gadget
echo "titanpocket" > $g/strings/0x409/serialnumber
echo "Unihertz" > $g/strings/0x409/manufacturer
echo "Titan Pocket" > $g/strings/0x409/product
echo "acm+ncm" > $g/configs/c.1/strings/0x409/configuration
# fixed NCM addresses (locally administered, made up): with random ones
# each boot is a new interface to macOS, which then waits for approval
# before it gets an address
echo 42:7b:a8:03:96:fa > $g/functions/ncm.usb0/dev_addr
echo 6a:ba:89:1a:0d:e7 > $g/functions/ncm.usb0/host_addr
ln -s $g/functions/acm.usb0 $g/configs/c.1/
ln -s $g/functions/ncm.usb0 $g/configs/c.1/
echo "$udc" > $g/UDC && log "gadget bound to $udc"

# Debian on the partition labelled titanroot, or (this busybox has no
# findfs) the GPT partition named linux, as the 4.14 ramdisk falls back
# to. The UFS may still be probing: wait up to 10 s for it.
if grep -qw titan.root /proc/cmdline; then
	n=0
	while :; do
		root=$(findfs LABEL=titanroot 2>/dev/null) ||
			root=$(grep -l '^PARTNAME=linux$' /sys/class/block/*/uevent 2>/dev/null |
				head -n1 | xargs -r sed -n 's|^DEVNAME=|/dev/|p')
		[ -n "$root" ] && [ -b "$root" ] && break
		n=$((n + 1))
		[ $n -gt 100 ] && break
		usleep 100000
	done
	if [ -n "$root" ] && mkdir -p /newroot &&
	   mount -t ext4 -o ro "$root" /newroot &&
	   { [ -e /newroot/sbin/init ] || [ -L /newroot/sbin/init ]; }; then
		log "switching to Debian on $root"
		umount /sys/kernel/config /dev/pts 2>/dev/null
		mount --move /dev /newroot/dev
		mount --move /proc /newroot/proc
		mount --move /sys /newroot/sys
		exec switch_root /newroot /sbin/init
	fi
	log "no Debian root (${root:-titanroot not found}); staying in rescue mode"
	umount /newroot 2>/dev/null
fi

# Rescue mode. telnet has no login, so it listens on the USB address only.
report
ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up &&
	telnetd -b 172.16.42.1 -l /bin/sh && udhcpd /etc/udhcpd.conf && log "telnet on 172.16.42.1"
(while true; do getty -n -l /bin/sh 115200 ttyGS0; sleep 1; done) &
# Stay up once a host has configured the gadget, or with no cable in (the
# Type-C port without a partner: a phone that booted unplugged is reached
# over Wi-Fi); otherwise return to fastboot after 90 s, so that the next
# image can be flashed.
n=0
until [ "$(cat /sys/class/udc/$udc/state 2>/dev/null)" = configured ]; do
	n=$((n + 1))
	[ $n -gt 90 ] && break
	sleep 1
done
log "udc state: $(cat /sys/class/udc/$udc/state 2>/dev/null)"
if [ $n -le 90 ]; then
	while true; do sleep 3600; done
fi
if [ -e /sys/class/typec/port0 ] && [ ! -e /sys/class/typec/port0-partner ]; then
	log "no cable; staying up"
	while true; do sleep 3600; done
fi
log "no host configured the gadget; rebooting to fastboot"
to_fastboot
