+/* ---- SODI and SODI3 ---- */
+
+static int so_set(const char *val, const struct kernel_param *kp);
+static int so_stats_get(char *buf, const struct kernel_param *kp);
+static const struct kernel_param_ops so_ops = {
+	.set = so_set,
+	.get = param_get_bool,
+};
+static const struct kernel_param_ops so_stats_ops = {
+	.get = so_stats_get,
+};
+
+static uint sodi_min_us = 2000;	/* the vendor's SODI and SODI3 min-residency */
+module_param(sodi_min_us, uint, 0644);
+MODULE_PARM_DESC(sodi_min_us, "SODI and SODI3 only when this CPU's next timer is this far");
+
+/*
+ * The SCP raises R12_SCP_SPM_IRQ_B with every message it sends (docs/
+ * power-testing.md, "The SCP trap"): in ATF's SODI set (0xed7ddff) it
+ * ended every SODI at once (debug 0x11000, r12 0x800, measured). Left out
+ * of both sets, as in suspend's wake_mask; the messages still interrupt
+ * the AP.
+ */
+#define R12_SCP_SPM_IRQ		BIT(11)
+
+/*
+ * The vendor's conditions (mtk_idle_mt6771.c, IDLE_TYPE_SO and _SO3):
+ * power domains (SO_PWR_STA_MASK: GPU, ISP, encoder, decoder, camera, VPU;
+ * the display may be on) and infra clock gates for both, with two more
+ * gates for SODI3 (0x094 bit 25, 0x0ac bit 4); for SODI, while DIS and the
+ * MM clock are on, MMSYS clock gates (CG_CON0/1) of the blocks a
+ * video-mode path does not use (MDP and the like). SODI3 asks for nearly
+ * every MMSYS clock gated (0xfffffc1b, 0x3fff) and the display PWM on its
+ * oscillator, which a video-mode panel never gives with the display
+ * running: here SODI3 needs DIS powered off. And UNIVPLL and MSDCPLL off
+ * (soidle3_pll_condition_mask). And 20 s of uptime for SODI, 30 for SODI3,
+ * as the vendor's.
+ */
+#define SODI_PWR_MASK		0xbef000b0
+#define PWR_DIS			BIT(3)
+#define MMSYS_CG_CON0		0x100
+#define MMSYS_CG_CON1		0x110
+#define SODI_MMSYS_CG0		0x000dfc00
+#define SODI_MMSYS_CG1		0x00000d70
+#define CLK_CFG_0		0x040
+#define MM_SEL_GATE		BIT(15)
+#define UNIVPLL_CON0		0x230
+#define MSDCPLL_CON0		0x250
+#define PLL_EN			BIT(0)
+#define SODI3_UPTIME_S		30
+#define SODI_UPTIME_S		20	/* the vendor's: 20 s for SODI, 30 for SODI3 */
+
+/* infra clock gate status registers, in the order of a scenario's masks */
+static const u16 so_cg_sta[] = { 0x094, 0x090, 0x0ac };
+
+enum { SO_OK, SO_SHORT, SO_PWR, SO_CG, SO_MMSYS, SO_PLL, SO_BOOT, SO_CPUS, SO_SECURE_CG,
+       SO_SSPM, SO_NR };
+static const char *const so_why[] = { "entered", "short", "power domain", "clock gate",
+				      "mmsys clock", "pll", "boot", "cpus", "secure clock",
+				      "sspm" };
+
+/*
+ * One scenario: what the vendor's spm_go_to_sodi() and spm_go_to_sodi3()
+ * set up, the knobs (module parameters) and the counters.
+ *
+ * SODI: the flags are the vendor's MT6771 SODI set (0x20019a) and
+ * SODI_CG_MODE, the scenario the vendor's display picks for a video-mode
+ * panel: the firmware arms DRAM self-refresh alone (docs/spm-firmware.md,
+ * the main program, step 10). The AP's APSRC and 26 MHz requests stay up.
+ *
+ * SODI3: the vendor's SODI3 set (SODI's with ENABLE_SODI3, bit 14, and
+ * without CG mode): the whole ladder down to 26 MHz, as in suspend, with
+ * infra kept powered; every AP request released; the SPM watchdog off for
+ * it (PW_WDT_DISABLE), as the vendor's with no watchdog API.
+ */
+struct so_scen {
+	const char *name;
+	bool three;
+	u32 psci, sspm_enter, sspm_leave, pwr_ctrl;
+	u32 cg_mask[3];
+	bool on;
+	bool at_probe;		/* asked for on the command line, before probe */
+	uint flags, flags1, hold, wake_mask;
+	unsigned long atf_wake;
+	bool ready;
+	struct {
+		unsigned long count[SO_NR];
+		u32 last_pwr, last_cg[3], last_mm[2], last_pll, last_r12, last_debug, last_cpu;
+		u64 slept_ticks;
+	} st;
+};
+
+#define SPM_FLAG_ENABLE_SODI3	BIT(14)
+#define SPM_PWR_CTRL_SODI3	20
+#define PW_WDT_DISABLE		15
+#define SSPM_SPM_ENTER_SODI3	6
+#define SSPM_SPM_LEAVE_SODI3	7
+#define MT6771_PSCI_SODI3	0x01010003
+
+static struct so_scen so_sodi = {
+	.name = "SODI", .psci = MT6771_PSCI_SODI,
+	.sspm_enter = SSPM_SPM_ENTER_SODI, .sspm_leave = SSPM_SPM_LEAVE_SODI,
+	.pwr_ctrl = SPM_PWR_CTRL_SODI,
+	.cg_mask = { 0x00040802, 0x03afb900, 0x000000c1 },
+	.flags = SPM_SODI_FLAGS, .hold = SPM_APSRC_REQ | SPM_F26M_REQ,
+};
+
+static struct so_scen so_sodi3 = {
+	.name = "SODI3", .three = true, .psci = MT6771_PSCI_SODI3,
+	.sspm_enter = SSPM_SPM_ENTER_SODI3, .sspm_leave = SSPM_SPM_LEAVE_SODI3,
+	.pwr_ctrl = SPM_PWR_CTRL_SODI3,
+	.cg_mask = { 0x02040802, 0x03afb900, 0x000000d1 },
+	.flags = (SPM_SODI_FLAGS & ~SPM_FLAG_SODI_CG_MODE) | SPM_FLAG_ENABLE_SODI3,
+};
+
+module_param_cb(sodi, &so_ops, &so_sodi.on, 0644);
+MODULE_PARM_DESC(sodi, "Enter the SPM's SODI from cpuidle (the last core, screen on)");
+module_param_named(sodi_flags, so_sodi.flags, uint, 0644);
+MODULE_PARM_DESC(sodi_flags, "SPM firmware flags for SODI (SPM_SW_FLAG)");
+module_param_named(sodi_flags1, so_sodi.flags1, uint, 0644);
+MODULE_PARM_DESC(sodi_flags1, "SPM firmware flags 1 for SODI (0: the A73 buck left alone)");
+module_param_named(sodi_hold, so_sodi.hold, uint, 0644);
+MODULE_PARM_DESC(sodi_hold, "SPM_SRC_REQ bits kept across SODI (0 APSRC, 1 26 MHz, 7 DDREN; default APSRC and 26 MHz)");
+module_param_named(sodi_wake_mask, so_sodi.wake_mask, uint, 0644);
+MODULE_PARM_DESC(sodi_wake_mask, "SODI wake sources (R12 bits) set at each sodi=1, 0 for ATF's less the SCP's");
+module_param_cb(sodi_stats, &so_stats_ops, &so_sodi, 0444);
+MODULE_PARM_DESC(sodi_stats, "SODI entries, why not, and the last wake");
+
+module_param_cb(sodi3, &so_ops, &so_sodi3.on, 0644);
+MODULE_PARM_DESC(sodi3, "Enter the SPM's SODI3 (26 MHz off) from cpuidle (the last core, display off)");
+module_param_named(sodi3_flags, so_sodi3.flags, uint, 0644);
+MODULE_PARM_DESC(sodi3_flags, "SPM firmware flags for SODI3 (SPM_SW_FLAG)");
+module_param_named(sodi3_flags1, so_sodi3.flags1, uint, 0644);
+MODULE_PARM_DESC(sodi3_flags1, "SPM firmware flags 1 for SODI3");
+module_param_named(sodi3_hold, so_sodi3.hold, uint, 0644);
+MODULE_PARM_DESC(sodi3_hold, "SPM_SRC_REQ bits kept across SODI3 (default none)");
+module_param_named(sodi3_wake_mask, so_sodi3.wake_mask, uint, 0644);
+MODULE_PARM_DESC(sodi3_wake_mask, "SODI3 wake sources (R12 bits) set at each sodi3=1, 0 for ATF's less the SCP's");
+module_param_cb(sodi3_stats, &so_stats_ops, &so_sodi3, 0444);
+MODULE_PARM_DESC(sodi3_stats, "SODI3 entries, why not, and the last wake");
+
+static void __iomem *mmsys_base;
+
+static int so_check(struct so_scen *sc)
+{
+	u32 pwr, v;
+	int i, blocked = 0;
+
+	if (ktime_us_delta(tick_nohz_get_next_hrtimer(), ktime_get()) < sodi_min_us)
+		return SO_SHORT;
+	if (ktime_get_boottime_seconds() < (sc->three ? SODI3_UPTIME_S : SODI_UPTIME_S))
+		return SO_BOOT;
+	pwr = readl(spm_base + PWR_STATUS) & readl(spm_base + PWR_STATUS_2ND);
+	sc->st.last_pwr = pwr & (SODI_PWR_MASK | (sc->three ? PWR_DIS : 0));
+	if (sc->st.last_pwr)
+		return SO_PWR;
+	for (i = 0; i < ARRAY_SIZE(so_cg_sta); i++) {
+		regmap_read(infracfg_regmap, so_cg_sta[i], &v);
+		sc->st.last_cg[i] = ~v & sc->cg_mask[i];
+		blocked |= !!sc->st.last_cg[i];
+	}
+	if (blocked)
+		return SO_CG;
+	if (sc->three) {
+		regmap_read(apmixed_regmap, UNIVPLL_CON0, &v);
+		sc->st.last_pll = v & PLL_EN;
+		regmap_read(apmixed_regmap, MSDCPLL_CON0, &v);
+		sc->st.last_pll |= (v & PLL_EN) << 1;
+		return sc->st.last_pll ? SO_PLL : SO_OK;
+	}
+	/* MMSYS registers only with DIS powered and the MM clock running */
+	regmap_read(topck_regmap, CLK_CFG_0, &v);
+	if ((pwr & PWR_DIS) && !(v & MM_SEL_GATE) && mmsys_base) {
+		sc->st.last_mm[0] = ~readl(mmsys_base + MMSYS_CG_CON0) & SODI_MMSYS_CG0;
+		sc->st.last_mm[1] = ~readl(mmsys_base + MMSYS_CG_CON1) & SODI_MMSYS_CG1;
+		if (sc->st.last_mm[0] | sc->st.last_mm[1])
+			return SO_MMSYS;
+	}
+	return SO_OK;
+}
+
+/*
+ * spm_go_to_sodi()/spm_go_to_sodi3(), once the conditions hold: the last
+ * core, the SSPM told, the scenario through a SiP call, PSCI CPU_SUSPEND
+ * with the state; anything that fails falls back to the cluster power-down
+ * cpuidle asked for.
+ */
+static int so_go(struct so_scen *sc)
+{
+	unsigned int cpu = smp_processor_id();
+	u32 r12, debug, timer;
+	int why = SO_OK, ret;
+
+	if (!mtk_mcdi_last_core(cpu)) {
+		sc->st.count[SO_CPUS]++;
+		return psci_cpu_suspend_enter(MT6771_PSCI_CLUSTER);
+	}
+	/* from here MCDI is paused: no other core comes up */
+	if (spm_sip(MTK_SIP_CHECK_SECURE_CG, 0, 0, 0))
+		why = SO_SECURE_CG;
+	else if (sspm_spm_command(sc->sspm_enter) < 0)
+		why = SO_SSPM;
+	if (why != SO_OK) {
+		mtk_mcdi_last_core_release();
+		sc->st.count[why]++;
+		return psci_cpu_suspend_enter(MT6771_PSCI_CLUSTER);
+	}
+
+	regmap_clear_bits(spm_regmap, SPM_SRC_REQ, SPM_HELD_REQ & ~READ_ONCE(sc->hold));
+	spm_sip(MTK_SIP_SPM_SODI_ARGS, READ_ONCE(sc->flags), READ_ONCE(sc->flags1), 0);
+	ret = psci_cpu_suspend_enter(sc->psci);
+	mt6771_spm_hold(spm_regmap);
+	sspm_spm_command(sc->sspm_leave);
+	mtk_mcdi_last_core_release();
+
+	regmap_read(spm_regmap, SPM_SW_RSV_0, &r12);
+	regmap_read(spm_regmap, SPM_SW_DEBUG, &debug);
+	regmap_read(spm_regmap, SPM_BSI_D1_SR, &timer);
+	sc->st.count[SO_OK]++;
+	sc->st.last_r12 = r12;
+	sc->st.last_debug = debug;
+	sc->st.last_cpu = cpu;
+	sc->st.slept_ticks += timer;
+	return ret;
+}
+
+/* SODI3 first (the deeper), else SODI, else the cluster power-down */
+static int so_enter(void)
+{
+	int why;
+
+	if (READ_ONCE(so_sodi3.on)) {
+		why = so_check(&so_sodi3);
+		if (why == SO_OK)
+			return so_go(&so_sodi3);
+		so_sodi3.st.count[why]++;
+	}
+	if (READ_ONCE(so_sodi.on)) {
+		why = so_check(&so_sodi);
+		if (why == SO_OK)
+			return so_go(&so_sodi);
+		so_sodi.st.count[why]++;
+	}
+	return psci_cpu_suspend_enter(MT6771_PSCI_CLUSTER);
+}
+
+static int so_stats_get(char *buf, const struct kernel_param *kp)
+{
+	struct so_scen *sc = kp->arg;
+	int i, n = 0;
+
+	for (i = 0; i < SO_NR; i++)
+		n += sysfs_emit_at(buf, n, "%s %lu\n", so_why[i], sc->st.count[i]);
+	n += sysfs_emit_at(buf, n, "slept_ms %llu\nlast_r12 0x%x\nlast_debug 0x%x\nlast_cpu %u\n",
+			   div_u64(sc->st.slept_ticks * 1000, 32768), sc->st.last_r12,
+			   sc->st.last_debug, sc->st.last_cpu);
+	n += sysfs_emit_at(buf, n, "last_pwr 0x%x\nlast_cg 0x%x 0x%x 0x%x\n", sc->st.last_pwr,
+			   sc->st.last_cg[0], sc->st.last_cg[1], sc->st.last_cg[2]);
+	if (sc->three)
+		n += sysfs_emit_at(buf, n, "last_pll 0x%x (bit 0 UNIVPLL, 1 MSDCPLL)\n",
+				   sc->st.last_pll);
+	else
+		n += sysfs_emit_at(buf, n, "last_mmsys 0x%x 0x%x\n", sc->st.last_mm[0],
+				   sc->st.last_mm[1]);
+	return n;
+}
+
+static bool so_hooked;
+
+static bool so_any(void)
+{
+	return READ_ONCE(so_sodi.on) || READ_ONCE(so_sodi3.on);
+}
+
+/* The wake sources at each 0 -> 1; the cpuidle hook the first time */
+static int so_setup(struct so_scen *sc)
+{
+	unsigned long src;
+
+	if (!dpidle_dev || !apmixed_regmap)
+		return -ENODEV;
+	if (!sc->ready) {
+		sc->atf_wake = spm_sip(MTK_SIP_SPM_GET_PWR_CTRL_ARGS, sc->pwr_ctrl,
+				       PW_WAKE_SRC, 0);
+		if (sc->three)
+			spm_sip(MTK_SIP_SPM_PWR_CTRL_ARGS, sc->pwr_ctrl, PW_WDT_DISABLE, 1);
+		sc->ready = true;
+	}
+	src = sc->wake_mask ?: sc->atf_wake & ~R12_SCP_SPM_IRQ;
+	spm_sip(MTK_SIP_SPM_PWR_CTRL_ARGS, sc->pwr_ctrl, PW_WAKE_SRC, src);
+	dev_info(dpidle_dev, "%s: ATF's wake sources 0x%lx, set 0x%lx, reads back 0x%lx\n",
+		 sc->name, sc->atf_wake, src,
+		 spm_sip(MTK_SIP_SPM_GET_PWR_CTRL_ARGS, sc->pwr_ctrl, PW_WAKE_SRC, 0));
+	if (!so_hooked)
+		psci_cpuidle_set_platform_enter(mt6771_spm_cpuidle_enter);
+	so_hooked = true;
+	return 0;
+}
+
+/*
+ * sodi=1 / sodi3=1. On the command line it comes before the driver
+ * probes: remembered then and set up at probe (so_probe()).
+ */
+static int so_set(const char *val, const struct kernel_param *kp)
+{
+	struct so_scen *sc = container_of((bool *)kp->arg, struct so_scen, on);
+	bool on;
+	int ret = kstrtobool(val, &on);
+
+	if (ret)
+		return ret;
+	if (!dpidle_dev) {
+		sc->at_probe = on;
+		return 0;
+	}
+	if (on && !READ_ONCE(sc->on)) {
+		ret = so_setup(sc);
+		if (ret)
+			return ret;
+	}
+	WRITE_ONCE(sc->on, on);
+	return 0;
+}
+
+static void so_probe(struct device *dev)
+{
+	struct so_scen *const scens[] = { &so_sodi, &so_sodi3 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(scens); i++) {
+		if (!scens[i]->at_probe)
+			continue;
+		if (so_setup(scens[i]))
+			dev_warn(dev, "%s unavailable\n", scens[i]->name);
+		else
+			WRITE_ONCE(scens[i]->on, true);
+	}
+}
+
+static void mt6771_spm_dpidle_init(struct device *dev)
+{
+	struct device_node *np;
+
+	spm_base = of_iomap(dev->parent->of_node, 0);
+	if (!spm_base || !infracfg_regmap || !topck_regmap) {
+		dev_warn(dev, "deep idle unavailable\n");
+		return;
+	}
+	/* SODI reads the MMSYS clock gates */
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6771-mmsys");
+	if (np) {
+		mmsys_base = of_iomap(np, 0);
+		of_node_put(np);
+	}
+	dpidle_dev = dev;
+	so_probe(dev);
+}
+
+static int crumb_held;
+
+static int mt6771_spm_suspend_enter(suspend_state_t state)
+{
+	u32 r12, wake_sta, r13, timer, debug, pc, pwr, fail;
+	u32 req_in, idle_in, src_in, req, idle, mask, mask2;
+	unsigned long wake_src;
+	int ret, vs1, aud = -1;
+	bool sdp;
+
+	crumb_failed = 0;
+	crumb_done = 0;
+	spm_crumb_atomic(CRUMB_ENTER);
+	ret = mt6771_spm_domains_off();
+	if (ret)
+		return ret;
+
+	if (wake_mask)
+		spm_sip(MTK_SIP_SPM_PWR_CTRL_ARGS, SPM_PWR_CTRL_SUSPEND,
+			PW_WAKE_SRC, wake_mask);
+	wake_src = spm_sip(MTK_SIP_SPM_GET_PWR_CTRL_ARGS, SPM_PWR_CTRL_SUSPEND,
+			   PW_WAKE_SRC, 0);
+	sdp = READ_ONCE(sleep_dpidle);
+	spm_sip(MTK_SIP_SPM_ARGS, SPM_ARGS_PCM_WDT, 1, pcm_wdt_timer ?: PCM_WDT_SEC);
+	spm_crumb_atomic(CRUMB_ATF_ARGS);
+	mtk_mcdi_pause(true);
+	spm_crumb_atomic(CRUMB_SSPM_ASK);
+	/* the vendor's spm_go_to_sleep_dpidle(): the SSPM's deep idle, "sleep" option */
+	ret = sdp ? sspm_spm_command_opt(SSPM_SPM_DPIDLE_ENTER, SSPM_OPT_SLEEP_DPIDLE) :
+		    sspm_spm_command(SSPM_SPM_SUSPEND);
+	if (ret < 0) {
+		/*
+		 * Going on into the SPM's sleep without the SSPM's part: every
+		 * reset on 2026-11-08 (9 of them) stopped at the step before.
+		 * Undo what suspend_enter set and refuse this suspend; the
+		 * kernel resumes the devices and titan-powerkey tries again.
+		 */
+		spm_crumb_atomic(CRUMB_SSPM_NOANS);
+		mtk_mcdi_pause(false);
+		spm_sip(MTK_SIP_SPM_ARGS, SPM_ARGS_PCM_WDT, 0, 0);
+		pr_warn("mt6771-spm: suspend aborted: SSPM did not answer (%d)\n", ret);
+		spm_crumb_report();
+		return -EBUSY;
+	}
+	vs1 = vs1_sleep_lp ? 0 : spm_vs1_full_power();
+	spm_crumb_atomic(CRUMB_SSPM_DOWN);
+	crumb_held = spm_crumb_readback();	/* what a reset in the sleep would show */
+
+	regmap_read(spm_regmap, PWR_STATUS, &pwr);	/* the domains going into it */
+	regmap_clear_bits(spm_regmap, SPM_SRC_REQ, SPM_HELD_REQ);
+	regmap_read(spm_regmap, SPM_SRC_REQ, &src_in);	/* ... and who asks for what */
+	regmap_read(spm_regmap, SRC_REQ_STA, &req_in);
+	regmap_read(spm_regmap, SUBSYS_IDLE_STA, &idle_in);
+	spm_clk_snapshot();
+	if (sdp) {
+		aud = dpidle_aud_intbus(0);
+		spm_sip(MTK_SIP_SPM_DPIDLE_ARGS, SPM_DPIDLE_FLAGS, 0, 0);
+		spm_sip(MTK_SIP_SPM_SLEEP_DPIDLE_ARGS, 0, wake_src, 0);
+		spm_mark(MARK_PSCI);
+		ret = psci_cpu_suspend_enter(MT6771_PSCI_DPIDLE);
+		if (aud >= 0)
+			dpidle_aud_intbus(aud);
+	} else {
+		spm_pll_sleep_apply(true);
+		spm_sip(MTK_SIP_SPM_SUSPEND_ARGS, pcm_flags, pcm_flags1, PCM_TIMER_MAX);
+		spm_mark(MARK_PSCI);
+		ret = psci_cpu_suspend_enter(MT6771_PSCI_SUSPEND);
+		spm_pll_sleep_apply(false);
+	}
+	spm_crumb_atomic(CRUMB_BACK);
+	mt6771_spm_hold(spm_regmap);
+	spm_mark(MARK_HELD);
+
+	sspm_spm_command(sdp ? SSPM_SPM_DPIDLE_LEAVE : SSPM_SPM_RESUME);
+	spm_crumb_atomic(CRUMB_SSPM_UP);
+	mtk_mcdi_pause(false);
+	spm_sip(MTK_SIP_SPM_ARGS, SPM_ARGS_PCM_WDT, 0, 0);
+	spm_mark(MARK_WDT_OFF);
+
+	regmap_read(spm_regmap, SPM_SW_RSV_0, &r12);
+	regmap_read(spm_regmap, SPM_WAKEUP_STA, &wake_sta);
+	regmap_read(spm_regmap, PCM_REG13_DATA, &r13);
+	regmap_read(spm_regmap, SPM_BSI_D1_SR, &timer);
+	regmap_read(spm_regmap, SPM_SW_DEBUG, &debug);
+	regmap_read(spm_regmap, PCM_REG_DATA_INI, &pc);
+	regmap_read(spm_regmap, WDT_LATCH_SPARE0_FIX, &fail);
+	regmap_read(spm_regmap, SRC_REQ_STA, &req);
+	regmap_read(spm_regmap, SUBSYS_IDLE_STA, &idle);
+	regmap_read(spm_regmap, SPM_SRC_MASK, &mask);
+	regmap_read(spm_regmap, SPM_SRC2_MASK, &mask2);
+	pr_info("mt6771-spm: %s %d: wake src 0x%lx, r12 0x%x, wake sta 0x%x, r13 0x%x, slept %u ms, debug 0x%x, pc 0x%x, fail 0x%x, pwr 0x%x, src_req 0x%x, req_sta 0x%x/0x%x, idle_sta 0x%x/0x%x, src_mask 0x%x/0x%x, crumbs lost 0x%x, held %d, cpu0 %u kHz\n",
+		sdp ? "sleep-dpidle" : "suspend", ret, wake_src, r12, wake_sta, r13,
+		(u32)div_u64((u64)timer * 1000, 32768), debug, pc, fail, pwr, src_in,
+		req_in, req, idle_in, idle, mask, mask2, crumb_failed, crumb_held,
+		cpufreq_quick_get(0));
+	spm_clk_report();
+	spm_crumb_report();
+	if (vs1)
+		pr_warn("mt6771-spm: VS1 low power not cleared for the sleep (OP_EN 0x%x)\n", vs1);
+
+	return ret;
+}
+
+/* The vendor sends these from its PM notifier; here only for "mem" */
+static int mt6771_spm_suspend_begin(suspend_state_t state)
+{
+	int ret = sspm_spm_command(SSPM_SPM_SUSPEND_PREPARE);
+
+	return ret < 0 ? ret : 0;
+}
+
+static void mt6771_spm_suspend_end(void)
+{
+	sspm_spm_command(SSPM_SPM_POST_SUSPEND);
+}
+
+static const struct platform_suspend_ops mt6771_spm_suspend_ops = {
+	.valid = suspend_valid_only_mem,
+	.begin = mt6771_spm_suspend_begin,
+	.enter = mt6771_spm_suspend_enter,
+	.end = mt6771_spm_suspend_end,
+};
+
+/* As spm_module_init() and spm_vcorefs_init() */
+static void mt6771_spm_start_firmware(struct device *dev)
+{
+	unsigned long status = spm_sip(MTK_SIP_SPM_FIRMWARE_STATUS, 0, 0, 0);
+
+	spm_sip(MTK_SIP_SPM_ARGS, SPM_ARGS_SPMFW_IDX, SPMFW_IDX, 0);
+	spm_sip(MTK_SIP_SPM_VCOREFS_ARGS, VCOREFS_PWRAP_CMD, 0, VCORE_PMIC_LOW);
+	spm_sip(MTK_SIP_SPM_VCOREFS_ARGS, VCOREFS_PWRAP_CMD, 1, VCORE_PMIC_HIGH);
+	spm_sip(MTK_SIP_SPM_VCOREFS_ARGS, VCOREFS_DVFSFW_INIT, 0, 0);
+	spm_sip(MTK_SIP_SPM_VCOREFS_ARGS, VCOREFS_GO, VCOREFS_FLAGS, 0);
+	dev_info(dev, "SPM firmware started (status %lu)\n", status);
+}
+
+static int mt6771_spm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	u32 val;
+	int ret;
+
+	spm_regmap = syscon_node_to_regmap(dev->parent->of_node);
+	if (IS_ERR(spm_regmap))
+		return dev_err_probe(dev, PTR_ERR(spm_regmap), "no SPM regmap\n");
+
+	if (deep) {
+		struct regmap *pmic = mt6771_spm_pmic(dev);
+		struct device_node *np;
+
+		if (IS_ERR(pmic))
+			return dev_err_probe(dev, PTR_ERR(pmic), "no PMIC\n");
+
+		np = of_parse_phandle(dev->of_node, "mediatek,sspm-mbox", 0);
+		if (!np)
+			return dev_err_probe(dev, -EINVAL, "no SSPM mailbox\n");
+		sspm_slots = devm_of_iomap(dev, np, 0, NULL);
+		sspm_ctrl = devm_of_iomap(dev, np, 1, NULL);
+		of_node_put(np);
+		if (IS_ERR(sspm_slots) || IS_ERR(sspm_ctrl))
+			return dev_err_probe(dev, -ENOMEM, "SSPM mailbox\n");
+		mt6771_spm_start_firmware(dev);
+		ret = mt6771_spm_pmic_lp(pmic);
+		if (ret)
+			return dev_err_probe(dev, ret, "PMIC low power setup\n");
+		spm_crumb_init(dev, pmic);
+		spm_clk_init(dev);
+		mt6771_spm_dpidle_init(dev);
+	}
+
+	ret = mt6771_spm_hold(spm_regmap);
+	if (ret)
+		return ret;
+	regmap_read(spm_regmap, SPM_SRC_REQ, &val);
+	dev_info(dev, "SPM_SRC_REQ 0x%x\n", val);
+
+	if (deep)
+		suspend_set_ops(&mt6771_spm_suspend_ops);
+	return 0;
+}
+
+/* The SPM keeps its registers in suspend; set again in case ATF changed it */
+static int mt6771_spm_resume(struct device *dev)
+{
+	return mt6771_spm_hold(spm_regmap);
+}
+
+static int mt6771_spm_suspend_noirq(struct device *dev)
+{
+	spm_crumb(CRUMB_SLEEP);
+	return 0;
+}
+
+static int mt6771_spm_resume_noirq(struct device *dev)
+{
+	spm_crumb(CRUMB_WOKE);
+	return 0;
+}
+
+static const struct dev_pm_ops mt6771_spm_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(NULL, mt6771_spm_resume)
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(mt6771_spm_suspend_noirq,
+				  mt6771_spm_resume_noirq)
+};
+
+static const struct of_device_id mt6771_spm_of_match[] = {
+	{ .compatible = "mediatek,mt6771-spm-resources" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6771_spm_of_match);
+
+static struct platform_driver mt6771_spm_driver = {
+	.driver = {
+		.name = "mt6771-spm",
+		.of_match_table = mt6771_spm_of_match,
+		.pm = pm_sleep_ptr(&mt6771_spm_pm_ops),
+	},
+	.probe = mt6771_spm_probe,
+};
+module_platform_driver(mt6771_spm_driver);
+
+MODULE_DESCRIPTION("MT6771 SPM resource requests and system suspend");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mtk-lk-fb.c b/drivers/soc/mediatek/mtk-lk-fb.c
new file mode 100644
index 0000000000000000000000000000000000000000..28528069e27e714e036b99aaa546bcf953d5564a
--- /dev/null
+++ b/drivers/soc/mediatek/mtk-lk-fb.c
