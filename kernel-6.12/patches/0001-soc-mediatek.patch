+/* ---- sensor hub ---- */
+
+static int sensor_hub_set(struct scp_sensor *s, bool enable, u32 freq_hz)
+{
+	struct config_cmd cmd = {
+		.evt_type = EVT_NO_SENSOR_CONFIG_EVENT,
+		.sensor_type = s->type,
+		.cmd = enable ? CONFIG_CMD_ENABLE : CONFIG_CMD_DISABLE,
+		.rate = s->on_change ? SENSOR_RATE_ONCHANGE : freq_hz * 1024,
+	};
+	int ret;
+
+	ret = nanohub_write(s->scp, &cmd, sizeof(cmd));
+	if (ret < 0)
+		return ret;
+	return ret ? 0 : -EIO;
+}
+
+/*
+ * The accelerometer and gyroscope are one chip (Senodia SH3001). The hub
+ * firmware powers it up only through the gyroscope: once both had been
+ * off, enabling the accelerometer alone kept reporting its last sample
+ * (measured: 1 distinct value in 50; with the gyroscope on, 50 of 50).
+ * So the gyroscope runs on the hub whenever either is wanted.
+ */
+static int sensor_config(struct scp_sensor *s, bool enable)
+{
+	struct mt6771_scp *scp = s->scp;
+	struct scp_sensor *acc = &scp->sensors[0], *gyro = &scp->sensors[1];
+	int ret;
+
+	if (!scp->hub_up)
+		return -EAGAIN;
+	s->want = enable;
+	if (s != acc && s != gyro)
+		return sensor_hub_set(s, enable, s->freq_hz);
+	ret = sensor_hub_set(gyro, gyro->want || acc->want,
+			     gyro->want ? gyro->freq_hz : acc->freq_hz);
+	if (!ret && s == acc)
+		ret = sensor_hub_set(acc, enable, acc->freq_hz);
+	return ret;
+}
+
+static void sensor_report(struct mt6771_scp *scp, const struct data_unit *u)
+{
+	struct scp_sensor *s = NULL;
+	int i;
+
+	/* records carry the handle: the Android type - 1 (vendor ID_*) */
+	for (i = 0; i < ARRAY_SIZE(scp->sensors); i++)
+		if (scp->sensors[i].type == u->sensor_type + 1)
+			s = &scp->sensors[i];
+	if (!s || u->flush_action)		/* flush, bias, calibration */
+		return;
+
+	for (i = 0; i < s->nch; i++)
+		s->last[i] = u->data[i];
+	/*
+	 * The hub's proximity record is { u32 steps; s32 oneshot; } (vendor proximity_vec_t):
+	 * the state is oneshot, 0 near / 1 far, which the vendor's alspshub reports (its alsps
+	 * framework then adds the 1 Android saw: 1 near, 2 far). steps reads 0 here: taking word 0
+	 * gave "near" for every change (2026-11-09).
+	 */
+	if (s->type == SENSOR_TYPE_PROXIMITY)
+		s->last[0] = u->data[1] ? 1 : 0;
+	complete(&s->sample);
+	if (s->buffered) {
+		memcpy(s->scan.val, s->last, sizeof(s->scan.val));
+		iio_push_to_buffers_with_timestamp(s->indio, &s->scan,
+						   iio_get_time_ns(s->indio));
+	}
+}
+
+static void drain_work(struct work_struct *work)
+{
+	struct mt6771_scp *scp = container_of(work, struct mt6771_scp, drain_work);
+	struct sensor_fifo *f = scp->fifo;
+	struct data_unit u;
+	u32 rp, wp, size;
+
+	spin_lock_irq(&scp->notify_lock);
+	wp = scp->notify_wp;
+	spin_unlock_irq(&scp->notify_lock);
+	size = READ_ONCE(f->size);
+	rp = READ_ONCE(f->rp);
+
+	if (wp > size || rp > size)
+		return;
+	rmb();
+	while (rp != wp) {
+		memcpy(&u, f->data + rp, sizeof(u));
+		sensor_report(scp, &u);
+		rp += sizeof(u);
+		if (rp >= size)
+			rp = 0;
+	}
+	WRITE_ONCE(f->rp, wp);
+}
+
+/*
+ * A sensor hub request, then its response: the SCP reads the send object
+ * from its task, after taking the doorbell, so the next request must wait
+ * (SET_TIMESTAMP right after SET_CONFIG overwrote it: the hub read FIFO
+ * base 0)
+ */
+static int hub_request(struct mt6771_scp *scp, void *req, unsigned int len)
+{
+	int ret;
+
+	reinit_completion(&scp->hub_rsp);
+	ret = scp_ipi_send(scp, IPI_SENSOR, req, len);
+	if (ret)
+		return ret;
+	if (!wait_for_completion_timeout(&scp->hub_rsp, msecs_to_jiffies(500)))
+		return -ETIMEDOUT;
+	return 0;
+}
+
+static void hub_send_time(struct mt6771_scp *scp)
+{
+	struct set_config_req req = {
+		.action = SENSOR_HUB_SET_TIMESTAMP,
+	};
+
+	local_irq_disable();
+	req.ap_timestamp = ktime_get_boottime_ns();
+	req.arch_counter = __arch_counter_get_cntvct();
+	local_irq_enable();
+	if (hub_request(scp, &req, sizeof(req)))
+		dev_warn(scp->dev, "sensor hub: no answer to the time\n");
+}
+
+static void hub_up_work(struct work_struct *work)
+{
+	struct mt6771_scp *scp = container_of(work, struct mt6771_scp, hub_up_work);
+	struct set_config_req req = {
+		.action = SENSOR_HUB_SET_CONFIG,
+		.buffer_base = lower_32_bits(scp->fifo_phys),
+	};
+	int ret;
+
+	ret = hub_request(scp, &req, sizeof(req));
+	if (ret) {
+		dev_err(scp->dev, "sensor hub: FIFO address not taken: %d\n", ret);
+		return;
+	}
+	hub_send_time(scp);
+	scp->hub_up = true;
+	dev_info(scp->dev, "sensor hub up (FIFO %pa, %u bytes)\n",
+		 &scp->fifo_phys, scp->fifo->size);
+}
+
+/* ---- the SCP's sleep (mt6771_scp.sleep) ---- */
+
+/*
+ * The SCP's clock (its firmware's dvfs.c, request_dfs_opp(); docs/
+ * scp-firmware.md): OPP0 (125 MHz) is ULPOSC1 at 250 MHz divided by two,
+ * OPP1 ULPOSC2 at 330 MHz; only OPP2 (416 MHz) runs on clk_sys, topckgen's
+ * scp_sel, which the SCP asks for with IPI_SCP_PLL_CTRL around the switch
+ * (turn_on/off_clk_sys). It sets OPP0 itself at start (SW_SEL 3, DIV_SEL 1
+ * read on 6.12) and nothing here asks for more. scp_sel also feeds the
+ * AP's bus gate to the SCP (infra_scp, held while the driver is bound), so
+ * between requests it is parked on 26 MHz: on its UNIVPLL parent it kept
+ * UNIVPLL running, which keeps the SoC out of SODI3 (MediaTek's
+ * soidle3_pll_condition_mask). MediaTek's handler reads the frequency a
+ * byte off (data + 1 on a void pointer) and only gates the mux; this holds
+ * it on the PLL for PLL_ENABLE (univpll_d3 for 416 MHz, else univpll_d2_d8,
+ * as scp_dvfs.c's table) and parks it again on PLL_DISABLE.
+ */
+#define SCP_SEL_26M		0	/* topckgen scp_parents[] */
+#define SCP_SEL_UNIVPLL_D2_D8	1
+#define SCP_SEL_UNIVPLL_D3	6
+
+static void scp_sel_parent(struct mt6771_scp *scp, unsigned int index)
+{
+	struct clk_hw *p = clk_hw_get_parent_by_index(__clk_get_hw(scp->scp_sel), index);
+
+	if (!p || clk_set_parent(scp->scp_sel, p->clk))
+		dev_warn(scp->dev, "scp_sel: parent %u not set\n", index);
+}
+
+static void scp_pll_ctrl(struct mt6771_scp *scp, u32 enable, u32 mhz)
+{
+	dev_dbg(scp->dev, "PLL %s (%u MHz)\n", enable ? "on" : "off", mhz);
+	scp->pll_requests++;
+	if (!scp->scp_sel || enable == scp->scp_sel_on)
+		return;
+	if (enable) {
+		scp_sel_parent(scp, mhz >= 416 ? SCP_SEL_UNIVPLL_D3 : SCP_SEL_UNIVPLL_D2_D8);
+		if (clk_prepare_enable(scp->scp_sel))
+			return;
+	} else {
+		clk_disable_unprepare(scp->scp_sel);
+		scp_sel_parent(scp, SCP_SEL_26M);
+	}
+	scp->scp_sel_on = enable;
+}
+
+/* Once the SCP runs: off scp_sel (its OPP0, ULPOSC1), the hold goes and scp_sel is parked */
+static void scp_sel_settle(struct mt6771_scp *scp)
+{
+	u32 sel = readl(scp->clkctrl + SCP_CLK_SW_SEL);
+
+	if (scp->scp_sel_on && (sel & SCP_CLK_SW_SEL_MASK)) {
+		clk_disable_unprepare(scp->scp_sel);
+		scp->scp_sel_on = false;
+		scp_sel_parent(scp, SCP_SEL_26M);
+	}
+	dev_info(scp->dev, "clock: SW_SEL 0x%x DIV_SEL 0x%x, scp_sel %s\n", sel,
+		 readl(scp->clkctrl + SCP_CLK_DIV_SEL), scp->scp_sel_on ? "held" : "on 26 MHz");
+}
+
+static void scp_sel_release(void *data)
+{
+	struct mt6771_scp *scp = data;
+
+	if (scp->scp_sel_on)
+		clk_disable_unprepare(scp->scp_sel);
+}
+
+static int scp_pmic_sshub(struct mt6771_scp *scp)
+{
+	struct device_node *np = of_parse_phandle(scp->dev->of_node, "mediatek,pwrap", 0);
+	struct platform_device *pwrap = np ? of_find_device_by_node(np) : NULL;
+	struct regmap *map;
+	int ret;
+
+	of_node_put(np);
+	if (!pwrap)
+		return -ENODEV;
+	map = dev_get_regmap(&pwrap->dev, NULL);
+	put_device(&pwrap->dev);
+	if (!map)
+		return -EPROBE_DEFER;
+	ret = regmap_update_bits(map, MT6358_BUCK_VCORE_SSHUB_CON1, SSHUB_VOSEL_MASK,
+				 SSHUB_VOSEL(600000) | SSHUB_VOSEL(600000) << 8);
+	if (!ret)
+		ret = regmap_update_bits(map, MT6358_BUCK_VCORE_SSHUB_CON0,
+					 SSHUB_EN | SSHUB_SLEEP_VOSEL_EN, SSHUB_EN);
+	if (!ret)
+		ret = regmap_update_bits(map, MT6358_LDO_VSRAM_OTHERS_SSHUB_CON1,
+					 SSHUB_VOSEL_MASK,
+					 SSHUB_VOSEL(850000) | SSHUB_VOSEL(850000) << 8);
+	if (!ret)
+		ret = regmap_update_bits(map, MT6358_LDO_VSRAM_OTHERS_SSHUB_CON0,
+					 SSHUB_EN | SSHUB_SLEEP_VOSEL_EN, SSHUB_EN);
+	if (!ret)
+		ret = regmap_set_bits(map, MT6358_TOP_CLK_CON0, RG_SRCVOLTEN_LP_EN);
+	return ret;
+}
+
+/* ---- interrupt ---- */
+
+static void scp_dispatch(struct mt6771_scp *scp, u32 id, const u8 *data,
+			 unsigned int len)
+{
+	switch (id) {
+	case IPI_SCP_A_READY: {
+		u32 sram = 0;
+
+		if (len >= 4)
+			memcpy(&sram, data, 4);
+		dev_info(scp->dev, "SCP ready (SRAM %u KB)\n", sram / 1024);
+		scp->ready = true;
+		scp_sel_settle(scp);
+		schedule_work(&scp->no_sleep_work);
+		complete(&scp->ready_done);
+		break;
+	}
+	case IPI_SENSOR: {
+		const struct notify_rsp *n = (const void *)data;
+
+		if (len < 4)
+			break;
+		if (n->action != SENSOR_HUB_NOTIFY) {
+			complete(&scp->hub_rsp);
+			break;
+		}
+		if (n->event == SCP_INIT_DONE) {
+			schedule_work(&scp->hub_up_work);
+		} else if ((n->event == SCP_DIRECT_PUSH ||
+			    n->event == SCP_FIFO_FULL) && len >= 12 && scp->hub_up) {
+			spin_lock(&scp->notify_lock);
+			scp->notify_wp = n->curr_wp;
+			spin_unlock(&scp->notify_lock);
+			schedule_work(&scp->drain_work);
+		}
+		break;
+	}
+	case IPI_LOGGER_INIT_A: {
+		struct scp_log_info info;
+
+		if (len < sizeof(info) || !scp->log)
+			break;
+		memcpy(&info, data, sizeof(info));
+		if (info.dram_addr + 4 > SCP_RTOS_START + 0x7f800)
+			break;
+		writel(lower_32_bits(scp->log_phys), scp->sram + info.dram_addr);
+		schedule_work(&scp->log_work);
+		break;
+	}
+	case IPI_SCP_PLL_CTRL: {
+		u32 req[2] = { };	/* PLL_ENABLE (1) / PLL_DISABLE (0), MHz */
+
+		memcpy(req, data, min_t(unsigned int, len, sizeof(req)));
+		scp_pll_ctrl(scp, req[0], req[1]);
+		break;
+	}
+	case IPI_CHRE:
+		spin_lock(&scp->nh_lock);
+		scp->nh_rx_len = len;
+		memcpy(scp->nh_rx, data, len);
+		scp->chrex_token = len;
+		spin_unlock(&scp->nh_lock);
+		complete(&scp->nh_rx_done);
+		schedule_work(&scp->chrex_work);
+		break;
+	default:
+		if (!test_and_set_bit(id, scp->ipi_seen))
+			dev_info(scp->dev, "IPI %u (%u bytes) not handled\n", id, len);
+		break;
+	}
+}
+
+static irqreturn_t scp_irq_thread(int irq, void *data)
+{
+	struct mt6771_scp *scp = data;
+	void __iomem *obj = scp->sram + SHARE_RCV;
+	u32 status = readl(scp->cfg + SCP_A_TO_HOST);
+	u32 id, len;
+
+	if (status & SCP_IRQ_WDT)
+		dev_err(scp->dev, "SCP watchdog (PC %#x)\n",
+			readl(scp->cfg + SCP_DEBUG_PC));
+	if (status & SCP_IRQ_SCP2HOST) {
+		id = readl(obj);
+		len = min_t(u32, readl(obj + 4), SHARE_DATA_SIZE);
+		memcpy_fromio(scp->rcv, obj + SHARE_DATA, len);
+		if (id < IPI_NR) {
+			scp->rcv_count[id]++;
+			scp_dispatch(scp, id, scp->rcv, len);
+		}
+	}
+	writel(status & (SCP_IRQ_SCP2HOST | SCP_IRQ_WDT), scp->cfg + SCP_A_TO_HOST);
+	return IRQ_HANDLED;
+}
+
+/* ---- IIO ---- */
+
+static struct scp_sensor *to_sensor(struct iio_dev *indio)
+{
+	return *(struct scp_sensor **)iio_priv(indio);
+}
+
+#define SCP_AXIS(_type, _axis, _idx) {					\
+	.type = _type,							\
+	.modified = 1,							\
+	.channel2 = IIO_MOD_##_axis,					\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),			\
+	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |		\
+				    BIT(IIO_CHAN_INFO_SAMP_FREQ),	\
+	.scan_index = _idx,						\
+	.scan_type = { .sign = 's', .realbits = 32, .storagebits = 32,	\
+		       .endianness = IIO_CPU },				\
+}
+
+#define SCP_VECTOR(_name, _type)					\
+static const struct iio_chan_spec _name[] = {				\
+	SCP_AXIS(_type, X, 0), SCP_AXIS(_type, Y, 1), SCP_AXIS(_type, Z, 2), \
+	IIO_CHAN_SOFT_TIMESTAMP(3),					\
+}
+
+SCP_VECTOR(scp_accel_channels, IIO_ACCEL);
+SCP_VECTOR(scp_gyro_channels, IIO_ANGL_VEL);
+SCP_VECTOR(scp_magn_channels, IIO_MAGN);
+
+static const struct iio_chan_spec scp_light_channels[] = {
+	{
+		.type = IIO_LIGHT,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED),
+		.scan_index = 0,
+		.scan_type = { .sign = 's', .realbits = 32, .storagebits = 32,
+			       .endianness = IIO_CPU },
+	},
+	IIO_CHAN_SOFT_TIMESTAMP(1),
+};
+
+static const struct iio_chan_spec scp_prox_channels[] = {
+	{
+		.type = IIO_PROXIMITY,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
+		.scan_index = 0,
+		.scan_type = { .sign = 's', .realbits = 32, .storagebits = 32,
+			       .endianness = IIO_CPU },
+	},
+	IIO_CHAN_SOFT_TIMESTAMP(1),
+};
+
+static int scp_read_once(struct scp_sensor *s, int idx, int *val)
+{
+	int ret = 0;
+
+	if (!s->buffered) {
+		reinit_completion(&s->sample);
+		s->reading = true;
+		ret = sensor_config(s, true);
+		if (!ret && !wait_for_completion_timeout(&s->sample,
+					msecs_to_jiffies(READ_TIMEOUT_MS)))
+			ret = -ETIMEDOUT;
+		sensor_config(s, false);
+		s->reading = false;
+	}
+	*val = s->last[idx];
+	return ret;
+}
+
+static int scp_read_raw(struct iio_dev *indio, struct iio_chan_spec const *ch,
+			int *val, int *val2, long mask)
+{
+	struct scp_sensor *s = to_sensor(indio);
+	int ret;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+	case IIO_CHAN_INFO_PROCESSED:
+		ret = iio_device_claim_direct_mode(indio);
+		if (ret)
+			return ret;
+		ret = scp_read_once(s, ch->scan_index, val);
+		iio_device_release_direct_mode(indio);
+		return ret ? ret : IIO_VAL_INT;
+	case IIO_CHAN_INFO_SCALE:
+		*val = 1;
+		switch (s->type) {
+		case SENSOR_TYPE_ACCELEROMETER:
+			*val2 = 1000;		/* m/s^2 */
+			break;
+		case SENSOR_TYPE_GYROSCOPE:
+			*val2 = 7505747;	/* rad/s */
+			break;
+		default:
+			*val2 = 10000;		/* gauss (1/100 uT) */
+			break;
+		}
+		return IIO_VAL_FRACTIONAL;
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		*val = s->freq_hz;
+		return IIO_VAL_INT;
+	}
+	return -EINVAL;
+}
+
+static int scp_write_raw(struct iio_dev *indio, struct iio_chan_spec const *ch,
+			 int val, int val2, long mask)
+{
+	struct scp_sensor *s = to_sensor(indio);
+
+	if (mask != IIO_CHAN_INFO_SAMP_FREQ || val < 1 || val > 200)
+		return -EINVAL;
+	s->freq_hz = val;
+	return s->buffered ? sensor_config(s, true) : 0;
+}
+
+static const struct iio_info scp_iio_info = {
+	.read_raw = scp_read_raw,
+	.write_raw = scp_write_raw,
+};
+
+static int scp_buffer_postenable(struct iio_dev *indio)
+{
+	struct scp_sensor *s = to_sensor(indio);
+
+	s->buffered = true;
+	return sensor_config(s, true);
+}
+
+static int scp_buffer_predisable(struct iio_dev *indio)
+{
+	struct scp_sensor *s = to_sensor(indio);
+
+	s->buffered = false;
+	return sensor_config(s, false);
+}
+
+static const struct iio_buffer_setup_ops scp_buffer_ops = {
+	.postenable = scp_buffer_postenable,
+	.predisable = scp_buffer_predisable,
+};
+
+static void scp_kfifo_put(void *buffer)
+{
+	iio_kfifo_free(buffer);
+}
+
+static int scp_add_sensor(struct mt6771_scp *scp, int i, const char *name,
+			  u8 type, const struct iio_chan_spec *ch, int nch_spec,
+			  int nch)
+{
+	struct iio_buffer *buffer;
+	struct iio_dev *indio;
+	struct scp_sensor *s;
+	int ret, n;
+
+	indio = devm_iio_device_alloc(scp->dev, sizeof(s));
+	if (!indio)
+		return -ENOMEM;
+	/* the sensor state lives in the hub's array */
+	s = &scp->sensors[i];
+	*(struct scp_sensor **)iio_priv(indio) = s;
+	s->scp = scp;
+	s->indio = indio;
+	s->name = name;
+	s->type = type;
+	s->nch = nch;
+	s->on_change = type == SENSOR_TYPE_LIGHT || type == SENSOR_TYPE_PROXIMITY;
+	s->freq_hz = 50;
+	init_completion(&s->sample);
+
+	indio->name = name;
+	indio->info = &scp_iio_info;
+	indio->channels = ch;
+	indio->num_channels = nch_spec;
+	indio->modes = INDIO_DIRECT_MODE;
+	ret = devm_iio_kfifo_buffer_setup(scp->dev, indio, &scp_buffer_ops);
+	if (ret)
+		return ret;
+	for (n = 1; n < SCP_BUFFERS; n++) {
+		buffer = iio_kfifo_allocate();
+		if (!buffer)
+			return -ENOMEM;
+		ret = devm_add_action_or_reset(scp->dev, scp_kfifo_put, buffer);
+		if (ret)
+			return ret;
+		ret = iio_device_attach_buffer(indio, buffer);
+		if (ret)
+			return ret;
+	}
+	return devm_iio_device_register(scp->dev, indio);
+}
+
+/* ---- probe ---- */
+
+static int mt6771_scp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct reserved_mem *rmem;
+	struct device_node *np;
+	struct mt6771_scp *scp;
+	struct dentry *dbg;
+	struct clk *clk;
+	int ret;
+
+	scp = devm_kzalloc(dev, sizeof(*scp), GFP_KERNEL);
+	if (!scp)
+		return -ENOMEM;
+	scp->dev = dev;
+	mutex_init(&scp->send_lock);
+	mutex_init(&scp->hub_lock);
+	spin_lock_init(&scp->notify_lock);
+	spin_lock_init(&scp->nh_lock);
+	init_completion(&scp->ready_done);
+	init_completion(&scp->nh_rx_done);
+	init_completion(&scp->hub_rsp);
+	INIT_WORK(&scp->hub_up_work, hub_up_work);
+	INIT_WORK(&scp->no_sleep_work, no_sleep_work);
+	INIT_WORK(&scp->drain_work, drain_work);
+	INIT_WORK(&scp->chrex_work, chrex_work);
+	scp->seq = 1;
+
+	scp->sram = devm_platform_ioremap_resource_byname(pdev, "sram");
+	if (IS_ERR(scp->sram))
+		return PTR_ERR(scp->sram);
+	scp->cfg = devm_platform_ioremap_resource_byname(pdev, "cfg");
+	if (IS_ERR(scp->cfg))
+		return PTR_ERR(scp->cfg);
+	scp->clkctrl = devm_platform_ioremap_resource_byname(pdev, "clkctrl");
+	if (IS_ERR(scp->clkctrl))
+		return PTR_ERR(scp->clkctrl);
+	scp->infracfg = syscon_regmap_lookup_by_phandle(dev->of_node, "mediatek,infracfg");
+	if (IS_ERR(scp->infracfg))
+		return dev_err_probe(dev, PTR_ERR(scp->infracfg), "no infracfg\n");
+
+	clk = devm_clk_get_enabled(dev, "main");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "no clock\n");
+	/*
+	 * The SCP runs on its ULPOSCs, not on scp_sel (scp_pll_ctrl()), unless
+	 * its clock control says it is on clk_sys (SW_SEL 0, also the value
+	 * before LK's image starts): then it is held until the SCP lets it go
+	 * or is ready on a ULPOSC (scp_sel_settle()).
+	 */
+	scp->scp_sel = devm_clk_get(dev, "scp-sel");
+	if (IS_ERR(scp->scp_sel))
+		return dev_err_probe(dev, PTR_ERR(scp->scp_sel), "no scp-sel\n");
+	if (!(readl(scp->clkctrl + SCP_CLK_SW_SEL) & SCP_CLK_SW_SEL_MASK)) {
+		ret = clk_prepare_enable(scp->scp_sel);
+		if (ret)
+			return ret;
+		scp->scp_sel_on = true;
+	} else {
+		scp_sel_parent(scp, SCP_SEL_26M);
+	}
+	ret = devm_add_action_or_reset(dev, scp_sel_release, scp);
+	if (ret)
+		return ret;
+	/* as MediaTek's scp_dvfs.c at every boot, the SCP's sleep on or off */
+	ret = scp_pmic_sshub(scp);
+	if (ret)
+		return dev_err_probe(dev, ret, "sensor hub supplies\n");
+
+	np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	rmem = np ? of_reserved_mem_lookup(np) : NULL;
+	of_node_put(np);
+	if (!rmem)
+		return dev_err_probe(dev, -ENODEV, "no sensor FIFO memory\n");
+	scp->fifo_phys = rmem->base;
+	scp->fifo_bytes = rmem->size;
+	scp->fifo = devm_memremap(dev, rmem->base, rmem->size, MEMREMAP_WC);
+	if (IS_ERR(scp->fifo))
+		return PTR_ERR(scp->fifo);
+	scp->fifo->rp = 0;
+	scp->fifo->wp = 0;
+	scp->fifo->size = (scp->fifo_bytes - sizeof(struct sensor_fifo)) /
+			  sizeof(struct data_unit) * sizeof(struct data_unit);
+
+	np = of_parse_phandle(dev->of_node, "memory-region", 1);
+	rmem = np ? of_reserved_mem_lookup(np) : NULL;
+	of_node_put(np);
+	if (rmem && rmem->size >= SCP_LOG_BUF_LEN + 64) {
+		scp->log_phys = rmem->base;
+		scp->log = devm_memremap(dev, rmem->base, rmem->size, MEMREMAP_WC);
+		if (IS_ERR(scp->log))
+			scp->log = NULL;
+		else
+			scp_log_init(scp);
+	}
+	INIT_WORK(&scp->log_work, log_work);
+
+	/* LK loads the SCP only when the scp node reads "okay" */
+	if (readl(scp->clkctrl + SCP_SRAM_PDN) ||
+	    !readl(scp->sram + SCP_REGION_INFO + 4))
+		return dev_err_probe(dev, -ENODEV,
+				     "SCP not loaded by the bootloader\n");
+
+	scp->irq = platform_get_irq(pdev, 0);
+	if (scp->irq < 0)
+		return scp->irq;
+	writel(SCP_IRQ_SCP2HOST | SCP_IRQ_WDT, scp->cfg + SCP_A_TO_HOST);
+	ret = devm_request_threaded_irq(dev, scp->irq, NULL, scp_irq_thread,
+					IRQF_ONESHOT, "scp", scp);
+	if (ret)
+		return ret;
+
+	ret = scp_add_sensor(scp, 0, "scp-accel", SENSOR_TYPE_ACCELEROMETER,
+			     scp_accel_channels, ARRAY_SIZE(scp_accel_channels), 3);
+	if (!ret)
+		ret = scp_add_sensor(scp, 1, "scp-gyro", SENSOR_TYPE_GYROSCOPE,
+				     scp_gyro_channels, ARRAY_SIZE(scp_gyro_channels), 3);
+	if (!ret)
+		ret = scp_add_sensor(scp, 2, "scp-magn", SENSOR_TYPE_MAGNETIC_FIELD,
+				     scp_magn_channels, ARRAY_SIZE(scp_magn_channels), 3);
+	if (!ret)
+		ret = scp_add_sensor(scp, 3, "scp-light", SENSOR_TYPE_LIGHT,
+				     scp_light_channels, ARRAY_SIZE(scp_light_channels), 1);
+	if (!ret)
+		ret = scp_add_sensor(scp, 4, "scp-proximity", SENSOR_TYPE_PROXIMITY,
+				     scp_prox_channels, ARRAY_SIZE(scp_prox_channels), 1);
+	if (ret)
+		return ret;
+
+	/* start the core (restart it if it already runs: no ready IPI then) */
+	if (readl(scp->cfg + SCP_CFG_RESET)) {
+		writel(0, scp->cfg + SCP_CFG_RESET);
+		udelay(100);
+	}
+	writel(1, scp->cfg + SCP_CFG_RESET);
+	if (!wait_for_completion_timeout(&scp->ready_done,
+					 msecs_to_jiffies(SCP_READY_TIMEOUT_MS)))
+		dev_warn(dev, "SCP not ready (PC %#x)\n",
+			 readl(scp->cfg + SCP_DEBUG_PC));
+	platform_set_drvdata(pdev, scp);
+	dbg = debugfs_create_dir("mt6771-scp", NULL);
+	if (scp->log)
+		debugfs_create_file("log", 0400, dbg, scp, &scp_log_fops);
+	debugfs_create_file("stats", 0400, dbg, scp, &scp_stats_fops);
+	return 0;
+}
+
+static const struct of_device_id mt6771_scp_of_match[] = {
+	{ .compatible = "mediatek,mt6771-scp-tinysys" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6771_scp_of_match);
+
+static int scp_set_sleep_mode(struct mt6771_scp *scp, s32 mode)
+{
+	int ret = scp_ipi_send(scp, IPI_DVFS_SLEEP, &mode, sizeof(mode));
+
+	if (ret)
+		dev_warn(scp->dev, "SCP sleep mode %d not set: %d\n", mode, ret);
+	return ret;
+}
+
+/* not fatal either way: a failed switch costs power, not the suspend */
+static int mt6771_scp_suspend(struct device *dev)
+{
+	struct mt6771_scp *scp = dev_get_drvdata(dev);
+
+	if (scp && scp->ready && scp_sleep && scp_suspend_mode >= SCP_SLEEP_OFF &&
+	    scp_suspend_mode <= SCP_SLEEP_NO_CONDITION && scp_suspend_mode != SCP_SLEEP_ON)
+		scp_set_sleep_mode(scp, scp_suspend_mode);
+	return 0;
+}
+
+static int mt6771_scp_resume(struct device *dev)
+{
+	struct mt6771_scp *scp = dev_get_drvdata(dev);
+
+	if (scp && scp->ready && scp_sleep && scp_suspend_mode >= SCP_SLEEP_OFF &&
+	    scp_suspend_mode <= SCP_SLEEP_NO_CONDITION && scp_suspend_mode != SCP_SLEEP_ON)
+		scp_set_sleep_mode(scp, SCP_SLEEP_ON);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(mt6771_scp_pm, mt6771_scp_suspend, mt6771_scp_resume);
+
+static struct platform_driver mt6771_scp_driver = {
+	.probe = mt6771_scp_probe,
+	.driver = {
+		.name = "mt6771-scp",
+		.pm = pm_sleep_ptr(&mt6771_scp_pm),
+		.of_match_table = mt6771_scp_of_match,
+		/* waits up to SCP_READY_TIMEOUT_MS for the SCP */
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+	},
+};
+module_platform_driver(mt6771_scp_driver);
+
+MODULE_DESCRIPTION("MT6771 SCP (tinysys) and its sensor hub");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6771-spm.c b/drivers/soc/mediatek/mt6771-spm.c
new file mode 100644
index 0000000000000000000000000000000000000000..4cc2f8dc6c054ae9d772b3916790220aafd575ea
--- /dev/null
+++ b/drivers/soc/mediatek/mt6771-spm.c
@@ -0,0 +1,1924 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6771 SPM: resource requests and system suspend.
+ *
+ * Resource requests. On MediaTek's kernel the SPM firmware holds the AP's
+ * requests for the 26 MHz clock, the bus/DRAM power source and DRAM
+ * (SPM_SRC_REQ reads 0x83 on 4.14). Without them, when UFS suspends it
+ * drops its reference-clock request; then nothing keeps 26 MHz, the
+ * display goes white and cores in power-down never wake (an RCU stall,
+ * measured on 6.12 in suspend with pm_test=devices). This sets the same
+ * requests at probe (after starting the firmware, which clears them) and
+ * keeps them, except across the SPM's own suspend: there they are what
+ * MediaTek's drivers drop (spm_resource_req()) so the SPM can turn 26 MHz
+ * and DRAM down.
+ *
+ * System suspend. The MT6771's ATF does not implement PSCI SYSTEM_SUSPEND
+ * usefully (the call reset the phone, measured). MediaTek's kernel never
+ * makes it: spm_go_to_sleep() (drivers/misc/mediatek/base/power/spm_v4)
+ * sets the SPM firmware's suspend scenario up through SiP calls and enters
+ * the vendor's suspend idle state through PSCI CPU_SUSPEND, with MCDI
+ * paused, and tells the SSPM around it (spm_to_sspm_command(): without
+ * that, the SSPM's MCDI task never answered again after the first
+ * suspend, measured). This does the same, after starting the SPM firmware
+ * at probe as spm_module_init() and spm_vcorefs_init() do (Vcore and DRAM
+ * frequency scaling off). Left out: the GIC masking and the CIRQ (edge
+ * interrupts that arrive while the GIC is off are lost; the PMIC's is a
+ * level).
+ *
+ * Deep idle. MediaTek's kernel enters the SPM firmware's deep idle
+ * scenario from cpuidle when the last CPU idles with the display and the
+ * other multimedia subsystems off and the clocks its condition masks name
+ * gated (spm_v4/mtk_idle.c, dpidle_can_enter()): the CPU top, MCUSYS and
+ * DRAM go down while the 26 MHz clock and infra stay up, so audio keeps
+ * playing from the AFE and wakes the CPU through the SPM to refill. This
+ * enters it the same way, spm_go_to_dpidle(): the SSPM told, the scenario
+ * set up through a SiP call, PSCI CPU_SUSPEND with the vendor's deep idle
+ * state, through a hook in cpuidle-psci: CPU 0's cluster power-down becomes
+ * deep idle when the conditions hold and the next timer is at least
+ * dpidle_min_us away (no idle-state node of its own: LK edits those by
+ * name). Only with CPU 0 the only one online (the vendor's MCDI governor
+ * picks the last core instead) and off by default (module parameter
+ * dpidle).
+ *
+ * SODI (screen-on deep idle). With the display running but the GPU and the
+ * other multimedia blocks off, MediaTek's kernel enters the firmware's SODI
+ * scenario from the last core (spm_v4/mtk_spm_sodi.c, spm_go_to_sodi();
+ * conditions in mtk_idle_mt6771.c): the CPU top and MCUSYS go down, infra
+ * and 26 MHz stay up and DRAM goes to self-refresh between the display's
+ * fetches. The last core is MCDI's: every other core and the other cluster
+ * powered off by the SSPM's MCDI task, which is then paused until the core
+ * is back (mtk-mcdi.c). Entered here through the same cpuidle-psci hook as
+ * deep idle, from any CPU's cluster power-down. The panel runs in video
+ * mode, for which the vendor uses SODI's "CG mode" (SODI_CG_MODE: only
+ * DRAM self-refresh; the DRAM PHY, its PLLs and the main PLLs stay on, so
+ * the display's DRAM requests are served at once). Off by default (module
+ * parameter sodi; on in the Debian boot images since 2026-11-17).
+ *
+ * SODI3 is the same scenario with 26 MHz going down too, as in suspend
+ * (the vendor's spm_go_to_sodi3()). The vendor kernel used it only with
+ * command-mode panels, whose display path stops between updates; with this
+ * video-mode panel it is for the screen off with the phone awake, the
+ * display powered down (a wakelock, a refused suspend). Tried before SODI
+ * when both are on (module parameter sodi3).
+ */
+#include <linux/arm-smccc.h>
+#include <linux/bits.h>
+#include <linux/clk-provider.h>
+#include <linux/cpufreq.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/psci.h>
+#include <linux/regmap.h>
+#include <linux/sizes.h>
+#include <linux/soc/mediatek/mtk-mcdi.h>
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+#include <linux/string.h>
+#include <linux/suspend.h>
+#include <linux/tick.h>
+
+#define SPM_SRC_REQ		0x0b8
+#define PWR_STATUS		0x180
+#define PWR_STATUS_2ND		0x184
+/* what the firmware decides its sleep from (vendor mtk_spm_reg_mt6771.h): the
+ * source masks it honours, the subsystems' idle and request status */
+#define SPM_SRC_MASK		0x0bc
+#define SPM_SRC2_MASK		0x0c0
+#define SUBSYS_IDLE_STA		0x170
+#define SRC_REQ_STA		0x17c
+#define SPM_APSRC_REQ		BIT(0)
+#define SPM_F26M_REQ		BIT(1)
+#define SPM_DDREN_REQ		BIT(7)
+
+/* Wake-up status the firmware leaves (vendor __spm_get_wakeup_status()) */
+#define PCM_REG_DATA_INI	0x028	/* PC before a handshake, 0 after */
+#define PCM_REG13_DATA		0x134
+#define SPM_WAKEUP_STA		0x15c
+#define SPM_BSI_D1_SR		0x420	/* sleep time, 32 kHz ticks */
+#define SPM_SW_DEBUG		0x604
+#define SPM_SW_RSV_0		0x608	/* wake-up events (PCM R12) */
+/* handshake timeouts the firmware records (vendor SPM_DBG1_*: bit 0 EMI
+ * clock off, 1 PMIC wrapper sleep, 2 PMIC wrapper DVFS) */
+#define WDT_LATCH_SPARE0_FIX	0x780
+
+/* SiP calls (vendor mtk_secure_api.h) */
+#define MTK_SIP_SPM_SUSPEND_ARGS	MTK_SIP_SMC_CMD(0x220)
+#define MTK_SIP_SPM_FIRMWARE_STATUS	MTK_SIP_SMC_CMD(0x221)
+#define MTK_SIP_SPM_VCOREFS_ARGS	MTK_SIP_SMC_CMD(0x226)
+#define MTK_SIP_SPM_ARGS		MTK_SIP_SMC_CMD(0x22a)
+#define MTK_SIP_SPM_GET_PWR_CTRL_ARGS	MTK_SIP_SMC_CMD(0x22b)
+#define MTK_SIP_SPM_PWR_CTRL_ARGS	MTK_SIP_SMC_CMD(0x224)
+
+/* SPM_ARGS commands */
+#define SPM_ARGS_SPMFW_IDX	0
+#define SPM_ARGS_PCM_WDT	8
+/* VCOREFS_ARGS commands */
+#define VCOREFS_DVFSFW_INIT	0
+#define VCOREFS_GO		1
+#define VCOREFS_PWRAP_CMD	3
+/* GET_PWR_CTRL_ARGS: the suspend scenario's wake sources */
+#define SPM_PWR_CTRL_SUSPEND	17
+#define SPM_PWR_CTRL_DPIDLE	18
+#define SPM_PWR_CTRL_SODI	19
+#define PW_WAKE_SRC		12
+/* SiP calls for deep idle */
+#define MTK_SIP_SPM_DPIDLE_ARGS		MTK_SIP_SMC_CMD(0x227)
+#define MTK_SIP_SPM_SODI_ARGS		MTK_SIP_SMC_CMD(0x228)
+#define MTK_SIP_SPM_SLEEP_DPIDLE_ARGS	MTK_SIP_SMC_CMD(0x229)
+#define MTK_SIP_CHECK_SECURE_CG		MTK_SIP_SMC_CMD(0x22d)
+
+/*
+ * Firmware index 0 (LPDDR4X, 2 channels), no external buck; the Vcore
+ * PMIC codes for 0.725 V and 0.8 V; vcorefs flags 0x8418: the common
+ * scenario with Vcore and DRAM scaling and MMSYS DVFS off.
+ */
+#define SPMFW_IDX		0
+#define VCORE_PMIC_LOW		36
+#define VCORE_PMIC_HIGH		48
+#define VCOREFS_FLAGS		0x8418
+
+/*
+ * Suspend flags, the vendor's slp_spm_flags for the MT6771: Vcore DVS and
+ * DFS off, no ATF abort, the suspend option; CPU, infra and DDR PHY power
+ * down.
+ */
+#define SPM_SUSPEND_FLAGS	0x80098
+#define PCM_WDT_SEC		30
+#define PCM_TIMER_MAX		(0xffffffff - PCM_WDT_SEC * 32768)	/* ATF's clamp */
+
+/*
+ * SSPM IPI pin 6 (SPM_SUSPEND): mailbox 1, slots 2-9, doorbell bit 1
+ * (vendor sspm/mt6771/sspm_ipi_mbox_layout.h). The command, then 7 words
+ * of arguments; the SSPM answers in slot 2.
+ */
+#define SSPM_MBOX_IN_IRQ	0x0
+#define SSPM_MBOX_OUT_IRQ	0x4
+#define SSPM_SPM_SLOT		2
+#define SSPM_SPM_LEN		8
+#define SSPM_SPM_IRQ		BIT(1)
+
+/* SSPM commands (vendor mtk_spm_internal.h) */
+#define SSPM_SPM_SUSPEND		0
+#define SSPM_SPM_RESUME			1
+#define SSPM_SPM_DPIDLE_ENTER		2
+#define SSPM_SPM_DPIDLE_LEAVE		3
+#define SSPM_SPM_ENTER_SODI		4
+#define SSPM_SPM_LEAVE_SODI		5
+/* the option word of a command (struct spm_data's spm_opt) */
+#define SSPM_SPM_OPT_SLOT		(SSPM_SPM_SLOT + 5)
+#define SSPM_OPT_SLEEP_DPIDLE		BIT(0)
+#define SSPM_SPM_SUSPEND_PREPARE	8
+#define SSPM_SPM_POST_SUSPEND		9
+
+/* The vendor tree's "suspend" idle state: cluster power-down, state 5 */
+#define MT6771_PSCI_SUSPEND	0x01010005
+/* its deep idle (state 4) and mcdi-cluster, what deep idle falls back to */
+#define MT6771_PSCI_DPIDLE	0x01010004
+#define MT6771_PSCI_CLUSTER	0x01010001
+/* the vendor tree's SODI state (2) */
+#define MT6771_PSCI_SODI	0x01010002
+
+/*
+ * The vendor's slp_spm_deepidle_flags for the MT6771 with an SSPM: infra
+ * kept on, Vcore DVS and DFS off, no ATF abort, CSYSPWRUPACK kept high, the
+ * deep idle option (the firmware keeps 26 MHz). Flags 1: 0, leaving the
+ * A73 buck alone.
+ */
+#define SPM_DPIDLE_FLAGS	0x10019a
+
+/*
+ * The vendor's slp_spm_SODI_flags for the MT6771 with an SSPM: the deep
+ * idle set with the SODI option (bit 21) instead of deep idle's; and
+ * SODI_CG_MODE (bit 12), the scenario the vendor's display picks for a
+ * video-mode panel (through the GCE there): the firmware arms DRAM
+ * self-refresh alone (docs/spm-firmware.md, the main program, step 10).
+ */
+#define SPM_FLAG_SODI_CG_MODE	BIT(12)
+#define SPM_SODI_FLAGS		(0x20019a | SPM_FLAG_SODI_CG_MODE)
+
+static uint pcm_flags = SPM_SUSPEND_FLAGS;
+module_param(pcm_flags, uint, 0644);
+MODULE_PARM_DESC(pcm_flags, "SPM suspend flags (vendor SPM_FLAG_*)");
+
+/*
+ * Second flag word (vendor SPM_FLAG1_*). MediaTek's spm_go_to_sleep() sets
+ * BIG_BUCK_OFF_ENABLE | BIG_BUCK_ON_ENABLE (0x300) unless its hotplug code
+ * already switched the A73 cluster's buck off: the SPM (through the SSPM)
+ * then switches it off for the sleep and on at the wake.
+ */
+static uint pcm_flags1;
+module_param(pcm_flags1, uint, 0644);
+MODULE_PARM_DESC(pcm_flags1, "SPM suspend flags 1 (vendor SPM_FLAG1_*; 0x300: A73 buck off asleep)");
+
+/*
+ * Off until it is stable: the first runs left the display tinted (the
+ * suspend ran with LK's display pipeline live, which the vendor's
+ * suspend refuses: "CANNOT SLEEP: power domain(s) still on").
+ */
+/*
+ * The suspend's wake sources (PCM R12 bits, pcm_def_mt6771.h): 0 keeps
+ * ATF's. An awake SCP (sensor hub, its sleep off) holds R12_SCP_SPM_IRQ_B
+ * (bit 11) and ends every suspend at once; clearing it here lets the SPM
+ * sleep with the SCP's request granted.
+ */
+static uint wake_mask;
+module_param(wake_mask, uint, 0644);
+MODULE_PARM_DESC(wake_mask, "SPM suspend wake sources (R12 bits), 0 for ATF's");
+
+/*
+ * The SSPM's SUSPEND puts VS1 into low power while SRCLKEN0 is down
+ * (BUCK_VS1_OP_EN bit 1, OP_CFG bit 1; its RESUME clears the enable again;
+ * docs/sspm-firmware.md). Off by default here: the enable is cleared again
+ * as soon as the SSPM answers, so VS1 sleeps at full power, to see whether
+ * the sleep resets follow it.
+ */
+static bool vs1_sleep_lp;
+module_param(vs1_sleep_lp, bool, 0644);
+MODULE_PARM_DESC(vs1_sleep_lp, "Leave VS1 in the SSPM's low-power mode in suspend (else full power)");
+
+/*
+ * The SPM's watchdog, armed before the SSPM is told and the suspend set up.
+ * ATF's SPM_ARGS_PCM_WDT writes this into PCM_TIMER_VAL and arms the
+ * watchdog 30 s past it; the suspend call re-arms it past the real sleep
+ * timer (PCM_TIMER_MAX here). MediaTek's kernel passes 30. Every deep-sleep
+ * reset logged on 2026-11-11 (7 of 7, the preloader's records in expdb)
+ * was this watchdog (TOPRGU status 0x2, SPM_RST), between arming it and the
+ * wake; with the maximum the window has the same 36 h limit as the sleep.
+ */
+static uint pcm_wdt_timer = PCM_TIMER_MAX;
+module_param(pcm_wdt_timer, uint, 0644);
+MODULE_PARM_DESC(pcm_wdt_timer, "PCM_TIMER_VAL when the SPM watchdog is armed (30: the vendor's)");
+
+static bool deep;
+module_param(deep, bool, 0444);
+MODULE_PARM_DESC(deep, "Start the SPM firmware and suspend through it");
+
+/*
+ * PLL sleep control (APMIXEDSYS AP_PLL_CON3 and AP_PLL_CON4): a set bit
+ * keeps a PLL or clock squarer under software control, a clear one hands it
+ * to the SPM, whose firmware then switches it with the sleep ladder
+ * (SPM_PLL_CON, the VRF18 step) and with a cluster's power. The reset value
+ * is all software, and that is what 6.12 ran with (0x07ffffff): nothing the
+ * firmware switched off took effect. MediaTek's kernel clears
+ *  - at boot, the bits of MPLL, CCIPLL, MAINPLL and the two clock squarers
+ *    (clk-mt6771.c mtk_apmixedsys_init(): CON3 &= 0x007d5550, CON4 &= 0x7f5);
+ *  - while a cluster is online, its CPU PLL's bits (mtk_cpuhp_mt6771.c:
+ *    "Switch LL/L cluster to HW mode", mp_enter_suspend(id, 1)); 4.14 reads
+ *    CON3 0x00044440 awake on this phone, both clusters in hardware mode.
+ * 0: leave the registers as the bootloader set them. 1: the boot-time
+ * bits, applied at probe and before each suspend from the values found at
+ * probe, so a write to the parameter takes effect at the next suspend,
+ * either way. 2: those, and the CPU PLLs' bits from just before the sleep
+ * until just after the wake, on the one CPU left running. Not while awake:
+ * set from userspace on #128 (2026-11-15) the phone slept and woke six
+ * times and then hung awake after eight minutes; MediaTek's hotplug code
+ * switches a cluster's PLL off and its frequency hopping around the mode
+ * change, and its DVFS runs in the SSPM, none of which 6.12 does.
+ */
+#define AP_PLL_CON3		0x00c
+#define AP_PLL_CON4		0x010
+#define AP_PLL_CON8		0x020
+#define PLL_CON3_BOOT_MASK	0x007d5550
+#define PLL_CON4_BOOT_MASK	0x000007f5
+#define PLL_CON3_CPU_BITS	(0x00780000 | 0x00011110)	/* mp0, mp1 */
+#define PLL_CON4_CPU_BITS	(0x00002000 | 0x00000001)
+/*
+ * 2 by default from #134: on #132 (2026-11-15) 90 two-minute sleeps at 2
+ * were all clean, against 1 hung wake (step 13) in 45 at 0 on the same boot.
+ */
+static uint pll_sleep = 2;
+module_param(pll_sleep, uint, 0644);
+MODULE_PARM_DESC(pll_sleep, "PLLs under the SPM's sleep control: 0 none, 1 the vendor's boot set, 2 and the CPU PLLs across a suspend");
+
+/*
+ * TVDPLL feeds only DPI, which this phone does not have; the bootloader
+ * leaves it running and clk_ignore_unused keeps it. MediaTek's kernel
+ * switches it off at boot (mtk_apmixedsys_init()).
+ */
+#define TVDPLL_CON0		0x260
+#define TVDPLL_PWR_CON0		0x26c
+static bool tvdpll_off = true;
+module_param(tvdpll_off, bool, 0444);
+MODULE_PARM_DESC(tvdpll_off, "Switch the unused TVDPLL off at boot");
+
+/*
+ * The two audio PLLs: the bootloader leaves them running too, and until the
+ * audio driver has used and released them once they stay on, through every
+ * sleep (read in the suspend path on #132). MediaTek's kernel switches them
+ * off at boot in the same place. Only when the clock framework counts no
+ * user: the AFE prepares them itself when it plays or records.
+ */
+#define APLL1_CON0		0x2a0
+#define APLL1_PWR_CON0		0x2b0
+#define APLL2_CON0		0x2b4
+#define APLL2_PWR_CON0		0x2c4
+static bool apll_off = true;
+module_param(apll_off, bool, 0444);
+MODULE_PARM_DESC(apll_off, "Switch the audio PLLs off at boot when nothing uses them");
+
+/* the infra clocks LK leaves on and nothing uses gated at probe (spm_clk_init()) */
+static bool infra_gate_unused = true;
+module_param(infra_gate_unused, bool, 0444);
+
+static struct regmap *apmixed_regmap, *topck_regmap, *infracfg_regmap;
+static u32 pll_con3_boot, pll_con4_boot;
+
+/*
+ * Only ever clears the bits it owns, and sets back only those that were set
+ * at probe: #130 wrote the whole of both words from their probe-time values
+ * before every suspend, pll_sleep 0 included, and its first deep sleep never
+ * woke (2026-11-15). AP_PLL_CON4 bits 12-13 change by themselves while
+ * awake, so a stale copy of that word is not harmless.
+ */
+static u32 pll_sleep_done;	/* the level the registers are at */
+
+static void spm_pll_sleep_apply(bool asleep)
+{
+	u32 level = min(pll_sleep, 2U);
+	bool cpu = level >= 2 && asleep;
+
+	if (!apmixed_regmap || (!level && !pll_sleep_done))
+		return;
+	if (level >= 1) {
+		regmap_clear_bits(apmixed_regmap, AP_PLL_CON3,
+				  ~PLL_CON3_BOOT_MASK & 0x07ffffff);
+		regmap_clear_bits(apmixed_regmap, AP_PLL_CON4,
+				  ~PLL_CON4_BOOT_MASK & 0x0000ffff & ~PLL_CON4_CPU_BITS & ~0x3000);
+	} else {
+		/* back to what probe found, for the bits level 1 cleared */
+		regmap_set_bits(apmixed_regmap, AP_PLL_CON3,
+				pll_con3_boot & ~PLL_CON3_BOOT_MASK & 0x07ffffff);
+		regmap_set_bits(apmixed_regmap, AP_PLL_CON4,
+				pll_con4_boot & ~PLL_CON4_BOOT_MASK & 0x0000ffff &
+				~PLL_CON4_CPU_BITS & ~0x3000);
+	}
+	if (cpu) {
+		regmap_clear_bits(apmixed_regmap, AP_PLL_CON3, PLL_CON3_CPU_BITS);
+		regmap_clear_bits(apmixed_regmap, AP_PLL_CON4, PLL_CON4_CPU_BITS);
+	} else if (pll_sleep_done >= 2) {
+		regmap_set_bits(apmixed_regmap, AP_PLL_CON3,
+				pll_con3_boot & PLL_CON3_CPU_BITS);
+		regmap_set_bits(apmixed_regmap, AP_PLL_CON4,
+				pll_con4_boot & PLL_CON4_CPU_BITS);
+	}
+	pll_sleep_done = cpu ? 2 : level ? 1 : 0;
+}
+
+/*
+ * What is clocked going into the sleep, read just before PSCI: the PLLs'
+ * enable and power bits, the sleep-control and 26 MHz-feed words, the
+ * top-level muxes (bit 7 of each byte: mux off) and the infra gates (set:
+ * gated). Logged after the wake, next to the SPM's line.
+ */
+static const u16 pll_con0[] = { 0x200, 0x210, 0x220, 0x230, 0x240, 0x250,
+				0x260, 0x270, 0x280, 0x290, 0x2a0, 0x2b4 };
+static const u16 pll_pwr[] = { 0x20c, 0x21c, 0x22c, 0x23c, 0x24c, 0x25c,
+			       0x26c, 0x27c, 0x28c, 0x29c, 0x2b0, 0x2c4 };
+static const u16 infra_cg_sta[] = { 0x090, 0x094, 0x0ac, 0x0c8 };
+static struct {
+	u32 pll_en, pll_pwr, con3, con4, con8;
+	u32 cfg[11], cg[ARRAY_SIZE(infra_cg_sta)];
+} clk_snap;
+
+static void spm_clk_snapshot(void)
+{
+	u32 v;
+	int i;
+
+	if (!apmixed_regmap || !topck_regmap || !infracfg_regmap)
+		return;
+	clk_snap.pll_en = clk_snap.pll_pwr = 0;
+	for (i = 0; i < ARRAY_SIZE(pll_con0); i++) {
+		regmap_read(apmixed_regmap, pll_con0[i], &v);
+		clk_snap.pll_en |= (v & 1) << i;
+		regmap_read(apmixed_regmap, pll_pwr[i], &v);
+		clk_snap.pll_pwr |= (v & 1) << i;
+	}
+	regmap_read(apmixed_regmap, AP_PLL_CON3, &clk_snap.con3);
+	regmap_read(apmixed_regmap, AP_PLL_CON4, &clk_snap.con4);
+	regmap_read(apmixed_regmap, AP_PLL_CON8, &clk_snap.con8);
+	for (i = 0; i < ARRAY_SIZE(clk_snap.cfg); i++)
+		regmap_read(topck_regmap, 0x040 + 0x10 * i, &clk_snap.cfg[i]);
+	for (i = 0; i < ARRAY_SIZE(infra_cg_sta); i++)
+		regmap_read(infracfg_regmap, infra_cg_sta[i], &clk_snap.cg[i]);
+}
+
+static void spm_clk_report(void)
+{
+	char cfg[11 * 9 + 1];
+	int i, n = 0;
+
+	if (!apmixed_regmap || !topck_regmap || !infracfg_regmap)
+		return;
+	for (i = 0; i < ARRAY_SIZE(clk_snap.cfg); i++)
+		n += scnprintf(cfg + n, sizeof(cfg) - n, " %08x", clk_snap.cfg[i]);
+	/*
+	 * PLL bits: 0 armpll_ll, 1 armpll_l, 2 main, 3 univ, 4 mfg, 5 msdc,
+	 * 6 tvd, 7 mm, 8 mpll, 9 cci, 10 apll1, 11 apll2. cfg: CLK_CFG_0-10.
+	 */
+	pr_info("mt6771-spm: clocks at suspend: pll en 0x%03x pwr 0x%03x, con3 0x%x con4 0x%x con8 0x%x, cfg%s, infra cg 0x%08x 0x%08x 0x%08x 0x%08x\n",
+		clk_snap.pll_en, clk_snap.pll_pwr, clk_snap.con3, clk_snap.con4,
+		clk_snap.con8, cfg, clk_snap.cg[0], clk_snap.cg[1],
+		clk_snap.cg[2], clk_snap.cg[3]);
+}
+
+/* The vendor's order: enable off, isolate, power off */
+static void spm_pll_off(unsigned int con0, unsigned int pwr)
+{
+	regmap_clear_bits(apmixed_regmap, con0, BIT(0));
+	regmap_set_bits(apmixed_regmap, pwr, BIT(1));
+	regmap_clear_bits(apmixed_regmap, pwr, BIT(0));
+}
+
+/* Off, unless the clock framework counts a user for it */
+static bool spm_pll_off_unused(const char *name, unsigned int con0, unsigned int pwr)
+{
+	struct clk *clk = __clk_lookup(name);
+
+	if (clk && __clk_get_enable_count(clk))
+		return false;
+	spm_pll_off(con0, pwr);
+	return true;
+}
+
+/*
+ * Infra clock gates in MediaTek's SODI and deep idle conditions
+ * (mtk_idle_mt6771.c) that LK leaves running: with clk_ignore_unused
+ * (docs/build-and-flash.md) nothing gates them, and each one blocks both
+ * idle states. Each one running with no user is switched on and off once
+ * through the clock framework, which leaves its gate closed (and, as
+ * disabling unused clocks would, parents nothing else uses); a driver that
+ * wants it later enables it as usual. The APDMA and display-PWM clocks of
+ * the same masks are left out: they have users.
+ */
+static const char *const spm_infra_unused[] = {
+	"infra_icusb", "infra_i2c0", "infra_i2c1", "infra_i2c2", "infra_pwm_hclk",
+	"infra_pwm1", "infra_pwm2", "infra_pwm3", "infra_pwm4", "infra_pwm",
+	"infra_uart1", "infra_uart2", "infra_uart3", "infra_spi0", "infra_cpum",
+	"infra_irtx", "infra_spi1", "infra_i2c4",
+};
+
+static void spm_infra_gate_unused(struct device *dev)
+{
+	char names[160] = "";
+	int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(spm_infra_unused); i++) {
+		struct clk *clk = __clk_lookup(spm_infra_unused[i]);
+
+		if (!clk || __clk_get_enable_count(clk) || !__clk_is_enabled(clk) ||
+		    clk_prepare_enable(clk))
+			continue;
+		clk_disable_unprepare(clk);
+		n += scnprintf(names + n, sizeof(names) - n, " %s",
+			       spm_infra_unused[i] + strlen("infra_"));
+	}
+	dev_info(dev, "unused infra clocks gated:%s\n", n ? names : " none");
+}
+
+static void spm_clk_init(struct device *dev)
+{
+	bool aplls = false;
+	u32 v;
+
+	apmixed_regmap = syscon_regmap_lookup_by_compatible("mediatek,mt6771-apmixedsys");
+	topck_regmap = syscon_regmap_lookup_by_compatible("mediatek,mt6771-topckgen");
+	infracfg_regmap = syscon_regmap_lookup_by_compatible("mediatek,mt6771-infracfg");
+	if (IS_ERR(apmixed_regmap) || IS_ERR(topck_regmap) || IS_ERR(infracfg_regmap)) {
+		dev_warn(dev, "no clock syscons: PLL sleep control and the clock report are off\n");
+		apmixed_regmap = topck_regmap = infracfg_regmap = NULL;
+		return;
+	}
+	regmap_read(apmixed_regmap, AP_PLL_CON3, &pll_con3_boot);
+	regmap_read(apmixed_regmap, AP_PLL_CON4, &pll_con4_boot);
+	spm_pll_sleep_apply(false);
+	if (tvdpll_off)
+		spm_pll_off(TVDPLL_CON0, TVDPLL_PWR_CON0);
+	if (apll_off)
+		aplls = spm_pll_off_unused("apll1", APLL1_CON0, APLL1_PWR_CON0) &
+			spm_pll_off_unused("apll2", APLL2_CON0, APLL2_PWR_CON0);
+	regmap_read(apmixed_regmap, AP_PLL_CON3, &v);
+	dev_info(dev, "AP_PLL_CON3 0x%x (boot 0x%x), CON4 boot 0x%x, pll_sleep %u, TVDPLL %s, APLLs %s\n",
+		 v, pll_con3_boot, pll_con4_boot, pll_sleep,
+		 tvdpll_off ? "off" : "left", aplls ? "off" : "left");
+	if (infra_gate_unused)
+		spm_infra_gate_unused(dev);
+}
+
+/*
+ * MT6358 rails in low power while the SoC sleeps (vendor pmic_initial_setting.c
+ * PMIC_LP_INIT_SETTING(), run at every 4.14 boot; values as 4.14 reads them).
+ * *_OP_EN: which controls a rail follows (bit 0 software, 1 SRCLKEN0, 2
+ * SRCLKEN1, 3 SRCLKEN2); *_OP_CFG: low power rather than off when a hardware
+ * control drops. SRCLKEN0 is the SPM's suspend, SRCLKEN2 its deep idle, both
+ * driven by the SPM firmware, so this is done only with it (deep=1). VS2,
+ * VDRAM1, VSRAM_OTHERS, VXO22, VA12, VAUX18, VAUD28, VDRAM2 and VUSB go to low
+ * power, VBIF28 off; the modem's RF rails (VFE28, VRF18, VRF12) follow its
+ * SRCLKEN1. 6.12 leaves them at reset: software only, full power asleep.
+ */
+static const struct {
+	u16 reg, val;
+} mt6358_lp[] = {
+	{ 0x1610, 0x000b }, { 0x1616, 0x010a },	/* BUCK_VDRAM1_OP_EN, _OP_CFG */
+	{ 0x1710, 0x000b }, { 0x1716, 0x010a },	/* BUCK_VS2 */
+	{ 0x1a8a, 0x000b }, { 0x1a90, 0x000a },	/* LDO_VXO22 */
+	{ 0x1a9e, 0x000b }, { 0x1aa4, 0x000a },	/* LDO_VA12 */
+	{ 0x1ab2, 0x000b }, { 0x1ab8, 0x000a },	/* LDO_VAUX18 */
+	{ 0x1ac6, 0x0003 }, { 0x1acc, 0x0002 },	/* LDO_VAUD28 */
+	{ 0x1b0a, 0x000b }, { 0x1b10, 0x000a },	/* LDO_VDRAM2 */
+	{ 0x1b32, 0x000b }, { 0x1b38, 0x000a },	/* LDO_VUSB */
+	{ 0x1bae, 0x000b }, { 0x1bb4, 0x000a },	/* LDO_VSRAM_OTHERS */
+	{ 0x1da0, 0x000b },			/* LDO_VBIF28_OP_EN (off asleep) */
+	{ 0x1c0a, 0x0005 },			/* LDO_VFE28_OP_EN */
+	{ 0x1c1e, 0x0005 },			/* LDO_VRF18_OP_EN */
+	{ 0x1c32, 0x0005 },			/* LDO_VRF12_OP_EN */
+};
+
+/* the PMIC's regmap (the wrapper's), or an error pointer */
+static struct regmap *mt6771_spm_pmic(struct device *dev)
+{
+	struct device_node *np = of_parse_phandle(dev->of_node, "mediatek,pwrap", 0);
+	struct platform_device *pwrap = np ? of_find_device_by_node(np) : NULL;
+	struct regmap *map;
+
+	of_node_put(np);
+	if (!pwrap)
+		return ERR_PTR(-ENODEV);
+	map = dev_get_regmap(&pwrap->dev, NULL);
+	put_device(&pwrap->dev);
+	return map ?: ERR_PTR(-EPROBE_DEFER);
+}
+
+/*
+ * Breadcrumbs that outlive a reset: how far the last suspend got, in the
+ * MT6358 RTC's RTC_SPAR0 bits 8-15 (reserved in the vendor's layout; the RTC
+ * keeps them across a reset, measured; neither DRAM, so pstore, nor the
+ * PMIC's other registers do). Low nibble the step, high nibble the suspends
+ * completed (mod 16); logged and cleared at probe. Written through the
+ * wrapper's regmap where sleeping is allowed (it takes a mutex and sleeps in
+ * its polls): the PM notifier and the SPM's own late (suspend_noirq) and early
+ * (resume_noirq) callbacks. Inside suspend_enter, with one CPU left and its
+ * interrupts off, nobody else can be using the wrapper: there the crumbs go
+ * straight through its WACS2 channel (as pwrap_read16/write16, mt8183 layout).
+ */
+#define MT6358_RTC_BBPU		0x588
+#define RTC_BBPU_CBUSY		BIT(6)
+#define MT6358_RTC_SPAR0	0x5b8
+#define MT6358_RTC_WRTGR	0x5c2
+#define MT6358_BUCK_VS1_OP_EN		0x1690
+#define MT6358_BUCK_VS1_OP_EN_CLR	0x1694
+#define VS1_HW0_OP_EN		BIT(1)	/* follows SRCLKEN0 */
+#define CRUMB_MASK		GENMASK(15, 8)
+#define PWRAP_WACS2_CMD		0xc20
+#define PWRAP_WACS2_RDATA	0xc24
+#define PWRAP_WACS2_VLDCLR	0xc28
+#define  WACS_FSM(x)		(((x) >> 16) & 7)
+#define  WACS_FSM_IDLE		0
+#define  WACS_FSM_WFVLDCLR	6
+#define  WACS_SYNC_IDLE		BIT(20)
+
+enum {
+	CRUMB_PREPARE = 1,	/* devices about to suspend */
+	CRUMB_SLEEP,		/* devices suspended: into the SPM's sleep */
+	CRUMB_WOKE,		/* back from the SPM's sleep, devices to resume */
+	CRUMB_RESUMED,		/* devices resumed */
+	CRUMB_ENTER,		/* CPUs off, in suspend_enter */
+	CRUMB_SSPM_DOWN,	/* SSPM told, into ATF and the SPM's sleep */
+	CRUMB_BACK,		/* back from ATF: the SPM woke us */
+	CRUMB_SSPM_UP,		/* SSPM told of the resume */
+	CRUMB_ATF_ARGS,		/* wake mask and PCM WDT set in ATF */
+	CRUMB_SSPM_ASK,		/* MCDI paused, asking the SSPM to suspend */
+	CRUMB_SSPM_NOANS,	/* the SSPM did not answer: suspend aborted */
+	CRUMB_SSPM_RUNG,	/* the command written, its mailbox about to be rung */
+	/* marks only (spm_mark): the RTC can't take these */
+	MARK_PSCI,		/* 13: the suspend set in ATF, into PSCI */
+	MARK_HELD,		/* 14: back, our SPM requests set again */
+	MARK_WDT_OFF,		/* 15: MCDI running again, the SPM's watchdog off */
+};
+
+static const char *const crumb_names[] = {
+	"none", "devices suspending", "devices suspended, CPUs going off",
+	"devices resuming", "resumed", "in suspend_enter",
+	"SSPM suspended: in the SPM's sleep or its wake",
+	"back from the SPM's wake", "SSPM resumed",
+	"ATF args set, pausing MCDI", "MCDI paused, SSPM asked to suspend",
+	"SSPM did not answer: suspend aborted",
+	"SSPM command written, ringing its mailbox",
+};
+
+static struct regmap *crumb_map;
+static unsigned int crumb_count;
+
+/*
+ * The same steps where a watchdog reset keeps them: TOPRGU's NONRST_REG, a
+ * plain register write, so it works at every step, also while the SSPM has
+ * the RTC's clocks gated. The resets in the SPM's sleep are its watchdog
+ * (30 s, set by the SPM firmware itself at each wake for the CPU to come
+ * back and switch it off); the preloader prints "[RGU] NONRST_REG:" before
+ * it overwrites it, and LK saves that log to expdb. 0x5c in the top byte,
+ * then the suspends completed, then the step.
+ */
+static void __iomem *rgu_base;
+#define RGU_NONRST_REG		0x20
+
+static void spm_mark(unsigned int step)
+{
+	if (rgu_base)
+		writel(0x5c000000 | (crumb_count & 0xffff) << 8 | step,
+		       rgu_base + RGU_NONRST_REG);
+}
+
+static void spm_crumb(unsigned int step)
+{
+	u32 v;
+
+	spm_mark(step);
+	if (!crumb_map)
+		return;
+	regmap_update_bits(crumb_map, MT6358_RTC_SPAR0, CRUMB_MASK,
+			   (crumb_count & 0xf) << 12 | step << 8);
+	regmap_write(crumb_map, MT6358_RTC_WRTGR, 1);
+	regmap_read_poll_timeout(crumb_map, MT6358_RTC_BBPU, v,
+				 !(v & RTC_BBPU_CBUSY), 10, 10000);
+}
+
+static void __iomem *pwrap_base;
+
+/*
+ * One WACS2 transfer, interrupts off; a read's RDATA word's low 16 bits.
+ * Only a read stops in WFVLDCLR: a write goes back to idle, and the next
+ * transfer's idle poll waits for it (pwrap_write16). Waiting for WFVLDCLR
+ * after a write timed out every time (kernel #120: "crumbs lost 0x17e0" on
+ * every suspend) and skipped the RTC_WRTGR that commits the breadcrumb.
+ */
+static u32 wacs2_last;	/* the RDATA word a timed-out transfer saw last */
+
+/* -EBUSY: the wrapper never went idle; -ETIMEDOUT: a read's data never came */
+static int wacs2(u32 cmd, u32 *rdata)
+{
+	u32 v;
+
+	if (readl_poll_timeout_atomic(pwrap_base + PWRAP_WACS2_RDATA, v,
+				      WACS_FSM(v) == WACS_FSM_IDLE && (v & WACS_SYNC_IDLE),
+				      1, 10000)) {
+		wacs2_last = v;
+		return -EBUSY;
+	}
+	writel(cmd, pwrap_base + PWRAP_WACS2_CMD);
+	if (!rdata)
+		return 0;
+	if (readl_poll_timeout_atomic(pwrap_base + PWRAP_WACS2_RDATA, v,
+				      WACS_FSM(v) == WACS_FSM_WFVLDCLR, 1, 10000)) {
+		wacs2_last = v;
+		return -ETIMEDOUT;
+	}
+	*rdata = v & 0xffff;
+	writel(1, pwrap_base + PWRAP_WACS2_VLDCLR);
+	return 0;
+}
+
+/*
+ * The steps whose breadcrumb didn't reach the RTC this suspend (a WACS2
+ * transfer timed out, or the RTC stayed busy): a reset then shows an
+ * earlier step than the one it died in. Reported after the resume.
+ */
+static u32 crumb_failed;
+
+/*
+ * Why each atomic step failed, for the line after the resume: on #121 the
+ * steps from ringing the SSPM until it is told of the resume (12, 6, 7)
+ * never reached the RTC while 5, 9, 10 and 8 did: the SSPM gates the RTC's
+ * clocks from SUSPEND to RESUME. Step 12 is now written before the
+ * doorbell; 6 and 7 still can't land. Per step: where it
+ * stopped, the WACS2 RDATA word (or RTC_BBPU) then, and the RTC_BBPU polls
+ * (a good step's count is the commit's margin).
+ */
+enum {
+	CRUMB_OK, CRUMB_RD_BUSY, CRUMB_RD_NODATA, CRUMB_WR_BUSY, CRUMB_TRIG_BUSY,
+	CRUMB_POLL_BUSY, CRUMB_POLL_NODATA, CRUMB_RTC_BUSY,
+};
+static const char *const crumb_why_names[] = {
+	"ok", "SPAR0 read: wrapper busy", "SPAR0 read: no data",
+	"SPAR0 write: wrapper busy", "WRTGR write: wrapper busy",
+	"BBPU read: wrapper busy", "BBPU read: no data", "RTC busy",
+};
+static u8 crumb_why[16];
+static u32 crumb_rdata[16];
+static u16 crumb_polls[16];
+static u16 crumb_done;		/* the atomic steps tried this suspend */
+
+static void spm_crumb_atomic(unsigned int step)
+{
+	u32 v;
+	int i = 0, ret, why;
+
+	spm_mark(step);
+	/*
+	 * From the SSPM's SUSPEND to its RESUME the RTC can't commit (its
+	 * clocks are gated): steps 6 and 7 never landed and each cost the
+	 * 10000 polls, awake, with the SPM's watchdog running after a wake.
+	 */
+	if (step == CRUMB_SSPM_DOWN || step == CRUMB_BACK)
+		return;
+	if (!crumb_map || !pwrap_base)
+		return;
+	crumb_done |= BIT(step);
+	ret = wacs2((MT6358_RTC_SPAR0 >> 1) << 16, &v);
+	if (ret) {
+		why = ret == -EBUSY ? CRUMB_RD_BUSY : CRUMB_RD_NODATA;
+		goto fail;
+	}
+	v = (v & ~CRUMB_MASK) | (crumb_count & 0xf) << 12 | step << 8;
+	why = CRUMB_WR_BUSY;
+	if (wacs2(BIT(31) | (MT6358_RTC_SPAR0 >> 1) << 16 | v, NULL))
+		goto fail;
+	why = CRUMB_TRIG_BUSY;
+	if (wacs2(BIT(31) | (MT6358_RTC_WRTGR >> 1) << 16 | 1, NULL))
+		goto fail;
+	for (i = 0; i < 10000; i++) {
+		ret = wacs2((MT6358_RTC_BBPU >> 1) << 16, &v);
+		if (ret) {
+			why = ret == -EBUSY ? CRUMB_POLL_BUSY : CRUMB_POLL_NODATA;
+			goto fail;
+		}
+		if (!(v & RTC_BBPU_CBUSY)) {
+			crumb_why[step] = CRUMB_OK;
+			crumb_polls[step] = i;
+			return;
+		}
+		udelay(1);
+	}
+	why = CRUMB_RTC_BUSY;
+	wacs2_last = v;
+fail:
+	crumb_failed |= BIT(step);
+	crumb_why[step] = why;
+	crumb_rdata[step] = wacs2_last;
+	crumb_polls[step] = i;
+}
+
+/* one line: each atomic step in the order tried, ok/polls or why it failed */
+static void spm_crumb_report(void)
+{
+	static const u8 order[] = { 5, 9, 10, 12, 11, 6, 7, 8 };
+	char buf[400];
+	int i, k = 0;
+
+	if (!crumb_failed)
+		return;
+	for (i = 0; i < ARRAY_SIZE(order); i++) {
+		unsigned int s = order[i];
+
+		if (!(crumb_done & BIT(s)))
+			continue;
+		if (crumb_why[s] == CRUMB_OK)
+			k += scnprintf(buf + k, sizeof(buf) - k, "%s%u ok/%u",
+				       k ? ", " : "", s, crumb_polls[s]);
+		else
+			k += scnprintf(buf + k, sizeof(buf) - k, "%s%u %s/%u (0x%x)",
+				       k ? ", " : "", s, crumb_why_names[crumb_why[s]],
+				       crumb_polls[s], crumb_rdata[s]);
+	}
+	pr_info("mt6771-spm: crumbs: %s\n", buf);
+}
+
+/* the breadcrumb step the RTC holds now, or -1 when it can't be read */
+static int spm_crumb_readback(void)
+{
+	u32 v;
+
+	if (!pwrap_base || wacs2((MT6358_RTC_SPAR0 >> 1) << 16, &v))
+		return -1;
+	return v >> 8 & 0xf;
+}
+
+/*
+ * Undo the SSPM's VS1 low power for this sleep (vs1_sleep_lp): one write to
+ * the CLR register, straight through WACS2 like the atomic breadcrumbs, then
+ * a read back. Returns 0, or what the read back saw (-1 if it failed).
+ */
+static int spm_vs1_full_power(void)
+{
+	u32 v;
+
+	if (!pwrap_base)
+		return -1;
+	if (wacs2(BIT(31) | (MT6358_BUCK_VS1_OP_EN_CLR >> 1) << 16 | VS1_HW0_OP_EN, NULL) ||
+	    wacs2((MT6358_BUCK_VS1_OP_EN >> 1) << 16, &v))
+		return -1;
+	return v & VS1_HW0_OP_EN ? v : 0;
+}
+
+static int spm_crumb_notify(struct notifier_block *nb, unsigned long ev,
+			    void *unused)
+{
+	if (ev == PM_SUSPEND_PREPARE)
+		spm_crumb(CRUMB_PREPARE);
+	else if (ev == PM_POST_SUSPEND) {
+		crumb_count++;
+		spm_crumb(CRUMB_RESUMED);
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block spm_crumb_nb = {
+	.notifier_call = spm_crumb_notify,
+};
+
+/*
+ * Why the last boot ended, from the two blocks that keep it: the MT6358's
+ * power-on and power-off status (PONSTS 0x00c, POFFSTS 0x00e; vendor
+ * upmu_hw.h) and the SoC watchdog's NONRST registers, which a watchdog or
+ * software reset keeps and a power loss clears. In NONRST2 the boot
+ * stages: bits 31:29 now, 28:26 at the last reset (1 preloader, 2 LK,
+ * 3 kernel; mtk_wdt.h). The resets on the way into deep sleep showed
+ * NONRST2 0x40002000, no last stage, as after a power loss, against
+ * 0x48002000 after a reboot: POFFSTS should say which loss.
+ */
+#define MT6358_PONSTS		0x00c
+#define MT6358_POFFSTS		0x00e
+#define MT6358_TOP_RST_MISC	0x14c
+#define  WDTRSTB_EN		BIT(0)	/* the SoC watchdog's reset pin resets the PMIC */
+#define  WDTRSTB_STATUS		BIT(2)	/* ... and it has, since the latch was cleared */
+#define  WDTRSTB_STATUS_CLR	BIT(3)
+#define  WDTRSTB_DEB		BIT(5)	/* that input deglitched (the preloader sets it) */
+#define MT6358_TOP_RST_STATUS	0x152
+
+static void spm_bits(char *buf, size_t len, u32 v, const char *const *names, int n)
+{
+	int i, k = 0;
+
+	buf[0] = 0;
+	for (i = 0; i < n; i++)
+		if (v & BIT(i))
+			k += scnprintf(buf + k, len - k, "%s%s", k ? " " : "", names[i]);
+}
+
+static void spm_reset_report(struct device *dev, struct regmap *pmic)
+{
+	static const char *const pon[] = { "pwrkey", "rtc-alarm", "charger", "spar", "reboot" };
+	static const char *const poff[] = { "uvlo", "pgfail", "psoc", "thermal", "wdt-reset",
+					    "cold-reset", "pwrkey-long", "normal-off", "bwdt", "ddlo" };
+	char ponb[64], poffb[96];
+	struct device_node *np;
+	void __iomem *wdt;
+	u32 on = 0, off = 0, rst = 0, sta = 0, nr1 = 0, nr2 = 0, misc;
+
+	regmap_read(pmic, MT6358_PONSTS, &on);
+	regmap_read(pmic, MT6358_POFFSTS, &off);
+	regmap_read(pmic, MT6358_TOP_RST_STATUS, &rst);
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6771-wdt");
+	wdt = of_iomap(np, 0);
+	of_node_put(np);
+	if (wdt) {
+		sta = readl(wdt + 0x0c);	/* WDT_STA */
+		nr1 = readl(wdt + 0x20);	/* NONRST_REG */
+		nr2 = readl(wdt + 0x24);	/* NONRST_REG2 */
+		iounmap(wdt);
+	}
+	spm_bits(ponb, sizeof(ponb), on, pon, ARRAY_SIZE(pon));
+	spm_bits(poffb, sizeof(poffb), off, poff, ARRAY_SIZE(poff));
+	dev_info(dev, "last boot ended: PMIC power-on 0x%x (%s), power-off 0x%x (%s), top rst 0x%x; WDT sta 0x%x, nonrst 0x%x/0x%x (stage %u, last stage %u)\n",
+		 on, ponb, off, poffb, rst, sta, nr1, nr2, nr2 >> 29 & 7, nr2 >> 26 & 7);
+	/*
+	 * The watchdog reset pin's side of it. The latch is cleared here, so
+	 * a set bit at the next boot means the PMIC saw the pin low after
+	 * this point (the preloader doesn't clear it). The deglitch should
+	 * read on: the preloader sets it, and the stock mtk-pmic-keys cleared
+	 * it (wrong bit layout for the MT6358; 0x1005 on 6.12 where 4.14
+	 * reads 0x0221), so every 6.12 boot up to #124 ran with it off.
+	 */
+	if (!regmap_read(pmic, MT6358_TOP_RST_MISC, &misc)) {
+		dev_info(dev, "last boot's PMIC reset pin: TOP_RST_MISC 0x%x (WDTRSTB %s, deglitch %s, %s)\n",
+			 misc, misc & WDTRSTB_EN ? "on" : "off",
+			 misc & WDTRSTB_DEB ? "on" : "OFF",
+			 misc & WDTRSTB_STATUS ? "seen low" : "not seen");
+		regmap_set_bits(pmic, MT6358_TOP_RST_MISC, WDTRSTB_STATUS_CLR);
+		regmap_clear_bits(pmic, MT6358_TOP_RST_MISC, WDTRSTB_STATUS_CLR);
+	}
+}
+
+/*
+ * What the preloader saw of the last boot's end. It reads the PMIC's
+ * power-off cause and status (pmic_check_rst: POFFSTS, the power-good and
+ * over-current shutdown status, the thermal status) and the watchdog's,
+ * logs them, and clears them: by the time the kernel runs POFFSTS reads 0.
+ * Its log of this boot is still in the buffer LK hands on: /chosen
+ * "log_store" gives an SRAM header that points to the DRAM buffer and the
+ * preloader's part of it (MediaTek's drivers/misc/mediatek/log_store). The
+ * lines that say why the phone restarted go to the kernel log, where
+ * titan-sleeplog keeps them.
+ */
+#define LOG_SRAM_SIG	0xabcd1234
+#define LOG_CUR_SIG	0xcdab3412
+#define LOG_BUF_MAX	SZ_1M
+#define LOG_LINES_MAX	40
+
+struct log_sram_header {
+	u32 sig, reboot_count, save_to_emmc;
+	/* the DRAM buffer */
+	u32 dram_sig, flag, buf_addr, buf_size, buf_offsize, buf_point;
+	u32 klog_addr, klog_size, atf_log_addr, atf_log_len;
+	/* this boot's log in it: the preloader's part, then LK's */
+	u32 cur_sig, cur_size, off_pl, sz_pl, pl_flag, off_lk, sz_lk, lk_flag;
+};
+
+static const char *const preloader_keys[] = {
+	"[PMIC]TOP_RST_STATUS", "[PMIC]PONSTS", "[PMIC]POFFSTS", "[PMIC]PGSTATUS",
+	"[PMIC]PSOCSTATUS", "[PMIC]BUCK_OC_SDN", "[PMIC]THERMALSTATUS",
+	"[PMIC]STRUP_CON4", "[PMIC]TOP_RST_MISC", "[pmic_check_rst]",
+	"[PMIC]just_rst", "[RGU] rst from", "[RGU] STA", "[RGU] NONRST_REG",
+	"[RGU] g_rgu_status", "[RGU] bypass pwrkey", "WDT normal boot",
+	"WDT reboot bypass", "Long Pressed Reboot", "detect abnormal boot",
+};
+
+static void spm_preloader_report(struct device *dev)
+{
+	struct device_node *chosen = of_find_node_by_path("/chosen");
+	const __be32 *prop;
+	struct log_sram_header h;
+	void __iomem *sram;
+	const char *log, *p, *end;
+	u32 addr;
+	int len, lines = 0;
+
+	prop = of_get_property(chosen, "log_store", &len);
+	of_node_put(chosen);
+	if (!prop || len < 8) {
+		dev_info(dev, "last boot's preloader log: no log_store from LK\n");
+		return;
+	}
+	/* LK writes the two words as it holds them, little-endian */
+	addr = le32_to_cpup((const __le32 *)prop);
+	if (addr & 3 || !addr)
+		addr = be32_to_cpup(prop);
+	sram = ioremap(addr, sizeof(h));
+	if (!sram)
+		return;
+	memcpy_fromio(&h, sram, sizeof(h));
+	iounmap(sram);
+	if (h.sig != LOG_SRAM_SIG || h.cur_sig != LOG_CUR_SIG || !h.buf_addr ||
+	    !h.sz_pl || h.off_pl > LOG_BUF_MAX || h.sz_pl > LOG_BUF_MAX) {
+		dev_info(dev, "last boot's preloader log: bad header at 0x%x (sig 0x%x/0x%x, buffer 0x%x+0x%x, preloader 0x%x+0x%x)\n",
+			 addr, h.sig, h.cur_sig, h.buf_addr, h.buf_size, h.off_pl, h.sz_pl);
+		return;
+	}
+	log = memremap(h.buf_addr + h.off_pl, h.sz_pl, MEMREMAP_WB);
+	if (!log) {
+		dev_info(dev, "last boot's preloader log: can't map 0x%x+0x%x\n",
+			 h.buf_addr + h.off_pl, h.sz_pl);
+		return;
+	}
+	for (p = log, end = log + h.sz_pl; p < end && lines < LOG_LINES_MAX; ) {
+		const char *nl = memchr(p, '\n', end - p) ?: end;
+		int i;
+
+		for (i = 0; i < ARRAY_SIZE(preloader_keys); i++) {
+			const char *k = strnstr(p, preloader_keys[i], nl - p);
+			char line[100], *c;
+			int n;
+
+			if (!k)
+				continue;
+			n = min_t(int, nl - k, sizeof(line) - 1);
+			memcpy(line, k, n);
+			line[n] = 0;
+			for (c = line; *c; c++)
+				if (*c < ' ' || *c > '~')
+					*c = ' ';
+			dev_info(dev, "last boot's end, preloader: %s\n", line);
+			lines++;
+			break;
+		}
+		p = nl + 1;
+	}
+	if (!lines)
+		dev_info(dev, "last boot's preloader log: 0x%x bytes at 0x%x, no reset lines\n",
+			 h.sz_pl, h.buf_addr + h.off_pl);
+	memunmap((void *)log);
+}
+
+/* the last boot's breadcrumb, then a clean slate */
+static void spm_crumb_init(struct device *dev, struct regmap *pmic)
+{
+	struct device_node *np;
+	u32 v, step;
+
+	if (regmap_read(pmic, MT6358_RTC_SPAR0, &v))
+		return;
+	step = v >> 8 & 0xf;
+	dev_info(dev, "last boot's suspend breadcrumb: step %u (%s), %u completed (mod 16)\n",
+		 step, step < ARRAY_SIZE(crumb_names) ? crumb_names[step] : "?",
+		 v >> 12 & 0xf);
+	spm_reset_report(dev, pmic);
+	spm_preloader_report(dev);
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6771-pwrap");
+	pwrap_base = of_iomap(np, 0);
+	of_node_put(np);
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6771-wdt");
+	rgu_base = of_iomap(np, 0);
+	of_node_put(np);
+	crumb_map = pmic;
+	spm_crumb(0);
+	register_pm_notifier(&spm_crumb_nb);
+}
+
+/* after the SPM firmware runs: the rails follow its SRCLKEN at once */
+static int mt6771_spm_pmic_lp(struct regmap *map)
+{
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(mt6358_lp); i++) {
+		ret = regmap_write(map, mt6358_lp[i].reg, mt6358_lp[i].val);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static struct regmap *spm_regmap;
+static void __iomem *sspm_slots, *sspm_ctrl;
+
+static unsigned long spm_sip(unsigned long id, unsigned long a1,
+			     unsigned long a2, unsigned long a3)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(id, a1, a2, a3, 0, 0, 0, 0, &res);
+	return res.a0;
+}
+
+#define SPM_HELD_REQ		(SPM_APSRC_REQ | SPM_F26M_REQ | SPM_DDREN_REQ)
+
+/* sspm_ipi_send_sync() in polling mode, as spm_to_sspm_command() */
+/* a command timed out: its answer may still come, and must not block the next */
+static bool sspm_late;
+
+static int sspm_spm_command_opt(u32 cmd, u32 opt);
+
+static int sspm_spm_command(u32 cmd)
+{
+	return sspm_spm_command_opt(cmd, 0);
+}
+
+static int sspm_spm_command_opt(u32 cmd, u32 opt)
+{
+	u32 val;
+	int i, ret;
+
+	if (readl(sspm_ctrl + SSPM_MBOX_OUT_IRQ) & SSPM_SPM_IRQ) {
+		if (!sspm_late)
+			return -EBUSY;
+		/* the late answer to the command that timed out: clear it */
+		writel(SSPM_SPM_IRQ, sspm_ctrl + SSPM_MBOX_OUT_IRQ);
+		pr_info("mt6771-spm: SSPM answered a timed-out command late\n");
+	}
+	sspm_late = false;
+	writel(cmd, sspm_slots + 4 * SSPM_SPM_SLOT);
+	for (i = 1; i < SSPM_SPM_LEN; i++)
+		writel(0, sspm_slots + 4 * (SSPM_SPM_SLOT + i));
+	writel(opt, sspm_slots + 4 * SSPM_SPM_OPT_SLOT);
+	/*
+	 * Before the doorbell: SUSPEND gates the RTC's clocks until RESUME
+	 * (docs/sspm-firmware.md), so a breadcrumb after it never commits and
+	 * leaves the RTC with a write pending through the sleep.
+	 */
+	if (cmd == SSPM_SPM_SUSPEND)
+		spm_crumb_atomic(CRUMB_SSPM_RUNG);
+	writel(SSPM_SPM_IRQ, sspm_ctrl + SSPM_MBOX_IN_IRQ);
+
+	ret = readl_poll_timeout_atomic(sspm_ctrl + SSPM_MBOX_OUT_IRQ, val,
+					val & SSPM_SPM_IRQ, 1, 500000);
+	if (ret) {
+		sspm_late = true;
+		pr_warn("mt6771-spm: SSPM command %u: no answer\n", cmd);
+		return ret;
+	}
+	writel(SSPM_SPM_IRQ, sspm_ctrl + SSPM_MBOX_OUT_IRQ);
+	ret = readl(sspm_slots + 4 * SSPM_SPM_SLOT);
+	if (ret < 0)
+		pr_warn("mt6771-spm: SSPM command %u: %d\n", cmd, ret);
+	return ret;
+}
+
+/*
+ * Power domains that must be off for the SPM's suspend, as MediaTek's
+ * kernel checks them (subsys_if_on(), clk-mt6771-pg.c: DIS, MFG, ISP,
+ * MFG_CORE0/1, VEN, MFG_2D, MFG_ASYNC, CAM, VPU_TOP/CORE0/CORE1, VDE; MD1,
+ * CONN and AUDIO only warn there). Suspending with the display path on
+ * left the screen tinted until a later reboot (measured).
+ */
+static const struct {
+	u8 bit;
+	const char *name;
+} spm_busy_domains[] = {
+	{ 3, "DIS" }, { 4, "MFG" }, { 5, "ISP" }, { 7, "MFG_CORE0" },
+	{ 20, "MFG_CORE1" }, { 21, "VEN" }, { 22, "MFG_2D" },
+	{ 23, "MFG_ASYNC" }, { 25, "CAM" }, { 26, "VPU_TOP" },
+	{ 27, "VPU_CORE0" }, { 28, "VPU_CORE1" }, { 31, "VDE" },
+};
+
+static int mt6771_spm_domains_off(void)
+{
+	u32 sta, sta2;
+	int i, busy = 0;
+
+	regmap_read(spm_regmap, PWR_STATUS, &sta);
+	regmap_read(spm_regmap, PWR_STATUS_2ND, &sta2);
+	sta &= sta2;
+	for (i = 0; i < ARRAY_SIZE(spm_busy_domains); i++) {
+		if (!(sta & BIT(spm_busy_domains[i].bit)))
+			continue;
+		pr_warn("mt6771-spm: cannot sleep: %s is on\n",
+			spm_busy_domains[i].name);
+		busy++;
+	}
+	return busy ? -EBUSY : 0;
+}
+
+static int mt6771_spm_hold(struct regmap *regmap)
+{
+	return regmap_set_bits(regmap, SPM_SRC_REQ, SPM_HELD_REQ);
+}
+
+/* ---- deep idle ---- */
+
+static int so_enter(void);	/* SODI and SODI3 (below) */
+static bool so_any(void);
+
+static bool dpidle;
+static int dpidle_set(const char *val, const struct kernel_param *kp);
+static const struct kernel_param_ops dpidle_ops = {
+	.set = dpidle_set,
+	.get = param_get_bool,
+};
+module_param_cb(dpidle, &dpidle_ops, &dpidle, 0644);
+MODULE_PARM_DESC(dpidle, "Enter the SPM's deep idle from cpuidle (CPU 0 alone online); set up at the first 1");
+
+static uint dpidle_min_us = 2000;	/* the vendor's min-residency */
+module_param(dpidle_min_us, uint, 0644);
+MODULE_PARM_DESC(dpidle_min_us, "Deep idle only when the next timer is this far");
+
+static uint dpidle_wake_mask;
+module_param(dpidle_wake_mask, uint, 0644);
+MODULE_PARM_DESC(dpidle_wake_mask, "Deep idle wake sources (R12 bits) set at probe, 0 for the suspend set plus the AFE");
+
+static bool sleep_dpidle;
+module_param(sleep_dpidle, bool, 0644);
+MODULE_PARM_DESC(sleep_dpidle, "System suspend through the deep idle scenario (26 MHz on: FM radio through the AFE keeps playing)");
+
+#define R12_AFE_IRQ_MCU		BIT(20)
+
+/*
+ * The vendor's deep idle conditions (mtk_idle_mt6771.c): power domains
+ * (PWR_STATUS, mask 0xbef000b8: display, GPU, ISP, encoder, decoder,
+ * camera, VPU) and infra clock gates (on when the status bit is clear),
+ * three groups at INFRA_SW_CG_0/1/2_STA = 0x94, 0x90, 0xac.
+ */
+#define DPIDLE_PWR_MASK		0xbef000b8
+static const struct { u16 sta; u32 mask; } dpidle_cg[] = {
+	{ 0x094, 0x00040802 }, { 0x090, 0x03afb900 }, { 0x0ac, 0x000000c5 },
+};
+
+/* aud_intbus_sel (CLK_CFG_5 bits 9:8, set/clr 0x94/0x98, update bit 21) */
+#define CLK_CFG_5		0x090
+#define CLK_CFG_5_CLR		0x098
+#define CLK_CFG_5_SET		0x094
+#define CLK_CFG_UPDATE		0x004
+#define AUD_INTBUS_SHIFT	8
+#define AUD_INTBUS_GATE		BIT(15)
+#define AUD_INTBUS_UPD		BIT(21)
+
+enum { DP_OK, DP_OFF, DP_CPUS, DP_SHORT, DP_PWR, DP_CG, DP_SECURE_CG, DP_SSPM, DP_NR };
+static const char *const dp_why[] = { "entered", "disabled", "cpus", "short", "power domain",
+				      "clock gate", "secure clock", "sspm" };
+static struct {
+	unsigned long count[DP_NR];
+	u32 last_pwr, last_cg[3], last_r12, last_debug;
+	u64 slept_ticks;
+} dp_stats;
+
+static void __iomem *spm_base;
+
+static int dpidle_check(void)
+{
+	u32 pwr, v;
+	int i, blocked = 0;
+
+	if (!READ_ONCE(dpidle))
+		return DP_OFF;
+	if (num_online_cpus() != 1 || smp_processor_id())
+		return DP_CPUS;
+	/* the next timer, as cpuidle programmed it (the broadcast's) */
+	if (ktime_us_delta(tick_nohz_get_next_hrtimer(), ktime_get()) < dpidle_min_us)
+		return DP_SHORT;
+	pwr = readl(spm_base + PWR_STATUS) & readl(spm_base + PWR_STATUS_2ND);
+	if (pwr & DPIDLE_PWR_MASK) {
+		dp_stats.last_pwr = pwr & DPIDLE_PWR_MASK;
+		return DP_PWR;
+	}
+	for (i = 0; i < ARRAY_SIZE(dpidle_cg); i++) {
+		regmap_read(infracfg_regmap, dpidle_cg[i].sta, &v);
+		dp_stats.last_cg[i] = ~v & dpidle_cg[i].mask;
+		blocked |= !!dp_stats.last_cg[i];
+	}
+	if (blocked)
+		return DP_CG;
+	if (spm_sip(MTK_SIP_CHECK_SECURE_CG, 0, 0, 0))
+		return DP_SECURE_CG;
+	return DP_OK;
+}
+
+/* the audio bus clock to 26 MHz across deep idle, as the vendor's audio
+ * driver did on its idle notifier; returns the selection to restore */
+static int dpidle_aud_intbus(int sel)
+{
+	u32 cfg;
+
+	regmap_read(topck_regmap, CLK_CFG_5, &cfg);
+	if (cfg & AUD_INTBUS_GATE)	/* gated: nobody uses it */
+		return -1;
+	regmap_write(topck_regmap, CLK_CFG_5_CLR, 3 << AUD_INTBUS_SHIFT);
+	if (sel > 0)
+		regmap_write(topck_regmap, CLK_CFG_5_SET, sel << AUD_INTBUS_SHIFT);
+	regmap_write(topck_regmap, CLK_CFG_UPDATE, AUD_INTBUS_UPD);
+	return (cfg >> AUD_INTBUS_SHIFT) & 3;
+}
+
+static int mt6771_spm_cpuidle_enter(u32 state)
+{
+	u32 r12, debug, timer;
+	int why, aud, ret;
+
+	/* only a cluster power-down may become an SoC idle state */
+	if (state != MT6771_PSCI_CLUSTER)
+		return psci_cpu_suspend_enter(state);
+	/* deep idle: CPU 0 alone */
+	why = DP_OFF;
+	if (READ_ONCE(dpidle) && !smp_processor_id()) {
+		why = dpidle_check();
+		if (why != DP_OK)
+			dp_stats.count[why]++;
+	}
+	if (why != DP_OK)
+		return so_any() ? so_enter() : psci_cpu_suspend_enter(state);
+
+	if (sspm_spm_command_opt(SSPM_SPM_DPIDLE_ENTER, 0) < 0) {
+		dp_stats.count[DP_SSPM]++;
+		return psci_cpu_suspend_enter(MT6771_PSCI_CLUSTER);
+	}
+	aud = dpidle_aud_intbus(0);
+	regmap_clear_bits(spm_regmap, SPM_SRC_REQ, SPM_HELD_REQ);
+	spm_sip(MTK_SIP_SPM_DPIDLE_ARGS, SPM_DPIDLE_FLAGS, 0, 0);
+	ret = psci_cpu_suspend_enter(MT6771_PSCI_DPIDLE);
+	mt6771_spm_hold(spm_regmap);
+	if (aud >= 0)
+		dpidle_aud_intbus(aud);
+	sspm_spm_command_opt(SSPM_SPM_DPIDLE_LEAVE, 0);
+
+	regmap_read(spm_regmap, SPM_SW_RSV_0, &r12);
+	regmap_read(spm_regmap, SPM_SW_DEBUG, &debug);
+	regmap_read(spm_regmap, SPM_BSI_D1_SR, &timer);
+	dp_stats.count[DP_OK]++;
+	dp_stats.last_r12 = r12;
+	dp_stats.last_debug = debug;
+	dp_stats.slept_ticks += timer;
+	return ret;
+}
+
+static int dpidle_stats_get(char *buf, const struct kernel_param *kp)
+{
+	int i, n = 0;
+
+	for (i = 0; i < DP_NR; i++)
+		n += sysfs_emit_at(buf, n, "%s %lu\n", dp_why[i], dp_stats.count[i]);
+	n += sysfs_emit_at(buf, n, "slept_ms %llu\nlast_r12 0x%x\nlast_debug 0x%x\n",
+			   div_u64(dp_stats.slept_ticks * 1000, 32768), dp_stats.last_r12,
+			   dp_stats.last_debug);
+	n += sysfs_emit_at(buf, n, "last_pwr 0x%x\nlast_cg 0x%x 0x%x 0x%x\n", dp_stats.last_pwr,
+			   dp_stats.last_cg[0], dp_stats.last_cg[1], dp_stats.last_cg[2]);
+	return n;
+}
+
+static const struct kernel_param_ops dpidle_stats_ops = {
+	.get = dpidle_stats_get,
+};
+module_param_cb(dpidle_stats, &dpidle_stats_ops, NULL, 0444);
+MODULE_PARM_DESC(dpidle_stats, "Deep idle entries, why not, and the last wake");
+
+static struct device *dpidle_dev;
+static bool dpidle_ready;
+
+/* At the first dpidle=1, not at boot: the wake sources and the cpuidle hook */
+static int dpidle_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned long src;
+	bool on;
+	int ret = kstrtobool(val, &on);
+
+	if (ret)
+		return ret;
+	if (on && !dpidle_ready) {
+		if (!dpidle_dev)
+			return -ENODEV;
+		src = dpidle_wake_mask ?: (wake_mask ?: spm_sip(MTK_SIP_SPM_GET_PWR_CTRL_ARGS,
+				SPM_PWR_CTRL_SUSPEND, PW_WAKE_SRC, 0)) | R12_AFE_IRQ_MCU;
+		spm_sip(MTK_SIP_SPM_PWR_CTRL_ARGS, SPM_PWR_CTRL_DPIDLE, PW_WAKE_SRC, src);
+		dev_info(dpidle_dev, "deep idle: wake sources 0x%lx, ATF reads back 0x%lx\n", src,
+			 spm_sip(MTK_SIP_SPM_GET_PWR_CTRL_ARGS, SPM_PWR_CTRL_DPIDLE,
+				 PW_WAKE_SRC, 0));
+		psci_cpuidle_set_platform_enter(mt6771_spm_cpuidle_enter);
+		dpidle_ready = true;
+	}
+	WRITE_ONCE(dpidle, on);
+	return 0;
+}
