 drivers/soc/mediatek/Makefile         |    4 +
 drivers/soc/mediatek/mt6771-scp.c     | 1206 +++++++++++++++++++++++++
 drivers/soc/mediatek/mt6771-spm.c     |  354 ++++++++
 drivers/soc/mediatek/mtk-lk-fb.c      |  249 +++++
 drivers/soc/mediatek/mtk-mcdi.c       |  196 ++++
 include/linux/soc/mediatek/mtk-mcdi.h |   13 +
 7 files changed, 2066 insertions(+)

