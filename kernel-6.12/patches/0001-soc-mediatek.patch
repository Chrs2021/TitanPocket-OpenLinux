--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -34,6 +34,38 @@ config MTK_INFRACFG
 	  INFRACFG controller contains various infrastructure registers not
 	  directly associated to any device.
 
+config MTK_LK_FB
+	tristate "MediaTek LK framebuffer handover"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on OF
+	imply FB_SIMPLE
+	help
+	  Hands the framebuffer MediaTek's bootloader (LK) leaves on the
+	  panel to simplefb, so the kernel console shows on the screen
+	  before a display driver runs. The geometry and pixel format are
+	  read from the display overlay engines LK left running.
+
+config MTK_MCDI
+	bool "MediaTek MCDI available-CPU mask (MT6771)"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on OF
+	help
+	  Keeps the SSPM firmware's MCDI available-CPU mask equal to the
+	  online CPUs, so cores that enter PSCI core or cluster power-down
+	  (cpuidle) are powered back on when woken.
+
+config MTK_MT6771_SPM
+	bool "MediaTek MT6771 SPM resource requests and system suspend"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on OF && ARM_PSCI_FW
+	select MFD_SYSCON
+	help
+	  Holds the AP's 26 MHz clock, bus and DRAM requests in the SPM, as
+	  MediaTek's SPM firmware does, so they stay up when blocks such as
+	  UFS release theirs (in suspend). Also starts the SPM firmware and
+	  suspends to RAM through it, as MediaTek's kernel does, in place
+	  of PSCI SYSTEM_SUSPEND.
+
 config MTK_PMIC_WRAP
 	tristate "MediaTek PMIC Wrapper Support"
 	depends on RESET_CONTROLLER
@@ -49,6 +81,18 @@ config MTK_REGULATOR_COUPLER
 	default ARCH_MEDIATEK
 	depends on REGULATOR
 
+config MTK_MT6771_SCP
+	tristate "MediaTek MT6771 SCP and sensor hub"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on IIO
+	select IIO_BUFFER
+	select IIO_KFIFO_BUF
+	help
+	  Starts the MT6771's SCP (the Cortex-M4 running MediaTek's tinysys
+	  firmware, loaded by the bootloader), talks to it over its IPI and
+	  runs the sensor hub on it: the accelerometer, gyroscope,
+	  magnetometer, light and proximity sensors as IIO devices.
+
 config MTK_MMSYS
 	tristate "MediaTek MMSYS Support"
 	default ARCH_MEDIATEK
