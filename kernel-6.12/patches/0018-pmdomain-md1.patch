 drivers/pmdomain/mediatek/mt6771-pm-domains.h | 332 ++++++++++++++++++
 drivers/pmdomain/mediatek/mtk-pm-domains.c    |  94 +++++
 drivers/pmdomain/mediatek/mtk-pm-domains.h    |   6 +
 include/dt-bindings/power/mt6771-power.h      |  13 +
 5 files changed, 451 insertions(+)

