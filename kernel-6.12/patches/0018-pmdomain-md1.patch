diff --git a/drivers/pmdomain/mediatek/mtk-pm-domains.c b/drivers/pmdomain/mediatek/mtk-pm-domains.c
index 88406e9ac63c22330d23f1c8cfa61e689eceb2c0..0a0a375176bfc05d7697ae3bf24f2a67cca21425 100644
--- a/drivers/pmdomain/mediatek/mtk-pm-domains.c
+++ b/drivers/pmdomain/mediatek/mtk-pm-domains.c
@@ -16,6 +16,7 @@
 #include <linux/regulator/consumer.h>
 #include <linux/soc/mediatek/infracfg.h>
 
+#include "mt6771-pm-domains.h"
 #include "mt6795-pm-domains.h"
 #include "mt8167-pm-domains.h"
 #include "mt8173-pm-domains.h"
@@ -48,6 +49,7 @@ struct scpsys_domain {
 	struct regmap *infracfg_nao;
 	struct regmap *infracfg;
 	struct regmap *smi;
+	struct regmap *topckgen;
 	struct regulator *supply;
 };
 
@@ -220,6 +222,73 @@ static int scpsys_bus_protect_disable(struct scpsys_domain *pd)
 	return 0;
 }
 
+/*
+ * The modem's sequence (MT6771 MD1; the vendor's clk-mt6771-pg.c and
+ * md_sys1_platform.c): its clocks leave gating in topckgen's CLK_MODE first,
+ * its SRAM powers up (with no ack) before the isolation is released, an
+ * extra isolation for its buck goes last, and the bus protection is released
+ * without waiting. Power off is the reverse, gating the clocks again last.
+ */
+#define MTK_TOPCKGEN_CLK_MODE		0x0000
+
+static int scpsys_md_power_on(struct scpsys_domain *pd)
+{
+	const struct scpsys_domain_data *data = pd->data;
+	struct regmap *base = pd->scpsys->base;
+	bool tmp;
+	int ret;
+
+	regmap_clear_bits(pd->topckgen, MTK_TOPCKGEN_CLK_MODE, data->md_clk_mode_mask);
+	regmap_clear_bits(base, data->ctl_offs, PWR_RST_B_BIT);
+	regmap_set_bits(base, data->ctl_offs, PWR_ON_BIT);
+	regmap_set_bits(base, data->ctl_offs, PWR_ON_2ND_BIT);
+
+	ret = readx_poll_timeout(scpsys_domain_is_on, pd, tmp, tmp, MTK_POLL_DELAY_US,
+				 MTK_POLL_TIMEOUT);
+	if (ret < 0) {
+		regmap_clear_bits(base, data->ctl_offs, PWR_ON_BIT | PWR_ON_2ND_BIT);
+		regmap_set_bits(pd->topckgen, MTK_TOPCKGEN_CLK_MODE, data->md_clk_mode_mask);
+		return ret;
+	}
+
+	regmap_clear_bits(base, data->ctl_offs, data->sram_pdn_bits);
+	regmap_set_bits(base, data->md_sram_iso_offs, BIT(0));
+	regmap_clear_bits(base, data->ctl_offs, PWR_ISO_BIT);
+	regmap_clear_bits(base, data->ctl_offs, PWR_CLK_DIS_BIT);
+	regmap_set_bits(base, data->ctl_offs, PWR_RST_B_BIT);
+	regmap_clear_bits(base, data->ext_buck_iso_offs, data->ext_buck_iso_mask);
+
+	return scpsys_bus_protect_disable(pd);
+}
+
+static int scpsys_md_power_off(struct scpsys_domain *pd)
+{
+	const struct scpsys_domain_data *data = pd->data;
+	struct regmap *base = pd->scpsys->base;
+	bool tmp;
+	int ret;
+
+	ret = scpsys_bus_protect_enable(pd);
+	if (ret < 0)
+		return ret;
+
+	regmap_set_bits(base, data->ext_buck_iso_offs, data->ext_buck_iso_mask);
+	regmap_set_bits(base, data->ctl_offs, PWR_CLK_DIS_BIT);
+	regmap_set_bits(base, data->ctl_offs, PWR_ISO_BIT);
+	regmap_clear_bits(base, data->md_sram_iso_offs, BIT(0));
+	regmap_set_bits(base, data->ctl_offs, data->sram_pdn_bits);
+	regmap_clear_bits(base, data->ctl_offs, PWR_ON_BIT);
