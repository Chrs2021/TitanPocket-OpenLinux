+
+#endif
diff --git a/sound/soc/codecs/mt6358.c b/sound/soc/codecs/mt6358.c
index 9247b90d1b99e2e3a85d4abc54f2dbf55dac6516..dd3a185d1f245680408132a72c1e98a89022a2d2 100644
--- a/sound/soc/codecs/mt6358.c
+++ b/sound/soc/codecs/mt6358.c
@@ -1517,6 +1517,9 @@ static int mt_rcv_event(struct snd_soc_dapm_widget *w,
 		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON9, 0x0001);
 		/* Switch HS MUX to audio DAC */
 		regmap_write(priv->regmap, MT6358_AUDDEC_ANA_CON6, 0x009b);
+		/* the gain "Handset Volume" set: power-down left it at -40 dB */
+		regmap_write(priv->regmap, MT6358_ZCD_CON3,
+			     priv->ana_gain[AUDIO_ANALOG_VOLUME_HSOUTL]);
 		break;
 	case SND_SOC_DAPM_PRE_PMD:
 		/* HS mux to open */
@@ -2407,6 +2410,11 @@ static struct snd_soc_dai_driver mt6358_dai_driver[] = {
 
 static void mt6358_codec_init_reg(struct mt6358_priv *priv)
 {
+	/* the handset's gain until "Handset Volume" is set (0 would be +8 dB) */
+	priv->ana_gain[AUDIO_ANALOG_VOLUME_HSOUTL] = DL_GAIN_N_10DB;
+	priv->ana_gain[AUDIO_ANALOG_VOLUME_HSOUTR] = DL_GAIN_N_10DB;
+	regmap_write(priv->regmap, MT6358_ZCD_CON3, DL_GAIN_N_10DB);
+
 	/* Disable HeadphoneL/HeadphoneR short circuit protection */
 	regmap_update_bits(priv->regmap, MT6358_AUDDEC_ANA_CON0,
