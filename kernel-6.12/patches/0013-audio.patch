diff --git a/sound/soc/mediatek/mt8183/mt6771-titanpocket.c b/sound/soc/mediatek/mt8183/mt6771-titanpocket.c
new file mode 100644
index 0000000000000000000000000000000000000000..99a4fca824885fa1836559a57fa2eed46bfccc8f
--- /dev/null
+++ b/sound/soc/mediatek/mt8183/mt6771-titanpocket.c
@@ -0,0 +1,320 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Unihertz Titan Pocket (MT6771) sound card.
+ *
+ * The MT6771's audio front end is the MT8183's, so this runs on the
+ * MT8183 AFE driver. Outputs:
+ *   - loudspeaker: I2S3 -> FourSemi FS1860 smart amp (i2c3/0x34)
+ *   - earpiece, headphones: the AFE's ADDA link -> MT6358 codec
+ * the microphones through the MT6358's ADC on the same link, the FM
+ * radio's audio: CONNSYS I2S, captured through UL2, and the modem's voice:
+ * PCM 2 (the internal modem PCM interface), switched on by holding the
+ * Hostless_Speech PCM open both ways while the modem's speech is on.
+ *
+ * Front ends (PCMs) are memory interfaces; which back ends they reach is
+ * set by the AFE's interconnect mixers, e.g. for DL1 on the loudspeaker:
+ *   "I2S3_CH1 DL1_CH1" and "I2S3_CH2 DL1_CH2" on;
+ * for FM into Capture_2 (UL2): "UL2_CH1 CONNSYS_I2S_CH1" and
+ * "UL2_CH2 CONNSYS_I2S_CH2" on.
+ */
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/jack.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "../../codecs/mt6358-accdet.h"
+#include "mt8183-afe-common.h"
+
+/* The FS1860 takes 32-bit slots at the stream's rate, as on 4.14 */
+static int titanpocket_i2s_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
+					   struct snd_pcm_hw_params *params)
+{
+	snd_mask_reset_range(hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT),
+			     0, (__force unsigned int)SNDRV_PCM_FORMAT_LAST);
+	params_set_format(params, SNDRV_PCM_FORMAT_S32_LE);
+	return 0;
+}
+
+static int titanpocket_i2s_hw_params(struct snd_pcm_substream *substream,
+				     struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	/* MCLK at 128 fs, as upstream's MT8183 boards; the amp ignores it */
+	return snd_soc_dai_set_sysclk(snd_soc_rtd_to_cpu(rtd, 0), 0,
+				      params_rate(params) * 128,
+				      SND_SOC_CLOCK_OUT);
+}
+
+static const struct snd_soc_ops titanpocket_i2s_ops = {
+	.hw_params = titanpocket_i2s_hw_params,
+};
+
+/* FE */
+SND_SOC_DAILINK_DEFS(playback1,
+	DAILINK_COMP_ARRAY(COMP_CPU("DL1")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(playback2,
+	DAILINK_COMP_ARRAY(COMP_CPU("DL2")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(capture1,
+	DAILINK_COMP_ARRAY(COMP_CPU("UL1")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(capture2,
+	DAILINK_COMP_ARRAY(COMP_CPU("UL2")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+/* FM through the AFE: CONNSYS I2S -> HW gain 1 -> I2S3/ADDA, no CPU */
+SND_SOC_DAILINK_DEFS(hostless_fm,
+	DAILINK_COMP_ARRAY(COMP_CPU("Hostless FM DAI")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+/* the modem's voice: ADDA UL -> PCM 2 -> modem -> PCM 2 -> ADDA DL/I2S3 */
+SND_SOC_DAILINK_DEFS(hostless_speech,
+	DAILINK_COMP_ARRAY(COMP_CPU("Hostless Speech DAI")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+/* BE */
+SND_SOC_DAILINK_DEFS(primary_codec,
+	DAILINK_COMP_ARRAY(COMP_CPU("ADDA")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("mt6358-sound", "mt6358-snd-codec-aif1")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(connsys_i2s,
+	DAILINK_COMP_ARRAY(COMP_CPU("CONNSYS_I2S")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+/* Bluetooth SCO: the BTCVSD driver is the platform */
+SND_SOC_DAILINK_DEFS(pcm2,
+	DAILINK_COMP_ARRAY(COMP_CPU("PCM 2")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(btcvsd,
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(hw_gain1,
+	DAILINK_COMP_ARRAY(COMP_CPU("HW Gain 1")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(i2s3,
+	DAILINK_COMP_ARRAY(COMP_CPU("I2S3")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),	/* the amp, from the DT */
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+#define TITANPOCKET_FE(_name, _link, _dir)			\
+	{							\
+		.name = _name,					\
+		.stream_name = _name,				\
+		.trigger = { SND_SOC_DPCM_TRIGGER_PRE,		\
+			     SND_SOC_DPCM_TRIGGER_PRE },	\
+		.dynamic = 1,					\
+		._dir = 1,					\
+		SND_SOC_DAILINK_REG(_link),			\
+	}
+
+static struct snd_soc_dai_link titanpocket_dai_links[] = {
+	/* FE */
+	TITANPOCKET_FE("Playback_1", playback1, dpcm_playback),
+	TITANPOCKET_FE("Playback_2", playback2, dpcm_playback),
+	TITANPOCKET_FE("Capture_1", capture1, dpcm_capture),
+	TITANPOCKET_FE("Capture_2", capture2, dpcm_capture),
+	{
+		.name = "Hostless_FM",
+		.stream_name = "Hostless_FM",
+		.trigger = { SND_SOC_DPCM_TRIGGER_PRE,
+			     SND_SOC_DPCM_TRIGGER_PRE },
+		.dynamic = 1,
+		.dpcm_playback = 1,
+		.dpcm_capture = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(hostless_fm),
+	},
+	{
+		.name = "Hostless_Speech",
+		.stream_name = "Hostless_Speech",
+		.trigger = { SND_SOC_DPCM_TRIGGER_PRE,
+			     SND_SOC_DPCM_TRIGGER_PRE },
+		.dynamic = 1,
+		.dpcm_playback = 1,
+		.dpcm_capture = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(hostless_speech),
+	},
+
+	/* BE */
+	{
+		.name = "Primary Codec",
+		.no_pcm = 1,
+		.dpcm_playback = 1,
+		.dpcm_capture = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(primary_codec),
+	},
+	{
+		.name = "I2S3",
+		.no_pcm = 1,
+		.dpcm_playback = 1,
+		.ignore_suspend = 1,
+		.be_hw_params_fixup = titanpocket_i2s_hw_params_fixup,
+		.ops = &titanpocket_i2s_ops,
+		SND_SOC_DAILINK_REG(i2s3),
+	},
+	{
+		.name = "CONNSYS_I2S",
+		.no_pcm = 1,
+		.dpcm_capture = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(connsys_i2s),
+	},
+	{
+		.name = "HW Gain 1",
+		.no_pcm = 1,
+		.dpcm_playback = 1,
+		.dpcm_capture = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(hw_gain1),
+	},
+	{
+		.name = "PCM 2",
+		.no_pcm = 1,
+		.dpcm_playback = 1,
+		.dpcm_capture = 1,
+		.ignore_suspend = 1,
+		SND_SOC_DAILINK_REG(pcm2),
+	},
+
+	/* last: dropped when the tree has no mediatek,btcvsd */
+	{
+		.name = "BTCVSD",
+		.stream_name = "BTCVSD",
+		SND_SOC_DAILINK_REG(btcvsd),
+	},
+};
+
+/* the 3.5 mm jack, detected by the MT6358's ACCDET */
+static struct snd_soc_jack titanpocket_jack;
+
+static struct snd_soc_jack_pin titanpocket_jack_pins[] = {
+	{ .pin = "Headphones", .mask = SND_JACK_HEADPHONE },
+	{ .pin = "Headset Mic", .mask = SND_JACK_MICROPHONE },
+};
+
+static const struct snd_soc_dapm_widget titanpocket_widgets[] = {
+	SND_SOC_DAPM_HP("Headphones", NULL),
+	SND_SOC_DAPM_MIC("Headset Mic", NULL),
+};
+
+static int titanpocket_accdet_init(struct snd_soc_component *component)
+{
+	int ret;
+
+	ret = snd_soc_card_jack_new_pins(component->card, "Headset Jack",
+					 SND_JACK_HEADSET | SND_JACK_BTN_0,
+					 &titanpocket_jack, titanpocket_jack_pins,
+					 ARRAY_SIZE(titanpocket_jack_pins));
+	if (ret)
+		return ret;
+	return mt6358_accdet_enable_jack_detect(component, &titanpocket_jack);
+}
+
+static struct snd_soc_aux_dev titanpocket_aux = {
+	.dlc = COMP_EMPTY(),
+	.init = titanpocket_accdet_init,
+};
+
+static struct snd_soc_card titanpocket_card = {
+	.name = "titanpocket",
+	.owner = THIS_MODULE,
+	.dai_link = titanpocket_dai_links,
+	.num_links = ARRAY_SIZE(titanpocket_dai_links),
+	.dapm_widgets = titanpocket_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(titanpocket_widgets),
+};
+
+static int titanpocket_dev_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &titanpocket_card;
+	struct device_node *platform_node, *amp_node, *btcvsd_node;
+	struct snd_soc_dai_link *dai_link;
+	int ret, i;
+
+	platform_node = of_parse_phandle(pdev->dev.of_node,
+					 "mediatek,platform", 0);
+	if (!platform_node)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "mediatek,platform missing\n");
+
+	amp_node = of_find_compatible_node(NULL, NULL, "foursemi,fs1860");
+	if (!amp_node) {
+		of_node_put(platform_node);
+		return dev_err_probe(&pdev->dev, -ENODEV, "no FS1860 node\n");
+	}
+
+	btcvsd_node = of_parse_phandle(pdev->dev.of_node, "mediatek,btcvsd", 0);
+	card->num_links = ARRAY_SIZE(titanpocket_dai_links) - !btcvsd_node;
+
+	/* the jack, when the tree has the PMIC's accdet */
+	titanpocket_aux.dlc.of_node = of_parse_phandle(pdev->dev.of_node,
+						       "mediatek,accdet", 0);
+	if (titanpocket_aux.dlc.of_node) {
+		card->aux_dev = &titanpocket_aux;
+		card->num_aux_devs = 1;
+	}
+
+	card->dev = &pdev->dev;
+	for_each_card_prelinks(card, i, dai_link) {
+		if (!strcmp(dai_link->name, "BTCVSD")) {
+			dai_link->platforms->of_node = btcvsd_node;
+			continue;
+		}
+		if (!strcmp(dai_link->name, "I2S3")) {
+			dai_link->codecs->of_node = amp_node;
+			dai_link->codecs->dai_name = "fs1860-aif";
+		}
+		if (!dai_link->platforms->name)
+			dai_link->platforms->of_node = platform_node;
+	}
+
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+
+	of_node_put(titanpocket_aux.dlc.of_node);
+	of_node_put(btcvsd_node);
+	of_node_put(amp_node);
+	of_node_put(platform_node);
+	return ret;
+}
+
+static const struct of_device_id titanpocket_dt_match[] = {
+	{ .compatible = "unihertz,titan-pocket-sound" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, titanpocket_dt_match);
+
+static struct platform_driver titanpocket_driver = {
+	.driver = {
+		.name = "titanpocket-sound",
+		.of_match_table = titanpocket_dt_match,
+		.pm = &snd_soc_pm_ops,
+	},
+	.probe = titanpocket_dev_probe,
+};
+module_platform_driver(titanpocket_driver);
+
+MODULE_DESCRIPTION("Unihertz Titan Pocket sound card");
+MODULE_LICENSE("GPL");
