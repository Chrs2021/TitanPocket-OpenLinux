+/*
+ * CONNSYS I2S: the FM radio's audio, an I2S input from CONNSYS (the
+ * MT6631 is the master, 32 kHz) through the AFE's ASRC to the stream rate.
+ * Register sequence and ASRC constants are the vendor MT6771 kernel's
+ * (setConnsysI2SIn/Asrc/Enable in mtk-soc-afe-control.c); its
+ * AFE_ASRC_CONNSYS_CON0/13-21 are upstream's AFE_ASRC_2CH_CON0/2-10.
+ */
+static int mtk_dai_connsys_i2s_hw_params(struct snd_pcm_substream *substream,
+					 struct snd_pcm_hw_params *params,
+					 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	unsigned int rate = params_rate(params);
+	unsigned int i2s_con;
+
+	/* i2s format, slave (proxy) mode, 16 bits, pad from connsys */
+	i2s_con = I2S_FMT_I2S << I2S_FMT_SFT |
+		  1 << I2S_SRC_SFT |
+		  get_i2s_wlen(SNDRV_PCM_FORMAT_S16_LE) << I2S_WLEN_SFT |
+		  I2S_IN_PAD_CONNSYS << I2SIN_PAD_SEL_SFT;
+	regmap_update_bits(afe->regmap, AFE_CONNSYS_I2S_CON, ~0x1u, i2s_con);
+
+	/* through the ASRC, to the stream rate */
+	regmap_update_bits(afe->regmap, AFE_CONNSYS_I2S_CON,
+			   I2S_BYPSRC_MASK_SFT, 0);
+	regmap_update_bits(afe->regmap, AFE_CONNSYS_I2S_CON, I2S_MODE_MASK_SFT,
+			   mt8183_general_rate_transform(afe->dev, rate) <<
+			   I2S_MODE_SFT);
+
+	regmap_write(afe->regmap, AFE_ASRC_2CH_CON3,
+		     rate == 44100 ? 0x001b9000 : 0x001e0000);
+	regmap_write(afe->regmap, AFE_ASRC_2CH_CON4, 0x00140000);
+	regmap_write(afe->regmap, AFE_ASRC_2CH_CON5, 0x00ff5987);
+	regmap_write(afe->regmap, AFE_ASRC_2CH_CON6, 0x00007ef4);
+	regmap_write(afe->regmap, AFE_ASRC_2CH_CON5, 0x00ff5986);
+	regmap_write(afe->regmap, AFE_ASRC_2CH_CON5, 0x00ff5987);
+	/* stereo */
+	regmap_update_bits(afe->regmap, AFE_ASRC_2CH_CON2, BIT(16), 0);
+	/* calibration */
+	regmap_write(afe->regmap, AFE_ASRC_2CH_CON9, 0x00036000);
+	regmap_write(afe->regmap, AFE_ASRC_2CH_CON10, 0x0002fc00);
+	return 0;
+}
+
+#define ASRC_2CH_CON0_EN	(BIT(6) | BIT(4) | BIT(0))
+
+static int mtk_dai_connsys_i2s_trigger(struct snd_pcm_substream *substream,
+				       int cmd, struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		regmap_update_bits(afe->regmap, AFE_ASRC_2CH_CON0,
+				   ASRC_2CH_CON0_EN, ASRC_2CH_CON0_EN);
+		regmap_update_bits(afe->regmap, AFE_CONNSYS_I2S_CON,
+				   I2S_EN_MASK_SFT, 1 << I2S_EN_SFT);
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		regmap_update_bits(afe->regmap, AFE_CONNSYS_I2S_CON,
+				   I2S_EN_MASK_SFT, 0);
+		regmap_update_bits(afe->regmap, AFE_ASRC_2CH_CON0,
+				   ASRC_2CH_CON0_EN, 0);
+		regmap_update_bits(afe->regmap, AFE_CONNSYS_I2S_CON,
+				   I2S_BYPSRC_MASK_SFT, I2S_BYPSRC_MASK_SFT);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mtk_dai_connsys_i2s_ops = {
+	.hw_params = mtk_dai_connsys_i2s_hw_params,
+	.trigger = mtk_dai_connsys_i2s_trigger,
+};
