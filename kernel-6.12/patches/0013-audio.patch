diff --git a/sound/soc/codecs/fs1860.c b/sound/soc/codecs/fs1860.c
new file mode 100644
index 0000000000000000000000000000000000000000..0084a6dc8cb6bf3a6372531f4cd2c8cf90bbf491
--- /dev/null
+++ b/sound/soc/codecs/fs1860.c
@@ -0,0 +1,519 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * FourSemi FS1860 smart speaker amplifier (Unihertz Titan Pocket).
+ *
+ * On stock Android this amp is driven entirely from the vendor HAL
+ * (libfs1860.so) through a raw I2C pass-through device. The sequences here
+ * were recovered from that library, and the steady-state configuration was
+ * captured from the running phone (see fs1860_config below). This is the
+ * 4.14 driver (docs/drivers/fs1860.md) on the current ASoC API: a plain
+ * component, bound by the machine driver's I2S3 back end.
+ *
+ * Registers are 16-bit big-endian. The register map closely follows the
+ * NXP TFA98xx family: 0x00 status, 0x04 I2S control, 0x06 volume,
+ * 0x09 system control (bit0 power-down, bit3 amp enable).
+ */
+
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#define FS1860_PRESET_FW	"fs16xx_01s_mono.preset"
+
+#define FS1860_REG_STATUS	0x00
+#define FS1860_STATUS_PLLS	BIT(1)
+#define FS1860_REG_REVID	0x03
+#define FS1860_REVID		0x0703
+#define FS1860_REG_I2SCTRL	0x04
+#define FS1860_REG_AUDIOCTRL	0x06
+#define FS1860_REG_SYSCTRL	0x09
+#define FS1860_SYSCTRL_PWDN	BIT(0)
+#define FS1860_SYSCTRL_AMPE	BIT(3)
+#define FS1860_REG_ACCKEY	0x0b
+#define FS1860_ACCKEY_UNLOCK	0xca91
+#define FS1860_REG_DSPCOEF	0x82
+#define FS1860_REG_COEFADDR	0x86
+#define FS1860_REG_DSPRAM	0xa2
+#define FS1860_REG_DSPADDR	0xa6
+#define FS1860_REG_TEMPPROT	0xaf
+#define FS1860_REG_DSPSTATUS	0xbd
+#define FS1860_REG_PWRKEY	0xc4
+
+/* Preset file layout (libfs1860 v0x0703): 468-byte header, then coefficients */
+#define FS1860_PRESET_VERSION	0x0703
+#define FS1860_PRESET_HDR_LEN	468
+#define FS1860_PRESET_NCOEF	42	/* u16 count field offset */
+#define FS1860_PRESET_RAM	144	/* 81 x u32 DSP RAM words */
+#define FS1860_PRESET_RAM_WORDS	81
+
+/*
+ * Volume until userspace sets one: the chip init below writes full gain
+ * (0xff), which on 4.14 played every first sound after boot at full level.
+ */
+#define FS1860_DEFAULT_VOLUME	160
+
+struct fs1860_reg {
+	u8 reg;
+	u16 val;
+};
+
+/* Fs16xx_reg_defaults from libfs1860.so, written first by fs16xx_init() */
+static const struct fs1860_reg fs1860_defaults[] = {
+	{ 0x0b, 0xca91 }, { 0x04, 0x800b }, { 0x06, 0xff00 }, { 0xc0, 0xb54e },
+	{ 0xc4, 0x000f }, { 0xae, 0x0010 }, { 0xb9, 0xffff }, { 0x09, 0x0009 },
+	{ 0xd7, 0x60a0 }, { 0xa1, 0x5802 }, { 0x99, 0x0000 }, { 0x0b, 0x0000 },
+};
+
+/*
+ * Configuration registers as left by the stock HAL after init (speaker
+ * idle), read back from this phone. Covers the 44.1/48k preset selection,
+ * mono channel select, mute/volume and protection thresholds.
+ * 0x62-0x69 are speaker-protection coefficients the HAL derives from the
+ * factory R25 calibration in OTP (0xe8); they are specific to this unit.
+ */
+static const struct fs1860_reg fs1860_config[] = {
+	{ 0x04, 0x801b }, { 0x06, 0xff00 }, { 0x08, 0x01fe }, { 0x0a, 0x0400 },
+	{ 0x62, 0x7f10 }, { 0x63, 0x8e4f }, { 0x64, 0x8c27 }, { 0x65, 0x8c27 },
+	{ 0x66, 0x8c27 }, { 0x67, 0x8c27 }, { 0x68, 0x89a6 }, { 0x69, 0x873c },
+	{ 0x6a, 0x0a05 }, { 0x6b, 0x2015 }, { 0x6c, 0x402a },
+	{ 0x72, 0x0a53 }, { 0x73, 0xeb59 }, { 0x74, 0x0a53 },
+	{ 0x77, 0x000b }, { 0x78, 0x0016 }, { 0x79, 0x000b },
+	{ 0x7e, 0x1000 }, { 0x7f, 0x0000 },
+	{ 0x89, 0x9080 }, { 0x8a, 0x0345 }, { 0x8b, 0x18bc }, { 0x8c, 0x14c7 },
+	{ 0xa1, 0x5802 }, { 0xa7, 0x0004 }, { 0xa8, 0x00e5 }, { 0xa9, 0x02d8 },
+	{ 0xaa, 0x0035 }, { 0xad, 0x00a3 }, { 0xae, 0x0010 }, { 0xb9, 0xffff },
+	{ 0xba, 0x0031 }, { 0xc0, 0x4aae }, { 0xc1, 0x0168 }, { 0xc2, 0x00f0 },
+	{ 0xc3, 0x0006 },
+};
+
+struct fs1860 {
+	struct i2c_client *client;
+	struct mutex lock;
+	bool initialized;
+	bool on;
+	u8 volume;
+};
+
+static int fs1860_read(struct fs1860 *fs, u8 reg)
+{
+	return i2c_smbus_read_word_swapped(fs->client, reg);
+}
+
+static int fs1860_write(struct fs1860 *fs, u8 reg, u16 val)
+{
+	return i2c_smbus_write_word_swapped(fs->client, reg, val);
+}
+
+static int fs1860_write_table(struct fs1860 *fs, const struct fs1860_reg *t,
+			      int n)
+{
+	int i, ret;
+
+	for (i = 0; i < n; i++) {
+		ret = fs1860_write(fs, t[i].reg, t[i].val);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int fs1860_bulk_write(struct fs1860 *fs, u8 reg, const u8 data[4])
+{
+	u8 buf[5] = { reg, data[0], data[1], data[2], data[3] };
+	int ret = i2c_master_send(fs->client, buf, sizeof(buf));
+
+	return ret == sizeof(buf) ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+/* Poll until (reg & mask) == want, up to tries x 1ms */
+static int fs1860_wait(struct fs1860 *fs, u8 reg, u16 mask, u16 want, int tries)
+{
+	while (tries--) {
+		int v = fs1860_read(fs, reg);
+
+		if (v >= 0 && (v & mask) == want)
+			return 0;
+		usleep_range(1000, 1200);
+	}
+	return -ETIMEDOUT;
+}
+
+static int fs1860_set_volume(struct fs1860 *fs, u8 vol)
+{
+	int v = fs1860_read(fs, FS1860_REG_AUDIOCTRL);
+
+	return v < 0 ? v : fs1860_write(fs, FS1860_REG_AUDIOCTRL,
+					(v & 0xff) | vol << 8);
+}
+
+/* fs16xx_load_presets_to_dev(): DSP RAM and coefficient upload */
+static int fs1860_load_preset(struct fs1860 *fs, const struct firmware *fw)
+{
+	const u8 *p = fw->data;
+	u16 ncoef = p[FS1860_PRESET_NCOEF] | p[FS1860_PRESET_NCOEF + 1] << 8;
+	int sysctrl, i, ret;
+	u8 b[4];
+
+	if (fw->size < FS1860_PRESET_HDR_LEN ||
+	    (p[0] | p[1] << 8) != FS1860_PRESET_VERSION ||
+	    fw->size != FS1860_PRESET_HDR_LEN + 2 * ncoef || ncoef & 1) {
+		dev_err(&fs->client->dev, "unexpected preset file layout\n");
+		return -EINVAL;
+	}
+
+	sysctrl = fs1860_read(fs, FS1860_REG_SYSCTRL);
+	if (sysctrl < 0)
+		return sysctrl;
+	fs1860_write(fs, FS1860_REG_SYSCTRL, sysctrl & ~FS1860_SYSCTRL_AMPE);
+	fs1860_write(fs, FS1860_REG_ACCKEY, FS1860_ACCKEY_UNLOCK);
+	if (fs1860_wait(fs, FS1860_REG_DSPSTATUS, 0x3, 0, 50))
+		dev_warn(&fs->client->dev, "DSP did not stop\n");
+
+	ret = fs1860_write(fs, FS1860_REG_DSPADDR, 0);
+	for (i = 0; !ret && i < FS1860_PRESET_RAM_WORDS; i++) {
+		const u8 *w = p + FS1860_PRESET_RAM + 4 * i;	/* LE u32 */
+
+		b[0] = w[1];
+		b[1] = w[0];
+		b[2] = 0;
+		b[3] = w[2];
+		ret = fs1860_bulk_write(fs, FS1860_REG_DSPRAM, b);
+	}
+
+	if (!ret)
+		ret = fs1860_write(fs, FS1860_REG_COEFADDR, 0);
+	for (i = 0; !ret && i < ncoef / 2; i++) {
+		const u8 *c = p + FS1860_PRESET_HDR_LEN + 4 * i;	/* 2 x LE u16 */
+
+		ret = fs1860_write(fs, FS1860_REG_COEFADDR, i);
+		b[0] = c[1];
+		b[1] = c[0];
+		b[2] = c[3];
+		b[3] = c[2];
+		if (!ret)
+			ret = fs1860_bulk_write(fs, FS1860_REG_DSPCOEF, b);
+	}
+
+	fs1860_write(fs, FS1860_REG_ACCKEY, 0);
+	fs1860_write(fs, FS1860_REG_SYSCTRL, sysctrl);
+	return ret;
+}
+
+static int fs1860_init_chip(struct fs1860 *fs)
+{
+	const struct firmware *fw;
+	int ret;
+
+	ret = fs1860_write_table(fs, fs1860_defaults,
+				 ARRAY_SIZE(fs1860_defaults));
+	if (ret)
+		return ret;
+
+	ret = request_firmware(&fw, FS1860_PRESET_FW, &fs->client->dev);
+	if (ret) {
+		dev_err(&fs->client->dev, "missing %s: %d\n",
+			FS1860_PRESET_FW, ret);
+		return ret;
+	}
+	ret = fs1860_load_preset(fs, fw);
+	release_firmware(fw);
+	if (ret)
+		return ret;
+
+	fs1860_write(fs, FS1860_REG_ACCKEY, FS1860_ACCKEY_UNLOCK);
+	ret = fs1860_write_table(fs, fs1860_config, ARRAY_SIZE(fs1860_config));
+	fs1860_write(fs, FS1860_REG_ACCKEY, 0);
+	if (!ret)
+		ret = fs1860_set_volume(fs, fs->volume);
+	if (ret)
+		return ret;
+
+	dev_info(&fs->client->dev, "initialized with %s\n", FS1860_PRESET_FW);
+	return 0;
+}
+
+static int fs1860_ensure_init(struct fs1860 *fs)
+{
+	int ret = 0;
+
+	if (!fs->initialized) {
+		ret = fs1860_init_chip(fs);
+		fs->initialized = !ret;
+	}
+	return ret;
+}
+
+/*
+ * fs16xx_powerdown(dev, 0) + the AMPE cycle from fs16xx_set_preset() +
+ * fs16xx_set_tempr_protection(dev, 1). The DSP only starts on an AMPE rising
+ * edge while the I2S clock is present, so power up with AMPE clear, wait for
+ * the PLL to lock, then enable the amplifier.
+ */
+static int fs1860_speaker_on(struct fs1860 *fs)
+{
+	int v, ret;
+
+	fs1860_write(fs, FS1860_REG_PWRKEY, 0x000f);
+	v = fs1860_read(fs, FS1860_REG_SYSCTRL);
+	if (v < 0)
+		return v;
+	v &= ~(FS1860_SYSCTRL_PWDN | FS1860_SYSCTRL_AMPE);
+	ret = fs1860_write(fs, FS1860_REG_SYSCTRL, v);
+	if (ret)
+		return ret;
+
+	/* The PLL locks to the I2S bit clock; no clock means no audio */
+	if (fs1860_wait(fs, FS1860_REG_STATUS, FS1860_STATUS_PLLS,
+			FS1860_STATUS_PLLS, 100))
+		dev_warn(&fs->client->dev, "PLL not locked (no I2S clock?)\n");
+	fs1860_wait(fs, FS1860_REG_DSPSTATUS, 0x3, 0, 50);
+
+	ret = fs1860_write(fs, FS1860_REG_SYSCTRL, v | FS1860_SYSCTRL_AMPE);
+	if (ret)
+		return ret;
+	usleep_range(5000, 6000);	/* boost soft-start */
+
+	ret = fs1860_write(fs, FS1860_REG_TEMPPROT, 0x362b);
+	fs->on = !ret;
+	dev_dbg(&fs->client->dev, "speaker on: status=0x%04x dsp=0x%04x\n",
+		fs1860_read(fs, FS1860_REG_STATUS),
+		fs1860_read(fs, FS1860_REG_DSPSTATUS));
+	return ret;
+}
+
+/* fs16xx_powerdown(dev, 1) */
+static int fs1860_speaker_off(struct fs1860 *fs)
+{
+	int v;
+
+	fs1860_write(fs, FS1860_REG_TEMPPROT, 0x7623);
+	v = fs1860_read(fs, FS1860_REG_SYSCTRL);
+	if (v >= 0)
+		fs1860_write(fs, FS1860_REG_SYSCTRL, v | FS1860_SYSCTRL_PWDN);
+	if (fs1860_wait(fs, FS1860_REG_DSPSTATUS, 0x3, 0, 50))
+		dev_warn(&fs->client->dev, "DSP did not stop\n");
+	fs1860_write(fs, FS1860_REG_PWRKEY, 0x0000);
+	fs->on = false;
+	return 0;
+}
+
+/* fs16xx_set_samplerate(): rate code in I2SCTRL[15:12], clear [7:6] */
+static int fs1860_rate_code(unsigned int rate)
+{
+	switch (rate) {
+	case 8000:	return 0x0;
+	case 16000:	return 0x3;
+	case 32000:	return 0x6;
+	case 44100:	return 0x7;
+	case 48000:	return 0x8;
+	default:	return -EINVAL;
+	}
+}
+
+static int fs1860_hw_params(struct snd_pcm_substream *substream,
+			    struct snd_pcm_hw_params *params,
+			    struct snd_soc_dai *dai)
+{
+	struct fs1860 *fs = snd_soc_component_get_drvdata(dai->component);
+	int code = fs1860_rate_code(params_rate(params));
+	int v, ret;
+
+	dev_dbg(&fs->client->dev, "%s: rate=%u ch=%u\n", __func__,
+		params_rate(params), params_channels(params));
+	if (code < 0)
+		return code;
+
+	mutex_lock(&fs->lock);
+	ret = fs1860_ensure_init(fs);
+	if (!ret) {
+		v = fs1860_read(fs, FS1860_REG_I2SCTRL);
+		ret = v < 0 ? v : fs1860_write(fs, FS1860_REG_I2SCTRL,
+					       (v & 0x0f3f) | code << 12);
+	}
+	mutex_unlock(&fs->lock);
+	return ret;
+}
+
+/*
+ * ASoC unmutes after the stream event has started the back end, so the
+ * I2S bit clock is running here: the amp is switched on at unmute and off
+ * at mute, not at prepare as on 4.14 (where a hostless link held it).
+ */
+static int fs1860_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
+{
+	struct fs1860 *fs = snd_soc_component_get_drvdata(dai->component);
+	int sysctrl, ret = 0;
+
+	mutex_lock(&fs->lock);
+	/* Trust the chip, not our flag: it may have been powered down behind us */
+	sysctrl = fs1860_read(fs, FS1860_REG_SYSCTRL);
+	if (sysctrl >= 0)
+		fs->on = !(sysctrl & FS1860_SYSCTRL_PWDN);
+	dev_dbg(&fs->client->dev, "%s: mute=%d sysctrl=0x%04x\n", __func__,
+		mute, sysctrl);
+
+	if (!mute && !fs->on) {
+		ret = fs1860_ensure_init(fs);
+		if (!ret)
+			ret = fs1860_speaker_on(fs);
+	} else if (mute && fs->on) {
+		ret = fs1860_speaker_off(fs);
+	}
+	if (ret)
+		dev_err(&fs->client->dev, "speaker %s failed: %d\n",
+			mute ? "off" : "on", ret);
+	mutex_unlock(&fs->lock);
+	return ret;
+}
+
+static const struct snd_soc_dai_ops fs1860_dai_ops = {
+	.hw_params	= fs1860_hw_params,
+	.mute_stream	= fs1860_mute_stream,
+	.no_capture_mute = 1,
+};
+
+static struct snd_soc_dai_driver fs1860_dai = {
+	.name = "fs1860-aif",
+	.playback = {
+		.stream_name	= "Playback",
+		.channels_min	= 1,
+		.channels_max	= 2,
+		.rates		= SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |
+				  SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_44100 |
+				  SNDRV_PCM_RATE_48000,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE |
+				  SNDRV_PCM_FMTBIT_S24_LE |
+				  SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &fs1860_dai_ops,
+};
+
+/*
+ * Volume: AUDIOCTRL[15:8], 0xff is the HAL's normal (full) level, -0.5dB
+ * steps. Kept here and written after the chip init, which sets 0xff.
+ */
+static int fs1860_volume_get(struct snd_kcontrol *kc,
+			     struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kc);
+	struct fs1860 *fs = snd_soc_component_get_drvdata(component);
+
+	uc->value.integer.value[0] = fs->volume;
+	return 0;
+}
+
+static int fs1860_volume_put(struct snd_kcontrol *kc,
+			     struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kc);
+	struct fs1860 *fs = snd_soc_component_get_drvdata(component);
+	u8 vol = clamp_t(long, uc->value.integer.value[0], 0, 0xff);
+	int ret = 0;
+
+	mutex_lock(&fs->lock);
+	if (vol != fs->volume) {
+		fs->volume = vol;
+		if (fs->initialized)
+			ret = fs1860_set_volume(fs, vol);
+	}
+	mutex_unlock(&fs->lock);
+	return ret ? ret : 1;
+}
+
+static const DECLARE_TLV_DB_SCALE(fs1860_vol_tlv, -12750, 50, 1);
+
+static const struct snd_kcontrol_new fs1860_controls[] = {
+	SOC_SINGLE_EXT_TLV("Speaker Amp Volume", SND_SOC_NOPM, 0, 0xff, 0,
+			   fs1860_volume_get, fs1860_volume_put,
+			   fs1860_vol_tlv),
+};
+
+/* The speaker ends the DAPM path, so the CPU's I2S back end powers up */
+static const struct snd_soc_dapm_widget fs1860_dapm_widgets[] = {
+	SND_SOC_DAPM_OUTPUT("SPK"),
+};
+
+static const struct snd_soc_dapm_route fs1860_dapm_routes[] = {
+	{ "SPK", NULL, "Playback" },
+};
+
+static const struct snd_soc_component_driver fs1860_component = {
+	.controls		= fs1860_controls,
+	.num_controls		= ARRAY_SIZE(fs1860_controls),
+	.dapm_widgets		= fs1860_dapm_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(fs1860_dapm_widgets),
+	.dapm_routes		= fs1860_dapm_routes,
+	.num_dapm_routes	= ARRAY_SIZE(fs1860_dapm_routes),
+	.endianness		= 1,
+};
+
+static int fs1860_probe(struct i2c_client *client)
+{
+	struct fs1860 *fs;
+	int rev;
+
+	rev = i2c_smbus_read_word_swapped(client, FS1860_REG_REVID);
+	if (rev != FS1860_REVID)
+		return dev_err_probe(&client->dev, -ENODEV,
+				     "unexpected revision 0x%04x\n", rev);
+
+	fs = devm_kzalloc(&client->dev, sizeof(*fs), GFP_KERNEL);
+	if (!fs)
+		return -ENOMEM;
+	fs->client = client;
+	fs->volume = FS1860_DEFAULT_VOLUME;
+	mutex_init(&fs->lock);
+	i2c_set_clientdata(client, fs);
+
+	/* Keep the amp powered down until a stream starts */
+	fs1860_write(fs, FS1860_REG_SYSCTRL,
+		     FS1860_SYSCTRL_PWDN | FS1860_SYSCTRL_AMPE);
+	dev_info(&client->dev, "FS1860 rev 0x%04x\n", rev);
+
+	return devm_snd_soc_register_component(&client->dev, &fs1860_component,
+					       &fs1860_dai, 1);
+}
+
+static void fs1860_shutdown(struct i2c_client *client)
+{
+	struct fs1860 *fs = i2c_get_clientdata(client);
+
+	if (fs && fs->on) {
+		mutex_lock(&fs->lock);
+		fs1860_speaker_off(fs);
+		mutex_unlock(&fs->lock);
+	}
+}
+
+static const struct of_device_id fs1860_of_match[] = {
+	{ .compatible = "foursemi,fs1860" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fs1860_of_match);
+
+static const struct i2c_device_id fs1860_i2c_id[] = {
+	{ "fs1860" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, fs1860_i2c_id);
+
+static struct i2c_driver fs1860_driver = {
+	.driver = {
+		.name = "fs1860",
+		.of_match_table = fs1860_of_match,
+	},
+	.probe = fs1860_probe,
+	.shutdown = fs1860_shutdown,
+	.id_table = fs1860_i2c_id,
+};
+module_i2c_driver(fs1860_driver);
+
+MODULE_DESCRIPTION("FourSemi FS1860 smart amplifier (Titan Pocket)");
+MODULE_FIRMWARE(FS1860_PRESET_FW);
+MODULE_LICENSE("GPL");
diff --git a/sound/soc/codecs/mt6358-accdet.c b/sound/soc/codecs/mt6358-accdet.c
new file mode 100644
index 0000000000000000000000000000000000000000..05b87d4d6c9c1d6cb4c1e5f8a52a0a4879707837
--- /dev/null
+++ b/sound/soc/codecs/mt6358-accdet.c
@@ -0,0 +1,323 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6358 accessory detection: the 3.5 mm jack's plug, headphones or a
+ * headset (with a microphone) and the headset's hook button.
+ *
+ * The PMIC watches the jack's detect pin itself (EINT0, level triggered;
+ * the driver flips the polarity after each edge). On plug-in the ACCDET
+ * block runs: it pulses the microphone bias and compares the mic pin
+ * (A/B bits in ACCDET_STATE_RG): 01 a headset, 00 headphones (the mic pin
+ * is grounded) or, with a headset in, the hook button, 11 nothing.
+ * Register use as the vendor's MT6358 driver (4.14, accdet/mt6358).
+ */
+#include <linux/delay.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/mt6397/core.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <sound/jack.h>
+#include <sound/soc.h>
+
+#include "mt6358-accdet.h"
+
+#define AUD_TOP_INT_STATUS0	0x2234
+#define  INT_STATUS_ACCDET		BIT(5)
+#define  INT_STATUS_ACCDET_EINT0	BIT(6)
+#define AUD_TOP_RST_CON0	0x2220
+#define  ACCDET_RST			BIT(1)
+#define AUDENC_ANA_CON6		0x2394
+#define  FSTDSCHRG_ANALOG_DIR_EN	BIT(5)
+#define  FSTDSCHRG_IMPR_EN		BIT(6)
+#define AUDENC_ANA_CON10	0x239c
+#define  MICBIAS1_LOWP_EN		BIT(2)
+#define  MICBIAS1_VREF_SFT		4
+#define  MICBIAS1_DCSW1PEN		BIT(8)
+#define AUDENC_ANA_CON11	0x239e
+#define  ACCDET_MODE1			0x0807	/* ACC */
+#define  ACCDET_MODE2			0x0887	/* DCC, also mode 6 */
+#define ACCDET_CTRL		0x250a
+#define  ACCDET_ENABLE			BIT(0)
+#define  ACCDET_SEQ_INIT		BIT(1)
+#define  ACCDET_EINT0_EN		BIT(2)
+#define ACCDET_STATE_SWCTRL	0x250c
+#define  ACCDET_PWM_EN			GENMASK(2, 0)
+#define  ACCDET_EINT0_PWM_EN		BIT(3)
+#define  ACCDET_PWM_IDLE		GENMASK(10, 8)
+#define  ACCDET_EINT0_PWM_IDLE		BIT(11)
+#define ACCDET_PWM_WIDTH	0x250e
+#define ACCDET_PWM_THRESH	0x2510
+#define ACCDET_EN_DELAY_NUM	0x2512
+#define ACCDET_DEBOUNCE0	0x2514	/* state 00: headphones, hook */
+#define ACCDET_DEBOUNCE1	0x2516	/* state 01: microphone bias */
+#define ACCDET_DEBOUNCE3	0x251a	/* state 11: plug out */
+#define ACCDET_DEBOUNCE4	0x251c	/* AUXADC */
+#define ACCDET_IRQ_STS		0x2520
+#define  ACCDET_IRQ			BIT(0)
+#define  ACCDET_EINT0_IRQ		BIT(2)
+#define  ACCDET_IRQ_CLR			BIT(8)
+#define  ACCDET_EINT0_IRQ_CLR		BIT(10)
+#define  ACCDET_EINT0_IRQ_POL		BIT(14)
+#define ACCDET_STATE_RG		0x2524
+#define  ACCDET_AB_SFT			6
+#define  ACCDET_AB_MASK			3
+#define ACCDET_EINT0_CTL	0x2526
+#define  EINT0_DEB_MASK			(0xf << 3)
+#define  EINT0_DEB_OUT_12MS		(0x1 << 3)
+#define  EINT0_DEB_IN_256MS		(0xe << 3)
+#define  EINT0_PWM_THRESH_MASK		(0x7 << 8)
+#define  EINT0_PWM_THRESH		(0x6 << 8)
+#define  EINT0_PWM_WIDTH_MASK		(0x3 << 12)
+#define  EINT0_PWM_WIDTH		(0x2 << 12)
+#define ACCDET_HW_MODE_DFF	0x2538
+#define  ACCDET_HWMODE_SEL		BIT(2)
+#define  ACCDET_FAST_DISCHARGE		BIT(4)
+
+#define AB_HEADPHONES		0
+#define AB_HEADSET		1
+#define AB_NONE			3
+
+#define JACK_MASK (SND_JACK_HEADSET | SND_JACK_BTN_0)
+
+struct mt6358_accdet {
+	struct device *dev;
+	struct regmap *regmap;
+	struct snd_soc_jack *jack;
+	struct mutex lock;
+	u32 mic_vol, mic_mode, eint_pol;
+	/* PWM width, threshold, fall and rise delay, debounce 0, 1, 3, 4 */
+	u32 pwm_deb[8];
+	bool plugged;
+	int status;		/* SND_JACK_* reported */
+};
+
+static void accdet_clear_irq(struct mt6358_accdet *a, u32 clr, u32 sts,
+			     u32 top)
+{
+	u32 v;
+
+	regmap_set_bits(a->regmap, ACCDET_IRQ_STS, clr);
+	regmap_read_poll_timeout(a->regmap, ACCDET_IRQ_STS, v, !(v & sts),
+				 10, 2000);
+	regmap_clear_bits(a->regmap, ACCDET_IRQ_STS, clr);
+	regmap_write(a->regmap, AUD_TOP_INT_STATUS0, top);
+}
+
+static void accdet_report(struct mt6358_accdet *a, int status)
+{
+	if (status == a->status)
+		return;
+	a->status = status;
+	dev_dbg(a->dev, "jack %#x\n", status);
+	if (a->jack)
+		snd_soc_jack_report(a->jack, status, JACK_MASK);
+}
+
+/* the sequencer and the state debounces, before each detection */
+static void accdet_init(struct mt6358_accdet *a)
+{
+	regmap_set_bits(a->regmap, ACCDET_CTRL, ACCDET_SEQ_INIT);
+	mdelay(2);
+	regmap_clear_bits(a->regmap, ACCDET_CTRL, ACCDET_SEQ_INIT);
+	mdelay(1);
+	regmap_write(a->regmap, ACCDET_DEBOUNCE0, a->pwm_deb[4]);
+	regmap_write(a->regmap, ACCDET_DEBOUNCE1, a->pwm_deb[5]);
+	regmap_write(a->regmap, ACCDET_DEBOUNCE3, a->pwm_deb[6]);
+	regmap_write(a->regmap, ACCDET_DEBOUNCE4, a->pwm_deb[7]);
+}
+
+static void accdet_plug(struct mt6358_accdet *a, bool in)
+{
+	if (in) {
+		accdet_init(a);
+		regmap_set_bits(a->regmap, ACCDET_STATE_SWCTRL,
+				ACCDET_PWM_IDLE | ACCDET_EINT0_PWM_IDLE |
+				ACCDET_PWM_EN);
+		regmap_set_bits(a->regmap, ACCDET_CTRL, ACCDET_ENABLE);
+		return;
+	}
+	regmap_clear_bits(a->regmap, ACCDET_STATE_SWCTRL, ACCDET_PWM_IDLE);
+	accdet_clear_irq(a, ACCDET_IRQ_CLR, ACCDET_IRQ, INT_STATUS_ACCDET);
+	regmap_clear_bits(a->regmap, ACCDET_CTRL, ACCDET_ENABLE);
+	regmap_clear_bits(a->regmap, ACCDET_STATE_SWCTRL, ACCDET_PWM_EN);
+	accdet_report(a, 0);
+}
+
+/* EINT0: the plug, level triggered; the polarity follows the state */
+static irqreturn_t accdet_eint_irq(int irq, void *data)
+{
+	struct mt6358_accdet *a = data;
+	bool active_low = a->eint_pol == IRQ_TYPE_LEVEL_LOW;
+
+	mutex_lock(&a->lock);
+	a->plugged = !a->plugged;
+	regmap_update_bits(a->regmap, ACCDET_IRQ_STS, ACCDET_EINT0_IRQ_POL,
+			   a->plugged == active_low ? ACCDET_EINT0_IRQ_POL : 0);
+	accdet_clear_irq(a, ACCDET_EINT0_IRQ_CLR, ACCDET_EINT0_IRQ,
+			 INT_STATUS_ACCDET_EINT0);
+	regmap_update_bits(a->regmap, ACCDET_EINT0_CTL, EINT0_DEB_MASK,
+			   a->plugged ? EINT0_DEB_IN_256MS : EINT0_DEB_OUT_12MS);
+	dev_dbg(a->dev, "plug %s\n", a->plugged ? "in" : "out");
+	accdet_plug(a, a->plugged);
+	mutex_unlock(&a->lock);
+	return IRQ_HANDLED;
+}
+
+/* ACCDET: the comparator's state changed */
+static irqreturn_t accdet_irq(int irq, void *data)
+{
+	struct mt6358_accdet *a = data;
+	u32 v;
+	int ab;
+
+	mutex_lock(&a->lock);
+	accdet_clear_irq(a, ACCDET_IRQ_CLR, ACCDET_IRQ, INT_STATUS_ACCDET);
+	regmap_read(a->regmap, ACCDET_STATE_RG, &v);
+	ab = (v >> ACCDET_AB_SFT) & ACCDET_AB_MASK;
+	if (!a->plugged)
+		goto out;
+	switch (ab) {
+	case AB_HEADSET:
+		accdet_report(a, SND_JACK_HEADSET);
+		/* buttons: debounce the press shorter, the plug-out longer */
+		regmap_write(a->regmap, ACCDET_DEBOUNCE0, a->pwm_deb[4] >> 1);
+		regmap_write(a->regmap, ACCDET_DEBOUNCE3, a->pwm_deb[6] * 30);
+		break;
+	case AB_HEADPHONES:
+		if (a->status & SND_JACK_MICROPHONE)
+			accdet_report(a, SND_JACK_HEADSET | SND_JACK_BTN_0);
+		else
+			accdet_report(a, SND_JACK_HEADPHONE);
+		break;
+	default:
+		break;
+	}
+out:
+	mutex_unlock(&a->lock);
+	return IRQ_HANDLED;
+}
+
+static void accdet_init_once(struct mt6358_accdet *a)
+{
+	struct regmap *r = a->regmap;
+
+	regmap_write(r, AUD_TOP_RST_CON0, ACCDET_RST);
+	regmap_write(r, AUD_TOP_RST_CON0, 0);
+	regmap_write(r, ACCDET_PWM_WIDTH, a->pwm_deb[0] - 1);
+	regmap_write(r, ACCDET_PWM_THRESH, a->pwm_deb[1] - 1);
+	regmap_write(r, ACCDET_EN_DELAY_NUM, a->pwm_deb[2] << 15 | a->pwm_deb[3]);
+	regmap_set_bits(r, AUDENC_ANA_CON10,
+			a->mic_vol << MICBIAS1_VREF_SFT | MICBIAS1_LOWP_EN);
+	if (a->mic_mode == 1) {
+		regmap_set_bits(r, AUDENC_ANA_CON11, ACCDET_MODE1);
+	} else {
+		regmap_set_bits(r, AUDENC_ANA_CON11, ACCDET_MODE2);
+		if (a->mic_mode == 6)
+			regmap_set_bits(r, AUDENC_ANA_CON10, MICBIAS1_DCSW1PEN);
+	}
+	if (a->eint_pol == IRQ_TYPE_LEVEL_LOW)
+		regmap_set_bits(r, AUDENC_ANA_CON6,
+				FSTDSCHRG_IMPR_EN | FSTDSCHRG_ANALOG_DIR_EN);
+	else
+		regmap_update_bits(r, AUDENC_ANA_CON6, 0xff, 0xe0);
+	/* software mode: EINT0 starts the detection, not the hardware */
+	regmap_update_bits(r, ACCDET_HW_MODE_DFF,
+			   ACCDET_HWMODE_SEL | ACCDET_FAST_DISCHARGE,
+			   ACCDET_FAST_DISCHARGE);
+	regmap_update_bits(r, ACCDET_EINT0_CTL,
+			   EINT0_PWM_THRESH_MASK | EINT0_PWM_WIDTH_MASK,
+			   EINT0_PWM_THRESH | EINT0_PWM_WIDTH);
+	regmap_set_bits(r, ACCDET_STATE_SWCTRL,
+			ACCDET_EINT0_PWM_EN | ACCDET_EINT0_PWM_IDLE);
+	regmap_set_bits(r, ACCDET_CTRL, ACCDET_EINT0_EN);
+}
+
+int mt6358_accdet_enable_jack_detect(struct snd_soc_component *component,
+				     struct snd_soc_jack *jack)
+{
+	struct mt6358_accdet *a = snd_soc_component_get_drvdata(component);
+
+	snd_jack_set_key(jack->jack, SND_JACK_BTN_0, KEY_PLAYPAUSE);
+	mutex_lock(&a->lock);
+	a->jack = jack;
+	snd_soc_jack_report(jack, a->status, JACK_MASK);
+	mutex_unlock(&a->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6358_accdet_enable_jack_detect);
+
+static const struct snd_soc_component_driver mt6358_accdet_component = {
+	.name = "mt6358-accdet",
+};
+
+static int mt6358_accdet_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	static const u32 pwm_deb[8] = {
+		0x500, 0x500, 0x1, 0x1f0, 0x800, 0x800, 0x20, 0x44,
+	};
+	struct mt6358_accdet *a;
+	int irq, eint, ret;
+
+	a = devm_kzalloc(dev, sizeof(*a), GFP_KERNEL);
+	if (!a)
+		return -ENOMEM;
+	a->dev = dev;
+	a->regmap = ((struct mt6397_chip *)dev_get_drvdata(dev->parent))->regmap;
+	mutex_init(&a->lock);
+	platform_set_drvdata(pdev, a);
+
+	a->mic_vol = 6;
+	a->mic_mode = 1;
+	a->eint_pol = IRQ_TYPE_LEVEL_LOW;
+	memcpy(a->pwm_deb, pwm_deb, sizeof(pwm_deb));
+	of_property_read_u32(np, "mediatek,mic-vol", &a->mic_vol);
+	of_property_read_u32(np, "mediatek,mic-mode", &a->mic_mode);
+	of_property_read_u32(np, "mediatek,eint-level-pol", &a->eint_pol);
+	of_property_read_u32_array(np, "mediatek,pwm-deb-setting", a->pwm_deb,
+				   ARRAY_SIZE(a->pwm_deb));
+
+	irq = platform_get_irq_byname(pdev, "accdet");
+	if (irq < 0)
+		return irq;
+	eint = platform_get_irq_byname(pdev, "accdet-eint0");
+	if (eint < 0)
+		return eint;
+
+	accdet_init_once(a);
+
+	ret = devm_request_threaded_irq(dev, irq, NULL, accdet_irq,
+					IRQF_ONESHOT, "mt6358-accdet", a);
+	if (!ret)
+		ret = devm_request_threaded_irq(dev, eint, NULL,
+						accdet_eint_irq, IRQF_ONESHOT,
+						"mt6358-accdet-eint0", a);
+	if (ret)
+		return ret;
+
+	return devm_snd_soc_register_component(dev, &mt6358_accdet_component,
+					       NULL, 0);
+}
+
+static const struct of_device_id mt6358_accdet_of_match[] = {
+	{ .compatible = "mediatek,mt6358-accdet" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6358_accdet_of_match);
+
+static struct platform_driver mt6358_accdet_driver = {
+	.driver = {
+		.name = "mt6358-accdet",
+		.of_match_table = mt6358_accdet_of_match,
+	},
+	.probe = mt6358_accdet_probe,
+};
+module_platform_driver(mt6358_accdet_driver);
+
+MODULE_DESCRIPTION("MT6358 accessory (jack) detection");
+MODULE_LICENSE("GPL");
