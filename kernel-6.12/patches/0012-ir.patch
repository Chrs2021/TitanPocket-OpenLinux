index 0000000000000000000000000000000000000000..7e7ea84be33eb7356c0081f5a91fdb96f865bfe1
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/irled/mediatek,mt6771-pwm-ir.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/irled/mediatek,mt6771-pwm-ir.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek PWM memory-mode IR transmitter
+
+maintainers:
+  - Unihertz Titan Pocket port
+
+description:
+  An IR LED on channel 0 of the MediaTek PWM block, driven from the PWM's
+  memory mode, which plays a bitstream from memory so the hardware times
+  the signal. The node takes the whole PWM block.
+
+properties:
+  compatible:
+    const: mediatek,mt6771-pwm-ir
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 3
+
+  clock-names:
+    items:
+      - const: top
+      - const: main
+      - const: pwm1
+
+  led-supply:
+    description: Supply of the IR LED, enabled only while transmitting
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+additionalProperties: false
