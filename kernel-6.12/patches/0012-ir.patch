 .../bindings/pwm/mediatek,mt2712-pwm.yaml     |   1 +
 drivers/media/rc/Kconfig                      |  13 ++
 drivers/media/rc/Makefile                     |   1 +
 drivers/media/rc/mtk-pwm-ir-tx.c              | 219 ++++++++++++++++++
 5 files changed, 276 insertions(+)

diff --git a/Documentation/devicetree/bindings/leds/irled/mediatek,mt6771-pwm-ir.yaml b/Documentation/devicetree/bindings/leds/irled/mediatek,mt6771-pwm-ir.yaml
