diff --git a/drivers/media/rc/mtk-pwm-ir-tx.c b/drivers/media/rc/mtk-pwm-ir-tx.c
new file mode 100644
index 0000000000000000000000000000000000000000..a0de0ed7b68501fd7b54269ea44f2361a9ddd22a
--- /dev/null
+++ b/drivers/media/rc/mtk-pwm-ir-tx.c
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * IR transmitter on the MediaTek PWM block's memory mode (MT6771)
+ *
+ * The PWM plays a bitstream from memory, one bit per HDURATION/LDURATION
+ * clocks of 26 MHz, so the hardware times every mark and space. A carrier
+ * period is PWM_IR_BITS_PER_PERIOD bits: a mark repeats "high bits, then
+ * low bits" for its length, a space is zero bits.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <media/rc-core.h>
+
+#define DRIVER_NAME	"mtk-pwm-ir-tx"
+
+#define PWM_EN			0x000
+#define PWM_CK_26M_SEL		0x210
+
+/* PWM channel 0 (PWM1 in MediaTek's numbering) */
+#define PWM_CON			0x010
+#define  PWM_CON_SRCSEL_MEM	BIT(5)
+#define  PWM_CON_STOP_BITS(n)	((n) << 9)
+#define PWM_HDURATION		0x014
+#define PWM_LDURATION		0x018
+#define PWM_GDURATION		0x01c
+#define PWM_BUF0_BASE_ADDR	0x020
+#define PWM_BUF0_SIZE		0x024
+#define PWM_WAVE_NUM		0x038
+#define PWM_BUF_BASE_ADDR2	0x04c
+
+#define PWM_IR_CLK		26000000
+#define PWM_IR_BITS_PER_PERIOD	3
+/* BUF0_SIZE is 16 bits, in words minus one */
+#define PWM_IR_MAX_WORDS	65536
+
+struct mtk_pwm_ir {
+	struct device *dev;
+	void __iomem *base;
+	struct clk_bulk_data clks[3];
+	struct regulator *led_supply;
+	u32 carrier;
+	u32 duty_cycle;
+};
+
+static int mtk_pwm_ir_set_duty_cycle(struct rc_dev *rc, u32 duty_cycle)
+{
+	struct mtk_pwm_ir *ir = rc->priv;
+
+	ir->duty_cycle = duty_cycle;
+
+	return 0;
+}
+
+static int mtk_pwm_ir_set_carrier(struct rc_dev *rc, u32 carrier)
+{
+	struct mtk_pwm_ir *ir = rc->priv;
+	u32 bitclk;
+
+	if (!carrier)
+		return -EINVAL;
+
+	bitclk = DIV_ROUND_CLOSEST(PWM_IR_CLK, carrier * PWM_IR_BITS_PER_PERIOD);
+	if (bitclk < 2 || bitclk > 0x10000)
+		return -EINVAL;
+
+	ir->carrier = carrier;
+
+	return 0;
+}
+
+static int mtk_pwm_ir_tx(struct rc_dev *rc, unsigned int *txbuf,
+			 unsigned int count)
+{
+	struct mtk_pwm_ir *ir = rc->priv;
+	u32 bitclk = DIV_ROUND_CLOSEST(PWM_IR_CLK,
+				       ir->carrier * PWM_IR_BITS_PER_PERIOD);
+	u32 high = clamp_t(u32, DIV_ROUND_CLOSEST(ir->duty_cycle *
+						  PWM_IR_BITS_PER_PERIOD, 100),
+			   1, PWM_IR_BITS_PER_PERIOD - 1);
+	u64 bit_div = (u64)bitclk * USEC_PER_SEC, total_us = 0, t = 0;
+	u64 start = 0, end, b;
+	unsigned int i, words;
+	dma_addr_t dma;
+	__le32 *buf;
+	int ret;
+
+	for (i = 0; i < count; i++)
+		total_us += txbuf[i];
+
+	/* one zero word more, so the stream ends low */
+	words = DIV_ROUND_UP_ULL(DIV_ROUND_CLOSEST_ULL(total_us * PWM_IR_CLK,
+						       bit_div), 32) + 1;
+	if (words > PWM_IR_MAX_WORDS)
+		return -EINVAL;
+
+	buf = dma_alloc_coherent(ir->dev, words * 4, &dma, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	/* edges at absolute bit positions, so rounding doesn't accumulate */
+	for (i = 0; i < count; i++) {
+		t += txbuf[i];
+		end = DIV_ROUND_CLOSEST_ULL(t * PWM_IR_CLK, bit_div);
+		if (!(i & 1))
+			for (b = start; b < end; b++)
+				if ((b - start) % PWM_IR_BITS_PER_PERIOD < high)
+					buf[b / 32] |= cpu_to_le32(BIT(b % 32));
+		start = end;
+	}
+
+	ret = regulator_enable(ir->led_supply);
+	if (ret)
+		goto free;
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(ir->clks), ir->clks);
+	if (ret)
+		goto led_off;
+
+	writel(1, ir->base + PWM_CK_26M_SEL);
+	writel(PWM_CON_SRCSEL_MEM | PWM_CON_STOP_BITS(31), ir->base + PWM_CON);
+	writel(bitclk - 1, ir->base + PWM_HDURATION);
+	writel(bitclk - 1, ir->base + PWM_LDURATION);
+	writel(0, ir->base + PWM_GDURATION);
+	writel(lower_32_bits(dma), ir->base + PWM_BUF0_BASE_ADDR);
+	writel(upper_32_bits(dma) & 0xf, ir->base + PWM_BUF_BASE_ADDR2);
+	writel(words - 1, ir->base + PWM_BUF0_SIZE);
+	writel(1, ir->base + PWM_WAVE_NUM);
+	writel(readl(ir->base + PWM_EN) | BIT(0), ir->base + PWM_EN);
+
+	fsleep(DIV_ROUND_UP_ULL((u64)words * 32 * bit_div, PWM_IR_CLK));
+
+	writel(readl(ir->base + PWM_EN) & ~BIT(0), ir->base + PWM_EN);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(ir->clks), ir->clks);
+	ret = count;
+led_off:
+	regulator_disable(ir->led_supply);
+free:
+	dma_free_coherent(ir->dev, words * 4, buf, dma);
+
+	return ret;
+}
+
+static int mtk_pwm_ir_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mtk_pwm_ir *ir;
+	struct rc_dev *rc;
+	int ret;
+
+	ir = devm_kzalloc(dev, sizeof(*ir), GFP_KERNEL);
+	if (!ir)
+		return -ENOMEM;
+
+	ir->dev = dev;
+	ir->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ir->base))
+		return PTR_ERR(ir->base);
+
+	ir->clks[0].id = "top";
+	ir->clks[1].id = "main";
+	ir->clks[2].id = "pwm1";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(ir->clks), ir->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	ir->led_supply = devm_regulator_get(dev, "led");
+	if (IS_ERR(ir->led_supply))
+		return dev_err_probe(dev, PTR_ERR(ir->led_supply),
+				     "failed to get LED supply\n");
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	ir->carrier = 38000;
+	ir->duty_cycle = 33;
+
+	rc = devm_rc_allocate_device(dev, RC_DRIVER_IR_RAW_TX);
+	if (!rc)
+		return -ENOMEM;
+
+	rc->priv = ir;
+	rc->driver_name = DRIVER_NAME;
+	rc->device_name = "MediaTek PWM IR Transmitter";
+	rc->tx_ir = mtk_pwm_ir_tx;
+	rc->s_tx_carrier = mtk_pwm_ir_set_carrier;
+	rc->s_tx_duty_cycle = mtk_pwm_ir_set_duty_cycle;
+
+	ret = devm_rc_register_device(dev, rc);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register rc device\n");
+
+	return 0;
+}
+
+static const struct of_device_id mtk_pwm_ir_of_match[] = {
+	{ .compatible = "mediatek,mt6771-pwm-ir" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_pwm_ir_of_match);
+
+static struct platform_driver mtk_pwm_ir_driver = {
+	.probe = mtk_pwm_ir_probe,
+	.driver = {
+		.name = DRIVER_NAME,
+		.of_match_table = mtk_pwm_ir_of_match,
+	},
+};
+module_platform_driver(mtk_pwm_ir_driver);
+
+MODULE_DESCRIPTION("MediaTek PWM memory-mode IR transmitter");
+MODULE_LICENSE("GPL");
