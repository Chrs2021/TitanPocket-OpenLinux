From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Topher Campbell <chrs2021@gmail.com>
Subject: [PATCH 09/16] pinctrl: aw9523, Input: matrix_keypad: fix locking for I2C expanders

pinctrl-aw9523 deferred interrupt mask writes by putting the whole
regmap in cache-only mode while the GPIO calls kept using it under
another lock: reads failed (gpio-matrix-keypad took that for a pressed
key) and writes stayed in the cache. Keep a shadow of the mask registers
and write it under i2c_lock instead. matrix_keypad enabled and disabled
the row interrupts under its spinlock, which an I2C expander's irq chip
cannot allow (its bus lock is a mutex).
---
 drivers/input/keyboard/matrix_keypad.c | 71 ++++++++++++++++---
 drivers/pinctrl/pinctrl-aw9523.c       | 94 ++++++++++++++++++++------
 2 files changed, 136 insertions(+), 29 deletions(-)

diff --git a/drivers/input/keyboard/matrix_keypad.c b/drivers/input/keyboard/matrix_keypad.c
index 3c38bae576edd69a31f785066668414a02529f64..ed3f0177f71dcb7622ece7da2630d828b2d74dd3 100644
--- a/drivers/input/keyboard/matrix_keypad.c
+++ b/drivers/input/keyboard/matrix_keypad.c
@@ -104,6 +104,32 @@ static void disable_row_irqs(struct matrix_keypad *keypad)
 /*
  * This gets the keys from keyboard and reports it to input subsystem
  */
+/* how often a scan repeats while any key is held (see matrix_keypad_scan) */
+#define MATRIX_POLL_MS	20
+
+static irqreturn_t matrix_keypad_interrupt(int irq, void *id);
+
+static bool keys_held(struct matrix_keypad *keypad, const uint32_t *state)
+{
+	int col;
+
+	for (col = 0; col < keypad->num_col_gpios; col++)
+		if (state[col])
+			return true;
+	return false;
+}
+
+/* any row asserted, with all columns active (between scans) */
+static bool rows_asserted(struct matrix_keypad *keypad)
+{
+	int row;
+
+	for (row = 0; row < keypad->num_row_gpios; row++)
+		if (row_asserted(keypad, row))
+			return true;
+	return false;
+}
+
 static void matrix_keypad_scan(struct work_struct *work)
 {
 	struct matrix_keypad *keypad =
@@ -157,11 +183,39 @@ static void matrix_keypad_scan(struct work_struct *work)
 
 	activate_all_cols(keypad, true);
 
-	/* Enable IRQs again */
+	/*
+	 * While a key is held, scan again on a timer instead of waiting for a
+	 * row interrupt. On an I2C expander (AW9523) a scan takes tens of
+	 * milliseconds with the rows masked, and a key released in that window
+	 * raised no interrupt: its release was never reported, so the desktop
+	 * (which does the key repeat) repeated it until another key was pressed.
+	 * The rows stay masked while polling; the scan that finds all keys up
+	 * enables them once, which balances the one disable that started it.
+	 * Once stopped, leave the IRQs enabled for matrix_keypad_stop().
+	 */
 	spin_lock_irq(&keypad->lock);
+	if (!keypad->stopped && keys_held(keypad, new_state)) {
+		spin_unlock_irq(&keypad->lock);
+		schedule_delayed_work(&keypad->work, msecs_to_jiffies(MATRIX_POLL_MS));
+		return;
+	}
 	keypad->scan_pending = false;
-	enable_row_irqs(keypad);
 	spin_unlock_irq(&keypad->lock);
+
+	/*
+	 * Enable IRQs again, outside the lock: for rows on an I2C expander
+	 * (AW9523) enable_irq() takes the irq chip's bus lock, a mutex. An
+	 * interrupt from a row already enabled disables all rows once and
+	 * schedules a scan, which enables them all once: the depths balance.
+	 */
+	enable_row_irqs(keypad);
+
+	/*
+	 * A key pressed between this scan's reads and the rows' interrupts
+	 * coming back raised none: look once, and scan if a row is asserted.
+	 */
+	if (!keypad->stopped && rows_asserted(keypad))
+		matrix_keypad_interrupt(0, keypad);
 }
 
 static irqreturn_t matrix_keypad_interrupt(int irq, void *id)
@@ -176,16 +230,17 @@ static irqreturn_t matrix_keypad_interrupt(int irq, void *id)
 	 * scan already. In that case we should not try to
 	 * disable IRQs again.
 	 */
-	if (unlikely(keypad->scan_pending || keypad->stopped))
-		goto out;
+	if (unlikely(keypad->scan_pending || keypad->stopped)) {
+		spin_unlock_irqrestore(&keypad->lock, flags);
+		return IRQ_HANDLED;
+	}
+	keypad->scan_pending = true;
+	spin_unlock_irqrestore(&keypad->lock, flags);
 
+	/* outside the lock, as in matrix_keypad_scan() */
 	disable_row_irqs(keypad);
-	keypad->scan_pending = true;
 	schedule_delayed_work(&keypad->work,
 			      msecs_to_jiffies(keypad->debounce_ms));
-
-out:
-	spin_unlock_irqrestore(&keypad->lock, flags);
 	return IRQ_HANDLED;
 }
 
diff --git a/drivers/pinctrl/pinctrl-aw9523.c b/drivers/pinctrl/pinctrl-aw9523.c
index 1374f30166bc3b679b5c7e418f4848e7ca1cf40a..ef331675474437c6cd152e0ccd5ea5e2435cb489 100644
--- a/drivers/pinctrl/pinctrl-aw9523.c
+++ b/drivers/pinctrl/pinctrl-aw9523.c
@@ -62,6 +62,8 @@
 struct aw9523_irq {
 	struct mutex lock;
 	u16 cached_gpio;
+	u16 disabled;	/* INTR_DIS bits, written at bus_sync_unlock */
+	u16 hw_disabled;	/* INTR_DIS bits as last written to the chip */
 };
 
 /*
@@ -428,10 +430,8 @@ static void aw9523_irq_mask(struct irq_data *d)
 {
 	struct aw9523 *awi = gpiochip_get_data(irq_data_get_irq_chip_data(d));
 	irq_hw_number_t hwirq = irqd_to_hwirq(d);
-	unsigned int n = hwirq % AW9523_PINS_PER_PORT;
 
-	regmap_update_bits(awi->regmap, AW9523_REG_INTR_DIS(hwirq),
-			   BIT(n), BIT(n));
+	awi->irq->disabled |= BIT(hwirq);
 	gpiochip_disable_irq(&awi->gpio, hwirq);
 }
 
@@ -446,33 +446,54 @@ static void aw9523_irq_unmask(struct irq_data *d)
 {
 	struct aw9523 *awi = gpiochip_get_data(irq_data_get_irq_chip_data(d));
 	irq_hw_number_t hwirq = irqd_to_hwirq(d);
-	unsigned int n = hwirq % AW9523_PINS_PER_PORT;
 
 	gpiochip_enable_irq(&awi->gpio, hwirq);
-	regmap_update_bits(awi->regmap, AW9523_REG_INTR_DIS(hwirq),
-			   BIT(n), 0);
+	awi->irq->disabled &= ~BIT(hwirq);
 }
 
-static irqreturn_t aw9523_irq_thread_func(int irq, void *dev_id)
+/* Both ports' input state into *val; reading it releases INTN. Under i2c_lock. */
+static int aw9523_read_inputs(struct aw9523 *awi, unsigned long *val)
 {
-	struct aw9523 *awi = (struct aw9523 *)dev_id;
-	unsigned long n, val = 0;
-	unsigned long changed_gpio;
-	unsigned int tmp, port_pin, i, ret;
+	unsigned int tmp, port_pin, i;
+	int ret;
 
+	*val = 0;
 	for (i = 0; i < AW9523_NUM_PORTS; i++) {
 		port_pin = i * AW9523_PINS_PER_PORT;
-		ret = regmap_read(awi->regmap,
-				  AW9523_REG_IN_STATE(port_pin),
-				  &tmp);
+		ret = regmap_read(awi->regmap, AW9523_REG_IN_STATE(port_pin), &tmp);
 		if (ret)
 			return ret;
-		val |= (u8)tmp << (i * 8);
+		*val |= (u8)tmp << (i * 8);
 	}
+	return 0;
+}
 
-	/* Handle GPIO input release interrupt as well */
+static irqreturn_t aw9523_irq_thread_func(int irq, void *dev_id)
+{
+	struct aw9523 *awi = (struct aw9523 *)dev_id;
+	unsigned long n, val = 0;
+	unsigned long changed_gpio;
+	unsigned int tmp;
+	int ret;
+
+	/*
+	 * Reading the input state releases INTN: if a read failed, INTN
+	 * would stay low. Under i2c_lock like every other register access
+	 * (the regmap has no locking of its own).
+	 */
+	mutex_lock(&awi->i2c_lock);
+	ret = aw9523_read_inputs(awi, &val);
+	if (ret) {
+		mutex_unlock(&awi->i2c_lock);
+		return IRQ_NONE;
+	}
+	/*
+	 * Handle GPIO input release interrupt as well. The cache is updated
+	 * under i2c_lock, as aw9523_irq_bus_sync_unlock() refreshes it there.
+	 */
 	changed_gpio = awi->irq->cached_gpio ^ val;
 	awi->irq->cached_gpio = val;
+	mutex_unlock(&awi->i2c_lock);
 
 	/*
 	 * To avoid up to four *slow* i2c reads from any driver hooked
@@ -499,7 +520,6 @@ static void aw9523_irq_bus_lock(struct irq_data *d)
 	struct aw9523 *awi = gpiochip_get_data(irq_data_get_irq_chip_data(d));
 
 	mutex_lock(&awi->irq->lock);
-	regcache_cache_only(awi->regmap, true);
 }
 
 /*
@@ -512,9 +532,36 @@ static void aw9523_irq_bus_lock(struct irq_data *d)
 static void aw9523_irq_bus_sync_unlock(struct irq_data *d)
 {
 	struct aw9523 *awi = gpiochip_get_data(irq_data_get_irq_chip_data(d));
+	u16 dis = awi->irq->disabled;
+
+	/*
+	 * Not through regcache_cache_only() and regcache_sync(): that put
+	 * the whole regmap in cache-only mode, while the GPIO calls (under
+	 * i2c_lock) went on using it. Their reads failed (-EBUSY, which
+	 * gpio-matrix-keypad took for a pressed key) and their writes
+	 * stayed in the cache; regcache_sync() then skipped any register
+	 * back at its default, so the keyboard's columns were left driven
+	 * high and no key raised an interrupt (measured on the Titan Pocket).
+	 */
+	u16 unmasked = awi->irq->hw_disabled & ~dis;
+	unsigned long val;
 
-	regcache_cache_only(awi->regmap, false);
-	regcache_sync(awi->regmap);
+	mutex_lock(&awi->i2c_lock);
+	regmap_update_bits(awi->regmap, AW9523_REG_INTR_DIS(0), U8_MAX, dis & U8_MAX);
+	regmap_update_bits(awi->regmap, AW9523_REG_INTR_DIS(AW9523_PINS_PER_PORT),
+			   U8_MAX, dis >> 8);
+	awi->irq->hw_disabled = dis;
+	/*
+	 * The cache only follows changes seen while a pin was unmasked. One
+	 * that came while it was masked (a key released during a keypad scan)
+	 * left it stale, and the next change back looked like no change: the
+	 * next press of that key was lost. Take the pins just unmasked from
+	 * the chip, so their next change is measured from the real state.
+	 */
+	if (unmasked && !aw9523_read_inputs(awi, &val))
+		awi->irq->cached_gpio = (awi->irq->cached_gpio & ~unmasked) |
+					(val & unmasked);
+	mutex_unlock(&awi->i2c_lock);
 	mutex_unlock(&awi->irq->lock);
 }
 
@@ -542,8 +589,11 @@ static int aw9523_gpio_get(struct gpio_chip *chip, unsigned int offset)
 	mutex_lock(&awi->i2c_lock);
 	ret = aw9523_get_port_state(awi->regmap, offset, regbit, &val);
 	mutex_unlock(&awi->i2c_lock);
-	if (ret)
+	if (ret) {
+		dev_warn_ratelimited(awi->dev, "reading gpio%u failed: %d\n",
+				     offset, ret);
 		return ret;
+	}
 
 	return !!(val & BIT(regbit));
 }
@@ -814,6 +864,8 @@ static int aw9523_init_irq(struct aw9523 *awi, int irq)
 		return -ENOMEM;
 
 	mutex_init(&awi->irq->lock);
+	awi->irq->disabled = U16_MAX;	/* as aw9523_hw_init() leaves them */
+	awi->irq->hw_disabled = U16_MAX;
 
 	ret = devm_request_threaded_irq(dev, irq, NULL, aw9523_irq_thread_func,
 					IRQF_ONESHOT, dev_name(dev), awi);
@@ -825,7 +877,7 @@ static int aw9523_init_irq(struct aw9523 *awi, int irq)
 	girq->parent_handler = NULL;
 	girq->num_parents = 0;
 	girq->parents = NULL;
-	girq->default_type = IRQ_TYPE_EDGE_BOTH;
+	girq->default_type = IRQ_TYPE_NONE;
 	girq->handler = handle_simple_irq;
 	girq->threaded = true;
 
