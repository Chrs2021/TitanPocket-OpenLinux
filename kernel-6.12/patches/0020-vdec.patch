+/* ---- queues ---- */
+
+static int tvdec_queue_setup(struct vb2_queue *vq, unsigned int *nbufs, unsigned int *nplanes,
+			     unsigned int sizes[], struct device *alloc_devs[])
+{
+	struct tvdec_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_pix_format_mplane *f =
+		V4L2_TYPE_IS_OUTPUT(vq->type) ? &ctx->src_fmt : &ctx->dst_fmt;
+	unsigned int i;
+
+	if (*nplanes) {
+		if (*nplanes != f->num_planes)
+			return -EINVAL;
+		for (i = 0; i < f->num_planes; i++)
+			if (sizes[i] < f->plane_fmt[i].sizeimage)
+				return -EINVAL;
+		return 0;
+	}
+	*nplanes = f->num_planes;
+	for (i = 0; i < f->num_planes; i++)
+		sizes[i] = f->plane_fmt[i].sizeimage;
+	return 0;
+}
+
+static int tvdec_buf_prepare(struct vb2_buffer *vb)
+{
+	struct tvdec_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct v4l2_pix_format_mplane *f =
+		V4L2_TYPE_IS_OUTPUT(vb->type) ? &ctx->src_fmt : &ctx->dst_fmt;
+	unsigned int i;
+
+	for (i = 0; i < f->num_planes; i++)
+		if (vb2_plane_size(vb, i) < f->plane_fmt[i].sizeimage)
+			return -EINVAL;
+	if (V4L2_TYPE_IS_OUTPUT(vb->type))
+		to_vb2_v4l2_buffer(vb)->field = V4L2_FIELD_NONE;
+	return 0;
+}
+
+static void tvdec_buf_queue(struct vb2_buffer *vb)
+{
+	struct tvdec_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+}
+
+static int tvdec_buf_out_validate(struct vb2_buffer *vb)
+{
+	to_vb2_v4l2_buffer(vb)->field = V4L2_FIELD_NONE;
+	return 0;
+}
+
+static void tvdec_buf_request_complete(struct vb2_buffer *vb)
+{
+	struct tvdec_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_ctrl_request_complete(vb->req_obj.req, &ctx->hdl);
+}
+
+static void free_mv(struct tvdec_ctx *ctx)
+{
+	unsigned int i;
+
+	for (i = 0; i < VB2_MAX_FRAME; i++) {
+		if (ctx->mv[i].va)
+			dma_free_coherent(ctx->vdec->dev, ctx->mv[i].size,
+					  ctx->mv[i].va, ctx->mv[i].da);
+		ctx->mv[i].va = NULL;
+	}
+}
+
+static int tvdec_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct tvdec_ctx *ctx = vb2_get_drv_priv(q);
+	unsigned int i, n;
+
+	if (V4L2_TYPE_IS_OUTPUT(q->type))
+		return 0;
+	/* a motion vector buffer for each capture buffer: 64 bytes a MB (vendor size) */
+	ctx->mv_size = ALIGN(ctx->dst_fmt.width / 16 * (ALIGN(ctx->dst_fmt.height, 32) / 16) *
+			     64 + 0x200, PAGE_SIZE);
+	n = vb2_get_num_buffers(q);
+	for (i = 0; i < n && i < VB2_MAX_FRAME; i++) {
+		ctx->mv[i].size = ctx->mv_size;
+		ctx->mv[i].va = dma_alloc_coherent(ctx->vdec->dev, ctx->mv_size,
+						   &ctx->mv[i].da, GFP_KERNEL);
+		if (!ctx->mv[i].va) {
+			free_mv(ctx);
+			return -ENOMEM;
+		}
+	}
+	return 0;
+}
+
+static void tvdec_stop_streaming(struct vb2_queue *q)
+{
+	struct tvdec_ctx *ctx = vb2_get_drv_priv(q);
+	struct vb2_v4l2_buffer *vbuf;
+
+	flush_workqueue(ctx->vdec->wq);
+	for (;;) {
+		vbuf = V4L2_TYPE_IS_OUTPUT(q->type) ? v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx) :
+						      v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+		if (!vbuf)
+			break;
+		v4l2_ctrl_request_complete(vbuf->vb2_buf.req_obj.req, &ctx->hdl);
+		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_ERROR);
+	}
+	if (!V4L2_TYPE_IS_OUTPUT(q->type))
+		free_mv(ctx);
+}
+
+static const struct vb2_ops tvdec_qops = {
+	.queue_setup = tvdec_queue_setup,
+	.buf_prepare = tvdec_buf_prepare,
+	.buf_queue = tvdec_buf_queue,
+	.buf_out_validate = tvdec_buf_out_validate,
+	.buf_request_complete = tvdec_buf_request_complete,
+	.start_streaming = tvdec_start_streaming,
+	.stop_streaming = tvdec_stop_streaming,
+	.wait_prepare = vb2_ops_wait_prepare,
+	.wait_finish = vb2_ops_wait_finish,
+};
+
+static int queue_init(void *priv, struct vb2_queue *src, struct vb2_queue *dst)
+{
+	struct tvdec_ctx *ctx = priv;
+	int ret;
+
+	src->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	src->io_modes = VB2_MMAP | VB2_DMABUF;
+	src->drv_priv = ctx;
+	src->ops = &tvdec_qops;
+	src->mem_ops = &vb2_dma_contig_memops;
+	src->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	src->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src->lock = &ctx->vdec->vfd_lock;
+	src->dev = ctx->vdec->dev;
+	src->supports_requests = true;
+	src->requires_requests = true;
+	ret = vb2_queue_init(src);
+	if (ret)
+		return ret;
+
+	dst->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	dst->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst->drv_priv = ctx;
+	dst->ops = &tvdec_qops;
+	dst->mem_ops = &vb2_dma_contig_memops;
+	dst->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	dst->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst->lock = &ctx->vdec->vfd_lock;
+	dst->dev = ctx->vdec->dev;
+	return vb2_queue_init(dst);
+}
+
+/* ---- controls ---- */
+
+static int tvdec_try_ctrl(struct v4l2_ctrl *ctrl)
+{
+	if (ctrl->id == V4L2_CID_STATELESS_H264_SPS) {
+		const struct v4l2_ctrl_h264_sps *sps = ctrl->p_new.p_h264_sps;
+
+		if (sps->chroma_format_idc > 1 || sps->bit_depth_luma_minus8 ||
+		    sps->bit_depth_chroma_minus8)
+			return -EINVAL;
+		if ((sps->pic_width_in_mbs_minus1 + 1) * 16 > MAX_W ||
+		    (sps->pic_height_in_map_units_minus1 + 1) * 16 > MAX_H)
+			return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops tvdec_ctrl_ops = {
+	.try_ctrl = tvdec_try_ctrl,
+};
+
+static int init_ctrls(struct tvdec_ctx *ctx)
+{
+	struct v4l2_ctrl_handler *h = &ctx->hdl;
+	struct v4l2_ctrl_config sps = {
+		.ops = &tvdec_ctrl_ops, .id = V4L2_CID_STATELESS_H264_SPS,
+	};
+
+	v4l2_ctrl_handler_init(h, 6);
+	v4l2_ctrl_new_custom(h, &sps, NULL);
+	v4l2_ctrl_new_custom(h, &(struct v4l2_ctrl_config){
+		.id = V4L2_CID_STATELESS_H264_PPS }, NULL);
+	v4l2_ctrl_new_custom(h, &(struct v4l2_ctrl_config){
+		.id = V4L2_CID_STATELESS_H264_SCALING_MATRIX }, NULL);
+	v4l2_ctrl_new_custom(h, &(struct v4l2_ctrl_config){
+		.id = V4L2_CID_STATELESS_H264_DECODE_PARAMS }, NULL);
+	v4l2_ctrl_new_custom(h, &(struct v4l2_ctrl_config){
+		.id = V4L2_CID_STATELESS_H264_DECODE_MODE,
+		.min = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.max = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+		.def = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED }, NULL);
+	v4l2_ctrl_new_custom(h, &(struct v4l2_ctrl_config){
+		.id = V4L2_CID_STATELESS_H264_START_CODE,
+		.min = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.max = V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		.def = V4L2_STATELESS_H264_START_CODE_ANNEX_B }, NULL);
+	v4l2_ctrl_new_std_menu(h, NULL, V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+			       V4L2_MPEG_VIDEO_H264_PROFILE_HIGH,
+			       ~(BIT(V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE) |
+				 BIT(V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE) |
+				 BIT(V4L2_MPEG_VIDEO_H264_PROFILE_MAIN) |
+				 BIT(V4L2_MPEG_VIDEO_H264_PROFILE_HIGH)),
+			       V4L2_MPEG_VIDEO_H264_PROFILE_MAIN);
+	v4l2_ctrl_new_std_menu(h, NULL, V4L2_CID_MPEG_VIDEO_H264_LEVEL,
+			       V4L2_MPEG_VIDEO_H264_LEVEL_4_1, 0,
+			       V4L2_MPEG_VIDEO_H264_LEVEL_4_1);
+	if (h->error) {
+		int ret = h->error;
+
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+	ctx->fh.ctrl_handler = h;
+	return v4l2_ctrl_handler_setup(h);
+}
+
+/* ---- file ops ---- */
+
+static int tvdec_open(struct file *file)
+{
+	struct tvdec_dev *v = video_drvdata(file);
+	struct tvdec_ctx *ctx;
+	int ret;
+
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->vdec = v;
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+	file->private_data = &ctx->fh;
+	ret = init_ctrls(ctx);
+	if (ret)
+		goto err_fh;
+	ctx->src_fmt.width = 1280;
+	ctx->src_fmt.height = 720;
+	fill_src_fmt(&ctx->src_fmt);
+	ctx->dst_fmt.width = 1280;
+	ctx->dst_fmt.height = 720;
+	fill_dst_fmt(ctx, &ctx->dst_fmt);
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(v->m2m, ctx, queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto err_ctrl;
+	}
+	v4l2_fh_add(&ctx->fh);
+	return 0;
+
+err_ctrl:
+	v4l2_ctrl_handler_free(&ctx->hdl);
+err_fh:
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return ret;
+}
+
+static int tvdec_release(struct file *file)
+{
+	struct tvdec_ctx *ctx = fh_to_ctx(file->private_data);
+	struct tvdec_dev *v = ctx->vdec;
+
+	mutex_lock(&v->vfd_lock);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	mutex_unlock(&v->vfd_lock);
+	v4l2_fh_del(&ctx->fh);
+	v4l2_fh_exit(&ctx->fh);
+	v4l2_ctrl_handler_free(&ctx->hdl);
+	free_mv(ctx);
+	kfree(ctx);
+	return 0;
+}
+
+static const struct v4l2_file_operations tvdec_fops = {
+	.owner = THIS_MODULE,
+	.open = tvdec_open,
+	.release = tvdec_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+static const struct media_device_ops tvdec_media_ops = {
+	.req_validate = vb2_request_validate,
+	.req_queue = v4l2_m2m_request_queue,
+};
+
+/* ---- debugfs: register trace of the last decode, counters ---- */
+
+static int trace_show(struct seq_file *m, void *p)
+{
+	struct tvdec_dev *v = m->private;
+
+	if (v->tbuf)
+		seq_puts(m, v->tbuf);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(trace);
+
+static int stats_show(struct seq_file *m, void *p)
+{
+	struct tvdec_dev *v = m->private;
+
+	seq_printf(m, "frames %lu errors %lu last_err %08x last_done %08x last_us %u\n",
+		   v->frames, v->errors, v->last_err, v->last_done, v->last_us);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(stats);
+
+static int trace_on_set(void *data, u64 val)
+{
+	struct tvdec_dev *v = data;
+
+	if (val && !v->tbuf) {
+		v->tbuf = vzalloc(PAGE_SIZE * 16);
+		if (!v->tbuf)
+			return -ENOMEM;
+	}
+	v->trace = !!val;
+	return 0;
+}
+
+static int trace_on_get(void *data, u64 *val)
+{
+	*val = ((struct tvdec_dev *)data)->trace;
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(trace_on_fops, trace_on_get, trace_on_set, "%llu\n");
+
+/* ---- platform ---- */
+
+static int tvdec_runtime_resume(struct device *dev)
+{
+	struct tvdec_dev *v = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(v->clk);
+}
+
+static int tvdec_runtime_suspend(struct device *dev)
+{
+	struct tvdec_dev *v = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(v->clk);
+	return 0;
+}
+
+static const struct dev_pm_ops tvdec_pm_ops = {
+	SET_RUNTIME_PM_OPS(tvdec_runtime_suspend, tvdec_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+};
+
+static int work_alloc(struct tvdec_dev *v, struct tvdec_buf *b, size_t size)
+{
+	b->size = size;
+	b->va = dmam_alloc_coherent(v->dev, size, &b->da, GFP_KERNEL);
+	return b->va ? 0 : -ENOMEM;
+}
+
+static int tvdec_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np;
+	struct tvdec_dev *v;
+	int irq, ret;
+
+	v = devm_kzalloc(dev, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return -ENOMEM;
+	v->dev = dev;
+	mutex_init(&v->vfd_lock);
+	init_completion(&v->irq_done);
+	INIT_WORK(&v->run_work, run_work);
+	platform_set_drvdata(pdev, v);
+
+	v->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(v->regs))
+		return PTR_ERR(v->regs);
+	v->sys = syscon_regmap_lookup_by_compatible("mediatek,mt8183-vdecsys");
+	if (IS_ERR(v->sys))
+		return PTR_ERR(v->sys);
+	v->clk = devm_clk_get(dev, "vdec");
+	if (IS_ERR(v->clk))
+		return PTR_ERR(v->clk);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, tvdec_irq, 0, DRV_NAME, v);
+	if (ret)
+		return ret;
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	ret = work_alloc(v, &v->vld_work, VLD_WORK_SIZE) ?:
+	      work_alloc(v, &v->mc_a20, MC_A20_SIZE) ?:
+	      work_alloc(v, &v->mc_a24, MC_A24_SIZE);
+	if (ret)
+		return ret;
+
+	/* larb 1 powers and clocks with us */
+	np = of_parse_phandle(dev->of_node, "mediatek,larb", 0);
+	if (np) {
+		struct platform_device *larb = of_find_device_by_node(np);
+
+		of_node_put(np);
+		if (!larb || !platform_get_drvdata(larb))
+			return -EPROBE_DEFER;
+		if (!device_link_add(dev, &larb->dev, DL_FLAG_PM_RUNTIME | DL_FLAG_STATELESS))
+			return -EINVAL;
+	}
+
+	v->wq = alloc_ordered_workqueue("titan-vdec", WQ_MEM_RECLAIM);
+	if (!v->wq)
+		return -ENOMEM;
+
+	pm_runtime_set_autosuspend_delay(dev, 200);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_device_register(dev, &v->v4l2_dev);
+	if (ret)
+		goto err_pm;
+	v->m2m = v4l2_m2m_init(&tvdec_m2m_ops);
+	if (IS_ERR(v->m2m)) {
+		ret = PTR_ERR(v->m2m);
+		goto err_v4l2;
+	}
+
+	v->mdev.dev = dev;
+	strscpy(v->mdev.model, DRV_NAME, sizeof(v->mdev.model));
+	strscpy(v->mdev.bus_info, "platform:" DRV_NAME, sizeof(v->mdev.bus_info));
+	media_device_init(&v->mdev);
+	v->mdev.ops = &tvdec_media_ops;
+	v->v4l2_dev.mdev = &v->mdev;
+
+	v->vfd = (struct video_device) {
+		.fops = &tvdec_fops,
+		.ioctl_ops = &tvdec_ioctl_ops,
+		.minor = -1,
+		.release = video_device_release_empty,
+		.vfl_dir = VFL_DIR_M2M,
+		.device_caps = V4L2_CAP_STREAMING | V4L2_CAP_VIDEO_M2M_MPLANE,
+		.lock = &v->vfd_lock,
+		.v4l2_dev = &v->v4l2_dev,
+	};
+	strscpy(v->vfd.name, DRV_NAME, sizeof(v->vfd.name));
+	video_set_drvdata(&v->vfd, v);
+	ret = video_register_device(&v->vfd, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_m2m;
+	ret = v4l2_m2m_register_media_controller(v->m2m, &v->vfd,
+						 MEDIA_ENT_F_PROC_VIDEO_DECODER);
+	if (ret)
+		goto err_vfd;
+	ret = media_device_register(&v->mdev);
+	if (ret)
+		goto err_mc;
+
+	v->dbg = debugfs_create_dir("titan_vdec", NULL);
+	debugfs_create_file("trace", 0400, v->dbg, v, &trace_fops);
+	debugfs_create_file("stats", 0400, v->dbg, v, &stats_fops);
+	debugfs_create_file_unsafe("trace_on", 0600, v->dbg, v, &trace_on_fops);
+	dev_info(dev, "H.264 decoder: %s\n", video_device_node_name(&v->vfd));
+	return 0;
+
+err_mc:
+	v4l2_m2m_unregister_media_controller(v->m2m);
+err_vfd:
+	video_unregister_device(&v->vfd);
+err_m2m:
+	v4l2_m2m_release(v->m2m);
+err_v4l2:
+	v4l2_device_unregister(&v->v4l2_dev);
+err_pm:
+	pm_runtime_disable(dev);
+	destroy_workqueue(v->wq);
+	return ret;
+}
+
+static void tvdec_remove(struct platform_device *pdev)
+{
+	struct tvdec_dev *v = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(v->dbg);
+	media_device_unregister(&v->mdev);
+	v4l2_m2m_unregister_media_controller(v->m2m);
+	video_unregister_device(&v->vfd);
+	media_device_cleanup(&v->mdev);
+	v4l2_m2m_release(v->m2m);
+	v4l2_device_unregister(&v->v4l2_dev);
+	destroy_workqueue(v->wq);
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+	vfree(v->tbuf);
+}
+
+static const struct of_device_id tvdec_of_match[] = {
+	{ .compatible = "mediatek,mt6771-vdec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tvdec_of_match);
+
+static struct platform_driver tvdec_driver = {
+	.probe = tvdec_probe,
+	.remove_new = tvdec_remove,
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = tvdec_of_match,
+		.pm = &tvdec_pm_ops,
+	},
+};
+module_platform_driver(tvdec_driver);
+
+MODULE_DESCRIPTION("MT6771 H.264 stateless video decoder");
+MODULE_LICENSE("GPL");
