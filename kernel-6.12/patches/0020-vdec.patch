+/* ---- platform ---- */
+
+static int tvenc_runtime_resume(struct device *dev)
+{
+	struct tvenc_dev *v = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(v->clk);
+}
+
+static int tvenc_runtime_suspend(struct device *dev)
+{
+	struct tvenc_dev *v = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(v->clk);
+	return 0;
+}
+
+static const struct dev_pm_ops tvenc_pm_ops = {
+	SET_RUNTIME_PM_OPS(tvenc_runtime_suspend, tvenc_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+};
+
+static int tvenc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np;
+	struct tvenc_dev *v;
+	int irq, ret;
+
+	v = devm_kzalloc(dev, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return -ENOMEM;
+	v->dev = dev;
+	mutex_init(&v->vfd_lock);
+	init_completion(&v->done);
+	INIT_WORK(&v->run_work, run_work);
+	platform_set_drvdata(pdev, v);
+	v->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(v->regs))
+		return PTR_ERR(v->regs);
+	v->clk = devm_clk_get(dev, "venc");
+	if (IS_ERR(v->clk))
+		return PTR_ERR(v->clk);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, tvenc_irq, 0, DRV_NAME, v);
+	if (ret)
+		return ret;
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	/* larb 4 powers and clocks with us */
+	np = of_parse_phandle(dev->of_node, "mediatek,larb", 0);
+	if (np) {
+		struct platform_device *larb = of_find_device_by_node(np);
+
+		of_node_put(np);
+		if (!larb || !platform_get_drvdata(larb))
+			return -EPROBE_DEFER;
+		if (!device_link_add(dev, &larb->dev, DL_FLAG_PM_RUNTIME | DL_FLAG_STATELESS))
+			return -EINVAL;
+	}
+
+	v->wq = alloc_ordered_workqueue("titan-venc", WQ_MEM_RECLAIM);
+	if (!v->wq)
+		return -ENOMEM;
+	pm_runtime_set_autosuspend_delay(dev, 200);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_device_register(dev, &v->v4l2_dev);
+	if (ret)
+		goto err_pm;
+	v->m2m = v4l2_m2m_init(&tvenc_m2m_ops);
+	if (IS_ERR(v->m2m)) {
+		ret = PTR_ERR(v->m2m);
+		goto err_v4l2;
+	}
+
+	/* a media device, so the node reports itself as an encoder (MEDIA_ENT_F_PROC_VIDEO_ENCODER) */
+	v->mdev.dev = dev;
+	strscpy(v->mdev.model, DRV_NAME, sizeof(v->mdev.model));
+	strscpy(v->mdev.bus_info, "platform:" DRV_NAME, sizeof(v->mdev.bus_info));
+	media_device_init(&v->mdev);
+	v->v4l2_dev.mdev = &v->mdev;
+
+	v->vfd = (struct video_device) {
+		.fops = &tvenc_fops,
+		.ioctl_ops = &tvenc_ioctl_ops,
+		.minor = -1,
+		.release = video_device_release_empty,
+		.lock = &v->vfd_lock,
+		.v4l2_dev = &v->v4l2_dev,
+		.vfl_dir = VFL_DIR_M2M,
+		.device_caps = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING,
+	};
+	strscpy(v->vfd.name, DRV_NAME, sizeof(v->vfd.name));
+	video_set_drvdata(&v->vfd, v);
+	ret = video_register_device(&v->vfd, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_m2m;
+	ret = v4l2_m2m_register_media_controller(v->m2m, &v->vfd,
+						 MEDIA_ENT_F_PROC_VIDEO_ENCODER);
+	if (ret)
+		goto err_vfd;
+	ret = media_device_register(&v->mdev);
+	if (ret)
+		goto err_mc;
+
+	v->dbg = debugfs_create_dir("titan_venc", NULL);
+	debugfs_create_file("stats", 0444, v->dbg, v, &stats_fops);
+	dev_info(dev, "H.264 encoder on /dev/video%d\n", v->vfd.num);
+	return 0;
+
+err_mc:
+	v4l2_m2m_unregister_media_controller(v->m2m);
+err_vfd:
+	video_unregister_device(&v->vfd);
+err_m2m:
+	media_device_cleanup(&v->mdev);
+	v4l2_m2m_release(v->m2m);
+err_v4l2:
+	v4l2_device_unregister(&v->v4l2_dev);
+err_pm:
+	pm_runtime_disable(dev);
+	destroy_workqueue(v->wq);
+	return ret;
+}
+
+static void tvenc_remove(struct platform_device *pdev)
+{
+	struct tvenc_dev *v = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(v->dbg);
+	media_device_unregister(&v->mdev);
+	v4l2_m2m_unregister_media_controller(v->m2m);
+	video_unregister_device(&v->vfd);
+	media_device_cleanup(&v->mdev);
+	v4l2_m2m_release(v->m2m);
+	v4l2_device_unregister(&v->v4l2_dev);
+	/*
+	 * The driver core resumed the device for remove(); with runtime PM off
+	 * its put does not suspend it again, so do that here: a clock left
+	 * enabled stays counted, and the gate, which resets with the power
+	 * domain, would never be opened again.
+	 */
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+	if (!pm_runtime_status_suspended(&pdev->dev))
+		tvenc_runtime_suspend(&pdev->dev);
+	pm_runtime_set_suspended(&pdev->dev);
+	destroy_workqueue(v->wq);
+}
+
+static const struct of_device_id tvenc_of_match[] = {
+	{ .compatible = "mediatek,mt6771-venc" },
