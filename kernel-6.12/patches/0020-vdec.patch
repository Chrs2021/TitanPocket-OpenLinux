+/* ---- formats ---- */
+
+static void fill_dst_fmt(struct tvdec_ctx *ctx, struct v4l2_pix_format_mplane *f)
+{
+	u32 w = clamp_t(u32, ALIGN(f->width, 16), MIN_W, MAX_W);
+	u32 h = clamp_t(u32, ALIGN(f->height, 32), MIN_H, MAX_H);
+
+	f->pixelformat = V4L2_PIX_FMT_MM21;
+	f->field = V4L2_FIELD_NONE;
+	f->num_planes = 2;
+	f->width = w;
+	f->height = h;
+	f->plane_fmt[0].bytesperline = w;
+	f->plane_fmt[0].sizeimage = w * h;
+	f->plane_fmt[1].bytesperline = w;
+	f->plane_fmt[1].sizeimage = w * h / 2;
+}
+
+static void fill_src_fmt(struct v4l2_pix_format_mplane *f)
+{
+	f->pixelformat = V4L2_PIX_FMT_H264_SLICE;
+	f->field = V4L2_FIELD_NONE;
+	f->num_planes = 1;
+	f->width = clamp_t(u32, f->width, MIN_W, MAX_W);
+	f->height = clamp_t(u32, f->height, MIN_H, MAX_H);
+	f->plane_fmt[0].bytesperline = 0;
+	if (f->plane_fmt[0].sizeimage < SZ_64K)
+		f->plane_fmt[0].sizeimage = max_t(u32, SZ_1M, f->width * f->height * 3 / 4);
+	f->plane_fmt[0].sizeimage = ALIGN(f->plane_fmt[0].sizeimage + 1024, PAGE_SIZE);
+}
+
+static int vidioc_querycap(struct file *file, void *priv, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, DRV_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "MT6771 H.264 decoder", sizeof(cap->card));
+	strscpy(cap->bus_info, "platform:" DRV_NAME, sizeof(cap->bus_info));
+	return 0;
+}
+
+static int vidioc_enum_fmt_out(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_H264_SLICE;
+	return 0;
+}
+
+static int vidioc_enum_fmt_cap(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_MM21;
+	return 0;
+}
+
+static int vidioc_enum_framesizes(struct file *file, void *priv, struct v4l2_frmsizeenum *fs)
+{
+	if (fs->index || fs->pixel_format != V4L2_PIX_FMT_H264_SLICE)
+		return -EINVAL;
+	fs->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fs->stepwise.min_width = MIN_W;
+	fs->stepwise.max_width = MAX_W;
+	fs->stepwise.step_width = 16;
+	fs->stepwise.min_height = MIN_H;
+	fs->stepwise.max_height = MAX_H;
+	fs->stepwise.step_height = 16;
+	return 0;
+}
+
+static int vidioc_g_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix_mp = fh_to_ctx(priv)->src_fmt;
+	return 0;
+}
+
+static int vidioc_g_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix_mp = fh_to_ctx(priv)->dst_fmt;
+	return 0;
+}
+
+static int vidioc_try_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	fill_src_fmt(&f->fmt.pix_mp);
+	return 0;
+}
+
+static int vidioc_try_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct tvdec_ctx *ctx = fh_to_ctx(priv);
+
+	/* the capture size follows the coded size */
+	f->fmt.pix_mp.width = ctx->src_fmt.width;
+	f->fmt.pix_mp.height = ctx->src_fmt.height;
+	fill_dst_fmt(ctx, &f->fmt.pix_mp);
+	f->fmt.pix_mp.colorspace = ctx->src_fmt.colorspace;
+	f->fmt.pix_mp.xfer_func = ctx->src_fmt.xfer_func;
+	f->fmt.pix_mp.ycbcr_enc = ctx->src_fmt.ycbcr_enc;
+	f->fmt.pix_mp.quantization = ctx->src_fmt.quantization;
+	return 0;
+}
+
+static int vidioc_s_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct tvdec_ctx *ctx = fh_to_ctx(priv);
+	struct vb2_queue *vq = v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx);
+	struct vb2_queue *cq = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+
+	if (vb2_is_busy(vq) || vb2_is_busy(cq))
+		return -EBUSY;
+	vidioc_try_fmt_out(file, priv, f);
+	ctx->src_fmt = f->fmt.pix_mp;
+	ctx->dst_fmt.width = ctx->src_fmt.width;
+	ctx->dst_fmt.height = ctx->src_fmt.height;
+	fill_dst_fmt(ctx, &ctx->dst_fmt);
+	ctx->dst_fmt.colorspace = ctx->src_fmt.colorspace;
+	ctx->dst_fmt.xfer_func = ctx->src_fmt.xfer_func;
+	ctx->dst_fmt.ycbcr_enc = ctx->src_fmt.ycbcr_enc;
+	ctx->dst_fmt.quantization = ctx->src_fmt.quantization;
+	return 0;
+}
+
+static int vidioc_s_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct tvdec_ctx *ctx = fh_to_ctx(priv);
+
+	if (vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	vidioc_try_fmt_cap(file, priv, f);
+	ctx->dst_fmt = f->fmt.pix_mp;
+	return 0;
+}
