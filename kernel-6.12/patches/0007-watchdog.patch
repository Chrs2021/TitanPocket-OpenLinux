From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Topher Campbell <chrs2021@gmail.com>
Subject: [PATCH 07/15] watchdog: mtk_wdt: stop in suspend when only the kernel pings it

The bootloader leaves the watchdog running (WDOG_HW_RUNNING) and the
kernel pings it; nothing pings it while the system sleeps, so a suspend
longer than the timeout reset the phone. Stop and restart it around
suspend in that case too.
---
 drivers/watchdog/mtk_wdt.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/drivers/watchdog/mtk_wdt.c b/drivers/watchdog/mtk_wdt.c
index 91d110646e16f7c11b3bf156c2b503b238cf8c9e..a830c9196859ad8839450a1c724a6421cf0a46e1 100644
--- a/drivers/watchdog/mtk_wdt.c
+++ b/drivers/watchdog/mtk_wdt.c
@@ -469,11 +469,21 @@ static int mtk_wdt_probe(struct platform_device *pdev)
 	return 0;
 }
 
+/*
+ * Also when only the kernel pings it (left running by the bootloader,
+ * WDOG_HW_RUNNING): nothing pings it while the system sleeps.
+ */
+static bool mtk_wdt_running(struct mtk_wdt_dev *mtk_wdt)
+{
+	return watchdog_active(&mtk_wdt->wdt_dev) ||
+	       watchdog_hw_running(&mtk_wdt->wdt_dev);
+}
+
 static int mtk_wdt_suspend(struct device *dev)
 {
 	struct mtk_wdt_dev *mtk_wdt = dev_get_drvdata(dev);
 
-	if (watchdog_active(&mtk_wdt->wdt_dev))
+	if (mtk_wdt_running(mtk_wdt))
 		mtk_wdt_stop(&mtk_wdt->wdt_dev);
 
 	return 0;
@@ -483,7 +493,7 @@ static int mtk_wdt_resume(struct device *dev)
 {
 	struct mtk_wdt_dev *mtk_wdt = dev_get_drvdata(dev);
 
-	if (watchdog_active(&mtk_wdt->wdt_dev)) {
+	if (mtk_wdt_running(mtk_wdt)) {
 		mtk_wdt_start(&mtk_wdt->wdt_dev);
 		mtk_wdt_ping(&mtk_wdt->wdt_dev);
 	}
