+	/*
+	 * No memory node: the board adds one, which LK requires and rewrites
+	 * with the real layout. LK adds its own /reserved-memory entries
+	 * (ATF, TEE, framebuffer, pstore) at boot, as it does for the vendor
+	 * tree.
+	 */
+	/*
+	 * mediatek-drm tells same-type display blocks apart by these aliases:
+	 * without them both OVL_2L nodes became OVL_2L0 and both RDMAs RDMA0,
+	 * the last probed winning, so DRM drove OVL_2L1 and RDMA1 while the
+	 * routed OVL_2L0 and RDMA0 ran only as LK left them: after the display
+	 * domain's first power-off the screen stayed black (measured).
+	 */
+	aliases {
+		ovl0 = &ovl0;
+		ovl-2l0 = &ovl_2l0;
+		ovl-2l1 = &ovl_2l1;
+		rdma0 = &rdma0;
+		rdma1 = &rdma1;
+	};
+
+	chosen: chosen {
+	};
+
+	/*
+	 * Left empty for LK, which adds a static no-map entry for each of
+	 * its own reservations (mblock-N-name: ATF, TEE, SCP, SPM, the
+	 * framebuffer, pstore, ...). It checks them against the static
+	 * entries already here and stops in while(1) on an overlap, so a
+	 * region LK reserves must not be listed again (the pstore area is
+	 * given to ramoops on the command line instead; the board's
+	 * bootargs). Dynamic entries (a size, no reg) are allowed: the
+	 * vendor tree has them, and the kernel places them itself.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* the memory CONNSYS shares with the AP, as in the vendor tree */
+		consys_mem: consys-reserve-memory {
+			compatible = "mediatek,consys-reserve-memory";
+			no-map;
+			size = <0 0x200000>;
+			alignment = <0 0x200000>;
+			alloc-ranges = <0 0x40000000 0 0x80000000>;
+		};
+
+		/*
+		 * The sensor hub's DRAM FIFO (the vendor's SENS_MEM_ID, 1 MB of
+		 * reserve-memory-scp_share): the SCP is given its 32-bit address
+		 */
+		/* the SCP's log (the vendor's SCP_A_LOGGER_MEM_ID, 1.5 MB) */
+		scp_log_mem: scp-log-memory {
+			no-map;
+			size = <0 0x180000>;
+			alignment = <0 0x100000>;
+			alloc-ranges = <0 0x40000000 0 0x10000000>;
+		};
+
+		scp_sensor_mem: scp-sensor-memory {
+			no-map;
+			size = <0 0x100000>;
+			alignment = <0 0x1000000>;
+			alloc-ranges = <0 0x40000000 0 0x10000000>;
+		};
+	};
+
+	/* the MT8183's GPU OPPs; the vendor MT6771 table has the same points */
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+		opp-shared;
