diff --git a/arch/arm64/boot/dts/mediatek/mt6771-unihertz-titan-pocket.dts b/arch/arm64/boot/dts/mediatek/mt6771-unihertz-titan-pocket.dts
new file mode 100644
index 0000000000000000000000000000000000000000..de68d3b86860a46986b52de785c77b07757f4c03
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6771-unihertz-titan-pocket.dts
@@ -0,0 +1,1123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Unihertz Titan Pocket (MT6771, 720x720 DSI panel, QWERTY keyboard).
+ *
+ * Boots from the stock LK: the boot image's dtb is this one, compiled with
+ * -@ so LK can apply the dtbo partition's overlay to it
+ * (mt6771-lk-dtbo-labels.dtsi).
+ */
+
+/dts-v1/;
+#include "mt6771.dtsi"
+#include "mt6358.dtsi"
+#include "mt6771-lk-dtbo-labels.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/iio/adc/mediatek,mt6370_adc.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/mt8183-pinfunc.h>
+#include <dt-bindings/usb/pd.h>
+
+/ {
+	model = "Unihertz Titan Pocket";
+	compatible = "unihertz,titan-pocket", "mediatek,mt6771";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	/*
+	 * LK starts the command line from bootargs and stops in while(1) if
+	 * there is no /memory node; it rewrites the node's reg with the real
+	 * 6 GiB layout.
+	 *
+	 * ramoops gets LK's pstore area (mblock-10-pstore, which LK reserves
+	 * no-map) here rather than from a reserved-memory node, which LK
+	 * would reject as overlapping its own. The layout is the one 4.14
+	 * gets from LK's SRAM info block (mtk_ram_console): "pstore:address
+	 * is 0x54410000, size is 0xe0000, console_size is 0x40000,
+	 * pmsg_size is 0x10000", record and ftrace sizes at its 4 KiB
+	 * default, no ECC, so either kernel can read the other's console
+	 * after a warm reset.
+	 */
+	chosen {
+		bootargs = "console=tty0 ramoops.mem_address=0x54410000 ramoops.mem_size=0xe0000 ramoops.record_size=0x1000 ramoops.console_size=0x40000 ramoops.ftrace_size=0x1000 ramoops.pmsg_size=0x10000";
+		stdout-path = "serial0:921600n8";
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x80000000>;
+	};
+
+	/*
+	 * The keyboard: a key matrix on the AW9523 expander. Rows are its
+	 * port 0 (inputs, they raise the interrupt), columns port 1 bits
+	 * 1-6, pulled low one at a time while the others float: the scan
+	 * of the stock driver (docs/drivers/aw9523-keyboard.md), which
+	 * gpio-matrix-keypad does the same way. The keymap is the stock
+	 * kernel's table; column n here is stock column n + 1.
+	 */
+	keyboard {
+		compatible = "gpio-matrix-keypad";
+		row-gpios = <&kbd_gpio 0 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 1 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 2 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 3 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 4 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 5 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 6 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 7 GPIO_ACTIVE_LOW>;
+		col-gpios = <&kbd_gpio 9 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 10 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 11 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 12 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 13 GPIO_ACTIVE_LOW>,
+			    <&kbd_gpio 14 GPIO_ACTIVE_LOW>;
+		/* the driver takes the polarity from here, not the flags */
+		gpio-activelow;
+		debounce-delay-ms = <5>;
+		col-scan-delay-us = <100>;
+		/* as on 4.14: no kernel repeat, the desktop repeats keys */
+		linux,no-autorepeat;
+		/*
+		 * Not a wake source: titan-powerkey sends any wake that isn't the
+		 * power key straight back to sleep, so a key pressed in a pocket
+		 * only cost a resume and a suspend.
+		 */
+		linux,keymap = <
+			MATRIX_KEY(4, 1, KEY_Q)		MATRIX_KEY(3, 1, KEY_W)
+			MATRIX_KEY(2, 1, KEY_E)		MATRIX_KEY(1, 1, KEY_R)
+			MATRIX_KEY(0, 1, KEY_T)		MATRIX_KEY(0, 0, KEY_Y)
+			MATRIX_KEY(1, 0, KEY_U)		MATRIX_KEY(2, 0, KEY_I)
+			MATRIX_KEY(3, 0, KEY_O)		MATRIX_KEY(4, 0, KEY_P)
+			MATRIX_KEY(4, 2, KEY_A)		MATRIX_KEY(3, 2, KEY_S)
+			MATRIX_KEY(2, 2, KEY_D)		MATRIX_KEY(1, 2, KEY_F)
+			MATRIX_KEY(0, 2, KEY_G)		MATRIX_KEY(4, 3, KEY_H)
+			MATRIX_KEY(3, 3, KEY_J)		MATRIX_KEY(2, 3, KEY_K)
+			MATRIX_KEY(1, 3, KEY_L)		MATRIX_KEY(0, 3, KEY_BACKSPACE)
+			MATRIX_KEY(3, 4, KEY_Z)		MATRIX_KEY(2, 4, KEY_X)
+			MATRIX_KEY(1, 4, KEY_C)		MATRIX_KEY(0, 4, KEY_V)
+			MATRIX_KEY(4, 4, KEY_SPACE)	MATRIX_KEY(1, 5, KEY_B)
+			MATRIX_KEY(0, 5, KEY_N)		MATRIX_KEY(2, 5, KEY_M)
+			MATRIX_KEY(3, 5, KEY_ENTER)	MATRIX_KEY(5, 0, KEY_LEFTSHIFT)
+			MATRIX_KEY(5, 1, KEY_COMPOSE)	MATRIX_KEY(5, 2, KEY_BACK)
+			MATRIX_KEY(5, 3, KEY_APPSELECT)	MATRIX_KEY(6, 0, KEY_F13)
+			MATRIX_KEY(7, 0, KEY_RIGHTALT)
+		>;
+	};
+
+	/* machine driver: sound/soc/mediatek/mt8183/mt6771-titanpocket.c */
+	sound: sound {
+		compatible = "unihertz,titan-pocket-sound";
+		mediatek,platform = <&afe>;
+		mediatek,btcvsd = <&btcvsd>;
+		mediatek,accdet = <&mt6358accdet>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&aud_pins>;
+	};
+
+	/*
+	 * The touchscreen's power switch: GPIO 153 (vendor gpio-en-std, which
+	 * the vendor driver drives high to power the controller), fed from
+	 * VLDO28 (vendor vtouch, on by default there).
+	 */
+	touchscreen_power: regulator-touchscreen {
+		compatible = "regulator-fixed";
+		regulator-name = "touchscreen";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pctl 153 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <10000>;
+		vin-supply = <&mt6358_vldo28_reg>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touchscreen_power_pins>;
+	};
+
+	/*
+	 * GPIO 158 (the vendor tree's finger_power) switches the supply of the
+	 * keyboard touchpad and of the fingerprint sensor; the bootloader leaves
+	 * it on and nothing here claims it. Cut in deep sleep it saved under one
+	 * gauge count (1.5 mA, 2026-11-05), and as the touchpad's vdd it would
+	 * power-cycle the touchpad at every resume (200 ms): left on.
+	 */
+
+
+	/*
+	 * Vibration motor on the MT6358's VIBR LDO, at the 3.0 V the vendor
+	 * tree sets (vib_vol 11); an input force-feedback (rumble) device.
+	 */
+	haptics {
+		compatible = "regulator-haptic";
+		haptic-supply = <&mt6358_vibr_reg>;
+		min-microvolt = <3000000>;
+		max-microvolt = <3000000>;
+	};
+
+	/*
+	 * IR LED: PWM channel 0 on GPIO 90 in memory mode (the PWM block,
+	 * not the pwm0 node), powered by the MT6370's LDO at 2.8 V while
+	 * transmitting (the vendor IRTX driver's irtx_ldo).
+	 */
+	ir-tx@11006000 {
+		compatible = "mediatek,mt6771-pwm-ir";
+		reg = <0 0x11006000 0 0x1000>;
+		clocks = <&infracfg CLK_INFRA_PWM>,
+			 <&infracfg CLK_INFRA_PWM_HCLK>,
+			 <&infracfg CLK_INFRA_PWM1>;
+		clock-names = "top", "main", "pwm1";
+		pinctrl-names = "default";
+		pinctrl-0 = <&irtx_pins>;
+		led-supply = <&mt6370_ldo>;
+	};
+};
+
+/*
+ * MT6370 sub-PMIC (vendor dtbo: i2c5 0x34, PMU interrupt GPIO 10; Type-C
+ * port controller interrupt GPIO 41). Only its Type-C port is used: TCPM
+ * tells mtu3 whether a cable is there (the role switch), since the SoC's
+ * USB PHY doesn't see VBUS. The backlight node only turns the boost off
+ * and on (its settings are LK's).
+ * Sink only at 5 V and device only: no VBUS output, no PD voltage change.
+ */
+&i2c_5 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	mt6370: pmic@34 {
+		compatible = "mediatek,mt6370";
+		reg = <0x34>;
+		interrupts-extended = <&pctl 10 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		wakeup-source;
+
+		mt6370_adc: adc {
+			compatible = "mediatek,mt6370-adc";
+			#io-channel-cells = <1>;
+		};
+
+		/*
+		 * The backlight boost, dimmed by the display PWM (pwm-backlight
+		 * below): at level 0 the driver clears BL_EN, so titan-powerkey
+		 * turns the boost off with the screen. The properties are what LK
+		 * leaves (read 2026-11-02: BL_EN 0x7e, BSTCTRL 0xed, PWM 0xb4, DIM
+		 * 0x3f/0x06 = level 511); the driver only sets bits from them.
+		 */
+		mt6370_backlight: backlight {
+			compatible = "mediatek,mt6370-backlight";
+			mediatek,bled-channel-use = /bits/ 8 <15>;
+			mediatek,bled-pwm-enable;
+			mediatek,bled-pwm-hys-enable;
+			mediatek,bled-ovp-shutdown;
+			mediatek,bled-ovp-microvolt = <29000000>;
+			mediatek,bled-ocp-shutdown;
+			mediatek,bled-ocp-microamp = <1500000>;
+			max-brightness = <2048>;
+			default-brightness = <511>;
+		};
+
+		/*
+		 * The input current follows the Type-C source (TCPM's power
+		 * supply) and BC1.2; charge current and voltage come from the
+		 * battery node. The driver reads its ADC channels by index, so
+		 * all nine are listed in order. Interrupts: MT6370_IRQ_OVPCTRL_UVP_D,
+		 * MT6370_IRQ_ATTACH, MT6370_IRQ_CHG_MIVR.
+		 */
+		mt6370_charger: charger {
+			compatible = "mediatek,mt6370-charger";
+			interrupt-parent = <&mt6370>;
+			interrupts = <68>, <48>, <6>;
+			interrupt-names = "uvp_d_evt", "attach_i", "mivr";
+			io-channels = <&mt6370_adc MT6370_CHAN_VBUSDIV5>,
+				      <&mt6370_adc MT6370_CHAN_VBUSDIV2>,
+				      <&mt6370_adc MT6370_CHAN_VSYS>,
+				      <&mt6370_adc MT6370_CHAN_VBAT>,
+				      <&mt6370_adc MT6370_CHAN_TS_BAT>,
+				      <&mt6370_adc MT6370_CHAN_IBUS>,
+				      <&mt6370_adc MT6370_CHAN_IBAT>,
+				      <&mt6370_adc MT6370_CHAN_CHG_VDDP>,
+				      <&mt6370_adc MT6370_CHAN_TEMP_JC>;
+			io-channel-names = "vbusdiv5", "vbusdiv2", "vsys", "vbat",
+					   "ts_bat", "ibus", "ibat", "chg_vddp",
+					   "temp_jc";
+			monitored-battery = <&battery>;
+			power-supplies = <&mt6370_tcpc>;
+		};
+
+		/*
+		 * The rear flash: a dual-tone pair, channel 1 the white (cool) LED,
+		 * channel 2 the yellowish (warm) one (docs/camera.md). Two LED class
+		 * devices, not one joint one, so the tones mix. Currents: 400 mA
+		 * torch is the 4.14 flashlight driver's maximum, strobe 1200/1000 mA
+		 * the vendor device tree's (2.2 A together, under the chip's 2.5 A
+		 * for both). The strobe timeout register is shared; 1184 ms is what
+		 * the vendor's second LED left in it.
+		 */
+		flashlight {
+			compatible = "mediatek,mt6370-flashlight";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			led@0 {
+				reg = <0>;
+				led-sources = <0>;
+				function = LED_FUNCTION_FLASH;
+				color = <LED_COLOR_ID_WHITE>;
+				led-max-microamp = <400000>;
+				flash-max-microamp = <1200000>;
+				flash-max-timeout-us = <1184000>;
+			};
+
+			led@1 {
+				reg = <1>;
+				led-sources = <1>;
+				function = LED_FUNCTION_FLASH;
+				color = <LED_COLOR_ID_YELLOW>;
+				led-max-microamp = <400000>;
+				flash-max-microamp = <1000000>;
+				flash-max-timeout-us = <1184000>;
+			};
+		};
+
+		/*
+		 * The notification LED: red, green and blue on sinks 1-3, named as
+		 * the 4.14 driver names them (titan-charge drives them); 4-24 mA in
+		 * six steps. Sink 4 stays undeclared, so it keeps the hardware's
+		 * charge indication (red while charging).
+		 */
+		indicator {
+			compatible = "mediatek,mt6370-indicator";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			led@0 {
+				reg = <0>;
+				color = <LED_COLOR_ID_RED>;
+				label = "mt6370_pmu_led1";
+				led-max-microamp = <24000>;
+			};
+
+			led@1 {
+				reg = <1>;
+				color = <LED_COLOR_ID_GREEN>;
+				label = "mt6370_pmu_led2";
+				led-max-microamp = <24000>;
+			};
+
+			led@2 {
+				reg = <2>;
+				color = <LED_COLOR_ID_BLUE>;
+				label = "mt6370_pmu_led3";
+				led-max-microamp = <24000>;
+			};
+		};
+
+		/*
+		 * Display bias for the panel: +/-5.0 V, as the vendor LCM driver
+		 * sets it (and as LK leaves DSVPOS/DSVNEG, 0xb3/0xb4 = 0x14).
+		 */
+		regulators {
+			dsvbst {
+				regulator-name = "mt6370-dsvbst";
+			};
+
+			mt6370_dsvpos: dsvpos {
+				regulator-name = "mt6370-dsvpos";
+				regulator-min-microvolt = <5000000>;
+				regulator-max-microvolt = <5000000>;
+				regulator-boot-on;
+			};
+
+			mt6370_dsvneg: dsvneg {
+				regulator-name = "mt6370-dsvneg";
+				regulator-min-microvolt = <5000000>;
+				regulator-max-microvolt = <5000000>;
+				regulator-boot-on;
+			};
+
+			mt6370_ldo: vibldo {
+				regulator-name = "mt6370-vibldo";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+		};
+
+		mt6370_tcpc: tcpc {
+			compatible = "mediatek,mt6370-tcpc";
+			interrupts-extended = <&pctl 41 IRQ_TYPE_LEVEL_LOW>;
+
+			connector {
+				compatible = "usb-c-connector";
+				label = "USB-C";
+				data-role = "device";
+				power-role = "sink";
+				/*
+				 * self-powered (a battery): TCPM's port reset
+				 * opens CC, so a cable already plugged in at
+				 * boot is seen again (with Rd kept, CC never
+				 * changed and the chip raised no alert).
+				 * pd-disable: plain Type-C at 5 V; with PD the
+				 * port waited for source caps and hard-reset.
+				 * TCPM then needs typec-power-opmode.
+				 */
+				self-powered;
+				pd-disable;
+				typec-power-opmode = "default";
+
+				port {
+					typec_con_hs: endpoint {
+						remote-endpoint = <&mtu3_role_sw>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&i2c_3 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/* FourSemi FS1860 smart amp: the loudspeaker, on I2S3 */
+	speaker_amp: amplifier@34 {
+		compatible = "foursemi,fs1860";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
+	};
+
+	/*
+	 * ST21NFC NFC controller (driver: modules/nfc/linux612/st21nfc.c):
+	 * VEN on GPIO19, IRQ on GPIO20 (high while it has a packet), its
+	 * 26 MHz reference the MT6358's XO buffer 3. As the vendor tree.
+	 */
+	nfc@8 {
+		compatible = "st,st21nfc";
+		reg = <0x08>;
+		interrupts-extended = <&pctl 20 IRQ_TYPE_LEVEL_HIGH>;
+		reset-gpios = <&pctl 19 GPIO_ACTIVE_HIGH>;
+		irq-gpios = <&pctl 20 GPIO_ACTIVE_HIGH>;
+		mediatek,pmic = <&pmic>;
+	};
+};
+
+&i2c_4 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * Reset on GPIO 178 (high = run), interrupt on EINT 0 (stock dtbo).
+	 * INTN stays low until the input state is read, so the trigger is
+	 * the level: on a falling edge, one missed read left it low and the
+	 * keyboard dead.
+	 */
+	kbd_gpio: gpio-expander@58 {
+		compatible = "awinic,aw9523-pinctrl";
+		reg = <0x58>;
+		interrupts-extended = <&pctl 0 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&pctl 178 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&kbd_pins>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&kbd_gpio 0 0 16>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+};
+
+&i2c_0 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * Goodix GT1151QM touchscreen (vendor dtbo: i2c0 0x5d, interrupt
+	 * GPIO 1, reset GPIO 18, power above). The vendor driver ran it
+	 * without swapping or mirroring the axes.
+	 */
+	touchscreen@14 {
+		compatible = "goodix,gt1151";
+		reg = <0x14>;
+		interrupts-extended = <&pctl 1 IRQ_TYPE_EDGE_FALLING>;
+		irq-gpios = <&pctl 1 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pctl 18 GPIO_ACTIVE_HIGH>;
+		AVDD28-supply = <&touchscreen_power>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touchscreen_pins>;
+	};
+};
+
+&i2c_6 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * Keyboard touchpad: Synaptics RMI4, interrupt EINT 2 (level low),
+	 * reset released by the GPIO 9 hog below. F55 must stay out of the
+	 * kernel: with it the probe fails (docs/drivers/touchpad.md).
+	 */
+	touchpad@20 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x20>;
+		interrupts-extended = <&pctl 2 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touchpad_pins>;
+		syna,startup-delay-ms = <200>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			syna,sensor-type = <2>;	/* touchpad: indirect pointer */
+		};
+	};
+
+	/* NTC strap on GPIO 5: high = 24k pull-up (docs/hardware.md) */
+	fuel-gauge@2f {
+		compatible = "o2micro,oz8806";
+		reg = <0x2f>;
+		/* charged by the MT6370 (which stops charging when it is too hot or cold) */
+		power-supplies = <&mt6370_charger>;
+		o2micro,ntc-strap-gpios = <&pctl 5 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+/*
+ * The 4250 mAh Li-polymer cell, with the vendor charger settings (stock
+ * dts mt6370 charger node: ichg 2.0 A, cv 4.35 V, ieoc 150 mA).
+ */
+&{/} {
+	battery: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <4250000>;
+		voltage-min-design-microvolt = <3450000>;
+		voltage-max-design-microvolt = <4400000>;
+		constant-charge-current-max-microamp = <2000000>;
+		constant-charge-voltage-max-microvolt = <4350000>;
+		charge-term-current-microamp = <150000>;
+		/* charging stops outside this range (stock min/max_charge_temp) */
+		operating-range-celsius = <0 59>;
+	};
+};
+
+&pctl {
+	/*
+	 * The stock dtbo's audgpio states, on: the MT6358 audio link
+	 * (GPIO 136-143) and I2S3 to the speaker amp (GPIO 170-172) with
+	 * I2S0's data input (GPIO 174), the amp's feedback.
+	 */
+	aud_pins: audio-pins {
+		pins-adda {
+			pinmux = <PINMUX_GPIO136__FUNC_AUD_CLK_MOSI>,
+				 <PINMUX_GPIO137__FUNC_AUD_SYNC_MOSI>,
+				 <PINMUX_GPIO138__FUNC_AUD_DAT_MOSI0>,
+				 <PINMUX_GPIO139__FUNC_AUD_DAT_MOSI1>,
+				 <PINMUX_GPIO140__FUNC_AUD_CLK_MISO>,
+				 <PINMUX_GPIO141__FUNC_AUD_SYNC_MISO>,
+				 <PINMUX_GPIO142__FUNC_AUD_DAT_MISO0>,
+				 <PINMUX_GPIO143__FUNC_AUD_DAT_MISO1>;
+			input-schmitt-enable;
+			bias-disable;
+		};
+
+		pins-i2s {
+			pinmux = <PINMUX_GPIO170__FUNC_I2S3_BCK>,
+				 <PINMUX_GPIO171__FUNC_I2S3_LRCK>,
+				 <PINMUX_GPIO172__FUNC_I2S3_DO>,
+				 <PINMUX_GPIO174__FUNC_I2S0_DI>;
+		};
+	};
+
+	kbd_pins: keyboard-pins {
+		pins-int {
+			pinmux = <PINMUX_GPIO0__FUNC_GPIO0>;
+			input-enable;
+			bias-disable;
+		};
+	};
+
+	/* GPS LNA enable (GPIO 155): the stock dtbo's gpslna states */
+	irtx_pins: irtx-pins {
+		pins-pwm {
+			pinmux = <PINMUX_GPIO90__FUNC_PWM_A>;
+		};
+	};
+
+	gps_lna_init: gps-lna-init-pins {
+		pins-lna {
+			pinmux = <PINMUX_GPIO155__FUNC_GPIO155>;
+			bias-disable;
+			output-low;
+		};
+	};
+
+	gps_lna_on: gps-lna-on-pins {
+		pins-lna {
+			pinmux = <PINMUX_GPIO155__FUNC_GPIO155>;
+			output-high;
+		};
+	};
+
+	gps_lna_off: gps-lna-off-pins {
+		pins-lna {
+			pinmux = <PINMUX_GPIO155__FUNC_GPIO155>;
+			output-low;
+		};
+	};
+
+	touchscreen_pins: touchscreen-pins {
+		pins-int {
+			pinmux = <PINMUX_GPIO1__FUNC_GPIO1>;
+			bias-disable;
+		};
+
+		/*
+		 * goodix releases reset by making the pin an input; the vendor
+		 * driver drove it high, so hold it high with the pull-up
+		 */
+		pins-rst {
+			pinmux = <PINMUX_GPIO18__FUNC_GPIO18>;
+			bias-pull-up;
+		};
+	};
+
+	touchscreen_power_pins: touchscreen-power-pins {
+		pins-en {
+			pinmux = <PINMUX_GPIO153__FUNC_GPIO153>;
+			bias-disable;
+		};
+	};
+
+	touchpad_pins: touchpad-pins {
+		pins-int {
+			pinmux = <PINMUX_GPIO2__FUNC_GPIO2>;
+			input-enable;
+			bias-disable;
+		};
+	};
+
+	/*
+	 * The touchpad controller sits in reset (GPIO 9 low) until this
+	 * releases it; the stock driver pulsed it the same way at probe.
+	 */
+	touchpad-reset-hog {
+		gpio-hog;
+		gpios = <9 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "touchpad-reset";
+	};
+};
+
+/*
+ * LK's SCP loader looks the SCP up by this compatible in the kernel's
+ * tree and does not hand over to the kernel without it. It also reads the
+ * status: only "okay" makes it load the SCP (tinysys loader and RTOS from
+ * the scp partition into SCP SRAM, its DRAM as mblock "SCP-reserved");
+ * with no status it treats the SCP as disabled and writes "disabled" here.
+ */
+&scp {
+	compatible = "mediatek,scp";
+	status = "okay";
+};
+
+&mt6358codec {
+	Avdd-supply = <&mt6358_vaud28_reg>;
+};
+
+/* PMIC interrupt: EINT 182, as in the vendor tree */
+&pmic {
+	interrupts-extended = <&pctl 182 IRQ_TYPE_LEVEL_HIGH>;
+
+	/* the 3.5 mm jack; settings from the stock dtbo's accdet node */
+	mt6358accdet: accdet {
+		compatible = "mediatek,mt6358-accdet";
+		mediatek,mic-vol = <6>;
+		mediatek,mic-mode = <1>;
+		mediatek,pwm-deb-setting = <0x500 0x500 0x1 0x1f0
+					    0x800 0x800 0x20 0x44>;
+		mediatek,eint-level-pol = <IRQ_TYPE_LEVEL_LOW>;
+	};
+};
+
+/* "reboot bootloader" stops in LK's fastboot, as on 4.14 */
+/* the USB controller's external 0.9 V supply, see &ssusb */
+&mt6358regulator {
+	mt6358_va09_reg: ldo_va09 {
+		regulator-name = "va09";
+		regulator-min-microvolt = <900000>;
+		regulator-max-microvolt = <900000>;
+		regulator-always-on;
+	};
+};
+
+&mt6358rtc {
+	mediatek,lk-reboot-mode;
+};
+
+/*
+ * USB-C as a USB 2.0 device; the role switch belongs to the MT6370
+ * Type-C controller, which comes later. The controller is a USB 3 IP.
+ * With both of port0's PHYs powered its PLL, reference and 125 MHz
+ * clocks come up but the U3 MAC never leaves reset (IP_PW_STS1 read
+ * 0x1000d0f, bit 16 clear) and probe timed out, so the device's U3 port
+ * is left disabled (the vendor kernel is built with
+ * CONFIG_USB_MU3D_DEFAULT_U2_MODE). Its USB code also switches on VA09.
+ */
+&ssusb {
+	vusb33-supply = <&mt6358_vusb_reg>;
+	mediatek,u3p-dis-msk = <1>;
+	maximum-speed = "high-speed";
+	/*
+	 * Device only for now (the xHCI child stays disabled). The role
+	 * switch says whether a cable is there: on "none" the forced VBUS
+	 * session in the PHY ends, so the controller can sleep.
+	 */
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+	status = "okay";
+
+	port {
+		mtu3_role_sw: endpoint {
+			remote-endpoint = <&typec_con_hs>;
+		};
+	};
+};
+
+/*
+ * The PHY's VBUS comparator doesn't see the cable (the MT6370 senses
+ * VBUS): without forced session signals the host never enumerated the
+ * gadget, though mtu3 had pulled D+ up. The vendor PHY driver forces
+ * them too. The forced session follows the role switch on ssusb.
+ */
+&u2port0 {
+	mediatek,force-vbus;
+};
+
+&btif {
+	status = "okay";
+};
+
+/*
+ * CONNSYS and its MT6631 RF chip: VCN18 and VCN33 (BT/Wi-Fi PA, at
+ * 3.5 V) are switched together, VCN28 for FM and GPS; the PMIC handle
+ * gives the WMT core the LDOs' op-mode bits, as in the vendor driver.
+ */
+/*
+ * CPU DVFS supplies: the A53 cluster and the CCI on VPROC12/VSRAM_PROC12,
+ * the A73 cluster on VPROC11/VSRAM_PROC11, within MediaTek's MT6771 limits
+ * (Vproc 0.6-1.12 V, Vsram 0.85-1.12 V).
+ */
+&cci {
+	proc-supply = <&mt6358_vproc12_reg>;
+	sram-supply = <&mt6358_vsram_proc12_reg>;
+};
+
+&cpu0 {
+	proc-supply = <&mt6358_vproc12_reg>;
+	sram-supply = <&mt6358_vsram_proc12_reg>;
+};
+
+&cpu1 {
+	proc-supply = <&mt6358_vproc12_reg>;
+	sram-supply = <&mt6358_vsram_proc12_reg>;
+};
+
+&cpu2 {
+	proc-supply = <&mt6358_vproc12_reg>;
+	sram-supply = <&mt6358_vsram_proc12_reg>;
+};
+
+&cpu3 {
+	proc-supply = <&mt6358_vproc12_reg>;
+	sram-supply = <&mt6358_vsram_proc12_reg>;
+};
+
+&cpu4 {
+	proc-supply = <&mt6358_vproc11_reg>;
+	sram-supply = <&mt6358_vsram_proc11_reg>;
+};
+
+&cpu5 {
+	proc-supply = <&mt6358_vproc11_reg>;
+	sram-supply = <&mt6358_vsram_proc11_reg>;
+};
+
+&cpu6 {
+	proc-supply = <&mt6358_vproc11_reg>;
+	sram-supply = <&mt6358_vsram_proc11_reg>;
+};
+
+&cpu7 {
+	proc-supply = <&mt6358_vproc11_reg>;
+	sram-supply = <&mt6358_vsram_proc11_reg>;
+};
+
+&mt6358_vproc11_reg {
+	regulator-min-microvolt = <600000>;
+	regulator-max-microvolt = <1118750>;
+};
+
+&mt6358_vproc12_reg {
+	regulator-min-microvolt = <600000>;
+	regulator-max-microvolt = <1118750>;
+};
+
+&mt6358_vsram_proc11_reg {
+	regulator-min-microvolt = <850000>;
+	regulator-max-microvolt = <1118750>;
+};
+
+&mt6358_vsram_proc12_reg {
+	regulator-min-microvolt = <850000>;
+	regulator-max-microvolt = <1118750>;
+};
+
+/*
+ * On with no consumer, so they need saying: VDRAM2 is the LPDDR4X I/O
+ * supply (VDDQ, 0.6 V); VSRAM_GPU feeds the GPU's SRAM, which Panfrost
+ * does not manage here (see &gpu). VAUX18, VIO28 and VBIF28 go off at
+ * the regulator cleanup with nothing seen to break (2026-11-01).
+ */
+/* the touchscreen's supply (vendor vtouch) */
+&mt6358_vldo28_reg {
+	regulator-min-microvolt = <2800000>;
+	regulator-max-microvolt = <2800000>;
+};
+
+&mt6358_vdram2_reg {
+	regulator-always-on;
+};
+
+&mt6358_vsram_gpu_reg {
+	regulator-always-on;
+};
+
+/*
+ * The panel (vendor LCM driver R63308_CASCADEMDZ40): two supplies switched
+ * by GPIOs 175 and 177, reset on GPIO 45, bias from the MT6370. Left on as
+ * LK leaves them until the panel driver takes over.
+ */
+&{/} {
+	panel_vddi: regulator-panel-vddi {
+		compatible = "regulator-fixed";
+		regulator-name = "panel-vddi";
+		gpio = <&pctl 175 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	panel_vci: regulator-panel-vci {
+		compatible = "regulator-fixed";
+		regulator-name = "panel-vci";
+		gpio = <&pctl 177 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	/*
+	 * The display PWM drives the MT6370's backlight PWM input (the
+	 * MT6370 stays in the PWM mode LK sets; clearing its own BL_EN left
+	 * the panel lit, switching the PWM off darkened it). LK runs a
+	 * 1023-step period at duty 122.
+	 */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&disp_pwm 0 40000>;
+		brightness-levels = <0 1023>;
+		num-interpolated-steps = <1023>;
+		default-brightness-level = <122>;
+	};
+};
+
+&disp_pwm {
+	status = "okay";
+};
+
+&mipi_tx0 {
+	status = "okay";
+};
+
+&dsi0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "unihertz,titan-pocket-panel";
+		reg = <0>;
+		vddi-supply = <&panel_vddi>;
+		vci-supply = <&panel_vci>;
+		avdd-supply = <&mt6370_dsvpos>;
+		avee-supply = <&mt6370_dsvneg>;
+		reset-gpios = <&pctl 45 GPIO_ACTIVE_LOW>;
+		backlight = <&backlight>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&dsi_out>;
+			};
+		};
+	};
+
+	port {
+		dsi_out: endpoint {
+			remote-endpoint = <&panel_in>;
+		};
+	};
+};
+
+/*
+ * The GPU domains' supplies, as on MT8183 boards (mt8183-kukui): genpd
+ * switches them on before the domain. Panfrost turns VGPU off in system
+ * suspend (GPU_PM_VREG_OFF) and back on only in its own resume, after genpd
+ * has already powered MFG on: without these, the GPU did not answer after
+ * s2idle ("error powering up gpu L2/shader/tiler", measured).
+ */
+&mfg_async {
+	domain-supply = <&mt6358_vsram_gpu_reg>;
+};
+
+&mfg {
+	domain-supply = <&mt6358_vgpu_reg>;
+};
+
+&btcvsd {
+	status = "okay";
+};
+
+&connsys {
+	vcn18-supply = <&mt6358_vcn18_reg>;
+	vcn28-supply = <&mt6358_vcn28_reg>;
+	vcn33-supply = <&mt6358_vcn33_reg>;
+	mediatek,pmic = <&pmic>;
+	/* the WMT core switches the GPS LNA by these names */
+	pinctrl-names = "gps_lna_state_init", "gps_lna_state_oh",
+			"gps_lna_state_ol";
+	pinctrl-0 = <&gps_lna_init>;
+	pinctrl-1 = <&gps_lna_on>;
+	pinctrl-2 = <&gps_lna_off>;
+	status = "okay";
+};
+
+&wifi {
+	status = "okay";
+};
+
+/*
+ * VGPU only: VSRAM_GPU stays where LK set it, above the top OPP's
+ * 0.79375 V.
+ */
+&gpu {
+	mali-supply = <&mt6358_vgpu_reg>;
+	status = "okay";
+};
+
+&uart0 {
+	status = "okay";
+};
+
+/* the root filesystem's UFS; VEMC supplies it as in the vendor tree */
+/*
+ * VA09 also feeds the UFS M-PHY: the vendor driver switches it (and the
+ * M-PHY's RG_VA09_ON, SiP 0x276 command 1) off in UFS low power and back
+ * on, as upstream does with mediatek,ufs-support-va09. The LDO itself
+ * stays on for USB.
+ */
+&ufshci {
+	vcc-supply = <&mt6358_vemc_reg>;
+	va09-supply = <&mt6358_va09_reg>;
+	mediatek,ufs-support-va09;
+	status = "okay";
+};
+
+/*
+ * Side keys on the SoC's key matrix (vendor kpd-hw-init-map: key 1 the red
+ * key, 0xfa as the vendor reported it, key 2 volume down, key 9 volume up;
+ * key = row * 9 + column). Power is the PMIC's key (mt6358keys).
+ */
+&kpd {
+	keypad,num-rows = <8>;
+	keypad,num-columns = <9>;
+	linux,keymap = <MATRIX_KEY(0, 1, 250)
+			MATRIX_KEY(0, 2, KEY_VOLUMEDOWN)
+			MATRIX_KEY(1, 0, KEY_VOLUMEUP)>;
+	wakeup-source;
+	status = "okay";
+};
+
+/* the SCP's sensor hub: accelerometer, gyro, magnetometer, light, proximity */
+&scp_tinysys {
+	status = "okay";
+};
+
+/*
+ * Cameras (stock dtbo kd_camera_hw states and the vendor imgsensor power
+ * sequence): the rear OV16880 on i2c_2 at 0x36 with its AK7371 focus
+ * motor at 0x0c, CSI port 0, MCLK 0 (GPIO 99); the front OV8865 on i2c_4
+ * at 0x10, CSI port 1, MCLK 1 (GPIO 100). Reset and power-down pins are
+ * low while the sensor is off. The rear AVDD is an LDO switched by GPIO
+ * 160 (cam0_ldo_vcama), the front one VCAMA1; both share VCAMIO and VCAMD.
+ * The sensor modes and register tables are in the driver
+ * (modules/camera/linux612/titan_camera.c).
+ */
+&{/} {
+	camera_rear_avdd: regulator-camera-rear-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "camera-rear-avdd";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pctl 160 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&pctl {
+	/* the microSD slot; values from the stock device tree and the pins' state there */
+	mmc1_pins_default: mmc1-pins-default {
+		pins-cmd-dat {
+			pinmux = <PINMUX_GPIO31__FUNC_MSDC1_CMD>,
+				 <PINMUX_GPIO32__FUNC_MSDC1_DAT0>,
+				 <PINMUX_GPIO34__FUNC_MSDC1_DAT1>,
+				 <PINMUX_GPIO33__FUNC_MSDC1_DAT2>,
+				 <PINMUX_GPIO30__FUNC_MSDC1_DAT3>;
+			drive-strength = <8>;
+			input-enable;
+			input-schmitt-enable;
+			mediatek,pull-up-adv = <10>;
+		};
+
+		pins-clk {
+			pinmux = <PINMUX_GPIO29__FUNC_MSDC1_CLK>;
+			drive-strength = <8>;
+			input-enable;
+			input-schmitt-enable;
+			mediatek,pull-down-adv = <10>;
+		};
+
+		pins-cd {
+			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
+			input-enable;
+			bias-pull-up;
+		};
+	};
+
+	mmc1_pins_uhs: mmc1-pins-uhs {
+		pins-cmd-dat {
+			pinmux = <PINMUX_GPIO31__FUNC_MSDC1_CMD>,
+				 <PINMUX_GPIO32__FUNC_MSDC1_DAT0>,
+				 <PINMUX_GPIO34__FUNC_MSDC1_DAT1>,
+				 <PINMUX_GPIO33__FUNC_MSDC1_DAT2>,
+				 <PINMUX_GPIO30__FUNC_MSDC1_DAT3>;
+			drive-strength = <6>;
+			input-enable;
+			mediatek,pull-up-adv = <10>;
+		};
+
+		pins-clk {
+			pinmux = <PINMUX_GPIO29__FUNC_MSDC1_CLK>;
+			drive-strength = <8>;
+			input-enable;
+			mediatek,pull-down-adv = <10>;
+		};
+
+		pins-cd {
+			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
+			input-enable;
+			bias-pull-up;
+		};
+	};
+
+	camera_mclk_pins: camera-mclk-pins {
+		pins-mclk {
+			pinmux = <PINMUX_GPIO99__FUNC_CMMCLK0>,
+				 <PINMUX_GPIO100__FUNC_CMMCLK1>;
+			drive-strength = <MTK_DRIVE_4mA>;
+		};
+	};
+};
+
+&i2c_2 {
+	clock-frequency = <400000>;
+	status = "okay";
+};
+
+&camsv1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&camera_mclk_pins>;
+	/* the SoC's cam_sel (as in mt6771.dtsi), then 24 MHz sensor clocks */
+	assigned-clocks = <&topckgen CLK_TOP_MUX_CAM>,
+			  <&topckgen CLK_TOP_MUX_CAMTG>,
+			  <&topckgen CLK_TOP_MUX_CAMTG2>;
+	assigned-clock-parents = <&topckgen CLK_TOP_SYSPLL_D3>,
+				 <&topckgen CLK_TOP_UNIVP_192M_D8>,
+				 <&topckgen CLK_TOP_UNIVP_192M_D8>;
+	status = "okay";
+
+	rear {
+		i2c-bus = <&i2c_2>;
+		clocks = <&topckgen CLK_TOP_MUX_CAMTG>;
+		dovdd-supply = <&mt6358_vcamio_reg>;
+		avdd-supply = <&camera_rear_avdd>;
+		dvdd-supply = <&mt6358_vcamd_reg>;
+		afvdd-supply = <&mt6358_vldo28_reg>;
+		reset-gpios = <&pctl 101 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&pctl 97 GPIO_ACTIVE_LOW>;
+	};
+
+	front {
+		i2c-bus = <&i2c_4>;
+		clocks = <&topckgen CLK_TOP_MUX_CAMTG2>;
+		dovdd-supply = <&mt6358_vcamio_reg>;
+		avdd-supply = <&mt6358_vcama1_reg>;
+		dvdd-supply = <&mt6358_vcamd_reg>;
+		reset-gpios = <&pctl 102 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&pctl 98 GPIO_ACTIVE_LOW>;
+	};
+};
+
+&dip {
+	status = "okay";
+};
+
+/* the LTE modem; the driver (titan_modem) is loaded by hand for bring-up */
+&modem {
+	status = "okay";
+};
+
+/*
+ * The microSD slot. Card detect is GPIO 3, active high (stock: cd_level 1). The stock
+ * tree also lists SDR104 and DDR50; this stops at SDR50 until the card has proved reliable.
+ */
+&mmc1 {
+	status = "okay";
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc1_pins_default>;
+	pinctrl-1 = <&mmc1_pins_uhs>;
+	bus-width = <4>;
+	max-frequency = <200000000>;
+	cap-sd-highspeed;
+	sd-uhs-sdr12;
+	sd-uhs-sdr25;
+	sd-uhs-sdr50;
+	no-mmc;
+	no-sdio;
+	cd-gpios = <&pctl 3 GPIO_ACTIVE_HIGH>;
+	vmmc-supply = <&mt6358_vmch_reg>;
+	vqmmc-supply = <&mt6358_vmc_reg>;
+	post-power-on-delay-ms = <100>;
+	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC30_1>;
+	assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_D2>;
+};
+
+/* the stock driver powers the card and its pads at 3.0 V */
+&mt6358_vmch_reg {
+	regulator-min-microvolt = <3000000>;
+	regulator-max-microvolt = <3000000>;
+};
+
+&mt6358_vmc_reg {
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <3000000>;
+};
