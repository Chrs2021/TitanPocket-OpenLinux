+		};
+
+		/* the dtbo stubs take the label "auxadc" */
+		/*
+		 * The SCP (Cortex-M4) running MediaTek's tinysys, which LK loads
+		 * (see the lk-dtbo-sink scp node): SRAM, configuration, clock
+		 * control and SCPSYS registers, and its interrupt to the host.
+		 * Our driver starts it and runs the sensor hub on it.
+		 */
+		scp_tinysys: scp@10500000 {
+			compatible = "mediatek,mt6771-scp-tinysys";
+			reg = <0 0x10500000 0 0x80000>,
+			      <0 0x105c0000 0 0x3000>,
+			      <0 0x105c4000 0 0x1000>,
+			      <0 0x105d4000 0 0x6000>;
+			reg-names = "sram", "cfg", "clkctrl", "scpsys";
+			interrupts = <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
+			/* scp-sel and the PMIC: for its sleep (mt6771_scp.sleep) */
+			clocks = <&infracfg CLK_INFRA_SCPSYS>,
+				 <&topckgen CLK_TOP_MUX_SCP>;
+			clock-names = "main", "scp-sel";
+			mediatek,pwrap = <&pwrap>;
+			/* the AP's awake requests (INFRA_IRQ_SET/CLEAR) */
+			mediatek,infracfg = <&infracfg>;
+			memory-region = <&scp_sensor_mem>, <&scp_log_mem>;
+			status = "disabled";
+		};
+
+		/*
+		 * The LTE modem (MD1). LK loads and checks the image and
+		 * programs its memory protection; the driver powers the MD1
+		 * domain on, starts it and talks over CCIF0. The reg windows
+		 * are the AP and MD sides of CCIF0, then the MD-internal blocks
+		 * the boot sequence needs (PLLs, clock switch, reset unit, boot
+		 * vector, boot-status), all reachable from the AP. Two
+		 * interrupts: CCIF0 data (151) and the modem's exception
+		 * channels (152). The syscons carry the power sequence (scpsys
+		 * MD1_PWR_CON and the SPM SRAM/extra registers, infracfg bus
+		 * protection and the 26 MHz request, topckgen clock gating,
+		 * apmixedsys clock-square filter). See docs/modem.md.
+		 */
+		modem: modem@10209000 {
+			compatible = "mediatek,mt6771-modem";
+			reg = <0 0x10209000 0 0x1000>,
+			      <0 0x1020a000 0 0x1000>,
+			      <0 0x20140000 0 0x1000>,
+			      <0 0x20150000 0 0x1000>,
+			      <0 0x200f0100 0 0x10>,
+			      <0 0x20000000 0 0x100>,
+			      <0 0x1020e300 0 0x8>,
+			      <0 0x10014000 0 0x1000>,
+			      <0 0x1021b000 0 0x1000>;
+			reg-names = "ap-ccif", "md-ccif", "md-pll", "md-clksw",
+				    "md-rgu", "md-boot", "md-cfg",
+				    "cldma-ao", "cldma-pdn";
+			interrupts = <GIC_SPI 151 IRQ_TYPE_LEVEL_LOW>,
+				     <GIC_SPI 152 IRQ_TYPE_LEVEL_LOW>,
+				     <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "ccif", "ccif-ex", "cldma";
+			clocks = <&infracfg CLK_INFRA_CLDMA_BCLK>,
+				 <&infracfg CLK_INFRA_CCIF_AP>,
+				 <&infracfg CLK_INFRA_CCIF_MD>,
+				 <&infracfg CLK_INFRA_CCIF1_AP>,
+				 <&infracfg CLK_INFRA_CCIF1_MD>,
+				 <&infracfg CLK_INFRA_CCIF2_AP>,
+				 <&infracfg CLK_INFRA_CCIF2_MD>;
+			clock-names = "cldma", "ccif-ap", "ccif-md",
+				      "ccif1-ap", "ccif1-md",
+				      "ccif2-ap", "ccif2-md";
+			mediatek,scpsys = <&scpsys>;
+			mediatek,infracfg = <&infracfg>;
+			mediatek,topckgen = <&topckgen>;
+			mediatek,apmixedsys = <&apmixedsys>;
+			status = "disabled";
+		};
+
+		/* key matrix controller (vendor "mediatek,kp", same interrupt) */
+		kpd: keypad@10010000 {
+			compatible = "mediatek,mt6771-keypad",
+				     "mediatek,mt6779-keypad";
+			reg = <0 0x10010000 0 0x1000>;
+			interrupts = <GIC_SPI 186 IRQ_TYPE_EDGE_FALLING>;
+			clocks = <&clk26m>;
+			clock-names = "kpd";
+			status = "disabled";
+		};
+
+		/*
+		 * Multimedia IOMMU (M4U), as MT8183's: same address, interrupt
+		 * and larb port order (vendor m4u_port.h). Described: larb 0
+		 * (display), 5 (ISP pass 2) and 6 (camera input); the IOMMU
+		 * binds only once all listed larbs have probed. All masters
+		 * share one address space, so a buffer mapped for one device
+		 * is at the same address for every port.
+		 */
+		iommu: iommu@10205000 {
+			compatible = "mediatek,mt6771-m4u", "mediatek,mt8183-m4u";
+			reg = <0 0x10205000 0 0x1000>;
+			interrupts = <GIC_SPI 166 IRQ_TYPE_LEVEL_LOW>;
+			mediatek,larbs = <&larb0>, <&larb4>, <&larb5>, <&larb6>;
+			#iommu-cells = <1>;
+		};
+
+		/*
+		 * Global command engine, as MT8183's: same address, interrupt,
+		 * subsys IDs (0x1400xxxx 1, 0x1401xxxx 2) and mutex events
+		 * (stream done 0/1: 130/131) in the vendor tree. The secure
+		 * world keeps threads 8 and 10; the display uses 0 and 1.
+		 */
+		gce: mailbox@10238000 {
+			compatible = "mediatek,mt6771-gce", "mediatek,mt8183-gce";
+			reg = <0 0x10238000 0 0x4000>;
+			interrupts = <GIC_SPI 162 IRQ_TYPE_LEVEL_LOW>;
+			#mbox-cells = <2>;
+			clocks = <&infracfg CLK_INFRA_GCE>;
+			clock-names = "gce";
+		};
+
+		ap_auxadc: adc@11001000 {
+			compatible = "mediatek,mt6771-auxadc",
+				     "mediatek,mt8183-auxadc",
+				     "mediatek,mt8173-auxadc";
+			reg = <0 0x11001000 0 0x1000>;
+			clocks = <&infracfg CLK_INFRA_AUXADC>;
+			clock-names = "main";
+			#io-channel-cells = <1>;
+		};
+
+		uart0: serial@11002000 {
+			compatible = "mediatek,mt6771-uart",
+				     "mediatek,mt6577-uart";
+			reg = <0 0x11002000 0 0x1000>;
+			interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&clk26m>, <&infracfg CLK_INFRA_UART0>;
+			clock-names = "baud", "bus";
+			status = "disabled";
+		};
+
+		/*
+		 * I2C controllers: the MT8183's, at the same addresses and
+		 * interrupts as the vendor tree's i2c6 and i2c4 (the vendor
+		 * numbering matches the MT8183's except i2c5/i2c11, swapped).
+		 */
+		i2c_0: i2c@11007000 {
+			compatible = "mediatek,mt6771-i2c", "mediatek,mt8183-i2c";
+			reg = <0 0x11007000 0 0x1000>,
+			      <0 0x11000080 0 0x80>;
+			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&infracfg CLK_INFRA_I2C0>,
+				 <&infracfg CLK_INFRA_AP_DMA>;
+			clock-names = "main", "dma";
+			clock-div = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		i2c_6: i2c@11005000 {
+			compatible = "mediatek,mt6771-i2c", "mediatek,mt8183-i2c";
+			reg = <0 0x11005000 0 0x1000>,
+			      <0 0x11000600 0 0x80>;
+			interrupts = <GIC_SPI 87 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&infracfg CLK_INFRA_I2C6>,
+				 <&infracfg CLK_INFRA_AP_DMA>;
+			clock-names = "main", "dma";
+			clock-div = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		/*
+		 * A shared controller (its I2C1 arbiter clock): the AP's own
+		 * channel is at +0x100, where the vendor driver puts it
+		 * (ch_offset_default); on channel 0 every transfer timed out.
+		 * The window reaches past 0x1000 because i2c-mt65xx's register
+		 * dump reads DCM_EN at 0xf88. The DMA channel has no offset.
+		 */
+		i2c_4: i2c@11008000 {
+			compatible = "mediatek,mt6771-i2c", "mediatek,mt8183-i2c";
+			reg = <0 0x11008100 0 0x1000>,
+			      <0 0x11000100 0 0x80>;
+			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&infracfg CLK_INFRA_I2C1>,
+				 <&infracfg CLK_INFRA_AP_DMA>,
+				 <&infracfg CLK_INFRA_I2C1_ARBITER>;
+			clock-names = "main", "dma", "arb";
+			clock-div = <1>;
+			/*
+			 * Multi-channel: ATF's id for its secure MULTI_DMA
+			 * register (MediaTek's i2c id 4), restored after deep
+			 * sleep
+			 */
+			mediatek,secure-channel-id = <4>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		/* the rear camera's bus, shared like i2c_4 (the vendor's id 2) */
+		i2c_2: i2c@11009000 {
+			compatible = "mediatek,mt6771-i2c", "mediatek,mt8183-i2c";
+			reg = <0 0x11009100 0 0x1000>,
+			      <0 0x11000280 0 0x80>;
+			interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&infracfg CLK_INFRA_I2C2>,
+				 <&infracfg CLK_INFRA_AP_DMA>,
+				 <&infracfg CLK_INFRA_I2C2_ARBITER>;
+			clock-names = "main", "dma", "arb";
+			clock-div = <1>;
+			mediatek,secure-channel-id = <2>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		/* The smart amp's bus; same block and interrupt as the MT8183's i2c3 */
+		i2c_3: i2c@1100f000 {
+			compatible = "mediatek,mt6771-i2c", "mediatek,mt8183-i2c";
+			reg = <0 0x1100f000 0 0x1000>,
+			      <0 0x11000400 0 0x80>;
+			interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&infracfg CLK_INFRA_I2C3>,
+				 <&infracfg CLK_INFRA_AP_DMA>;
+			clock-names = "main", "dma";
+			clock-div = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		/*
+		 * The vendor's i2c5 (the MT6370), MT8183's i2c11 block: the same
+		 * address, DMA window and interrupt (SPI 133).
+		 */
+		i2c_5: i2c@11017000 {
+			compatible = "mediatek,mt6771-i2c", "mediatek,mt8183-i2c";
+			reg = <0 0x11017000 0 0x1000>,
+			      <0 0x11000580 0 0x80>;
+			interrupts = <GIC_SPI 133 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&infracfg CLK_INFRA_I2C5_IMM>,
+				 <&infracfg CLK_INFRA_AP_DMA>,
+				 <&infracfg CLK_INFRA_I2C5_ARBITER>;
+			clock-names = "main", "dma", "arb";
+			clock-div = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		ssusb: usb@11201000 {
+			compatible = "mediatek,mt6771-mtu3", "mediatek,mt8183-mtu3",
+				     "mediatek,mtu3";
+			reg = <0 0x11201000 0 0x2e00>,
+			      <0 0x11203e00 0 0x0100>;
+			reg-names = "mac", "ippc";
+			interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_LOW>;
+			phys = <&u2port0 PHY_TYPE_USB2>,
+			       <&u3port0 PHY_TYPE_USB3>;
+			clocks = <&infracfg CLK_INFRA_UNIPRO_SCK>,
+				 <&infracfg CLK_INFRA_USB>;
+			clock-names = "sys_ck", "ref_ck";
+			mediatek,syscon-wakeup = <&pericfg 0x420 101>;
+			#address-cells = <2>;
+			#size-cells = <2>;
+			ranges;
+			status = "disabled";
+
+			usb_host: usb@11200000 {
+				compatible = "mediatek,mt6771-xhci",
+					     "mediatek,mt8183-xhci",
+					     "mediatek,mtk-xhci";
+				reg = <0 0x11200000 0 0x1000>;
+				reg-names = "mac";
+				interrupts = <GIC_SPI 73 IRQ_TYPE_LEVEL_LOW>;
+				clocks = <&infracfg CLK_INFRA_UNIPRO_SCK>,
+					 <&infracfg CLK_INFRA_USB>;
+				clock-names = "sys_ck", "ref_ck";
+				status = "disabled";
+			};
+		};
+
+		/*
+		 * The audio front end is the MT8183's: the 385 register names
+		 * the vendor MT6771 header (mtk-auddrv-afe.h) shares with
+		 * upstream's mt8183-reg.h all have the same offsets, and the
+		 * interrupt (SPI 161) and clocks match the vendor tree.
+		 */
+		audiosys: audio-controller@11220000 {
+			compatible = "mediatek,mt6771-audiosys",
+				     "mediatek,mt8183-audiosys", "syscon";
+			reg = <0 0x11220000 0 0x1000>;
+			#clock-cells = <1>;
+
+			afe: mt8183-afe-pcm {
+				compatible = "mediatek,mt8183-audio";
+				interrupts = <GIC_SPI 161 IRQ_TYPE_LEVEL_LOW>;
+				resets = <&watchdog MT8183_TOPRGU_AUDIO_SW_RST>;
+				reset-names = "audiosys";
+				power-domains = <&spm MT8183_POWER_DOMAIN_AUDIO>;
+				clocks = <&audiosys CLK_AUDIO_AFE>,
+					 <&audiosys CLK_AUDIO_DAC>,
+					 <&audiosys CLK_AUDIO_DAC_PREDIS>,
+					 <&audiosys CLK_AUDIO_ADC>,
+					 <&audiosys CLK_AUDIO_PDN_ADDA6_ADC>,
+					 <&audiosys CLK_AUDIO_22M>,
+					 <&audiosys CLK_AUDIO_24M>,
+					 <&audiosys CLK_AUDIO_APLL_TUNER>,
+					 <&audiosys CLK_AUDIO_APLL2_TUNER>,
+					 <&audiosys CLK_AUDIO_I2S1>,
+					 <&audiosys CLK_AUDIO_I2S2>,
+					 <&audiosys CLK_AUDIO_I2S3>,
+					 <&audiosys CLK_AUDIO_I2S4>,
+					 <&audiosys CLK_AUDIO_TDM>,
+					 <&audiosys CLK_AUDIO_TML>,
+					 <&infracfg CLK_INFRA_AUDIO>,
+					 <&infracfg CLK_INFRA_AUDIO_26M_BCLK>,
+					 <&topckgen CLK_TOP_MUX_AUDIO>,
+					 <&topckgen CLK_TOP_MUX_AUD_INTBUS>,
+					 <&topckgen CLK_TOP_SYSPLL_D2_D4>,
+					 <&topckgen CLK_TOP_MUX_AUD_1>,
+					 <&topckgen CLK_TOP_APLL1_CK>,
+					 <&topckgen CLK_TOP_MUX_AUD_2>,
+					 <&topckgen CLK_TOP_APLL2_CK>,
+					 <&topckgen CLK_TOP_MUX_AUD_ENG1>,
+					 <&topckgen CLK_TOP_APLL1_D8>,
+					 <&topckgen CLK_TOP_MUX_AUD_ENG2>,
+					 <&topckgen CLK_TOP_APLL2_D8>,
+					 <&topckgen CLK_TOP_MUX_APLL_I2S0>,
+					 <&topckgen CLK_TOP_MUX_APLL_I2S1>,
+					 <&topckgen CLK_TOP_MUX_APLL_I2S2>,
+					 <&topckgen CLK_TOP_MUX_APLL_I2S3>,
+					 <&topckgen CLK_TOP_MUX_APLL_I2S4>,
+					 <&topckgen CLK_TOP_MUX_APLL_I2S5>,
+					 <&topckgen CLK_TOP_APLL12_DIV0>,
+					 <&topckgen CLK_TOP_APLL12_DIV1>,
+					 <&topckgen CLK_TOP_APLL12_DIV2>,
+					 <&topckgen CLK_TOP_APLL12_DIV3>,
+					 <&topckgen CLK_TOP_APLL12_DIV4>,
+					 <&topckgen CLK_TOP_APLL12_DIVB>,
+					 <&clk26m>;
+				clock-names = "aud_afe_clk",
+					      "aud_dac_clk",
+					      "aud_dac_predis_clk",
+					      "aud_adc_clk",
+					      "aud_adc_adda6_clk",
+					      "aud_apll22m_clk",
+					      "aud_apll24m_clk",
+					      "aud_apll1_tuner_clk",
+					      "aud_apll2_tuner_clk",
+					      "aud_i2s1_bclk_sw",
+					      "aud_i2s2_bclk_sw",
+					      "aud_i2s3_bclk_sw",
+					      "aud_i2s4_bclk_sw",
+					      "aud_tdm_clk",
+					      "aud_tml_clk",
+					      "aud_infra_clk",
+					      "mtkaif_26m_clk",
+					      "top_mux_audio",
+					      "top_mux_aud_intbus",
+					      "top_syspll_d2_d4",
+					      "top_mux_aud_1",
+					      "top_apll1_ck",
+					      "top_mux_aud_2",
+					      "top_apll2_ck",
+					      "top_mux_aud_eng1",
+					      "top_apll1_d8",
+					      "top_mux_aud_eng2",
+					      "top_apll2_d8",
+					      "top_i2s0_m_sel",
+					      "top_i2s1_m_sel",
+					      "top_i2s2_m_sel",
+					      "top_i2s3_m_sel",
+					      "top_i2s4_m_sel",
+					      "top_i2s5_m_sel",
+					      "top_apll12_div0",
+					      "top_apll12_div1",
+					      "top_apll12_div2",
+					      "top_apll12_div3",
+					      "top_apll12_div4",
+					      "top_apll12_divb",
+					      "top_clk26m_clk";
+			};
+		};
+
+		/*
+		 * The MT6771's UFS host and M-PHY are the ones upstream's
+		 * MediaTek UFS bindings were written for: their examples use
+		 * these addresses. Interrupt from the vendor tree (SPI 80).
+		 */
+		mmc1: mmc@11240000 {
+			compatible = "mediatek,mt8183-mmc";
+			reg = <0 0x11240000 0 0x1000>,
+			      <0 0x11e10000 0 0x1000>;
+			interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&topckgen CLK_TOP_MUX_MSDC30_1>,
+				 <&infracfg CLK_INFRA_MSDC1>,
+				 <&infracfg CLK_INFRA_MSDC1_SCK>;
+			clock-names = "source", "hclk", "source_cg";
+			status = "disabled";
+		};
+
+		ufshci: ufs@11270000 {
+			compatible = "mediatek,mt6771-ufshci", "mediatek,mt8183-ufshci";
+			reg = <0 0x11270000 0 0x2300>;
+			interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_LOW>;
+			phys = <&ufsphy>;
+			clocks = <&infracfg CLK_INFRA_UFS>;
+			clock-names = "ufs";
+			freq-table-hz = <0 0>;
+			/*
+			 * MT8183's infracfg reset bits: asserting UFSHCI (47)
+			 * cleared the controller's enable, measured. The vendor
+			 * MT6771 header's bits (bank 0 bits 14/15) are those of
+			 * other blocks in this table. No M-PHY reset: the driver
+			 * pairs it with an M-PHY backup SiP call this ATF lacks.
+			 */
+			resets = <&infracfg MT8183_INFRACFG_AO_UFSHCI_SW_RST>,
+				 <&infracfg MT8183_INFRACFG_AO_UNIPRO_UFS_SW_RST>,
+				 <&infracfg MT8183_INFRACFG_AO_UFS_AES_SW_RST>;
+			reset-names = "hci_rst", "unipro_rst", "crypto_rst";
+			status = "disabled";
+		};
+
+		efuse: efuse@11f10000 {
+			compatible = "mediatek,mt6771-efuse",
+				     "mediatek,mt8183-efuse", "mediatek,efuse";
+			reg = <0 0x11f10000 0 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			thermal_calibration: calib@180 {
+				reg = <0x180 0xc>;
+			};
+
+			mipi_tx_calibration: calib@190 {
+				reg = <0x190 0xc>;
+			};
+		};
+
+		u3phy: t-phy@11f40000 {
+			compatible = "mediatek,mt6771-tphy", "mediatek,mt8183-tphy",
+				     "mediatek,generic-tphy-v2";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0 0 0x11f40000 0x1000>;
+
+			u2port0: usb-phy@0 {
+				reg = <0x0 0x700>;
+				clocks = <&clk26m>;
+				clock-names = "ref";
+				#phy-cells = <1>;
+				mediatek,discth = <15>;
+			};
+
+			u3port0: usb-phy@700 {
+				reg = <0x0700 0x900>;
+				clocks = <&clk26m>;
+				clock-names = "ref";
+				#phy-cells = <1>;
+			};
+		};
+
+		ufsphy: ufs-phy@11fa0000 {
+			compatible = "mediatek,mt6771-ufsphy", "mediatek,mt8183-ufsphy";
+			reg = <0 0x11fa0000 0 0xc000>;
+			clocks = <&infracfg CLK_INFRA_UNIPRO_SCK>,
+				 <&infracfg CLK_INFRA_UFS_MP_SAP_BCLK>;
+			clock-names = "unipro", "mp";
+			#phy-cells = <0>;
+		};
+
+		/*
+		 * BTIF: the UART-like link that carries STP (WMT commands, ROM
+		 * patches, BT, FM and GPS) to CONNSYS, with its two APDMA
+		 * virtual FIFO channels (tx, rx) and their interrupts.
+		 * Addresses, interrupts and clocks from the vendor tree.
+		 */
+		/*
+		 * The MT8183's thermal controller, at the vendor tree's
+		 * therm_ctrl address and interrupt. Its calibration words are
+		 * the vendor's devinfo 100-102 (eFuse 0x180-0x188), with the
+		 * same fields (vendor mtk_tc.c); sensors TS1 SoC, TS2 GPU,
+		 * TS3 MD, TS4 little cluster, TS5 big cluster, as the vendor
+		 * banks use them.
+		 */
+		thermal: thermal-sensor@1100b000 {
+			compatible = "mediatek,mt6771-thermal",
+				     "mediatek,mt8183-thermal";
+			reg = <0 0x1100b000 0 0xc00>;
+			#thermal-sensor-cells = <1>;
+			clocks = <&infracfg CLK_INFRA_THERM>,
+				 <&infracfg CLK_INFRA_AUXADC>;
+			clock-names = "therm", "auxadc";
+			resets = <&infracfg MT8183_INFRACFG_AO_THERM_SW_RST>;
+			interrupts = <GIC_SPI 76 IRQ_TYPE_LEVEL_LOW>;
+			mediatek,auxadc = <&ap_auxadc>;
+			mediatek,apmixedsys = <&apmixedsys>;
+			nvmem-cells = <&thermal_calibration>;
+			nvmem-cell-names = "calibration-data";
+		};
+
+		btif: serial@1100c000 {
+			compatible = "mediatek,mt6771-btif";
+			reg = <0 0x1100c000 0 0x1000>,
+			      <0 0x11000a80 0 0x80>,
+			      <0 0x11000b00 0 0x80>;
+			interrupts = <GIC_SPI 114 IRQ_TYPE_LEVEL_LOW>,
+				     <GIC_SPI 139 IRQ_TYPE_LEVEL_LOW>,
+				     <GIC_SPI 140 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&infracfg CLK_INFRA_BTIF>,
+				 <&infracfg CLK_INFRA_AP_DMA>;
+			clock-names = "main", "apdma";
+			status = "disabled";
+		};
+
