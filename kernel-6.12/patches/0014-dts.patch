+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6771 (Helio P60/P70).
+ *
+ * The MT6771 is the MT8183's phone sibling: of the 90 MMIO nodes in
+ * mt8183.dtsi, 87 sit at the same address in the vendor MT6771 device
+ * tree. This file starts with what first light needs (CPUs, interrupts,
+ * timer, UART, watchdog) and takes blocks over from mt8183.dtsi as each is
+ * checked on the hardware. The clock controllers and pinctrl are the
+ * MT8183's (same tables and registers, docs/mainline.md), so their nodes
+ * name the MT8183 compatible after the MT6771 one. The dtbo overlay owns
+ * the vendor labels (pio, i2c0, ...: mt6771-lk-dtbo-labels.dtsi), so nodes
+ * taken from mt8183.dtsi get other labels here.
+ */
+
+#include <dt-bindings/clock/mt8183-clk.h>
