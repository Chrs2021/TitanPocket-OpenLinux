 	{ .compatible = "mediatek,mt8183", },
 	{ .compatible = "mediatek,mt8186", },
 	{ .compatible = "mediatek,mt8365", },
diff --git a/drivers/cpufreq/mediatek-cpufreq.c b/drivers/cpufreq/mediatek-cpufreq.c
index 663f61565cf7289fe34d9a735e825206dd13152c..301b59077059114db63b3204ed121f6ee41ed06b 100644
--- a/drivers/cpufreq/mediatek-cpufreq.c
+++ b/drivers/cpufreq/mediatek-cpufreq.c
@@ -23,6 +23,9 @@ struct mtk_cpufreq_platform_data {
 	int sram_min_volt;
 	int sram_max_volt;
 	bool ccifreq_supported;
+	/* schedutil's rate limit: little cluster (the one with CPU 0), big one; 0 for the default */
+	unsigned int little_delay_us;
+	unsigned int big_delay_us;
 };
 
 /*
@@ -571,6 +574,45 @@ static void mtk_cpu_dvfs_info_release(struct mtk_cpu_dvfs_info *info)
 	dev_pm_opp_unregister_notifier(info->cpu_dev, &info->opp_nb);
 }
 
+/*
+ * The frequency to sleep at: the fastest operating point that runs at or
+ * below the rail's power-on voltage. On the MT6771 the SPM firmware takes
+ * the CPU rails down in its suspend and brings them back to their set
+ * voltage at the wake, then restarts CPU 0 after a fixed wait. Asleep at
+ * whatever the governor had (often the top point, 1.0 V), about one long
+ * sleep in twenty ended with CPU 0 never restarting and the SPM's watchdog
+ * resetting the phone 30 s later (Titan Pocket, 2026-11: the PMIC's
+ * latched VPROC read 1.0 V at every such reset). MediaTek's own software
+ * leaves CPU DVFS to the SSPM, which stops it for the suspend.
+ */
+static unsigned int suspend_microvolt = 800000;
+module_param(suspend_microvolt, uint, 0644);
+MODULE_PARM_DESC(suspend_microvolt, "Sleep at the fastest OPP at or below this voltage (0: wherever the governor left it)");
+
+static unsigned int mtk_cpufreq_suspend_freq(struct mtk_cpu_dvfs_info *info,
+					     struct cpufreq_frequency_table *table)
+{
+	struct cpufreq_frequency_table *pos;
+	unsigned int best = 0;
+
+	if (!suspend_microvolt)
+		return 0;
+	cpufreq_for_each_valid_entry(pos, table) {
+		struct dev_pm_opp *opp;
+		unsigned long volt;
+
+		opp = dev_pm_opp_find_freq_exact(info->cpu_dev,
+						 pos->frequency * 1000UL, true);
+		if (IS_ERR(opp))
+			continue;
+		volt = dev_pm_opp_get_voltage(opp);
+		dev_pm_opp_put(opp);
+		if (volt <= suspend_microvolt && pos->frequency > best)
+			best = pos->frequency;
+	}
+	return best;
+}
+
 static int mtk_cpufreq_init(struct cpufreq_policy *policy)
 {
 	struct mtk_cpu_dvfs_info *info;
@@ -596,6 +638,10 @@ static int mtk_cpufreq_init(struct cpufreq_policy *policy)
 	policy->freq_table = freq_table;
 	policy->driver_data = info;
 	policy->clk = info->cpu_clk;
+	policy->suspend_freq = mtk_cpufreq_suspend_freq(info, freq_table);
+	dev_info(info->cpu_dev, "suspend frequency %u kHz\n", policy->suspend_freq);
+	policy->transition_delay_us = cpumask_test_cpu(0, &info->cpus) ?
+		info->soc_data->little_delay_us : info->soc_data->big_delay_us;
 
 	return 0;
 }
@@ -616,6 +662,7 @@ static struct cpufreq_driver mtk_cpufreq_driver = {
 	.get = cpufreq_generic_get,
 	.init = mtk_cpufreq_init,
 	.exit = mtk_cpufreq_exit,
+	.suspend = cpufreq_generic_suspend,
 	.register_em = cpufreq_register_em_with_opp,
 	.name = "mtk-cpufreq",
 	.attr = cpufreq_generic_attr,
@@ -728,6 +775,23 @@ static const struct mtk_cpufreq_platform_data mt8186_platform_data = {
 	.ccifreq_supported = true,
 };
 
+/* MediaTek's MT6771 limits (cpufreq_v1 mach/mt6771): Vsram = Vproc + 100 mV */
+static const struct mtk_cpufreq_platform_data mt6771_platform_data = {
+	.min_volt_shift = 100000,
+	.max_volt_shift = 262500,
+	.proc_max_volt = 1118750,
+	.sram_min_volt = 850000,
+	.sram_max_volt = 1118750,
+	.ccifreq_supported = true,
+	/*
+	 * With the default 1 ms the little cluster changed frequency up to 315 times a second, each
+	 * change sleeping about 46 times on its voltage: 190-260 mA with the screen on against
+	 * 142-151 mA here, with first frame, opening and scrolling unchanged (docs/power.md).
+	 */
+	.little_delay_us = 50000,
+	.big_delay_us = 10000,
+};
+
 static const struct mtk_cpufreq_platform_data mt8516_platform_data = {
 	.min_volt_shift = 100000,
 	.max_volt_shift = 200000,
@@ -748,6 +812,7 @@ static const struct of_device_id mtk_cpufreq_machines[] __initconst __maybe_unus
 	{ .compatible = "mediatek,mt817x", .data = &mt2701_platform_data },
 	{ .compatible = "mediatek,mt8173", .data = &mt2701_platform_data },
 	{ .compatible = "mediatek,mt8176", .data = &mt2701_platform_data },
+	{ .compatible = "mediatek,mt6771", .data = &mt6771_platform_data },
 	{ .compatible = "mediatek,mt8183", .data = &mt8183_platform_data },
 	{ .compatible = "mediatek,mt8186", .data = &mt8186_platform_data },
 	{ .compatible = "mediatek,mt8365", .data = &mt2701_platform_data },
diff --git a/drivers/cpuidle/dt_idle_states.c b/drivers/cpuidle/dt_idle_states.c
index 97feb7d8fb2329fa4e0f20a858e0a9c1680ff49a..78e95eb170022932592b7ff1785349d354643948 100644
--- a/drivers/cpuidle/dt_idle_states.c
+++ b/drivers/cpuidle/dt_idle_states.c
@@ -17,6 +17,15 @@
 
 #include "dt_idle_states.h"
 
+/*
+ * Bring-up aid: dt_idle_states.off=1 starts every DT idle state disabled
+ * (CPUIDLE_FLAG_OFF), to be enabled one at a time through cpuidle's sysfs
+ * "disable" files.
+ */
+static bool off;
+module_param(off, bool, 0444);
+MODULE_PARM_DESC(off, "start DT idle states disabled");
+
 static int init_state_node(struct cpuidle_state *idle_state,
 			   const struct of_device_id *match_id,
 			   struct device_node *state_node)
@@ -77,6 +86,8 @@ static int init_state_node(struct cpuidle_state *idle_state,
 		desc = state_node->name;
 
 	idle_state->flags = CPUIDLE_FLAG_RCU_IDLE;
+	if (off)
+		idle_state->flags |= CPUIDLE_FLAG_OFF;
 	if (of_property_read_bool(state_node, "local-timer-stop"))
 		idle_state->flags |= CPUIDLE_FLAG_TIMER_STOP;
 	/*
diff --git a/drivers/devfreq/mtk-cci-devfreq.c b/drivers/devfreq/mtk-cci-devfreq.c
index 6e608d92f7e66a42fedaf83d96db35100fa80988..dd909396bcc5e7e5fd886c74b07fef7916b85fe8 100644
--- a/drivers/devfreq/mtk-cci-devfreq.c
+++ b/drivers/devfreq/mtk-cci-devfreq.c
@@ -414,6 +414,14 @@ static const struct mtk_ccifreq_platform_data mt8183_platform_data = {
 	.proc_max_volt = 1150000,
 };
 
+static const struct mtk_ccifreq_platform_data mt6771_platform_data = {
+	.min_volt_shift = 100000,
+	.max_volt_shift = 262500,
+	.proc_max_volt = 1118750,
+	.sram_min_volt = 850000,
+	.sram_max_volt = 1118750,
+};
+
 static const struct mtk_ccifreq_platform_data mt8186_platform_data = {
 	.min_volt_shift = 100000,
 	.max_volt_shift = 250000,
@@ -423,6 +431,7 @@ static const struct mtk_ccifreq_platform_data mt8186_platform_data = {
 };
 
 static const struct of_device_id mtk_ccifreq_machines[] = {
+	{ .compatible = "mediatek,mt6771-cci", .data = &mt6771_platform_data },
 	{ .compatible = "mediatek,mt8183-cci", .data = &mt8183_platform_data },
 	{ .compatible = "mediatek,mt8186-cci", .data = &mt8186_platform_data },
 	{ },
diff --git a/drivers/soc/mediatek/mtk-svs.c b/drivers/soc/mediatek/mtk-svs.c
index 07ab261e1269d0f9073e32f2ef49c9dab287207a..ce9cdd416f6e4af642e4110b4f91bc1b39b938a8 100644
--- a/drivers/soc/mediatek/mtk-svs.c
+++ b/drivers/soc/mediatek/mtk-svs.c
@@ -2828,12 +2828,33 @@ static const struct svs_platform_data svs_mt8183_platform_data = {
 	}
 };
 
+/*
+ * MT6771: the MT8183's SVS (MediaTek's EEM v2 for the MT6771 runs the same
+ * four detectors with the same efuse fields, control words, limits and
+ * frequency bases, and smaller voltage margins than these). The GPU bank
+ * is left out: it needs a "gpu-thermal" zone, and the MT6771's thermal
+ * driver registers one sensor only.
+ */
+static const struct svs_platform_data svs_mt6771_platform_data = {
+	.name = "mt6771-svs",
+	.banks = svs_mt8183_banks,
+	.efuse_parsing = svs_mt8183_efuse_parsing,
+	.probe = svs_mt8183_platform_probe,
+	.regs = svs_regs_v2,
+	.bank_max = 3,			/* CPU little, CPU big, CCI */
+	.glb_fuse_map = (const struct svs_fusemap[GLB_MAX]) {
+		/* VMIN not present */
+		{ 0, 4 }, { -1, 0 }
+	}
+};
+
 static const struct of_device_id svs_of_match[] = {
 	{ .compatible = "mediatek,mt8195-svs", .data = &svs_mt8195_platform_data },
 	{ .compatible = "mediatek,mt8192-svs", .data = &svs_mt8192_platform_data },
 	{ .compatible = "mediatek,mt8188-svs", .data = &svs_mt8188_platform_data },
 	{ .compatible = "mediatek,mt8186-svs", .data = &svs_mt8186_platform_data },
 	{ .compatible = "mediatek,mt8183-svs", .data = &svs_mt8183_platform_data },
+	{ .compatible = "mediatek,mt6771-svs", .data = &svs_mt6771_platform_data },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, svs_of_match);
