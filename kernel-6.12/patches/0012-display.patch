@@ -75,6 +75,30 @@ static const struct mtk_mmsys_driver_data mt8183_mmsys_driver_data = {
 	.num_resets = 32,
 };
 
+/*
+ * MMSYS_SODI_REQ_MASK (vendor ddp_reg_mmsys.h, ddp_path.c and ddp_rdma_ex.c
+ * for the MT6771): bits 4:0 a golden value of 3; for RDMA0, mask enables
+ * (9:8) and mask values (13:12) of its two requests, the AP source (bit 0:
+ * DRAM and its PHY powered) and DDREN (bit 1: DRAM out of self-refresh).
+ * The vendor's rdma_start() holds the AP source and leaves DDREN to the
+ * RDMA's FIFO thresholds, so with the display running the SPM may put DRAM
+ * into self-refresh between fetches but no further (SODI's CG mode);
+ * rdma_stop() forces both requests low.
+ */
+#define MT6771_MMSYS_SODI_REQ_MASK	0x0f8
+
+static const struct mtk_mmsys_driver_data mt6771_mmsys_driver_data = {
+	.clk_driver = "clk-mt8183-mm",
+	.routes = mmsys_mt8183_routing_table,
+	.num_routes = ARRAY_SIZE(mmsys_mt8183_routing_table),
+	.sw0_rst_offset = MT8183_MMSYS_SW0_RST_B,
+	.num_resets = 32,
+	.sodi_req_offset = MT6771_MMSYS_SODI_REQ_MASK,
+	.sodi_req_mask = GENMASK(4, 0) | GENMASK(9, 8) | GENMASK(13, 12),
+	.sodi_req_on = 0x3 | (0x1 << 8) | (0x3 << 12),
+	.sodi_req_off = 0x3 | (0x3 << 8) | (0x0 << 12),
+};
+
 static const struct mtk_mmsys_driver_data mt8186_mmsys_driver_data = {
 	.clk_driver = "clk-mt8186-mm",
 	.routes = mmsys_mt8186_routing_table,
@@ -213,6 +237,19 @@ void mtk_mmsys_ddp_disconnect(struct device *dev,
 }
 EXPORT_SYMBOL_GPL(mtk_mmsys_ddp_disconnect);
 
+/* The display path's DRAM requests to the SPM: on while it runs */
+void mtk_mmsys_sodi_req(struct device *dev, bool on)
+{
+	struct mtk_mmsys *mmsys = dev_get_drvdata(dev);
+	const struct mtk_mmsys_driver_data *data = mmsys->data;
+
+	if (!data->sodi_req_mask)
+		return;
+	mtk_mmsys_update_bits(mmsys, data->sodi_req_offset, data->sodi_req_mask,
+			      on ? data->sodi_req_on : data->sodi_req_off, NULL);
+}
+EXPORT_SYMBOL_GPL(mtk_mmsys_sodi_req);
