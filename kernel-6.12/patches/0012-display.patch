+/*
+ * The block's power domain (the display's, on MT6771) and its clocks, held
+ * while the PWM runs or is read: without runtime PM genpd counts the PWM as
+ * in use and never powers the domain off.
+ */
+static int mtk_disp_pwm_power_on(struct pwm_chip *chip)
+{
+	struct mtk_disp_pwm *mdp = to_mtk_disp_pwm(chip);
+	struct device *dev = pwmchip_parent(chip);
+	int err;
+
+	err = pm_runtime_resume_and_get(dev);
+	if (err < 0)
+		return err;
+
+	err = clk_prepare_enable(mdp->clk_main);
+	if (err < 0) {
+		dev_err(dev, "Can't enable mdp->clk_main: %pe\n", ERR_PTR(err));
+		goto err_pm;
+	}
+
+	err = clk_prepare_enable(mdp->clk_mm);
+	if (err < 0) {
+		dev_err(dev, "Can't enable mdp->clk_mm: %pe\n", ERR_PTR(err));
+		clk_disable_unprepare(mdp->clk_main);
+		goto err_pm;
+	}
+	return 0;
+
+err_pm:
+	pm_runtime_put(dev);
+	return err;
+}
+
+static void mtk_disp_pwm_power_off(struct pwm_chip *chip)
+{
+	struct mtk_disp_pwm *mdp = to_mtk_disp_pwm(chip);
+
+	clk_disable_unprepare(mdp->clk_mm);
+	clk_disable_unprepare(mdp->clk_main);
+	pm_runtime_put(pwmchip_parent(chip));
+}
