diff --git a/drivers/gpu/drm/mediatek/mtk_disp_rdma.c b/drivers/gpu/drm/mediatek/mtk_disp_rdma.c
index 07243f3722604a2d92516b1b1a3c1343f2e50bba..c609a91253c6207d18703c26701fc1a4f344bbce 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_rdma.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_rdma.c
@@ -50,6 +50,7 @@
 #define RDMA_FIFO_PSEUDO_SIZE(bytes)			(((bytes) / 16) << 16)
 #define RDMA_OUTPUT_VALID_FIFO_THRESHOLD(bytes)		((bytes) / 16)
 #define RDMA_FIFO_SIZE(rdma)			((rdma)->data->fifo_size)
+#define DISP_REG_RDMA_THRESHOLD_FOR_SODI	0x00a8
 #define DISP_RDMA_MEM_START_ADDR		0x0f00
 
 #define RDMA_MEM_GMC				0x40402020
@@ -72,6 +73,7 @@ struct mtk_disp_rdma_data {
 	unsigned int fifo_size;
 	const u32 *formats;
 	size_t num_formats;
+	bool sodi;	/* the SPM's SODI: the FIFO decides the DRAM requests */
 };
 
 /*
@@ -181,6 +183,35 @@ void mtk_rdma_stop(struct device *dev)
 	rdma_update_bits(dev, DISP_REG_RDMA_GLOBAL_CON, RDMA_ENGINE_EN, 0);
 }
 
+/*
+ * The FIFO levels between which the RDMA lets DRAM go to self-refresh in the
+ * SPM's SODI (MT6771, vendor rdma_set_ultra_l() for RDMA0 without a shared
+ * SRAM): below the low one it asks for DRAM, above the high one it lets it
+ * go. In FIFO entries (16 bytes), from what the panel takes per µs with a
+ * quarter's margin, rounded up: low covers 10 µs (the 5 µs ultra level and
+ * 5 µs for the SPM to bring DRAM back); high is the FIFO less the vendor's
+ * refill margin (1200 x (fill - take) / 10^6, filling at the MM clock's low
+ * rate, 300 MHz), at least the 9 µs pre-ultra level. 720x720 at 60 Hz, 3
+ * bytes a pixel, 320 entries: 80 and 265.
+ */
+static u32 rdma_sodi_threshold(unsigned int width, unsigned int height,
+			       unsigned int vrefresh, unsigned int fifo_entries)
+{
+	u64 bytes_ms = div_u64((u64)width * height * (vrefresh ?: 60) * 3, 1000);
+	u32 per_us = DIV_ROUND_UP((u32)div_u64(bytes_ms * 1250, 16000 * 100), 10);
+	u32 fill = 960 * 300 * 3 / 16;	/* entries per ms, x1000 per us */
+	u32 low = (5 * 10 + 50) * per_us / 10;
+	u32 high = 9 * per_us;
+	u32 room;
+
+	if (fill > per_us * 1000) {
+		room = 1200 * (fill - per_us * 1000) / 1000000;
+		if (fifo_entries > room)
+			high = max(high, fifo_entries - room);
+	}
+	return min(low, fifo_entries) | (min(high, fifo_entries) << 16);
+}
+
 void mtk_rdma_config(struct device *dev, unsigned int width,
 		     unsigned int height, unsigned int vrefresh,
 		     unsigned int bpc, struct cmdq_pkt *cmdq_pkt)
@@ -211,6 +242,11 @@ void mtk_rdma_config(struct device *dev, unsigned int width,
 	      RDMA_FIFO_PSEUDO_SIZE(rdma_fifo_size) |
 	      RDMA_OUTPUT_VALID_FIFO_THRESHOLD(threshold);
 	mtk_ddp_write(cmdq_pkt, reg, &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_FIFO_CON);
+
+	if (rdma->data->sodi)
+		mtk_ddp_write(cmdq_pkt,
+			      rdma_sodi_threshold(width, height, vrefresh, rdma_fifo_size / 16),
+			      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_THRESHOLD_FOR_SODI);
 }
 
 static unsigned int rdma_fmt_convert(struct mtk_disp_rdma *rdma,
@@ -396,6 +432,13 @@ static const struct mtk_disp_rdma_data mt8183_rdma_driver_data = {
 	.num_formats = ARRAY_SIZE(mt8173_formats),
 };
 
+static const struct mtk_disp_rdma_data mt6771_rdma_driver_data = {
+	.fifo_size = 5 * SZ_1K,
+	.formats = mt8173_formats,
+	.num_formats = ARRAY_SIZE(mt8173_formats),
+	.sodi = true,
+};
+
 static const struct mtk_disp_rdma_data mt8195_rdma_driver_data = {
 	.fifo_size = 1920,
 	.formats = mt8173_formats,
@@ -405,6 +448,8 @@ static const struct mtk_disp_rdma_data mt8195_rdma_driver_data = {
 static const struct of_device_id mtk_disp_rdma_driver_dt_match[] = {
 	{ .compatible = "mediatek,mt2701-disp-rdma",
 	  .data = &mt2701_rdma_driver_data},
+	{ .compatible = "mediatek,mt6771-disp-rdma",
