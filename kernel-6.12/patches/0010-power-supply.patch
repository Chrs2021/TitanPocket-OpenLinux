 drivers/power/supply/Makefile         |   1 +
 drivers/power/supply/mt6370-charger.c | 190 +++++++++-
 drivers/power/supply/oz8806_battery.c | 525 ++++++++++++++++++++++++++
 4 files changed, 721 insertions(+), 2 deletions(-)

