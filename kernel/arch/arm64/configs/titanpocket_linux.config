# Titan Pocket: fragment for a plain (non-Android) Linux userspace.
# Apply on top of titanpocket_defconfig:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/titanpocket_defconfig \
#       arch/arm64/configs/titanpocket_linux.config && make olddefconfig

CONFIG_LOCALVERSION="-titanpocket"
# Native gcc in the build container, not the Android toolchain
CONFIG_CROSS_COMPILE=""
# CONFIG_LOCALVERSION_AUTO is not set

# Vendor sensor/EEPROM drivers have no source (yet)
CONFIG_CUSTOM_KERNEL_IMGSENSOR=""
CONFIG_CUSTOM_KERNEL_CAM_CAL_DRV=""

# Keyboard (halium-11.0 reverse-engineered AW9523 driver)
CONFIG_MTK_AW9523=y

# systemd / generic distro requirements
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_IPV6=y
# CONFIG_UEVENT_HELPER is not set

# Framebuffer text console on the MTK fb so early userspace is visible
CONFIG_EXPERT=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_8x16=y

# USB networking gadget for SSH during bring-up
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y

# Root on ext4 / initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# kheaders needs Android prebuilt cpio; not useful here
# CONFIG_IKHEADERS is not set

# Battery fuel gauge (reverse-engineered from stock)
CONFIG_BATTERY_OZ8806=y

# Userspace I2C access for bring-up (i2cget/i2cdump)
CONFIG_I2C_CHARDEV=y

# FS1860 speaker amp (MTK speaker_amp hook)
CONFIG_SND_SOC_FS1860=y

# debugfs (MTK audio/display debug dumps)
CONFIG_DEBUG_FS=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# Keyboard touchpad: Synaptics RMI4 (F01/F12) + board glue
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_2D_SENSOR=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
# CONFIG_RMI4_F55 is not set
CONFIG_INPUT_TITANPOCKET_TOUCHPAD=y

# DRM core for the Panfrost backport (phase 1: core + scheduler, vgem smoke test)
CONFIG_DRM=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_VGEM=y
# Panfrost (Mali-G72), replaces kbase (docs/gpu.md)
# module during bring-up: blacklisted, loaded by hand (docs/gpu.md)
CONFIG_DRM_PANFROST=m
# page-table library with the backported Mali LPAE format
CONFIG_IOMMU_IO_PGTABLE_LPAE=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_DRM_MEDIATEK is not set

# Bluetooth for BlueZ (MT6631 BT reaches it through /dev/stpbt + a VHCI bridge)
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIVHCI=y
CONFIG_UHID=y
CONFIG_DRM_MTKFB_KMS=m

# Cameras: V4L2 + media controller for the titan_camera module (docs/camera.md)
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEOBUF2_DMA_SG=y
# /dev/udmabuf (backported from 4.20): libcamera software ISP buffers
CONFIG_UDMABUF=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_RC_SUPPORT is not set
# CONFIG_MEDIA_CEC_SUPPORT is not set
# CONFIG_MEDIA_USB_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
# CONFIG_V4L_PLATFORM_DRIVERS is not set
# CONFIG_V4L_MEM2MEM_DRIVERS is not set
# CONFIG_V4L_TEST_DRIVERS is not set
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
# CONFIG_VIDEO_IR_I2C is not set
