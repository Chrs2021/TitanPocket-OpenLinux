# The modem's AT channels (titan_modem's at_dlci, in that order) by name, as
# /dev/radio/<name>. ModemManager gets cmd1 for commands (the first port is its
# primary) and noti for URCs; the others are for what needs its own channel. After ModemManager's own rules (80).
SUBSYSTEM!="wwan", GOTO="titan_modem_end"
KERNEL!="wwan0at*", GOTO="titan_modem_end"
ENV{ID_MM_PORT_IGNORE}="1"
KERNEL=="wwan0at0", SYMLINK+="radio/cmd1", ENV{ID_MM_PORT_IGNORE}=""
KERNEL=="wwan0at1", SYMLINK+="radio/noti", ENV{ID_MM_PORT_IGNORE}=""
KERNEL=="wwan0at2", SYMLINK+="radio/cmd4"
KERNEL=="wwan0at3", SYMLINK+="radio/cmd2"
KERNEL=="wwan0at4", SYMLINK+="radio/cmd3"
KERNEL=="wwan0at5", SYMLINK+="radio/atci"
KERNEL=="wwan0at6", SYMLINK+="radio/cmd7"
KERNEL=="wwan0at7", SYMLINK+="radio/cmd8"
KERNEL=="wwan0at8", SYMLINK+="radio/cmd9"
KERNEL=="wwan0at9", SYMLINK+="radio/cmd10"
KERNEL=="wwan0at10", SYMLINK+="radio/cmd11"
KERNEL=="wwan0at11", SYMLINK+="radio/2cmd1"
KERNEL=="wwan0at12", SYMLINK+="radio/2noti"
KERNEL=="wwan0at13", SYMLINK+="radio/2cmd4"
KERNEL=="wwan0at14", SYMLINK+="radio/2cmd2"
KERNEL=="wwan0at15", SYMLINK+="radio/2cmd3"
KERNEL=="wwan0at16", SYMLINK+="radio/2atci"
KERNEL=="wwan0at17", SYMLINK+="radio/2cmd7"
KERNEL=="wwan0at18", SYMLINK+="radio/2cmd8"
KERNEL=="wwan0at19", SYMLINK+="radio/2cmd9"
KERNEL=="wwan0at20", SYMLINK+="radio/2cmd10"
KERNEL=="wwan0at21", SYMLINK+="radio/2cmd11"
KERNEL=="wwan0at22", SYMLINK+="radio/nwcmd"
KERNEL=="wwan0at23", SYMLINK+="radio/nwurc"
LABEL="titan_modem_end"
