#!/usr/bin/python3
"""
titan-powerkey: power button → screen off + suspend to RAM, volume keys →
speaker volume (Titan Pocket).

Volume keys (screen on only) step the speaker level (0-VOL_MAX) by
VOL_STEP; the FS1860 amp ("Speaker Amp Volume", 0-255, 0.5 dB a step) is set
on a dB curve from it (amp_value), capped at VOL_MAX so it never goes full
blast. Volume
keys are read from every input device that has them: the side rocker
(mtk-kpd) and a headset's buttons (ACCDET).

There is one speaker level, kept in /var/lib/titan-audio/volume and shared
with the panel's volume indicator, the Sound app's "All apps" slider
(titan-mixer) and titan-speakerd, which re-applies it whenever it powers the
amp on (the codec's chip init writes full gain). It's re-read before every
step and re-applied at start and after resume. PipeWire's own sink volumes
are kept at 100 % (a key press re-pins them) so they can't quietly scale
everything down.

While an app owns the volume keys (titan-remote sends a TV's volume), it
writes its PID into VOL_KEYS_GRABBED; the grab is ignored once that process
is gone, so a crashed app can't leave the keys dead.

  awake      short press → lock, blank the panel, suspend ("mem", deep)
             if the kernel refuses (e.g. USB cable connected): stay
             "screen off" and retry every RETRY_S seconds; while a
             charger or computer is plugged in, or a userspace wakelock
             is held, it doesn't try at all, it looks again every
             RETRY_S seconds
  awake      held 3 s, unlocked → the power menu (the shell's)
  screen off short press → panel on
  asleep     the power key wakes the SoC; its press is swallowed and the
             panel comes back. Any other wake source (RTC alarm, cable
             plugged in, ...) → straight back to sleep, panel stays off.

The saved screen brightness (titan-brightness) is applied at start and every
time the screen comes back on.

Screenshot: the red key (left side, KEY_RED = 250 on mtk-kpd) together with
volume up, in either order, while the screen is on. The frame on the panel
(fbgrab) is saved as ~/Pictures/Screenshots/Screenshot_<date>_<time>.png,
where Photos finds it; the backlight dips for a moment as a shutter. Volume
up doesn't change the volume while the red key is held, and a step made just
before the red key joined it is undone.

Locking: before blanking, the Weston session is asked to lock (the file
LOCK_REQUEST, which the compositor takes and deletes) and the panel goes
dark once the lock screen is up (LOCKED_FLAG, at most LOCK_WAIT_S), so the
lock screen is what's there when it comes back on. The compositor has no
power key binding of its own.

The power menu: the key held HOLD_MENU_S while the screen is on and the
session unlocked (no LOCKED_FLAG) clicks the vibration motor and asks the
Weston shell for its power menu (the file POWER_MENU_REQUEST, which the
compositor takes and deletes). If it's still there after POWER_MENU_WAIT_S
(no shell that has one), the titan-power-menu app starts instead. Let go
after that, the key does nothing more. Held on the lock screen it does
nothing.

The compositor asks for the screen off too: when the session goes idle
([core] idle-time, the Display app's Screen timeout) it locks and writes
"off" into the FIFO CTL_FIFO, which does what a short press does while the
screen is on (and nothing while it's off).

Wakelocks: writing "mem" to /sys/power/state doesn't look at them (that
needs the wakeup_count handshake), so the ones userspace holds
(/sys/power/wake_lock) are checked here. titan-gnss-open holds one while
the GPS runs: the chip wakes the SoC about once a second then, and a resume
with the GPS running can crash the CONNSYS chip (docs/power.md).

TITAN_SLEEP_WIFI=off takes Wi-Fi down while asleep (experimental): while
associated, the CONNSYS chip wakes the SoC within ~0.5 s even with the
driver's suspend mode (measured, docs/power.md). wpa_supplicant and
systemd-networkd reconnect when the link comes back up.

The panel is blanked through mtkfb (fb0 blank = FB_BLANK_POWERDOWN), which
runs MediaTek's display suspend (panel + backlight off, display wakelock
released). On Linux 6.12 (no lcd-backlight LED) Weston holds the DRM card,
so an fbdev blank does nothing; the backlight's level is set to 0 instead
(the PWM off, which is dark on this board) and the display pipeline stays
on until suspend, which turns it off. Its bl_power doesn't hold: the panel
is linked to the backlight, so every panel enable sets bl_power back to on. Presses between SHORT_PRESS_S and HOLD_MENU_S are left alone;
the PMIC resets the phone after holding the key for ~10 s.
"""
import errno
import os
import select
import struct
import subprocess
import sys
import syslog
import threading
import time
import zlib

EVENT = struct.Struct("llHHi")      # struct input_event (64-bit)
EV_KEY = 1
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
KEY_POWER = 116
KEY_RED = 250                       # the red key on the left (mtk-kpd 0xfa)
SHOT_DIR = "/root/Pictures/Screenshots"
FBGRAB = "/usr/local/bin/fbgrab"     # the panned 720x720 XRGB area of fb0
SHOT_W = SHOT_H = 720
BACKLIGHT_LED = "/sys/class/leds/lcd-backlight/brightness"
# Linux 6.12: upstream pwm-backlight, the same PWM high time out of 1023
BACKLIGHT_612 = "/sys/class/backlight/backlight/brightness"
ON_612 = not os.path.exists(BACKLIGHT_LED)
BACKLIGHT = BACKLIGHT_612 if ON_612 else BACKLIGHT_LED
VOL_CONTROL = "Speaker Amp Volume"
# the amp's volume is 0.5 dB a step (fs1860.c): the level spreads over
# AMP_RANGE_DB below VOL_MAX (1.5 dB a key step) instead of one to one, which
# put 40 % 82 dB down. Same curve in titan-mixer and titan-speakerd.
AMP_RANGE_DB = 42.0
AMP_STEP_DB = 0.5
VOL_FILE = "/var/lib/titan-audio/volume"
VOL_DEFAULT = 160
VOL_STEP = 8
VOL_MAX = 224
# while this file names a live process, that app owns the volume keys
# (titan-remote sends the TV's volume instead)
VOL_KEYS_GRABBED = "/run/titan-volume-keys.grab"
# PipeWire runs in root's user session; its sinks stay at 100 %
PIPEWIRE_RUNTIME = "/run/user/0"
# the volume keys' tones (userspace/debian/sounds/gen-sounds.py): a rising
# major arpeggio up, a falling minor one down, at the level just set. A
# sleeping speaker (the PCM closed) takes ~250 ms to wake (titan-speakerd),
# so then the copy with silence in front (-cold) plays.
SOUNDS = "/usr/local/share/titan/sounds"
SPEAKER_PCM = ("/proc/asound/card0/pcm0p/sub0/status"     # 6.12: DL1
               if os.path.exists("/proc/asound/titanpocket")
               else "/proc/asound/card0/pcm7p/sub0/status")
PIPEWIRE_SINKS = ("titan-speaker-limited", "titan-speaker")
PIN_INTERVAL_S = 10
SHORT_PRESS_S = 1.5
HOLD_MENU_S = 3.0
POWER_MENU = "/usr/local/bin/titan-power-menu"     # if the shell has none
# to the compositor: the power menu (it deletes the file)
POWER_MENU_REQUEST = "/run/titan-power-menu.request"
POWER_MENU_WAIT_S = 1.0
VIBRATE = "/usr/local/bin/titan-vibrate"
# the Weston session (titan-desktop.service, root's)
WAYLAND_DISPLAY = "wayland-1"
# from the compositor: exists while the lock screen is up
LOCKED_FLAG = "/run/titan-locked"
# to the compositor: lock now (it deletes the file)
LOCK_REQUEST = "/run/titan-lock.request"
LOCK_WAIT_S = 0.6
LOCK_SETTLE_S = 0.08                # a frame or two for the lock screen
RETRY_S = 30
WAKE_WINDOW_S = 1.5                  # wait for the waking key press after resume
FB_BLANK = "/sys/class/graphics/fb0/blank"
# exists while the screen is off (titan-kbd keeps the keyboard backlight dark)
SCREEN_OFF_FLAG = "/run/titan-screen.off"
WLAN_CMD = "/usr/local/bin/titan-wlan-cmd"
WAKE_LOCKS = "/sys/power/wake_lock"     # the userspace wakelocks held now
CTL_FIFO = "/run/titan-powerkey.ctl"   # "off" from the compositor (idle)
WIFI_IF = "wlan0"
# off by default: taking wlan0 down before suspend (with Bluetooth on) hung
# the phone once (hardware watchdog reset, 2026-10-12) - under investigation
WIFI_OFF_IN_SLEEP = os.environ.get("TITAN_SLEEP_WIFI", "on") == "off"


def log(msg):
    syslog.syslog(syslog.LOG_INFO, msg)


def key_devices(code):
    """(path, name) of every input device that can send key `code`"""
    found = []
    for name in sorted(os.listdir("/dev/input")):
        if not name.startswith("event"):
            continue
        base = "/sys/class/input/%s/device" % name
        try:
            caps = open(base + "/capabilities/key").read().split()
            dev = open(base + "/name").read().strip()
        except OSError:
            continue
        # bitmap, most significant word first, 64-bit words
        words = [int(w, 16) for w in reversed(caps)]
        idx, bit = divmod(code, 64)
        if idx < len(words) and words[idx] >> bit & 1:
            found.append(("/dev/input/" + name, dev))
    return found


def find_power_key():
    for path, dev in key_devices(KEY_POWER):
        if dev in ("mtk-kpd", "mtk-pmic-keys") or "kpd" in dev:
            return path, dev
    return None, None


def keys_grabbed():
    """True while a live app owns the volume keys; clears a stale grab"""
    try:
        data = open(VOL_KEYS_GRABBED).read().strip()
    except OSError:
        return False
    try:
        cmdline = open("/proc/%d/cmdline" % int(data), "rb").read()
        if b"titan-remote" in cmdline:
            return True
    except (OSError, ValueError):
        pass
    log("volume keys: dropping stale grab (%s)" % (data or "no pid"))
    try:
        os.unlink(VOL_KEYS_GRABBED)
    except OSError:
        pass
    return False


def amp_value(level):
    """the amp's volume for a speaker level (0 mutes)"""
    if level <= 0:
        return 0
    return round(VOL_MAX - AMP_RANGE_DB * (1 - level / VOL_MAX) / AMP_STEP_DB)


def write(path, value):
    with open(path, "w") as f:
        f.write(value)


def background(cmd, env=None):
    """run without waiting (the screen-on path must stay instant)"""
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, env=env)
    except OSError as e:
        log("%s: %s" % (cmd[0], e))


class Tones:
    """one tone at a time: a new step cuts the last one short (a held key)"""
    def __init__(self):
        self.proc = None

    def play(self, name):
        try:
            awake = open(SPEAKER_PCM).read().strip() != "closed"
        except OSError:
            awake = True
        path = os.path.join(SOUNDS, name + ("" if awake else "-cold") + ".wav")
        if not os.path.exists(path):
            return
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
        try:
            self.proc = subprocess.Popen(
                ["pw-play", path], env=dict(os.environ, XDG_RUNTIME_DIR=PIPEWIRE_RUNTIME),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            log("pw-play: %s" % e)


TONES = Tones()


def wifi_suspend_mode(on):
    """The Wi-Fi driver's suspend mode, as Android sets it with the screen
    off: the firmware gets the IP addresses (it answers ARP and neighbour
    solicitations itself and drops those for other hosts), and multicast
    narrows to IPv6 router advertisements. Without it every broadcast on the
    network (a router checking its clients sends a few a second) wakes the
    SoC while asleep."""
    if not os.path.exists("/sys/class/net/wlan0"):
        return
    try:
        subprocess.run([WLAN_CMD, "SETSUSPENDMODE", "1" if on else "0"], timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as e:
        log("wifi suspend mode: %s" % e)


def time_sync(on):
    """systemd-timesyncd off while the screen is off. Every resume counts as a
    clock change (hrtimers_resume -> clock_was_set), so it sends an NTP query
    after each wake; the phone is back asleep before the reply arrives, and
    the reply (unicast, a legitimate WoWLAN wake) wakes it again: a loop of
    ~0.7 s sleeps. The RTC keeps time meanwhile; it syncs at screen-on."""
    try:
        subprocess.run(["systemctl", "start" if on else "stop", "systemd-timesyncd"],
                       timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as e:
        log("time sync: %s" % e)


def panel(on):
    try:
        if on:
            os.unlink(SCREEN_OFF_FLAG)
        else:
            open(SCREEN_OFF_FLAG, "w").close()
    except OSError:
        pass
    try:
        if not ON_612:
            write(FB_BLANK, "0" if on else "4")
        elif not on:
            write(BACKLIGHT_612, "0")   # on: brightness() below restores it
    except OSError as e:
        log("panel %s: %s" % ("on" if on else "off", e))
    if on:
        # light first: the panel stays black until the backlight is set, and
        # a second press during that gap turned the screen off again
        brightness()
        if os.path.exists("/sys/class/net/wlan0"):
            background([WLAN_CMD, "SETSUSPENDMODE", "0"])
        background(["systemctl", "start", "systemd-timesyncd"])
    else:
        # these must be done before the SoC sleeps
        wifi_suspend_mode(True)
        time_sync(False)


def brightness():
    """re-apply the saved screen brightness (titan-brightness). Write 0 to the
    LED first. The display driver caches both the level and the PWM's enable
    bit and skips writes that match its cache: restoring the same level left
    the panel dark, and after deep suspend (the display power domain off) the
    PWM comes back with EN=0 while the driver still thinks it is enabled, so
    any level stayed dark. Level 0 clears the enable bit in the driver; the
    next level sets it again in the hardware."""
    if not ON_612:
        try:
            write(BACKLIGHT_LED, "0")
        except OSError:
            pass
    try:
        subprocess.run(["/usr/local/bin/titan-brightness", "apply"], timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass


def wifi(up):
    if not WIFI_OFF_IN_SLEEP or not os.path.exists("/sys/class/net/" + WIFI_IF):
        return
    os.system("ip link set %s %s" % (WIFI_IF, "up" if up else "down"))


class Volume:
    """
    The speaker level (amp gain, 0-VOL_MAX) is shared through VOL_FILE: the
    volume keys here, the mixer's "All apps" slider (titan-mixer), the
    panel's volume indicator and titan-speakerd all use it. 0 is muted.
    """
    def __init__(self):
        self.level = VOL_DEFAULT
        self.pinned_at = 0.0
        self.reload()
        self.apply()

    def reload(self):
        try:
            self.level = max(0, min(VOL_MAX, int(open(VOL_FILE).read())))
        except (OSError, ValueError):
            pass

    def apply(self):
        os.system("tinymix -D 0 set '%s' %d >/dev/null 2>&1" % (VOL_CONTROL,
                                                             amp_value(self.level)))

    def pin_pipewire(self):
        """keep PipeWire's sinks at 100 %, unmuted (in the background)"""
        now = time.monotonic()
        if now - self.pinned_at < PIN_INTERVAL_S:
            return
        self.pinned_at = now

        def run():
            env = dict(os.environ, XDG_RUNTIME_DIR=PIPEWIRE_RUNTIME)
            for sink in PIPEWIRE_SINKS:
                for args in (["set-sink-volume", sink, "100%"], ["set-sink-mute", sink, "0"]):
                    try:
                        subprocess.run(["pactl"] + args, env=env, timeout=3,
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    except (OSError, subprocess.TimeoutExpired):
                        return
        threading.Thread(target=run, daemon=True).start()

    def step(self, up):
        self.pin_pipewire()
        self.reload()               # the mixer may have changed it
        new = max(0, min(VOL_MAX, self.level + (VOL_STEP if up else -VOL_STEP)))
        if new == self.level:
            return False
        self.set(new)
        return True

    def set(self, new):
        self.level = new
        self.apply()
        try:
            os.makedirs(os.path.dirname(VOL_FILE), exist_ok=True)
            tmp = VOL_FILE + ".tmp"
            with open(tmp, "w") as f:
                f.write("%d\n" % new)
            os.replace(tmp, VOL_FILE)
        except OSError:
            pass


def write_png(path, w, h, xrgb):
    """XRGB8888 (B, G, R, X bytes) to an RGB PNG, written whole then renamed
    so a folder watcher never sees half a file"""
    rgb = bytearray(w * h * 3)
    rgb[0::3] = xrgb[2::4]
    rgb[1::3] = xrgb[1::4]
    rgb[2::3] = xrgb[0::4]
    stride = w * 3
    raw = b"".join(b"\0" + bytes(rgb[y * stride:(y + 1) * stride]) for y in range(h))

    def chunk(kind, body):
        return (struct.pack(">I", len(body)) + kind + body +
                struct.pack(">I", zlib.crc32(kind + body) & 0xffffffff))
    data = (b"\x89PNG\r\n\x1a\n" +
            chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) +
            chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def screenshot():
    """grab the panel now, save it in the background, dip the backlight"""
    try:
        frame = subprocess.run([FBGRAB], capture_output=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        log("screenshot: %s" % e)
        return
    if len(frame) < SHOT_W * SHOT_H * 4:
        log("screenshot: short frame (%d bytes)" % len(frame))
        return

    def save():
        name = time.strftime("Screenshot_%Y-%m-%d_%H-%M-%S.png")
        try:
            os.makedirs(SHOT_DIR, exist_ok=True)
            write_png(os.path.join(SHOT_DIR, name), SHOT_W, SHOT_H, frame)
            log("screenshot: %s" % name)
        except OSError as e:
            log("screenshot: %s" % e)
    threading.Thread(target=save, daemon=True).start()

    # the shutter: the backlight dips, then the saved level comes back
    try:
        level = int(open(BACKLIGHT).read())
        write(BACKLIGHT, str(max(1, level // 5)))
        time.sleep(0.12)
    except (OSError, ValueError):
        pass
    brightness()


def session_up():
    return os.path.exists(os.path.join(PIPEWIRE_RUNTIME, WAYLAND_DISPLAY))


def lock_session():
    """ask Weston to lock and wait until its lock screen is up, so that's
    what the panel shows when it comes back on"""
    if os.path.exists(LOCKED_FLAG) or not session_up():
        return
    try:
        open(LOCK_REQUEST, "w").close()
    except OSError as e:
        log("lock: %s" % e)
        return
    deadline = time.monotonic() + LOCK_WAIT_S
    while not os.path.exists(LOCKED_FLAG):
        if time.monotonic() > deadline:
            log("lock: no lock screen after %.1f s" % LOCK_WAIT_S)
            return
        time.sleep(0.02)
    time.sleep(LOCK_SETTLE_S)


def power_menu():
    """the key held while the screen is on: the power menu, unless locked"""
    if os.path.exists(LOCKED_FLAG):
        log("power key held on the lock screen: ignored")
        return
    if not session_up():
        log("power key held: no Weston session")
        return
    log("power key held: power menu")
    background([VIBRATE, "click"])
    try:
        open(POWER_MENU_REQUEST, "w").close()
    except OSError as e:
        log("power menu: %s" % e)
        return

    def fallback():
        """the shell didn't take it: the app"""
        try:
            os.unlink(POWER_MENU_REQUEST)
        except OSError:
            return              # taken
        log("power menu: no shell menu, starting %s" % POWER_MENU)
        background([POWER_MENU], env=dict(os.environ, XDG_RUNTIME_DIR=PIPEWIRE_RUNTIME,
                                          WAYLAND_DISPLAY=WAYLAND_DISPLAY, HOME="/root"))
    threading.Timer(POWER_MENU_WAIT_S, fallback).start()


def plugged():
    """A charger or computer on the USB port: the kernel refuses suspend then
    (the cable-detect interrupt aborts it at the noirq stage)."""
    for s in ("usb", "ac"):
        try:
            with open("/sys/class/power_supply/%s/online" % s) as f:
                if f.read().strip() == "1":
                    return True
        except OSError:
            pass
    return False


def wake_locks():
    """the names of the userspace wakelocks held now"""
    try:
        with open(WAKE_LOCKS) as f:
            return f.read().split()
    except OSError:
        return []


def suspend():
    """True after a real suspend/resume cycle, False if the kernel refused."""
    os.sync()
    try:
        write("/sys/power/state", "mem")
        return True
    except OSError as e:
        if e.errno not in (errno.EBUSY, errno.EAGAIN):
            log("suspend: %s" % e)
        return False


def open_ctl():
    """the compositor's FIFO, opened read-write so it never reads EOF"""
    try:
        if os.path.exists(CTL_FIFO) and not os.path.isfile(CTL_FIFO):
            os.unlink(CTL_FIFO)
        os.mkfifo(CTL_FIFO, 0o600)
    except FileExistsError:
        pass
    except OSError as e:
        log("%s: %s" % (CTL_FIFO, e))
        return None
    try:
        return os.open(CTL_FIFO, os.O_RDWR | os.O_NONBLOCK)
    except OSError as e:
        log("%s: %s" % (CTL_FIFO, e))
        return None


class PowerKey:
    def __init__(self, path, volume=None, volume_paths=()):
        self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        self.ctl = open_ctl()
        self.screen_on = True       # "off" requests count only while on
        # other devices with volume keys (headset buttons); volume only
        self.volume_fds = []
        for p in volume_paths:
            try:
                self.volume_fds.append(os.open(p, os.O_RDONLY | os.O_NONBLOCK))
            except OSError as e:
                log("volume keys: %s: %s" % (p, e))
        self.pressed_at = None
        self.on_hold = None         # called once the key is held HOLD_MENU_S
        self.volume = volume        # stepped on volume keys while set
        # the screenshot chord: red key + volume up
        self.red_down = False
        self.volup_down = False
        self.last_up = None         # (when, level before) of the last up step

    def drain(self):
        for fd in [self.fd] + self.volume_fds:
            try:
                while os.read(fd, EVENT.size * 64):
                    pass
            except BlockingIOError:
                pass
        self.pressed_at = None

    def volume_event(self, code, value):
        if code == KEY_VOLUMEUP:
            self.volup_down = value != 0
            if self.red_down:           # the chord: no volume change
                if value == 1 and self.screen_on:
                    screenshot()
                return
        if self.volume and value in (1, 2) and not keys_grabbed():   # press, autorepeat
            before = self.volume.level
            up = code == KEY_VOLUMEUP
            if self.volume.step(up):
                if self.screen_on and self.volume.level > 0:   # muted: nothing to hear
                    TONES.play("vol-up" if up else "vol-down")
                if up:
                    self.last_up = (time.monotonic(), before)

    def red_event(self, value):
        self.red_down = value != 0
        if value != 1 or not self.volup_down or not self.screen_on:
            return
        # volume up came first: undo the step it just made, then shoot
        if (self.volume and self.last_up and
                time.monotonic() - self.last_up[0] < 2.0):
            self.volume.set(self.last_up[1])
        self.last_up = None
        screenshot()

    def wait_press(self, timeout=None):
        """Wait for a short press (on release); False on timeout. A key held
        HOLD_MENU_S calls on_hold (if set) and its release is ignored."""
        deadline = None if timeout is None else time.monotonic() + timeout
        while True:
            now = time.monotonic()
            left = None if deadline is None else max(0.0, deadline - now)
            hold = None
            if self.on_hold and self.pressed_at is not None:
                hold = max(0.0, self.pressed_at + HOLD_MENU_S - now)
                left = hold if left is None else min(left, hold)
            fds = [self.fd] + self.volume_fds + ([self.ctl] if self.ctl is not None else [])
            r, _, _ = select.select(fds, [], [], left)
            if not r:
                if hold is not None and time.monotonic() >= self.pressed_at + HOLD_MENU_S:
                    self.pressed_at = None      # the release does nothing
                    self.on_hold()
                    continue
                if deadline is not None and time.monotonic() >= deadline:
                    return False
                continue
            if self.ctl is not None and self.ctl in r:
                try:
                    msg = os.read(self.ctl, 256)
                except BlockingIOError:
                    msg = b""
                if b"off" in msg and self.screen_on:
                    log("idle: screen off")
                    return True     # as a press would
            for fd in r:
                if fd == self.fd or fd == self.ctl:
                    continue
                try:
                    data = os.read(fd, EVENT.size * 64)
                except BlockingIOError:
                    continue
                for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    _, _, typ, code, value = EVENT.unpack_from(data, i)
                    if typ == EV_KEY and code in (KEY_VOLUMEUP, KEY_VOLUMEDOWN):
                        self.volume_event(code, value)
            if self.fd not in r:
                continue
            try:
                data = os.read(self.fd, EVENT.size * 64)
            except BlockingIOError:
                continue
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, typ, code, value = EVENT.unpack_from(data, i)
                if typ == EV_KEY and code in (KEY_VOLUMEUP, KEY_VOLUMEDOWN):
                    self.volume_event(code, value)
                    continue
                if typ == EV_KEY and code == KEY_RED:
                    self.red_event(value)
                    continue
                if typ != EV_KEY or code != KEY_POWER:
                    continue
                if value == 1:
                    self.pressed_at = time.monotonic()
                elif value == 0 and self.pressed_at is not None:
                    held = time.monotonic() - self.pressed_at
                    self.pressed_at = None
                    if held < SHORT_PRESS_S:
                        return True


def main():
    path, name = find_power_key()
    if not path:
        print("titan-powerkey: no input device with KEY_POWER", file=sys.stderr)
        return 1
    syslog.openlog("titan-powerkey")
    log("power key: %s (%s)" % (path, name))
    volume = Volume()
    brightness()
    time_sync(True)             # in case a restart left it stopped (screen off)
    others = [p for p, d in key_devices(KEY_VOLUMEUP) if p != path]
    for p in others:
        log("volume keys also from %s" % p)
    key = PowerKey(path, volume, others)
    while True:
        key.volume = volume         # screen on: volume keys work
        key.screen_on = True
        key.on_hold = power_menu
        key.wait_press()
        key.on_hold = None
        key.volume = None
        key.screen_on = False
        lock_session()
        log("screen off, suspending")
        panel(False)
        wifi(False)
        held_before = []
        while True:
            # plugged in: don't even try (each refused attempt froze every
            # process, suspended every device and, before WoWLAN was set,
            # dropped the Wi-Fi connection); look again every RETRY_S
            if plugged():
                if key.wait_press(RETRY_S):
                    break
                continue
            held = wake_locks()
            if held:
                if held != held_before:
                    log("not suspending: wakelock %s" % " ".join(held))
                held_before = held
                if key.wait_press(RETRY_S):
                    break
                continue
            t0 = time.time()
            if suspend():
                log("slept %.1f s" % (time.time() - t0))
                # woke up: was it the power key?
                if key.wait_press(WAKE_WINDOW_S) or key.pressed_at is not None:
                    key.drain()
                    break
                log("woken by something else, back to sleep")
                continue
            # suspend refused (USB connected, ...): screen stays off
            if key.wait_press(RETRY_S):
                break
        wifi(True)
        panel(True)
        brightness()                # the display driver may restore its own level
        volume.reload()             # the amp may have lost power while asleep
        volume.apply()
        log("screen on")


if __name__ == "__main__":
    sys.exit(main())
