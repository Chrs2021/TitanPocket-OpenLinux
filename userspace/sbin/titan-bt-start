#!/bin/sh
# Start the Bluetooth bridge (/dev/stpbt <-> /dev/vhci -> hci0) with this
# phone's factory address from NVRAM APCFG/APRDEB/BT_Addr (first 6 bytes, in
# display order) and the controller's sleep parameters (bytes 18-24; without
# them the controller never sleeps). The rest are radio settings the
# controller does not need.
NV=/var/lib/titan-bt/bt_addr.bin
modprobe bt_drv
for i in $(seq 50); do [ -e /dev/stpbt ] && break; sleep 0.2; done
titan-nvram-copy APCFG/APRDEB/BT_Addr "$NV" || rm -f "$NV"
addr=
if [ -s "$NV" ]; then
	addr=$(od -An -tx1 -N6 "$NV" | awk '{ printf "%s:%s:%s:%s:%s:%s", $1, $2, $3, $4, $5, $6 }')
	case $addr in 00:00:00:00:00:00|ff:ff:ff:ff:ff:ff) addr= ;; esac
fi
sleep=
if [ -s "$NV" ]; then
	sleep=$(od -An -tx1 -j18 -N7 "$NV" | tr -d ' \n')
	case $sleep in 00000000000000|ffffffffffffff|*[!0-9a-f]*) sleep= ;; esac
	[ ${#sleep} = 14 ] || sleep=
fi
exec titan-btbridge ${addr:+-a "$addr"} ${sleep:+-s "$sleep"}
