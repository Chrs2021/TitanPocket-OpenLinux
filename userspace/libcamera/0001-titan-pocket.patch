+/*
+ * Titan Pocket: manual exposure time and analogue gain (AeEnable,
+ * ExposureTimeMode, AnalogueGainMode, ExposureTime, AnalogueGain), so an
+ * application can meter a scene itself, e.g. for a flash photo, instead of
+ * waiting for the stepwise AE to converge.
+ */
+int Agc::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::AeEnable] = ControlInfo(false, true, true);
+	context.ctrlMap[&controls::ExposureTimeMode] =
+		ControlInfo(controls::ExposureTimeModeValues,
+			    ControlValue(static_cast<int32_t>(controls::ExposureTimeModeAuto)));
+	context.ctrlMap[&controls::AnalogueGainMode] =
+		ControlInfo(controls::AnalogueGainModeValues,
+			    ControlValue(static_cast<int32_t>(controls::AnalogueGainModeAuto)));
+	context.ctrlMap[&controls::ExposureTime] = ControlInfo(1, 1000000, 10000);
+	context.ctrlMap[&controls::AnalogueGain] = ControlInfo(1.0f, 64.0f, 1.0f);
+	return 0;
+}
+
+int Agc::configure(IPAContext &context, [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &agc = context.activeState.agc;
+
+	agc.manualExposure = false;
+	agc.manualGain = false;
+	agc.manualExposureUs = 10000;
+	agc.manualGain_ = 1.0;
+	return 0;
+}
+
+void Agc::queueRequest(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	auto &agc = context.activeState.agc;
+
+	const auto &aeEnable = controls.get(controls::AeEnable);
+	if (aeEnable.has_value())
+		agc.manualExposure = agc.manualGain = !aeEnable.value();
+	const auto &expMode = controls.get(controls::ExposureTimeMode);
+	if (expMode.has_value())
+		agc.manualExposure = expMode.value() == controls::ExposureTimeModeManual;
+	const auto &gainMode = controls.get(controls::AnalogueGainMode);
+	if (gainMode.has_value())
+		agc.manualGain = gainMode.value() == controls::AnalogueGainModeManual;
+	const auto &exposureTime = controls.get(controls::ExposureTime);
+	if (exposureTime.has_value())
+		agc.manualExposureUs = exposureTime.value();
+	const auto &gain = controls.get(controls::AnalogueGain);
+	if (gain.has_value())
+		agc.manualGain_ = gain.value();
+}
+
+void Agc::applyManual(IPAContext &context, IPAFrameContext &frameContext)
