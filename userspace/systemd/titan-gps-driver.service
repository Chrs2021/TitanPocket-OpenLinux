[Unit]
Description=GPS kernel driver (gps_drv: /dev/stpgps over the WMT core)
Requires=titan-wmt.service
After=titan-wmt.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/modprobe gps_drv
ExecStart=/bin/sh -c 'for i in $(seq 50); do [ -e /dev/stpgps ] && exit 0; sleep 0.1; done; echo "/dev/stpgps missing" >&2; exit 1'
