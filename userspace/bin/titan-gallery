#!/usr/bin/python3
"""
titan-gallery: photo gallery for the Titan Pocket (GTK 4, titan_ui4).

- Grid: every JPEG/PNG under ~/Pictures (the Camera app saves into
  ~/Pictures/Camera), newest first, four square thumbnails per row.
- Selecting: hold a photo (or tap Select): it's picked and taps pick or
  unpick more; the header counts them and offers Select all and Delete
  (to the trash, after asking). Back or Escape ends it.
  Thumbnails are made on a worker thread and cached in
  ~/.cache/titan-gallery (keyed by path, size and mtime); new and removed
  files show up by themselves (a file monitor on each folder).
- Viewer: tap a thumbnail. The photo fits the window; swipe or Left/Right
  for the previous/next one, pinch or double-tap to zoom, drag to pan when
  zoomed. The toolbar has back, previous, next, info and delete; delete asks
  first and moves the photo to the trash, it isn't erased: on the SD card
  (where ~/Pictures is, see titan-usb-storage) the card's own .Trash-0,
  reached through /media/sdcard since GIO won't trash on the ~/Pictures bind
  mount; elsewhere ~/.local/share/Trash.
- QR codes: a background thread scans every photo once (newest first;
  the one being viewed jumps the queue), QR only: zxing-cpp at full
  resolution (~0.2 s for 16 MP), then libzbar at 2000 px on the long side
  if that finds nothing (either decoder alone works too). Results
  are cached in ~/.cache/titan-gallery/qr.json by path and mtime. Grid
  tiles of photos with codes get a "QR" badge; the viewer shows each code
  as a chip (what it holds; Copy, and Open for web links: nothing opens
  without a tap).
- titan-gallery PATH opens the viewer on that photo.

Keys: Left/Right previous/next, Escape/Backspace back to the grid,
Delete delete, I info, +/- zoom. On the grid: Escape ends selecting (or
closes), Delete deletes the picked photos.
"""
import ctypes
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
from urllib.parse import urlsplit

import titan_ui4 as ui
import titan_water4 as water
import gi  # noqa: E402

gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Graphene, Gtk, Pango  # noqa: E402

try:
    import numpy as np  # noqa: E402
except ImportError:         # no QR scanning without it
    np = None
try:
    import zxingcpp  # noqa: E402  (python3-zxing-cpp)
except ImportError:
    zxingcpp = None

PICTURES = os.path.expanduser("~/Pictures")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                     "titan-gallery")
EXTENSIONS = (".jpg", ".jpeg", ".png")
COLUMNS = 4                  # the design's grid: 4 across, 3 px apart
THUMB = 177                  # px, square (4 across 720 px)
ZOOM_STEPS = (1.0, 2.0, 4.0)
SWIPE_MIN = 300              # px/s for a page swipe
QR_CACHE = os.path.join(CACHE, "qr.json")
QR_FIRST_SIZE = 2000         # px, long side of the first QR pass
BROWSER = "/usr/local/bin/titan-chromium"

CSS = """
/* selecting: a ring on every photo, white with a check when picked */
.pick { min-width: 26px; min-height: 26px; border-radius: 15px;
        border: 2px solid rgba(255,255,255,0.92); background-color: rgba(0,0,0,0.28);
        color: #141821; font-size: 16px; font-weight: bold; text-shadow: none;
        box-shadow: 0 2px 6px rgba(0,0,0,0.45); }
.pick.on { background-color: #FFFFFF; }
.grid { background: #0B0D12; }
.thumb { background: #1B1E26; }
.empty { color: rgba(255, 255, 255, 0.78); font-size: 20px; }
.viewer { background: black; }
.bar { background: #0B0D12; padding: 8px 12px; }
.caption { color: #d0d0d0; background: rgba(0,0,0,0.55); border-radius: 8px;
           padding: 4px 10px; font-size: 16px; }
.info { color: white; background: rgba(0,0,0,0.75); border-radius: 10px;
        padding: 10px 14px; font-size: 17px; }
.qrbadge { color: #141821; background: #FFD24A; border-radius: 6px; padding: 1px 6px;
           font-size: 12px; font-weight: bold; text-shadow: none; }
.qr { background: rgba(16,16,18,0.82); border-radius: 14px; padding: 6px 8px 6px 10px;
      border: 2px solid rgba(255,255,255,0.15); }
.qrkind { color: #141821; background: #FFD24A; border-radius: 6px; padding: 0 6px;
          font-size: 13px; font-weight: bold; text-shadow: none; }
.qrtext { color: white; font-size: 16px; }
"""

QR_ICON = "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2.5v2.5H14zM18 18h2v2h-2zM14 19h1M19 14h1"
PREV = "M6.5 6v12M18 6.5l-8 5.5 8 5.5z"
NEXT = "M17.5 6v12M6 6.5l8 5.5-8 5.5z"


def same_file_elsewhere(path):
    """The same file through another mount of its filesystem, or None.

    ~/Pictures is a bind mount of the SD card's Pictures folder
    (titan-usb-storage), and GIO refuses to trash there ("Trashing on system
    internal mounts is not supported"); through the card's own mount point
    (/media/sdcard) it uses the card's trash, .Trash-0. From
    /proc/self/mountinfo: the mount holding path, then another mount of the
    same device whose root contains that mount's root."""
    try:
        with open("/proc/self/mountinfo") as f:
            mounts = [line.split() for line in f]
    except OSError:
        return None
    real = os.path.realpath(path)
    best = None
    for m in mounts:            # id parent major:minor root mountpoint ...
        mp = m[4]
        if real == mp or real.startswith(mp.rstrip("/") + "/"):
            if best is None or len(mp) > len(best[4]):
                best = m
    if best is None:
        return None
    dev, root, mp = best[2], best[3], best[4]
    inner = os.path.join(root, os.path.relpath(real, mp)).replace("//", "/")
    for m in mounts:
        if m is best or m[2] != dev:
            continue
        r = m[3].rstrip("/") + "/"
        if inner == m[3] or inner.startswith(r) or m[3] == "/":
            rel = os.path.relpath(inner, m[3])
            other = os.path.normpath(os.path.join(m[4], rel))
            if os.path.exists(other):
                return other
    return None


def trash(path):
    """Move a photo to the trash; through the card's own mount when GIO
    refuses the bind mount. Raises GLib.Error."""
    try:
        Gio.File.new_for_path(path).trash(None)
    except GLib.Error:
        other = same_file_elsewhere(path)
        if other is None:
            raise
        Gio.File.new_for_path(other).trash(None)


def find_photos():
    """(path, mtime) of every photo under ~/Pictures, newest first"""
    found = []
    for dirpath, dirs, files in os.walk(PICTURES):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for name in files:
            if name.lower().endswith(EXTENSIONS) and not name.startswith("."):
                path = os.path.join(dirpath, name)
                try:
                    found.append((path, os.stat(path).st_mtime))
                except OSError:
                    pass
    found.sort(key=lambda p: p[1], reverse=True)
    return found


def thumb_path(path, mtime):
    key = hashlib.sha1(("%s\0%d\0%d" % (path, int(mtime), THUMB)).encode()).hexdigest()
    return os.path.join(CACHE, key + ".png")


def make_thumb(path, mtime):
    """a THUMB x THUMB centre crop, from the cache or made now"""
    cached = thumb_path(path, mtime)
    if os.path.exists(cached):
        try:
            return GdkPixbuf.Pixbuf.new_from_file(cached)
        except GLib.Error:
            pass
    try:
        info = GdkPixbuf.Pixbuf.get_file_info(path)
        w, h = info[1], info[2]
        if not w or not h:
            return None
        scale = THUMB / min(w, h)
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(
            path, max(THUMB, round(w * scale)), max(THUMB, round(h * scale)), True)
        pix = pix.apply_embedded_orientation()
    except (GLib.Error, TypeError):
        return None
    x = (pix.get_width() - THUMB) // 2
    y = (pix.get_height() - THUMB) // 2
    pix = pix.new_subpixbuf(max(0, x), max(0, y), min(THUMB, pix.get_width()),
                            min(THUMB, pix.get_height())).copy()
    try:
        os.makedirs(CACHE, exist_ok=True)
        pix.savev(cached + ".tmp", "png", [], [])
        os.replace(cached + ".tmp", cached)
    except (GLib.Error, OSError):
        pass
    return pix


class QrScanner:
    """libzbar (ctypes), QR codes only"""
    Y800 = 0x30303859
    QRCODE = 64
    lib = None

    @classmethod
    def load(cls):
        if cls.lib is None:
            try:
                z = ctypes.CDLL("libzbar.so.0")
            except OSError:
                cls.lib = False
                return False
            vp, ui, ul = ctypes.c_void_p, ctypes.c_uint, ctypes.c_ulong
            for name, res, args in (
                    ("zbar_image_scanner_create", vp, []),
                    ("zbar_image_scanner_set_config", ctypes.c_int, [vp, ctypes.c_int, ctypes.c_int, ctypes.c_int]),
                    ("zbar_image_create", vp, []),
                    ("zbar_image_destroy", None, [vp]),
                    ("zbar_image_set_format", None, [vp, ul]),
                    ("zbar_image_set_size", None, [vp, ui, ui]),
                    ("zbar_image_set_data", None, [vp, vp, ul, vp]),
                    ("zbar_scan_image", ctypes.c_int, [vp, vp]),
                    ("zbar_image_first_symbol", vp, [vp]),
                    ("zbar_symbol_next", vp, [vp]),
                    ("zbar_symbol_get_type", ctypes.c_int, [vp]),
                    ("zbar_symbol_get_data", vp, [vp]),
                    ("zbar_symbol_get_data_length", ui, [vp])):
                f = getattr(z, name)
                f.restype, f.argtypes = res, args
            cls.lib = z
        return bool(cls.lib)

    def __init__(self):
        z = self.lib
        self.sc = z.zbar_image_scanner_create()
        z.zbar_image_scanner_set_config(self.sc, 0, 0, 0)               # all off...
        z.zbar_image_scanner_set_config(self.sc, self.QRCODE, 0, 1)     # ...but QR

    def scan(self, gray, w, h):
        """the QR codes in a w x h 8-bit image (bytes), as text"""
        z = self.lib
        buf = ctypes.create_string_buffer(gray, len(gray))
        im = z.zbar_image_create()
        z.zbar_image_set_format(im, self.Y800)
        z.zbar_image_set_size(im, w, h)
        z.zbar_image_set_data(im, ctypes.addressof(buf), len(gray), None)
        found = []
        if z.zbar_scan_image(self.sc, im) > 0:
            sym = z.zbar_image_first_symbol(im)
            while sym:
                if z.zbar_symbol_get_type(sym) == self.QRCODE:
                    data = ctypes.string_at(z.zbar_symbol_get_data(sym),
                                            z.zbar_symbol_get_data_length(sym))
                    found.append(data.decode("utf-8", "replace"))
                sym = z.zbar_symbol_next(sym)
        z.zbar_image_destroy(im)
        return found


def pixbuf_gray(pix):
    """a pixbuf as an 8-bit luma array (h x w)"""
    n, rs, w, h = pix.get_n_channels(), pix.get_rowstride(), pix.get_width(), pix.get_height()
    data = pix.get_pixels()
    data = data + bytes(rs * h - len(data))         # the last row isn't padded
    a = np.frombuffer(data, np.uint8).reshape(h, rs)[:, :w * n].reshape(h, w, n)
    g = (a[:, :, 0].astype(np.uint16) * 77 + a[:, :, 1].astype(np.uint16) * 150 +
         a[:, :, 2].astype(np.uint16) * 29) >> 8
    return np.ascontiguousarray(g.astype(np.uint8))


def scan_photo(scanner, path):
    """the QR codes in a photo: zxing-cpp at full size, else zbar at
    QR_FIRST_SIZE (scanner None: no zbar)"""
    try:
        pix = GdkPixbuf.Pixbuf.new_from_file(path)
    except GLib.Error:
        return []
    g = pixbuf_gray(pix)
    del pix
    codes = []
    if zxingcpp is not None:
        codes = [r.text for r in zxingcpp.read_barcodes(
            g, formats=zxingcpp.BarcodeFormat.QRCode) if r.text]
    if not codes and scanner is not None:
        step = max(1, -(-max(g.shape) // QR_FIRST_SIZE))
        small = np.ascontiguousarray(g[::step, ::step])
        codes = scanner.scan(small.tobytes(), small.shape[1], small.shape[0])
    return list(dict.fromkeys(codes))


def qr_describe(text):
    """(kind, what to show, URL to open or None)"""
    t = text.strip()
    if re.match(r"(?i)https?://\S+$", t):
        u = urlsplit(t)
        return "LINK", u.netloc + u.path.rstrip("/") + ("?" + u.query if u.query else ""), t
    if t[:5].upper() == "WIFI:":
        m = re.search(r"(?:^WIFI:|;)S:((?:\\.|[^;])*)", t, re.I)
        ssid = re.sub(r"\\(.)", r"\1", m.group(1)) if m else "?"
        return "WI-FI", "Network \u201c%s\u201d" % ssid, None
    for prefix, kind in (("mailto:", "EMAIL"), ("tel:", "PHONE"), ("geo:", "PLACE"),
                         ("BEGIN:VCARD", "CONTACT"), ("BEGIN:VEVENT", "EVENT")):
        if t[:len(prefix)].lower() == prefix.lower():
            return kind, t[len(prefix):].strip() if ":" in prefix else t, None
    return "TEXT", " ".join(t.split()), None


class PhotoView(Gtk.Widget):
    """the viewer's photo, drawn by the GPU: fitted, or zoomed (1..4 x the
    fit) around a point and panned; the full-size photo is loaded when it's
    first zoomed (the fit is decoded at the view's size, which is quick)"""

    def __init__(self):
        super().__init__()
        self.fit = None             # (texture, w, h): decoded at the view's size
        self.full = None            # texture at full size, once zoomed
        self.zoom = 1.0
        self.pan = (0.0, 0.0)       # the image's centre from the view's, px
        self.set_overflow(Gtk.Overflow.HIDDEN)
        self.add_css_class("viewer")

    def set_photo(self, fit, full=None):
        self.fit, self.full = fit, full
        self.zoom, self.pan = 1.0, (0.0, 0.0)
        self.queue_draw()

    def placed(self, zoom=None, pan=None):
        """where the image is drawn: x, y, w, h"""
        zoom = self.zoom if zoom is None else zoom
        px, py = self.pan if pan is None else pan
        W, H = self.get_width(), self.get_height()
        _, fw, fh = self.fit
        k = min(W / fw, H / fh) * zoom
        w, h = fw * k, fh * k
        # never pan the image off: its edges stay outside the view (or centred)
        px = 0.0 if w <= W else max(-(w - W) / 2, min((w - W) / 2, px))
        py = 0.0 if h <= H else max(-(h - H) / 2, min((h - H) / 2, py))
        return (W - w) / 2 + px, (H - h) / 2 + py, w, h, (px, py)

    def set_zoom(self, zoom, cx=None, cy=None):
        """zoom relative to the fit, keeping (cx, cy) in place"""
        if not self.fit:
            return
        zoom = max(1.0, min(ZOOM_STEPS[-1], zoom))
        W, H = self.get_width(), self.get_height()
        cx = W / 2 if cx is None else cx
        cy = H / 2 if cy is None else cy
        x, y, w, h, _ = self.placed()
        u, v = (cx - x) / w, (cy - y) / h       # the point under the finger, in the image
        k = zoom / self.zoom
        nw, nh = w * k, h * k
        pan = (cx - u * nw - (W - nw) / 2, cy - v * nh - (H - nh) / 2)
        self.zoom = zoom
        self.pan = self.placed(pan=pan)[4]
        self.queue_draw()

    def move(self, start, dx, dy):
        self.pan = self.placed(pan=(start[0] + dx, start[1] + dy))[4]
        self.queue_draw()

    def do_snapshot(self, s):
        if not self.fit:
            return
        x, y, w, h, _ = self.placed()
        tex = self.full if self.zoom > 1.0 and self.full else self.fit[0]
        s.append_texture(tex, Graphene.Rect().init(x, y, w, h))


class Gallery(ui.AppWindow):
    def __init__(self, app, start=None):
        self.select_btn = ui.GlassButton("Select", height=46, size=17)
        self.select_btn.connect("clicked", lambda b: self.start_selecting())
        self.all_btn = ui.GlassButton("All", height=46, size=17)
        self.all_btn.connect("clicked", lambda b: self.select_all())
        self.del_btn = ui.GlassButton(icon=ui.ICONS["trash"], height=46, kind="destructive")
        self.del_btn.set_tooltip_text("Delete the picked photos")
        self.del_btn.connect("clicked", lambda b: self.delete_selected())
        super().__init__(app, "Photos", " ", on_back=self.go_back,
                         actions=[self.select_btn, self.all_btn, self.del_btn])
        ui.add_css(self.get_display(), CSS)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        self.photos = []            # [(path, mtime)]
        self.selecting = False      # picking photos (hold one, or Select)
        self.selected = set()       # their paths
        self.tiles = {}             # path -> its tile in the grid
        self.index = 0              # the photo in the viewer
        self.monitors = []
        self.generation = 0         # thumbnail jobs of an older scan are dropped
        self.refresh_pending = 0
        # QR codes: path -> [mtime, [codes]], and the scanning thread's queue
        self.qr = {}
        try:
            with open(QR_CACHE) as f:
                self.qr = json.load(f)
        except (OSError, ValueError):
            pass
        self.qr_queue = []
        self.qr_cond = threading.Condition()
        if np is not None and (zxingcpp is not None or QrScanner.load()):
            threading.Thread(target=self.qr_worker, daemon=True).start()
        else:
            self.qr_cond = None

        self.build()
        self.rescan()
        self.show_count()
        if start and os.path.exists(start):
            paths = [p for p, _ in self.photos]
            if os.path.abspath(start) in paths:
                GLib.idle_add(self.open_viewer, paths.index(os.path.abspath(start)))

    # ---- layout ----

    def build(self):
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        # the design's photo frame: the grid edge to edge, the glass header
        # and the filter floating over it
        self.float_over(self.stack)

        # grid page
        self.flow = Gtk.FlowBox()
        self.flow.set_valign(Gtk.Align.START)
        self.flow.set_max_children_per_line(COLUMNS)
        self.flow.set_min_children_per_line(COLUMNS)
        self.flow.set_homogeneous(True)
        self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flow.set_activate_on_single_click(True)
        self.flow.set_row_spacing(3)
        self.flow.set_column_spacing(3)
        # room to scroll the first and last rows out from under the floating
        # header and filter
        self.flow.set_margin_top(84)
        self.flow.set_margin_bottom(84)
        self.flow.set_filter_func(self.filter_tile)
        self.flow.connect("child-activated", self.on_tile)
        # hold a photo to start picking photos
        self.hold = Gtk.GestureLongPress()
        self.hold.connect("pressed", self.on_hold)
        self.flow.add_controller(self.hold)
        self.held = False           # the tap that ends a hold opens nothing
        self.empty = ui.label("No photos yet.\nThe Camera app saves into ~/Pictures/Camera.",
                              "empty", xalign=0.5)
        self.empty.set_justify(Gtk.Justification.CENTER)
        self.empty.set_vexpand(True)
        grid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        grid.add_css_class("grid")
        grid.append(self.flow)
        grid.append(self.empty)
        frame = Gtk.Overlay()
        frame.set_child(ui.scroll(grid))
        self.filter = "all"
        self.filters = ("all", "camera", "qr")
        self.nav = water.NavSlider([("All", ui.ICONS["photo"]), ("Camera", ui.ICONS["camera"]),
                                    ("With QR", QR_ICON)])
        self.nav.set_size_request(470, -1)
        self.nav.set_halign(Gtk.Align.CENTER)
        self.nav.set_valign(Gtk.Align.END)
        self.nav.set_margin_bottom(16)
        self.nav.connect("changed", lambda n, i: self.on_filter(self.filters[i]))
        frame.add_overlay(self.nav)
        self.stack.add_named(frame, "grid")

        # viewer page: the photo, its caption, info and QR chips, a toolbar
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        page.add_css_class("viewer")
        self.stack.add_named(page, "viewer")
        overlay = Gtk.Overlay()
        overlay.set_vexpand(True)
        page.append(overlay)
        self.view = PhotoView()
        overlay.set_child(self.view)
        self.caption = ui.label("", "caption", xalign=0.5)
        self.caption.set_halign(Gtk.Align.CENTER)
        self.caption.set_valign(Gtk.Align.START)
        self.caption.set_margin_top(8)
        self.caption.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        overlay.add_overlay(self.caption)
        self.info = ui.label("", "info")
        self.info.set_halign(Gtk.Align.CENTER)
        self.info.set_valign(Gtk.Align.CENTER)
        self.info.set_visible(False)
        overlay.add_overlay(self.info)
        self.qr_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.qr_box.set_valign(Gtk.Align.END)
        self.qr_box.set_halign(Gtk.Align.FILL)
        for side in ("start", "end", "bottom"):
            getattr(self.qr_box, "set_margin_" + side)(10)
        overlay.add_overlay(self.qr_box)

        bar = Gtk.Box(spacing=10)
        bar.add_css_class("bar")
        page.append(bar)
        for icon, cb in ((ui.ICONS["back"], lambda b: self.close_viewer()),
                         (PREV, lambda b: self.step(-1)),
                         (NEXT, lambda b: self.step(1)),
                         (ui.ICONS["info"], lambda b: self.toggle_info())):
            b = ui.GlassButton(icon=icon, height=56)
            b.connect("clicked", cb)
            bar.append(b)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bar.append(spacer)
        b = ui.GlassButton(icon=ui.ICONS["trash"], height=56, kind="destructive")
        b.connect("clicked", lambda b: self.delete_current())
        bar.append(b)

        # gestures: swipe pages, pinch zooms, double-tap steps the zoom,
        # drag pans
        self.swipe = Gtk.GestureSwipe()
        self.swipe.connect("swipe", self.on_swipe)
        self.view.add_controller(self.swipe)
        self.pinch = Gtk.GestureZoom()
        self.pinch.connect("begin", self.on_pinch_begin)
        self.pinch.connect("scale-changed", self.on_pinch)
        self.pinch.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        self.view.add_controller(self.pinch)
        self.taps = Gtk.GestureClick()
        self.taps.connect("pressed", self.on_taps)
        self.view.add_controller(self.taps)
        self.drag = Gtk.GestureDrag()
        self.drag.connect("drag-begin", self.on_drag_begin)
        self.drag.connect("drag-update", self.on_drag_update)
        self.view.add_controller(self.drag)

    # ---- the photo list ----

    def make_tile(self, path, mtime):
        """a grid tile: the thumbnail (filled in later), the QR badge, the
        pick mark"""
        tile = Gtk.Overlay()
        tile.path = path
        tile.mtime = mtime
        tile.img = Gtk.Picture()
        tile.img.set_content_fit(Gtk.ContentFit.COVER)
        tile.img.set_can_shrink(True)
        tile.has_thumb = False
        tile.img.set_size_request(THUMB, THUMB)
        tile.img.add_css_class("thumb")
        tile.set_child(tile.img)
        tile.badge = ui.label("QR", "qrbadge")
        tile.badge.set_halign(Gtk.Align.END)
        tile.badge.set_valign(Gtk.Align.START)
        tile.badge.set_margin_top(6)
        tile.badge.set_margin_end(6)
        tile.badge.set_visible(False)
        tile.add_overlay(tile.badge)
        tile.pick = ui.label("", "pick", xalign=0.5)
        tile.pick.set_halign(Gtk.Align.START)
        tile.pick.set_valign(Gtk.Align.START)
        tile.pick.set_margin_top(8)
        tile.pick.set_margin_start(8)
        tile.pick.set_visible(False)
        tile.add_overlay(tile.pick)
        return tile

    def rescan(self):
        """bring the grid up to date with ~/Pictures, in place: tiles of
        photos that went are taken out, new ones go in at their place, the
        rest stay as they are (no reflow, the scroll position kept)"""
        self.refresh_pending = 0
        photos = find_photos()
        if photos == self.photos:
            return False
        self.photos = photos
        self.generation += 1
        now = dict(photos)
        for path, tile in list(self.tiles.items()):
            if now.get(path) != tile.mtime:     # gone, or changed
                child = tile.get_parent()
                if child is not None:
                    self.flow.remove(child)
                del self.tiles[path]
        pending = []
        for i, (path, mtime) in enumerate(photos):     # newest first
            tile = self.tiles.get(path)
            if tile is None:
                tile = self.make_tile(path, mtime)
                self.flow.insert(tile, i)
                self.tiles[path] = tile
                pending.append((path, mtime, tile))
            elif not tile.has_thumb:
                # its thumbnail was still to come from a scan that this one
                # replaces (a delete during the first thumbnailing)
                pending.append((path, mtime, tile))
            tile.badge.set_visible(bool(self.qr_codes(path, mtime)))
        keep = self.tiles
        self.selected &= set(keep)  # deleted elsewhere: no longer picked
        self.show_picks()
        self.qr_enqueue([(p, m) for p, m in photos if self.qr_codes(p, m) is None])
        self.empty.set_visible(not photos)
        self.set_title("Photos (%d)" % len(photos) if photos else "Photos")
        self.show_count()
        if pending:
            gen = self.generation
            threading.Thread(target=self.thumb_worker, args=(pending, gen), daemon=True).start()
        self.watch()
        if self.stack.get_visible_child_name() == "viewer":
            if not photos:
                self.close_viewer()
            else:
                self.index = min(self.index, len(photos) - 1)
                self.show_photo()
        return False

    # ---- QR codes ----

    def qr_codes(self, path, mtime):
        """the cached codes of a photo, or None if not scanned yet"""
        e = self.qr.get(path)
        return e[1] if e and e[0] == int(mtime) else None

    def qr_enqueue(self, items, first=False):
        if not self.qr_cond:
            return
        with self.qr_cond:
            for it in items:
                if it in self.qr_queue:
                    self.qr_queue.remove(it)
            self.qr_queue = (list(items) + self.qr_queue) if first else (self.qr_queue + list(items))
            self.qr_cond.notify()

    def qr_worker(self):
        try:
            os.setpriority(os.PRIO_PROCESS, threading.get_native_id(), 10)
        except (OSError, AttributeError):
            pass
        scanner = QrScanner() if QrScanner.load() else None
        while True:
            with self.qr_cond:
                while not self.qr_queue:
                    self.qr_cond.wait()
                path, mtime = self.qr_queue.pop(0)
            if self.qr_codes(path, mtime) is not None or not os.path.exists(path):
                continue
            codes = scan_photo(scanner, path)
            GLib.idle_add(self.qr_done, path, mtime, codes)

    def qr_done(self, path, mtime, codes):
        self.qr[path] = [int(mtime), codes]
        live = {p for p, _ in self.photos}
        self.qr = {p: e for p, e in self.qr.items() if p in live}
        try:
            os.makedirs(CACHE, exist_ok=True)
            with open(QR_CACHE + ".tmp", "w") as f:
                json.dump(self.qr, f)
            os.replace(QR_CACHE + ".tmp", QR_CACHE)
        except OSError:
            pass
        tile = self.tiles.get(path)
        if tile is not None and tile.mtime == mtime:
            tile.badge.set_visible(bool(codes))
            if self.filter == "qr":
                self.flow.invalidate_filter()
                self.show_count()
        if path == self.current() and self.stack.get_visible_child_name() == "viewer":
            self.show_qr()
        return False

    def show_qr(self):
        """the viewed photo's codes as chips (scanning it first if needed)"""
        while self.qr_box.get_first_child():
            self.qr_box.remove(self.qr_box.get_first_child())
        if not self.photos:
            return
        path, mtime = self.photos[self.index]
        codes = self.qr_codes(path, mtime)
        if codes is None:
            self.qr_enqueue([(path, mtime)], first=True)
            return
        for text in codes[:3]:
            self.qr_box.append(self.qr_chip(text))

    def qr_chip(self, text):
        kind, shown, url = qr_describe(text)
        chip = Gtk.Box(spacing=8)
        chip.add_css_class("qr")
        badge = ui.label("QR · " + kind, "qrkind")
        badge.set_valign(Gtk.Align.CENTER)
        chip.append(badge)
        lab = ui.label(shown, "qrtext", wrap=True, ellipsize=True)
        lab.set_lines(2)
        lab.set_hexpand(True)
        chip.append(lab)
        if url:
            b = ui.GlassButton("Open", height=42, size=15, kind="suggested")
            b.set_valign(Gtk.Align.CENTER)
            b.connect("clicked", lambda b: self.qr_open(url))
            chip.append(b)
        b = ui.GlassButton("Copy", height=42, size=15)
        b.set_valign(Gtk.Align.CENTER)
        b.connect("clicked", lambda b: self.qr_copy(text))
        chip.append(b)
        return chip

    def qr_copy(self, text):
        self.get_clipboard().set_content(Gdk.ContentProvider.new_for_bytes(
            "text/plain;charset=utf-8", GLib.Bytes.new(text.encode())))
        self.note("Copied")

    def qr_open(self, url):
        try:
            subprocess.Popen([BROWSER, url], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            self.note("Opening link…")
        except OSError as e:
            self.note("Can't open: %s" % e)

    def note(self, text):
        """a short message in the caption"""
        old = self.caption.get_text()
        self.caption.set_text(text)
        GLib.timeout_add(1200, lambda: (self.caption.get_text() == text and
                                        self.caption.set_text(old), False)[1])

    def thumb_worker(self, jobs, gen):
        for path, mtime, tile in jobs:
            if gen != self.generation:
                return              # a newer scan asks for what's left
            pix = make_thumb(path, mtime)
            if pix:
                GLib.idle_add(self.set_thumb, tile, mtime, pix)

    def set_thumb(self, tile, mtime, pix):
        # still right for the tile, whichever scan asked for it
        if tile.mtime == mtime:
            tile.img.set_paintable(Gdk.Texture.new_for_pixbuf(pix))
            tile.has_thumb = True
        return False

    def watch(self):
        """file monitors on ~/Pictures and every folder below"""
        for m in self.monitors:
            m.cancel()
        self.monitors = []
        dirs = [PICTURES] + [os.path.join(d, n) for d, ds, _ in os.walk(PICTURES)
                             for n in ds if not n.startswith(".")]
        for d in dirs:
            try:
                m = Gio.File.new_for_path(d).monitor_directory(Gio.FileMonitorFlags.NONE, None)
            except GLib.Error:
                continue
            m.connect("changed", self.on_changed)
            self.monitors.append(m)

    def on_changed(self, *a):
        # a photo being written fires several events: rescan once it settles
        if self.refresh_pending:
            GLib.source_remove(self.refresh_pending)
        self.refresh_pending = GLib.timeout_add(600, self.rescan)

    # ---- the filter (All, Camera, With QR) ----

    def shown(self, path, mtime):
        if self.filter == "camera":
            return os.path.dirname(path) == os.path.join(PICTURES, "Camera")
        if self.filter == "qr":
            return bool(self.qr_codes(path, mtime))
        return True

    def filter_tile(self, child):
        tile = child.get_child()
        return self.shown(tile.path, tile.mtime)

    def on_filter(self, key):
        self.filter = key
        self.flow.invalidate_filter()
        if self.selecting:
            self.show_picks()
        else:
            self.show_count()

    def show_count(self):
        if self.selecting:          # the header says what's picked
            return
        n = sum(1 for p, m in self.photos if self.shown(p, m))
        where = {"all": "All photos", "camera": "Camera", "qr": "With QR codes"}[self.filter]
        self.header.set_subtitle("%s · %d photo%s" % (where, n, "" if n == 1 else "s"))

    # ---- selecting (hold a photo, or Select) ----

    def on_hold(self, gesture, x, y):
        child = self.flow.get_child_at_pos(int(x), int(y))
        if child is None:
            return
        # the hold is ours: the flow box doesn't also take it as a tap
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        self.held = True
        if shutil.which("titan-vibrate"):
            subprocess.Popen(["titan-vibrate", "tick"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        path = child.get_child().path
        if not self.selecting:
            self.start_selecting()
        self.selected.add(path)
        self.show_picks()

    def start_selecting(self):
        self.selecting = True
        self.show_picks()

    def stop_selecting(self):
        self.selecting = False
        self.selected.clear()
        self.show_picks()

    def select_all(self):
        shown = {p for p, m in self.photos if self.shown(p, m)}
        if shown <= self.selected:
            self.selected -= shown          # all picked already: none
        else:
            self.selected |= shown
        self.show_picks()

    def go_back(self):
        """the header's back button, Esc: out of the viewer, out of
        selecting, or close"""
        if self.stack.get_visible_child_name() == "viewer":
            self.close_viewer()
        elif self.selecting:
            self.stop_selecting()
        else:
            self.close()

    def show_picks(self):
        """the tiles' pick marks and the header, for the selection"""
        for path, tile in self.tiles.items():
            on = path in self.selected
            tile.pick.set_visible(self.selecting)
            tile.pick.set_text("✓" if on else "")
            (tile.pick.add_css_class if on else tile.pick.remove_css_class)("on")
            tile.img.set_opacity(0.6 if on else 1.0)
        self.select_btn.set_visible(not self.selecting)
        self.all_btn.set_visible(self.selecting)
        self.del_btn.set_visible(self.selecting)
        self.del_btn.set_sensitive(bool(self.selected))
        if self.selecting:
            n = len(self.selected)
            shown = {p for p, m in self.photos if self.shown(p, m)}
            self.all_btn.set_label("None" if shown and shown <= self.selected else "All")
            self.header.set_title("%d selected" % n if n else "Select photos")
            self.header.set_subtitle("Tap photos to pick them")
        else:
            self.header.set_title("Photos")
            self.show_count()

    def delete_selected(self):
        paths = sorted(self.selected)
        if not paths:
            return
        n = len(paths)

        def really():
            failed = 0
            for path in paths:
                try:
                    trash(path)
                except GLib.Error:
                    failed += 1
            self.stop_selecting()
            self.rescan()
            if failed:
                self.header.set_subtitle("%d could not be deleted" % failed)
        self.confirm("Delete %d photo%s?" % (n, "" if n == 1 else "s"),
                     "They go to the trash." if n > 1 else "It goes to the trash.",
                     "Delete", really)

    def on_tile(self, flow, child):
        if self.held:               # the end of a hold, not a tap
            self.held = False
            return
        if self.selecting:
            path = child.get_child().path
            self.selected ^= {path}
            self.show_picks()
            return
        paths = [p for p, _ in self.photos]
        self.open_viewer(paths.index(child.get_child().path))

    # ---- viewer ----

    def open_viewer(self, index):
        self.index = index
        self.stack.set_visible_child_name("viewer")
        self.show_header(False)             # the photo gets the whole screen
        self.info.set_visible(False)
        self.show_photo()
        return False

    def close_viewer(self):
        self.stack.set_visible_child_name("grid")
        self.show_header(True)
        self.view.set_photo(None)

    def step(self, d):
        if not self.photos:
            return
        self.index = (self.index + d) % len(self.photos)
        self.show_photo()

    def current(self):
        return self.photos[self.index][0] if self.photos else None

    def show_photo(self):
        path = self.current()
        if not path:
            return
        w = max(self.view.get_width(), 720)
        h = max(self.view.get_height(), 600)
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, w, h, True)
            pix = pix.apply_embedded_orientation()
        except GLib.Error as e:
            self.view.set_photo(None)
            self.caption.set_text("%s: %s" % (os.path.basename(path), e.message))
            return
        self.view.set_photo((Gdk.Texture.new_for_pixbuf(pix), pix.get_width(), pix.get_height()))
        self.caption.set_text("%s  ·  %d / %d" % (os.path.basename(path), self.index + 1,
                                                 len(self.photos)))
        self.show_qr()
        if self.info.get_visible():
            self.toggle_info(update=True)

    def set_zoom(self, zoom, cx=None, cy=None):
        """zoom relative to the fitted size, keeping (cx, cy) in place; the
        full-size photo is decoded the first time"""
        path = self.current()
        if not path or not self.view.fit:
            return
        if zoom > 1.0 and self.view.full is None:
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file(path).apply_embedded_orientation()
                self.view.full = Gdk.Texture.new_for_pixbuf(pix)
            except GLib.Error:
                return
        self.view.set_zoom(zoom, cx, cy)

    def on_taps(self, gesture, n, x, y):
        if n == 2:
            nxt = [z for z in ZOOM_STEPS if z > self.view.zoom + 0.01]
            self.set_zoom(nxt[0] if nxt else 1.0, x, y)

    def on_pinch_begin(self, gesture, seq):
        self.pinch_start = self.view.zoom

    def on_pinch(self, gesture, scale):
        ok, x, y = gesture.get_bounding_box_center()
        self.set_zoom(self.pinch_start * scale, x if ok else None, y if ok else None)

    def on_swipe(self, gesture, vx, vy):
        if self.view.zoom > 1.0 or abs(vx) < SWIPE_MIN or abs(vx) < abs(vy):
            return
        self.step(-1 if vx > 0 else 1)

    def on_drag_begin(self, gesture, x, y):
        self.drag_from = self.view.pan

    def on_drag_update(self, gesture, dx, dy):
        if self.view.zoom > 1.0:
            self.view.move(self.drag_from, dx, dy)

    def toggle_info(self, update=False):
        if self.info.get_visible() and not update:
            self.info.set_visible(False)
            return
        path = self.current()
        if not path:
            return
        try:
            st = os.stat(path)
            fmt, w, h = GdkPixbuf.Pixbuf.get_file_info(path)
        except (OSError, TypeError):
            return
        self.info.set_text("%s\n%d × %d  ·  %.1f MB\n%s\n%s" % (
            os.path.basename(path), w, h, st.st_size / 1e6,
            time.strftime("%Y-%m-%d %H:%M", time.localtime(st.st_mtime)),
            os.path.dirname(path).replace(os.path.expanduser("~"), "~")))
        self.info.set_visible(True)

    def delete_current(self):
        path = self.current()
        if not path:
            return

        def really():
            try:
                trash(path)
            except GLib.Error as e:
                self.caption.set_text("Delete failed: %s" % e.message)
                return
            self.rescan()
        self.confirm("Delete %s?" % os.path.basename(path), "It goes to the trash.",
                     "Delete", really)

    # ---- keys ----

    def on_key(self, ctl, keyval, code, state):
        name = Gdk.keyval_name(keyval) or ""
        if self.stack.get_visible_child_name() != "viewer":
            if name == "Delete" and self.selecting:
                self.delete_selected()
                return True
            return False
        if name in ("Left", "Right"):
            self.step(-1 if name == "Left" else 1)
        elif name == "BackSpace":
            self.close_viewer()
        elif name == "Delete":
            self.delete_current()
        elif name in ("i", "I"):
            self.toggle_info()
        elif name in ("plus", "equal", "KP_Add"):
            self.set_zoom(self.view.zoom * 2)
        elif name in ("minus", "KP_Subtract"):
            self.set_zoom(self.view.zoom / 2)
        else:
            return False
        return True


if __name__ == "__main__":
    start = sys.argv[1] if len(sys.argv) > 1 else None
    sys.exit(ui.run("org.titanpocket.gallery", lambda app: Gallery(app, start),
                    lock="titan-gallery"))
