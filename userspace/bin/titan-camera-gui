    os.environ["GST_PLUGIN_PATH"] = ":".join(
        p for p in (_gst_path, os.environ.get("GST_PLUGIN_PATH")) if p)
os.environ.setdefault("LIBCAMERA_LOG_LEVELS", "*:ERROR")

import numpy as np  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
