# Hardware ISP preview: request YUYV from the driver, so MediaTek's pass-2 ISP
# does demosaic/colour/gamma and the GPU only converts YUYV->RGB for display
# (no debayer). The YUYV node streams at the sensor-mode size; the display
# scales it. Off falls back to the GPU software ISP at PREVIEW (BGRx).
HW_ISP = os.environ.get("TITAN_CAMERA_HWISP", "1") != "0"
PREVIEW = (960, 720)
SETTLE_FRAMES = 15          # auto exposure settles in ~8 frames
HW_SETTLE_FRAMES = 8        # hardware ISP: the still starts at the preview's
                            # exposure and white balance (the driver carries them)
QR_RATE = 5                 # preview frames a second the QR decoder looks at
QR_SIZE = (640, 480)        # ...scaled to this, grayscale
QR_DENSITY = 2              # zbar reads every 2nd line and column
QR_MAX = 3                  # QR chips kept on screen
QR_FRESH_MS = 1200          # a chip stays outlined this long after its code was seen
BROWSER = "/usr/local/bin/titan-chromium"
VIBRATOR = "/sys/class/leds/vibrator"
QR_BUZZ = (40, 90, 40)      # ms on, off, on: a new QR code was found
JPEG_QUALITY = 92

STATE_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or
                         os.path.expanduser("~/.config"), "titan-camera")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
PHOTO_DIR = os.path.expanduser("~/Pictures/Camera")

VIDIOC_G_CTRL = 0xc008561b
VIDIOC_S_CTRL = 0xc008561c
V4L2_CID_FOCUS_ABSOLUTE = 0x009a090a
V4L2_CID_ANALOGUE_GAIN = 0x009e0903
V4L2_CID_EXPOSURE = 0x00980911

# MediaTek flashlight-core ioctls (flashlight.h): struct {type_id, ct_id, arg},
# 1-based ids; type 1 = rear; ct 1 = white LED, ct 2 = warm LED
_FL = ord("S")
FLASH_SET_DRIVER = (3 << 30) | (4 << 16) | (_FL << 8) | 30
FLASH_SET_TIMEOUT = (2 << 30) | (4 << 16) | (_FL << 8) | 100
FLASH_SET_DUTY = (2 << 30) | (4 << 16) | (_FL << 8) | 110
FLASH_SET_ONOFF = (2 << 30) | (4 << 16) | (_FL << 8) | 115
FLASH_SET_SCENARIO = (3 << 30) | (4 << 16) | (_FL << 8) | 215
FLASH_SCENARIO_CAMERA = 1           # coupled (both channels together)
FLASH_PHOTO_LEVEL = 15              # 400 mA per LED (torch maximum)
FLASH_TORCH_LEVEL = 6               # 175 mA per LED
FLASH_PHOTO_TIMEOUT_MS = 6000    # a full-resolution capture takes ~4 s
FLASH_AUTO_GAIN = 512               # analogue gain code, 128 = 1x
FLASH_MODES = ["off", "auto", "on", "torch"]
AF_ASSIST_LEVEL = FLASH_TORCH_LEVEL
# flash metering, in units of the AF statistics' pixel sums (word 3 per
# block, over STAT_NPIX pixels): raw/8, black ~8, clipping at ~119
STAT_NPIX = 146 * 146       # pixels per statistics block (2336x1752 mode)
STAT_BLACK = 8.0
STAT_CLIP = 110.0           # a block above this is (nearly) clipped
# measured against the software ISP's output: block level s maps to about
# 303 x (s / 111) ^ (1 / 2.2) in the photo (its gamma and AWB gains); its own
# AE settles near a centre-weighted 40 with the highlights clipped
METER_TARGET = 32.0         # centre-weighted mean above black (photo ~80)...
METER_HIGHLIGHT = 66.0      # ...with the 97th-percentile block at most this (~240)
METER_START_US = 400        # first pre-flash exposure (gain 1x)
METER_MIN_US = 40
METER_MAX_US = 25600
METER_SETTLE = 3            # frames after the sensor has the new exposure
METER_TIMEOUT_MS = 2500
LINE_US = 2512 / 288.0      # line time of both rear modes (HTS / pixel rate)
FLASH_MIN_LINES = 4         # the sensor's shortest exposure
# Shake: an unsteady hand or a tremor blurs anything much longer than ~1/100 s,
# and the flash is a continuous LED, so it freezes nothing. Photo exposures
# stop there and gain takes over (the driver's auto exposure has the same cap,
# its ae_max_us); then the sharpest frame of a short burst is kept.
PHOTO_MAX_US = 10000
FLASH_MAX_LINES = int(PHOTO_MAX_US / LINE_US)   # then gain
FLASH_MAX_GAIN = 15.5       # the sensor's maximum analogue gain
STILL_BURST = 6             # frames scored for sharpness, the sharpest kept
FLASH_SETTLE_FRAMES = 6     # still frames skipped with a metered exposure
AF_ASSIST_GAIN = FLASH_AUTO_GAIN    # dark: auto exposure is at 4x or more
AF_ASSIST_WAIT_MS = 500             # auto exposure settles on the lit scene
AF_ASSIST_DARK_S = 2.0              # gain is low this long after the light


def vibrate(pattern):
    """the vibration motor: on, off, on, ... (ms), without blocking. The
    BSP driver's LED-class node: a duration, then activate; it stops by
    itself (docs/hardware.md)"""
    def pulse(ms):
        try:
            with open(VIBRATOR + "/duration", "w") as f:
                f.write(str(ms))
            with open(VIBRATOR + "/activate", "w") as f:
                f.write("1")
        except OSError:
            pass
        return False
    t = 0
    for i, ms in enumerate(pattern):
        if i % 2 == 0:
            if t:
                GLib.timeout_add(t, pulse, ms)
            else:
                pulse(ms)
        t += ms


class QrScanner:
    """libzbar (ctypes), QR codes only; one per decoding thread"""
    Y800 = 0x30303859
    QRCODE = 64
    CFG_ENABLE, CFG_X_DENSITY, CFG_Y_DENSITY = 0, 0x100, 0x101
    lib = None

    @classmethod
    def load(cls):
        if cls.lib is None:
            try:
                z = ctypes.CDLL("libzbar.so.0")
            except OSError:
                cls.lib = False
                return False
            vp, ui, ul = ctypes.c_void_p, ctypes.c_uint, ctypes.c_ulong
            for name, res, args in (
                    ("zbar_image_scanner_create", vp, []),
                    ("zbar_image_scanner_set_config", ctypes.c_int, [vp, ctypes.c_int, ctypes.c_int, ctypes.c_int]),
                    ("zbar_image_create", vp, []),
                    ("zbar_image_destroy", None, [vp]),
                    ("zbar_image_set_format", None, [vp, ul]),
                    ("zbar_image_set_size", None, [vp, ui, ui]),
                    ("zbar_image_set_data", None, [vp, vp, ul, vp]),
                    ("zbar_scan_image", ctypes.c_int, [vp, vp]),
                    ("zbar_image_first_symbol", vp, [vp]),
                    ("zbar_symbol_next", vp, [vp]),
                    ("zbar_symbol_get_type", ctypes.c_int, [vp]),
                    ("zbar_symbol_get_data", vp, [vp]),
                    ("zbar_symbol_get_data_length", ui, [vp])):
                f = getattr(z, name)
                f.restype, f.argtypes = res, args
            cls.lib = z
        return bool(cls.lib)

    def __init__(self):
        z = self.lib
        self.sc = z.zbar_image_scanner_create()
        z.zbar_image_scanner_set_config(self.sc, 0, self.CFG_ENABLE, 0)
        z.zbar_image_scanner_set_config(self.sc, self.QRCODE, self.CFG_ENABLE, 1)
        z.zbar_image_scanner_set_config(self.sc, 0, self.CFG_X_DENSITY, QR_DENSITY)
        z.zbar_image_scanner_set_config(self.sc, 0, self.CFG_Y_DENSITY, QR_DENSITY)

    def scan(self, gray, w, h):
        """the QR codes in a w x h 8-bit image (bytes-like), as text"""
        z = self.lib
        buf = (ctypes.c_char * len(gray)).from_buffer_copy(gray)
        im = z.zbar_image_create()
        z.zbar_image_set_format(im, self.Y800)
        z.zbar_image_set_size(im, w, h)
        z.zbar_image_set_data(im, ctypes.addressof(buf), len(gray), None)
        found = []
        if z.zbar_scan_image(self.sc, im) > 0:
            sym = z.zbar_image_first_symbol(im)
            while sym:
                if z.zbar_symbol_get_type(sym) == self.QRCODE:
                    data = ctypes.string_at(z.zbar_symbol_get_data(sym),
                                            z.zbar_symbol_get_data_length(sym))
                    found.append(data.decode("utf-8", "replace"))
                sym = z.zbar_symbol_next(sym)
        z.zbar_image_destroy(im)
        return found


class Flash:
    """both rear flash LEDs through /dev/flashlight"""

    def __init__(self):
        self.fd = None

    def _io(self, req, ct, arg):
        fcntl.ioctl(self.fd, req, struct.pack("=iii", 1, ct, arg))

    def on(self, level, timeout_ms=0):
        self.off()
        try:
            self.fd = os.open("/dev/flashlight", os.O_RDWR | os.O_CLOEXEC)
            self._io(FLASH_SET_DRIVER, 1, 1)
            self._io(FLASH_SET_SCENARIO, 1, FLASH_SCENARIO_CAMERA)
            for ct in (1, 2):
                self._io(FLASH_SET_TIMEOUT, ct, timeout_ms)
                self._io(FLASH_SET_DUTY, ct, level)
            for ct in (1, 2):
                self._io(FLASH_SET_ONOFF, ct, 1)
            return True
        except OSError:
            self.off()
            return False

    def off(self):
        if self.fd is None:
            return
        try:
            for ct in (1, 2):
                self._io(FLASH_SET_ONOFF, ct, 0)
            self._io(FLASH_SET_SCENARIO, 1, 0)
            self._io(FLASH_SET_DRIVER, 1, 0)
        except OSError:
            pass
        os.close(self.fd)
        self.fd = None
V4L2_CID_CAMERA_SENSOR_ROTATION = 0x009a0923   # degrees, counter-clockwise
FOCUS_MAX = 1023

# autofocus
AF_COARSE_STEP = 64
AF_FINE_STEP = 16
AF_SETTLE_NS = 15_000_000   # lens settling after a move
AF_FRAME_NS = 40_000_000    # longest exposure + readout we wait out
AF_REGION = 0.3             # focus region: this fraction of width and height
AF_FRAMES_PER_POS = 2       # frames averaged per lens position: coarse...
AF_FINE_FRAMES = 4          # ...and fine (noisy in dim light)
AF_MIN_RATIO = 1.25         # best/worst sharpness below this: low contrast
AF_HW_MIN_RATIO = 1.15      # the same for the hardware statistics
AF_HW_POLL_MS = 33          # hardware statistics: one frame
AF_HW_SETTLE = 3            # frames after a lens move before a set counts
AF_BASELINE_FRAMES = 8      # frames measured at the focused position
AF_TRACK_FRAMES = 15        # median window while tracking (measured frames)
AF_TRACK_EVERY = 3          # while tracking, measure every third frame
AF_DROP = 0.6               # refocus when sharpness falls below this share...
AF_DROP_FRAMES = 30         # ...for this many frames in a row...
AF_MIN_GAP_S = 3.0          # ...and the last focus is this old
AF_IDLE = ("off", "manual", "hold", "wait")     # states that take no samples


def video_direction(rotation, mirror):
    """GstVideoOrientationMethod nick for a clockwise rotation, then an
    optional horizontal mirror"""
    if not mirror:
        return {0: "identity", 90: "90r", 180: "180", 270: "90l"}[rotation]
    return {0: "horiz", 90: "ul-lr", 180: "vert", 270: "ur-ll"}[rotation]


def read_af_stats(path):
    """(frame, running, words[12][16][10], SGG1 gain) from the driver's
    af_stats, or None"""
    try:
        with open(path, "rb") as f:
            d = f.read()
    except OSError:
        return None
    if len(d) < 32:
        return None
    magic, frame, running, nx, ny, blk, stride, pgn = struct.unpack_from("<8I", d)
    if magic != 0x31464154 or blk != 40 or len(d) < 32 + stride * ny:
        return None
    rows = [np.frombuffer(d, np.uint32, nx * 10, 32 + y * stride).reshape(nx, 10)
            for y in range(ny)]
    return frame, running, np.stack(rows), pgn


def hw_sharpness(words, region, pgn):
    """H0 filter energy (w1) over pixel sum (w3) of the region's blocks. The
    filter energy scales with 1/SGG1 gain (which the driver adjusts to the
    scene brightness), so it is multiplied by the gain"""
    ny, nx = words.shape[:2]
    bw, bh = max(1, round(nx * AF_REGION)), max(1, round(ny * AF_REGION))
    x0 = min(max(int(region[0] * nx - bw / 2 + 0.5), 0), nx - bw)
    y0 = min(max(int(region[1] * ny - bh / 2 + 0.5), 0), ny - bh)
    r = words[y0:y0 + bh, x0:x0 + bw].astype(np.float64)
    light = r[:, :, 3].sum()
    return r[:, :, 1].sum() * pgn / light if light else 0.0


def subdev_node(sysdir):
    """/dev/v4l-subdevN under a sensor's device directory"""
    try:
        for name in os.listdir(os.path.join(sysdir, "video4linux")):
            if name.startswith("v4l-subdev"):
                return "/dev/" + name
    except OSError:
        pass
    return None


def subdev_ctrl(sysdir, cid, value=None):
    """read (value None) or write a control on a sensor subdev; None on error"""
    node = subdev_node(sysdir)
    if not node:
        return None
    try:
        fd = os.open(node, os.O_RDWR)
        try:
            buf = bytearray(struct.pack("=Ii", cid, value or 0))
            fcntl.ioctl(fd, VIDIOC_G_CTRL if value is None else VIDIOC_S_CTRL, buf, True)
            return struct.unpack("=Ii", buf)[1]
        finally:
            os.close(fd)
    except OSError:
        return None


def sharpness(data, w, h, region):
    """gradient energy of the focus region: its luma, binned 2x2 against
    noise, normalised by brightness so auto exposure changes don't look like
    focus changes. BGRx (green at byte 4x+1) or YUYV (Y at byte 2x). Only the
    region is touched, straight in the buffer."""
    stride = len(data) // h
    bpp = max(stride // w, 1)		# 4 BGRx, 2 YUYV
    a = np.frombuffer(data, np.uint8).reshape(h, stride)
    cx, cy = region
    rw, rh = int(w * AF_REGION) & ~1, int(h * AF_REGION) & ~1
    x0 = min(max(int(cx * w) - rw // 2, 0), w - rw) & ~1
    y0 = min(max(int(cy * h) - rh // 2, 0), h - rh) & ~1
    chan = 1 if bpp >= 4 else 0		# green in BGRx, Y in YUYV
    g = a[y0:y0 + rh, bpp * x0 + chan:bpp * (x0 + rw):bpp].astype(np.int32)
    g = g[0::2, 0::2] + g[1::2, 0::2] + g[0::2, 1::2] + g[1::2, 1::2]
    gx = g[:, 1:] - g[:, :-1]
    gy = g[1:, :] - g[:-1, :]
    energy = float((gx * gx).mean() + (gy * gy).mean())
    mean = float(g.mean())
    return energy / (mean * mean + 1024.0)


class AutoFocus:
    """contrast-detect autofocus, driven by sharpness samples (main thread)

    states: off, wait (AF assist light on, exposure settling), sweep
    (coarse), fine, settle (measuring the focused level), track (refocus when
    it drops), hold (low contrast or focused in the dark: no tracking), manual
    """

    def __init__(self, app):
        self.app = app
        self.state = "off"
        self.region = (0.5, 0.5)
        self.pos = app.focus
        self.start_pos = self.pos
        self.moved_at = 0       # pipeline running time of the last move
        self.moved_frame = 0    # the ISP's frame counter then (hardware statistics)
        self.frames = []        # valid samples at the current position
        self.samples = {}       # position -> sharpness
        self.queue = []         # positions still to measure
        self.baseline = None
        self.recent = []
        self.low = 0
        self.focused_at = 0.0

    def start(self, region=None):
        if region:
            self.region = region
        self.start_pos = self.pos
        self.samples = {}
        self.queue = list(range(0, FOCUS_MAX + 1, AF_COARSE_STEP)) + [FOCUS_MAX]
        self.state = "sweep"
        self.app.set_status("Focusing…")
        self.move(self.queue.pop(0))

    def stop(self, manual=False):
        self.state = "manual" if manual else "off"

    def resume(self):
        """keep the lens where it is and watch sharpness from now on"""
        self.frames = []
        self.state = "settle"
        self.moved_at = self.app.running_time()
        self.moved_frame = self.app.af_frame()

    def move(self, pos):
        self.pos = pos
        self.frames = []
        self.app.set_lens(pos)
        self.moved_at = self.app.running_time()
        self.moved_frame = self.app.af_frame()

    def valid(self, pts):
        """a frame whose capture started after the lens settled: a pipeline
        timestamp, or ("hw", ISP frame counter) for the hardware statistics"""
        if isinstance(pts, tuple):
            return (pts[1] - self.moved_frame) & 0xff >= AF_HW_SETTLE
        return pts is not None and pts >= self.moved_at + AF_SETTLE_NS + AF_FRAME_NS

    def on_sample(self, pts, value):
        if self.state in AF_IDLE:
            return
        if self.state == "track":
            self.track(value)
            return
        if not self.valid(pts):
            return
        self.frames.append(value)
        if self.state == "settle":
            if len(self.frames) >= AF_BASELINE_FRAMES:
                self.baseline = float(np.median(self.frames))
                self.recent = []
                self.low = 0
                self.state = "track"
            return
        if len(self.frames) < (AF_FINE_FRAMES if self.state == "fine" else AF_FRAMES_PER_POS):
            return
        value = sum(self.frames) / len(self.frames)
        self.samples[self.pos] = value
        if self.state == "sweep":
            best = max(self.samples, key=self.samples.get)
            past_peak = (self.pos - best >= 3 * AF_COARSE_STEP and
                         value < 0.6 * self.samples[best])
            if self.queue and not past_peak:
                self.move(self.queue.pop(0))
                return
            self.state = "fine"
            self.queue = [p for p in range(best - 3 * AF_FINE_STEP,
                                           best + 3 * AF_FINE_STEP + 1, AF_FINE_STEP)
                          if 0 <= p <= FOCUS_MAX and p not in self.samples]
        if self.queue:
            self.move(self.queue.pop(0))
            return
        # done
        best = max(self.samples, key=self.samples.get)
        ratio = AF_HW_MIN_RATIO if self.app.hw_af else AF_MIN_RATIO
        if self.samples[best] < ratio * min(self.samples.values()):
            self.move(self.start_pos)        # nothing to focus on here
            self.state = "hold"
            self.app.focus_done(None)
            return
        self.move(best)
        self.state = "settle"
        self.focused_at = time.monotonic()
        self.app.focus_done(best)

    def track(self, value):
        self.recent = (self.recent + [value])[-AF_TRACK_FRAMES:]
        if len(self.recent) < AF_TRACK_FRAMES:
            return
        level = float(np.median(self.recent))
        if level > self.baseline:
            self.baseline = 0.95 * self.baseline + 0.05 * level
        if level < AF_DROP * self.baseline:
            self.low += 1
            if self.low >= AF_DROP_FRAMES and time.monotonic() - self.focused_at > AF_MIN_GAP_S:
                self.app.autofocus()
        else:
            self.low = 0


CSS = """
.bar { background: #0B0D12; padding: 8px 12px; }
.thumb { min-width: 60px; min-height: 60px; padding: 0; border-radius: 16px; }
/* glass over the preview */
.status { color: white; background-color: rgba(18, 24, 48, 0.55);
          border: 1px solid rgba(255,255,255,0.40); border-radius: 20px; padding: 6px 16px;
          font-size: 20px;
          box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 6px 18px rgba(0,0,0,0.35); }
.viewer { background: black; }
.afmode { color: #141821; background: #FFD24A; border-radius: 7px;
          padding: 1px 7px; font-size: 14px; font-weight: bold; text-shadow: none; }
.afmode.manual { background: rgba(255, 255, 255, 0.80); }
.qr { background-color: rgba(18, 24, 48, 0.72); border-radius: 24px; padding: 5px 6px 5px 12px;
      border: 1px solid rgba(255,255,255,0.40);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.45), 0 6px 18px rgba(0,0,0,0.35); }
.qr.fresh { border-color: #FFD24A; }
.qrkind { color: #141821; background: #FFD24A; border-radius: 6px; padding: 0 6px;
          font-size: 13px; font-weight: bold; text-shadow: none; }
.qrtext { color: white; font-size: 16px; }
"""

ROTATE = "M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4.5v4.5H15"
FLASH = "M13 3L6 13.5h5L10 21l8-11h-5z"
SWITCH = "M4 8h3.5L9 5.5h6L16.5 8H20v11H4zM9 13.5a3 3 0 0 1 5.6-1.5M15 13.5a3 3 0 0 1-5.6 1.5"
VIEW_BOX = (720, 540)       # the preview is scaled on the GPU to fit about this


class VideoView(Gtk.Widget):
    """the live preview: the newest frame (RGBA, already converted, turned
    and scaled to about this size on the GPU) as a texture, fitted and
    centred on black"""

    def __init__(self):
        super().__init__()
        self.tex = None
        self.frame = (4, 3)
        self.add_css_class("viewer")
        self.set_hexpand(True)
        self.set_vexpand(True)

    def set_frame(self, w, h, stride, data):
        self.tex = Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.R8G8B8A8,
                                         GLib.Bytes.new(data), stride)
        self.frame = (w, h)
        self.queue_draw()

    def clear(self):
        self.tex = None
        self.queue_draw()

    def placed(self):
        """where the frame is drawn: x, y, w, h"""
        W, H = self.get_width(), self.get_height()
        fw, fh = self.frame
        k = min(W / fw, H / fh)
        return (W - fw * k) / 2, (H - fh * k) / 2, fw * k, fh * k

    def do_snapshot(self, s):
        if self.tex is not None:
            x, y, w, h = self.placed()
            s.append_texture(self.tex, Graphene.Rect().init(x, y, w, h))


class CameraApp(ui.AppWindow):
    def __init__(self, app):
        super().__init__(app, "Camera", on_back=self.go_back)
        ui.add_css(self.get_display(), CSS)
        self.connect("close-request", self.on_quit)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        st = self.load_state()
        self.cam = st.get("camera", 0) % len(CAMERAS)
        saved = st.get("rotation", {})
        self.rotation = {c["id"]: saved.get(c["id"], self.driver_rotation(c)) for c in CAMERAS}
        self.focus = st.get("focus", 256)
        self.last_photo = st.get("last_photo")
        self.flash_mode = st.get("flash", "off")
        if self.flash_mode not in FLASH_MODES:
            self.flash_mode = "off"
        self.flash = Flash()

        self.preview = None         # Gst.Pipeline
        self.still = None
        self.busy = False
        self.hw_stats = False       # the driver's ISP AF statistics exist (flash metering)
        self.hw_af = False          # ...and autofocus uses them
        self.hw_timer = 0
        self.hw_last = -1
        self.af = AutoFocus(self)
        self.assist = False         # the AF assist light is on
        self.assist_timer = 0
        self.assist_off_at = 0.0    # monotonic time the assist light went off
        self.frame_pending = False  # a preview frame waits for the main loop

        self.build()
        self.build_preview()
        GLib.idle_add(self.start_preview)

    @staticmethod
    def driver_rotation(c):
        """clockwise correction from the driver's counter-clockwise one"""
        ccw = subdev_ctrl(c["sysdir"], V4L2_CID_CAMERA_SENSOR_ROTATION)
        return (360 - ccw) % 360 if ccw in (0, 90, 180, 270) else c["rotation"]

    # ---- layout ----

    def build(self):
        self.stack = Gtk.Stack()
        # the camera fills the screen; the header gives way to a droplet
        # back button floating over the preview
        self.float_over(self.stack)
        self.show_header(False)

        # camera page: preview with a status overlay, focus row, button bar
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        page.add_css_class("viewer")
        self.stack.add_named(page, "camera")
        overlay = Gtk.Overlay()
        overlay.add_css_class("viewer")
        overlay.set_vexpand(True)
        page.append(overlay)
        self.view = VideoView()
        tap = Gtk.GestureClick()
        tap.connect("released", lambda g, n, x, y: self.on_tap(x, y))
        self.view.add_controller(tap)
        overlay.set_child(self.view)
        self.status = ui.label("", "status", xalign=0.5)
        self.status.set_halign(Gtk.Align.CENTER)
        self.status.set_valign(Gtk.Align.START)
        self.status.set_margin_top(12)
        self.status.set_visible(False)
        overlay.add_overlay(self.status)
        self.qr_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.qr_box.set_valign(Gtk.Align.END)
        self.qr_box.set_halign(Gtk.Align.FILL)
        self.qr_box.set_margin_start(10)
        self.qr_box.set_margin_end(10)
        self.qr_box.set_margin_bottom(10)
        overlay.add_overlay(self.qr_box)    # only as tall as its chips
        self.qr_chips = {}          # code text -> chip
        # the design's back button, a droplet floating over the preview
        back = ui.RoundButton("back", tooltip="Back (Esc)")
        back.set_halign(Gtk.Align.START)
        back.set_valign(Gtk.Align.START)
        back.set_margin_top(12)
        back.set_margin_start(12)
        back.connect("clicked", lambda b: self.close())
        overlay.add_overlay(back)

        # the focus: a water slider, far to near (moving it is manual focus
        # until the next tap)
        self.focus_row = Gtk.Box(spacing=12)
        self.focus_row.add_css_class("bar")
        self.af_label = ui.label("AF", "afmode")
        self.af_label.set_valign(Gtk.Align.CENTER)
        self.focus_row.append(self.af_label)
        self.focus_slider = water.WaterSlider("Far → Near", self.focus, lo=0, hi=FOCUS_MAX,
                                              fmt=lambda v: "%d" % v)
        self.focus_slider.set_hexpand(True)
        self.focus_slider.connect("value-changed", self.on_focus)
        self.focus_row.append(self.focus_slider)
        page.append(self.focus_row)

        bar = Gtk.CenterBox()
        bar.add_css_class("bar")
        page.append(bar)
        left = Gtk.Box(spacing=12)
        self.thumb = Gtk.Button()
        self.thumb.add_css_class("thumb")
        self.thumb.set_valign(Gtk.Align.CENTER)
        self.thumb.connect("clicked", self.on_thumb)
        left.append(self.thumb)
        self.rotate_btn = ui.GlassButton(icon=ROTATE, height=60)
        self.rotate_btn.set_valign(Gtk.Align.CENTER)
        self.rotate_btn.connect("clicked", lambda b: self.rotate())
        left.append(self.rotate_btn)
        self.flash_btn = ui.GlassButton("Off", icon=FLASH, height=60, size=16)
        self.flash_btn.set_valign(Gtk.Align.CENTER)
        self.flash_btn.connect("clicked", lambda b: self.cycle_flash())
        left.append(self.flash_btn)
        bar.set_start_widget(left)
        # the shutter: a big bead of lit water
        self.shutter = water.Droplet("", size=100, radius=42, tint=0.9)
        self.shutter.set_valign(Gtk.Align.CENTER)
        self.shutter.connect("clicked", lambda b: self.take_photo())
        self.shutter.connect("notify::sensitive",
                             lambda w, p: w.set_opacity(1.0 if w.get_sensitive() else 0.45))
        bar.set_center_widget(self.shutter)
        self.switch_btn = ui.GlassButton(icon=SWITCH, height=60)
        self.switch_btn.set_valign(Gtk.Align.CENTER)
        self.switch_btn.connect("clicked", lambda b: self.switch_camera())
        bar.set_end_widget(self.switch_btn)

        # photo page: the last photo, tap to go back
        self.photo_img = Gtk.Picture()
        self.photo_img.add_css_class("viewer")
        self.photo_img.set_can_shrink(True)
        back_tap = Gtk.GestureClick()
        back_tap.connect("released", lambda *a: self.show_camera())
        self.photo_img.add_controller(back_tap)
        self.stack.add_named(self.photo_img, "photo")

        self.update_thumb()

    def set_status(self, text, timeout_ms=0):
        if text:
            self.status.set_text(text)
            self.status.set_visible(True)
        else:
            self.status.set_visible(False)
        if timeout_ms:
            GLib.timeout_add(timeout_ms, self.clear_status, text)

    def clear_status(self, text):
        if self.status.get_text() == text:
            self.status.set_visible(False)
        return False

    def show_af_mode(self):
        manual = self.af.state == "manual"
        self.af_label.set_text("MF" if manual else "AF")
        (self.af_label.add_css_class if manual else self.af_label.remove_css_class)("manual")

    def go_back(self):
        """Esc, Back: from the photo to the camera, or close"""
        if self.stack.get_visible_child_name() == "photo":
            self.show_camera()
        else:
            self.close()

    # ---- state ----

    def load_state(self):
        try:
            with open(STATE_FILE) as f:
                st = json.load(f)
            return st if isinstance(st, dict) else {}
        except (OSError, ValueError):
            return {}

    def save_state(self):
        # only rotations that differ from the driver's are kept
        rot = {c["id"]: self.rotation[c["id"]] for c in CAMERAS
               if self.rotation[c["id"]] != self.driver_rotation(c)}
        st = {"camera": self.cam, "rotation": rot, "focus": self.focus,
              "flash": self.flash_mode,
              "last_photo": self.last_photo}
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            tmp = STATE_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(st, f)
            os.replace(tmp, STATE_FILE)
        except OSError:
            pass

    # ---- preview ----

    def build_preview(self):
        """libcamerasrc -> tee: (1) glupload -> glcolorconvert -> glvideoflip
        -> glcolorscale to about the screen's size, all on the GPU, then
        down to an appsink and into the preview as a texture (GTK 4 has no
        GStreamer GL sink in Debian 12); (2) the frames -> appsink for
        autofocus (the same preview buffers, no copy); (3) QR codes"""
        # the source caps (format + size) are set per camera in
        # configure_preview: YUYV from the hardware ISP, or BGRx from the GPU
        src = ("libcamerasrc name=src ! capsfilter name=srccaps ! "
               "tee name=t ! queue max-size-buffers=2 leaky=downstream ! ")
        af = (" t. ! queue max-size-buffers=1 leaky=downstream ! "
              "appsink name=af emit-signals=true max-buffers=1 drop=true sync=false")
        if QrScanner.load():
            # QR codes: a few frames a second, never blocking the preview
            af += (" t. ! videorate max-rate=%d drop-only=true ! "
                   "queue max-size-buffers=1 leaky=downstream ! videoscale ! "
                   "video/x-raw,width=%d,height=%d ! videoconvert ! "
                   "video/x-raw,format=GRAY8 ! appsink name=qr emit-signals=true "
                   "max-buffers=1 drop=true sync=false" % ((QR_RATE,) + QR_SIZE))
        self.preview = Gst.parse_launch(
            src + "glupload ! glcolorconvert ! glvideoflip name=flip ! glcolorscale ! "
            "capsfilter name=viewcaps ! gldownload ! video/x-raw,format=RGBA ! "
            "appsink name=view emit-signals=true max-buffers=1 drop=true sync=false" + af)
        self.preview.get_by_name("view").connect("new-sample", self.on_view_sample)
        self.preview.get_by_name("af").connect("new-sample", self.on_af_sample)
        qr = self.preview.get_by_name("qr")
        if qr:
            self.qr_scanner = None      # made in the decoding thread
            qr.connect("new-sample", self.on_qr_sample)

        bus = self.preview.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_preview_error)

    def on_view_sample(self, sink):
        """a preview frame (the appsink's thread): copied out and shown from
        the main loop, one at a time (frames that come meanwhile are dropped)"""
        sample = sink.emit("pull-sample")
        if sample is None or self.frame_pending:
            return Gst.FlowReturn.OK
        info = GstVideo.VideoInfo.new_from_caps(sample.get_caps())
        buf = sample.get_buffer()
        ok, m = buf.map(Gst.MapFlags.READ)
        if not ok:
            return Gst.FlowReturn.OK
        data = bytes(m.data)
        buf.unmap(m)
        self.frame_pending = True
        GLib.idle_add(self.show_view_frame, info.width, info.height, info.stride[0], data)
        return Gst.FlowReturn.OK

    def show_view_frame(self, w, h, stride, data):
        self.frame_pending = False
        if self.stack.get_visible_child_name() == "camera":
            self.view.set_frame(w, h, stride, data)
        return False

    def configure_preview(self):
        c = CAMERAS[self.cam]
        self.preview.get_by_name("src").set_property("camera-name", c["id"])
        if HW_ISP:
            w, h = c["hwisp"]
            fmt = "YUY2"		# V4L2 YUYV: the driver's hardware-ISP output
        else:
            w, h = PREVIEW
            fmt = "BGRx"		# the GPU software ISP debayers to this
        caps = Gst.Caps.from_string(
            "video/x-raw,format=%s,width=%d,height=%d" % (fmt, w, h))
        self.preview.get_by_name("srccaps").set_property("caps", caps)
        Gst.util_set_object_arg(self.preview.get_by_name("flip"), "video-direction",
                                video_direction(self.rotation[c["id"]], c["mirror"]))
        # the preview at about the screen's size: turned, its sides swap
        if self.rotation[c["id"]] in (90, 270):
            w, h = h, w
        k = min(VIEW_BOX[0] / w, VIEW_BOX[1] / h)
        vw, vh = int(w * k) // 2 * 2, int(h * k) // 2 * 2
        self.preview.get_by_name("viewcaps").set_property("caps", Gst.Caps.from_string(
            "video/x-raw(memory:GLMemory),format=RGBA,width=%d,height=%d" % (vw, vh)))

    def start_preview(self, refocus=True):
        self.configure_preview()
        ret = self.preview.set_state(Gst.State.PLAYING)
        if ret == Gst.StateChangeReturn.FAILURE:
            self.set_status("Camera not available")
            return False
        self.set_status(None)
        c = CAMERAS[self.cam]
        self.focus_row.set_visible(c["focus"])
        self.show_flash()
        self.apply_torch()
        path = self.af_stats_path()
        self.hw_stats = bool(path and os.path.exists(path))
        # Focus from the hardware statistics only on the software-ISP path.
        # Their filters see the raw sensor noise: in dim light, at high gain,
        # a focus peak the image shows at 2.6x is a 15% bump on a noise floor
        # there (measured, lens swept on a still scene), too weak to find.
        # The hardware-ISP preview is full-size demosaiced YUYV, so the
        # image's own gradient (sharpness()) is the better signal.
        self.hw_af = self.hw_stats and not HW_ISP
        if self.hw_af and not self.hw_timer:
            self.hw_last = -1
            self.hw_timer = GLib.timeout_add(AF_HW_POLL_MS, self.poll_hw_af)
        if c["focus"]:
            self.set_lens(self.focus)
            if self.af.state != "manual" and refocus:
                self.af_wait = 0
                GLib.timeout_add(200, self.autofocus_when_playing)
        self.show_af_mode()
        return False

    # ---- flash ----

    def show_flash(self):
        rear = CAMERAS[self.cam]["focus"]
        self.flash_btn.set_visible(rear)
        self.flash_btn.set_label({"off": "Off", "auto": "Auto", "on": "On",
                                  "torch": "Torch"}[self.flash_mode])
        self.flash_btn.set_kind("suggested" if self.flash_mode != "off" else "")

    def cycle_flash(self):
        if self.busy:
            return
        self.flash_mode = FLASH_MODES[(FLASH_MODES.index(self.flash_mode) + 1) % len(FLASH_MODES)]
        self.save_state()
        self.apply_torch()
        self.show_flash()

    def apply_torch(self):
        """the torch is on while the rear camera runs in torch mode"""
        if self.flash_mode == "torch" and CAMERAS[self.cam]["focus"]:
            if self.flash.fd is None:
                self.flash.on(FLASH_TORCH_LEVEL)
            self.assist = False
        elif not self.busy:
            self.assist_off()
            self.flash.off()

    def dark(self):
        """auto exposure has raised the analogue gain to the flash threshold
        (or did, before the AF assist light lit the scene)"""
        if self.assist or time.monotonic() - self.assist_off_at < AF_ASSIST_DARK_S:
            return True
        gain = subdev_ctrl(CAMERAS[self.cam]["sysdir"], V4L2_CID_ANALOGUE_GAIN)
        return gain is not None and gain >= AF_ASSIST_GAIN

    def needs_assist(self):
        return (CAMERAS[self.cam]["focus"] and self.flash_mode in ("auto", "on")
                and self.dark())

    def assist_on(self):
        if not self.assist:
            self.assist = self.flash.on(AF_ASSIST_LEVEL)

    def assist_off(self):
        if self.assist_timer:
            GLib.source_remove(self.assist_timer)
            self.assist_timer = 0
        if self.assist:
            self.assist = False
            self.assist_off_at = time.monotonic()
            self.flash.off()

    def photo_needs_flash(self):
        if not CAMERAS[self.cam]["focus"] or self.flash_mode == "torch":
            return False
        if self.flash_mode == "on":
            return True
        if self.flash_mode == "auto":
            return self.dark()
        return False

    def stop_preview(self):
        if self.af.state != "manual":
            self.af.stop()
        self.assist_off()
        self.preview.set_state(Gst.State.NULL)

    def running_time(self):
        clock = self.preview.get_clock()
        if not clock:
            return 0
        return clock.get_time() - self.preview.get_base_time()

    def on_preview_error(self, bus, msg):
        err, dbg = msg.parse_error()
        self.set_status("Camera error: %s" % err.message)
        self.stop_preview()

    # ---- autofocus ----

    def af_stats_path(self):
        c = CAMERAS[self.cam]
        return os.path.join(c["sysdir"], "af_stats") if c["focus"] else None

    def af_frame(self):
        """the ISP's frame counter (hardware statistics), else 0"""
        if not self.hw_af:
            return 0
        st = read_af_stats(self.af_stats_path())
        return st[0] if st else 0

    def poll_hw_af(self):
        """main thread, once a frame: the hardware statistics"""
        if not self.hw_af:
            self.hw_timer = 0
            return False
        if self.busy or self.af.state in AF_IDLE:
            return True
        st = read_af_stats(self.af_stats_path())
        if not st or not st[1] or st[0] == self.hw_last:
            return True
        self.hw_last = st[0]
        self.af_count = getattr(self, "af_count", 0) + 1
        if self.af.state == "track" and self.af_count % AF_TRACK_EVERY:
            return True
        self.af.on_sample(("hw", st[0]), hw_sharpness(st[2], self.af.region, st[3]))
        return True

    def on_af_sample(self, sink):
        """streaming thread: measure, hand the number to the main thread"""
        sample = sink.emit("pull-sample")
        if self.hw_af or self.af.state in AF_IDLE:
            return Gst.FlowReturn.OK
        self.af_count = getattr(self, "af_count", 0) + 1
        if self.af.state == "track" and self.af_count % AF_TRACK_EVERY:
            return Gst.FlowReturn.OK
        buf = sample.get_buffer()
        s = sample.get_caps().get_structure(0)
        fw, fh = s.get_value("width"), s.get_value("height")
        ok, info = buf.map(Gst.MapFlags.READ)
        if not ok:
            return Gst.FlowReturn.OK
        try:
            value = sharpness(info.data, fw, fh, self.af.region)
        finally:
            buf.unmap(info)
        pts = buf.pts if buf.pts != Gst.CLOCK_TIME_NONE else None
        # default priority, not idle: a playing video widget keeps a redraw
        # (priority 120) pending, and idle sources (200) would never run
        GLib.idle_add(self.af_sample, pts, value, priority=GLib.PRIORITY_DEFAULT)
        return Gst.FlowReturn.OK

    def af_sample(self, pts, value):
        if not self.busy and CAMERAS[self.cam]["focus"]:
            self.af.on_sample(pts, value)
        return False

    def autofocus_when_playing(self):
        """the first sweep, once frames flow and exposure had a moment"""
        self.af_wait += 1
        if self.preview.get_state(0)[1] != Gst.State.PLAYING:
            return self.af_wait < 50 and not self.busy     # up to 10 s
        if self.af_wait < 3:
            return True
        self.autofocus()
        return False

    def autofocus(self, region=None):
        if self.busy or not CAMERAS[self.cam]["focus"]:
            return False
        if self.preview.get_state(0)[1] != Gst.State.PLAYING:
            return False
        if not self.assist and self.needs_assist():
            # light the scene, let auto exposure settle, then sweep
            self.assist_on()
            if self.assist:
                if self.assist_timer:
                    GLib.source_remove(self.assist_timer)
                self.af.state = "wait"
                self.set_status("Focusing…")
                self.assist_timer = GLib.timeout_add(AF_ASSIST_WAIT_MS, self.assisted_start,
                                                     region)
                self.show_af_mode()
                return False
        self.af.start(region)
        self.show_af_mode()
        return False

    def assisted_start(self, region):
        self.assist_timer = 0
        if not self.busy and self.af.state == "wait":
            self.af.start(region)
        return False

    def focus_done(self, pos):
        """pos: the focused lens position, or None for low contrast"""
        if pos is None:
            self.set_status("Low contrast: tap something detailed", 1500)
            pos = self.af.pos
        else:
            self.set_status("Focused", 800)
        self.focus = pos
        self.focus_slider.set_value(pos, notify=False)
        self.save_state()
        if self.assist:
            # focused in the dark: hold, tracking would keep re-lighting
            self.assist_off()
            self.af.state = "hold"

    def set_lens(self, pos):
        c = CAMERAS[self.cam]
        if c["focus"]:
            subdev_ctrl(c["sysdir"], V4L2_CID_FOCUS_ABSOLUTE, int(pos))
        if self.af.state in ("sweep", "fine", "settle", "hold"):
            self.focus_slider.set_value(pos, notify=False)

    def on_focus(self, slider, value):
        self.af.stop(manual=True)
        self.assist_off()
        self.show_af_mode()
        self.focus = int(value)
        self.set_lens(self.focus)
        self.save_state()

    def on_tap(self, tx, ty):
        """tap to focus: map the tap to the unrotated frame"""
        c = CAMERAS[self.cam]
        if not c["focus"] or self.busy:
            return False
        rot = self.rotation[c["id"]]
        x0, y0, dw, dh = self.view.placed()
        u = (tx - x0) / dw
        v = (ty - y0) / dh
        if not (0 <= u <= 1 and 0 <= v <= 1):
            return False
        if c["mirror"]:
            u = 1 - u
        x, y = {0: (u, v), 90: (v, 1 - u), 180: (1 - u, 1 - v), 270: (1 - v, u)}[rot]
        self.autofocus((x, y))
        return True

    # ---- actions ----

    def switch_camera(self):
        if self.busy:
            return
        self.stop_preview()
        self.cam = (self.cam + 1) % len(CAMERAS)
        self.save_state()
        self.set_status(CAMERAS[self.cam]["label"] + " camera", 1200)
        GLib.idle_add(self.start_preview)

    def rotate(self):
        if self.busy:
            return
        cid = CAMERAS[self.cam]["id"]
        self.rotation[cid] = (self.rotation[cid] + 90) % 360
        self.save_state()
        self.stop_preview()
        GLib.idle_add(self.start_preview)

    # ---- photo ----

    def take_photo(self):
        if self.busy:
            return
        flash = self.photo_needs_flash()   # before the preview stops (gain)
        self.af_before_photo = "hold" if self.assist else self.af.state
        self.busy = True
        self.shutter.set_sensitive(False)
        if flash and self.hw_stats and self.meter_start():
            return                          # capture() follows the metering
        self.capture(FLASH_PHOTO_LEVEL if flash else None)

    # ---- flash metering ----

    def meter_levels(self):
        """(ISP frame counter, block signal levels above black) or None"""
        st = read_af_stats(self.af_stats_path())
        if not st or not st[1]:
            return None
        return st[0], np.maximum(st[2][:, :, 3].astype(np.float64) / STAT_NPIX - STAT_BLACK, 0)

    def meter_start(self):
        """pre-flash: the preview at a short manual exposure, flash on"""
        amb = self.meter_levels()
        c = CAMERAS[self.cam]
        e = subdev_ctrl(c["sysdir"], V4L2_CID_EXPOSURE)
        g = subdev_ctrl(c["sysdir"], V4L2_CID_ANALOGUE_GAIN)
        if not amb or not e or not g:
            return False
        self.set_status("Metering…")
        self.meter_log = "no measurement"
        self.assist_off()
        ny, nx = amb[1].shape
        yy, xx = np.mgrid[0:ny, 0:nx]
        centre = (abs(xx - (nx - 1) / 2) <= nx / 4) & (abs(yy - (ny - 1) / 2) <= ny / 4)
        self.meter = {"ambient": amb[1] / (e * g / 128.0),   # per line x gain
                      "weights": np.where(centre, 3.0, 1.0),
                      "us": METER_START_US, "level": FLASH_PHOTO_LEVEL,
                      "t0": time.monotonic()}
        self.flash.on(FLASH_PHOTO_LEVEL, FLASH_PHOTO_TIMEOUT_MS)
        self.meter_set(METER_START_US)
        GLib.timeout_add(15, self.meter_tick)
        return True

    def meter_set(self, us):
        src = self.preview.get_by_name("src")
        Gst.util_set_object_arg(src, "exposure-time-mode", "manual")
        Gst.util_set_object_arg(src, "analogue-gain-mode", "manual")
        src.set_property("exposure-time", int(us))
        src.set_property("analogue-gain", 1.0)
        lines = round(us / LINE_US)
        if HW_ISP:
            # YUYV passthrough runs no software ISP, so libcamera's manual
            # exposure goes nowhere: set the sensor directly. The driver's
            # AE loop sees the manual write and backs off for this stream.
            c = CAMERAS[self.cam]
            subdev_ctrl(c["sysdir"], V4L2_CID_EXPOSURE, lines)
            subdev_ctrl(c["sysdir"], V4L2_CID_ANALOGUE_GAIN, 128)
        # libcamera applies it a few requests later: wait for the sensor
        self.meter.update(us=us, lines=lines, frame=None)

    def meter_tick(self):
        """wait for the exposure to reach the sensor, then METER_SETTLE frames
        (the ones exposed with it), measure; step the exposure while blocks
        clip or the scene is too dark"""
        m = self.meter
        st = self.meter_levels()
        timed_out = (time.monotonic() - m["t0"]) * 1000 > METER_TIMEOUT_MS
        if timed_out:
            if m["frame"] is None or not st:
                st = None                   # no valid measurement
        elif not st:
            return True
        elif m["frame"] is None:
            c = CAMERAS[self.cam]
            e = subdev_ctrl(c["sysdir"], V4L2_CID_EXPOSURE)
            g = subdev_ctrl(c["sysdir"], V4L2_CID_ANALOGUE_GAIN)
            if e is not None and abs(e - m["lines"]) <= 1 and g == 128:
                m["frame"] = st[0]
            return True
        elif (st[0] - m["frame"]) & 0xff < METER_SETTLE:
            return True
        if st:
            top = np.percentile(st[1], 97)
            if not timed_out and top > STAT_CLIP - STAT_BLACK:
                if m["us"] > METER_MIN_US:
                    self.meter_set(max(METER_MIN_US, m["us"] / 8))
                    return True
                if m["level"] > 0:
                    # clipping at the shortest exposure (a very close
                    # subject): pre-flash about 4x dimmer (15 -> 3 -> 0)
                    m["level"] = max(0, (m["level"] + 1) // 4 - 1)
                    self.flash.on(m["level"], FLASH_PHOTO_TIMEOUT_MS)
                    m["frame"] = st[0]      # same exposure: the next frames
                    return True
            if not timed_out and top < 4 and m["us"] < METER_MAX_US:
                self.meter_set(min(METER_MAX_US, m["us"] * 8))
                return True
        level, exposure = self.meter_result(st[1] if st else None)
        print("meter: %s" % getattr(self, "meter_log", "no measurement"), file=sys.stderr, flush=True)
        # the preview goes back to auto exposure when it restarts
        src = self.preview.get_by_name("src")
        Gst.util_set_object_arg(src, "exposure-time-mode", "auto")
        Gst.util_set_object_arg(src, "analogue-gain-mode", "auto")
        self.capture(level, exposure)
        return False

    def meter_result(self, lv):
        """(flash level, (exposure lines, gain)) for the photo from the
        pre-flash levels (flash at FLASH_PHOTO_LEVEL, gain 1x)"""
        m = self.meter
        if lv is None:
            return FLASH_PHOTO_LEVEL, None
        w = m["weights"]
        lit = lv / (m["us"] / LINE_US)          # per line x gain: flash + ambient
        amb = np.minimum(m["ambient"], lit)
        # the flash's share at full power (the pre-flash may have been dimmed;
        # its current is about 25 mA x (level + 1))
        flash = (lit - amb) * (FLASH_PHOTO_LEVEL + 1) / (m["level"] + 1)

        def solve(k):
            """exposure (lines x gain) for the flash at k x full power"""
            t = amb + k * flash
            mean = (t * w).sum() / w.sum()
            top = np.percentile(t, 97)
            return min(METER_TARGET / mean if mean > 0 else 1e9,
                       METER_HIGHLIGHT / top if top > 0 else 1e9)

        level = FLASH_PHOTO_LEVEL
        x = solve(1.0)
        if x < FLASH_MIN_LINES:
            # too bright even at the shortest exposure: dim the flash (its
            # current is about 25 mA x (level + 1))
            lo, hi = 0.0, 1.0
            for _ in range(20):
                k = (lo + hi) / 2
                if solve(k) < FLASH_MIN_LINES:
                    hi = k
                else:
                    lo = k
            level = max(0, min(FLASH_PHOTO_LEVEL, int(lo * (FLASH_PHOTO_LEVEL + 1)) - 1))
            x = max(FLASH_MIN_LINES, solve((level + 1) / (FLASH_PHOTO_LEVEL + 1)))
        lines = max(FLASH_MIN_LINES, min(FLASH_MAX_LINES, x))
        gain = max(1.0, min(FLASH_MAX_GAIN, x / lines))
        self.meter_log = "pre-flash %d us at level %d, top %.0f: flash level %d, %d lines x %.2f" % (
            m["us"], m["level"], np.percentile(lv, 97), level, lines, gain)
        return level, (int(lines), gain)

    # ---- capture ----

    def capture(self, flash_level, exposure=None):
        """the still pipeline; flash_level None = no flash; exposure
        (lines, gain) = manual exposure from the flash metering"""
        self.set_status("Taking photo…")
        self.stop_preview()

        c = CAMERAS[self.cam]
        # Hardware ISP: the DIP delivers finished YUYV at the sensor-mode size,
        # so the still skips the slow GPU software debayer (~4 s -> tens of ms).
        # The size must be the mode's own size (the driver only has a DIP tile
        # list for that); the software-ISP path keeps its cropped "still" size.
        # A manual exposure (flash) makes the driver's in-kernel AE loop back
        # off for this stream, so it does not fight the metered value.
        if HW_ISP:
            w, h = c["hwstill"]
            still_fmt = "YUY2"
        else:
            w, h = c["still"]
            still_fmt = "BGRx"
        manual = ""
        if exposure:
            manual = (" exposure-time-mode=manual analogue-gain-mode=manual "
                      "exposure-time=%d analogue-gain=%.3f" % (exposure[0] * LINE_US, exposure[1]))
            if HW_ISP:
                # set before the still stream starts (the preview has
                # stopped): the driver applies it at stream on and keeps its
                # AE loop off until this stream stops
                subdev_ctrl(c["sysdir"], V4L2_CID_EXPOSURE, int(exposure[0]))
                subdev_ctrl(c["sysdir"], V4L2_CID_ANALOGUE_GAIN, round(exposure[1] * 128))
        if exposure:
            self.still_settle = FLASH_SETTLE_FRAMES
        else:
            self.still_settle = HW_SETTLE_FRAMES if HW_ISP else SETTLE_FRAMES
        # raw frames to an appsink: the burst is scored for sharpness there
        # and only the sharpest is rotated and encoded (encode_still)
        desc = ("libcamerasrc name=src camera-name=\"%s\"%s ! "
                "video/x-raw,format=%s,width=%d,height=%d ! "
                "identity name=gate ! appsink name=out emit-signals=true sync=false "
                "max-buffers=2 drop=false"
                % (c["id"], manual, still_fmt, w, h))
        self.still = Gst.parse_launch(desc)
        self.still_frames = 0
        self.still_done = False
        self.still_scores = []
        self.still_best = (-1.0, None, None)
        self.still_region = self.af.region if c["focus"] else (0.5, 0.5)
        self.still_direction = video_direction(self.rotation[c["id"]], False)
        # skip the frames auto exposure needs to settle
        self.still.get_by_name("gate").get_static_pad("src").add_probe(
            Gst.PadProbeType.BUFFER, self.on_still_buffer)
        self.still.get_by_name("out").connect("new-sample", self.on_still_sample)
        bus = self.still.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_still_error)
        self.still_timeout = GLib.timeout_add_seconds(10, self.on_still_timeout)
        if flash_level is not None:
            # lit for the whole capture (a continuous light, not a strobe);
            # the hardware timeout switches it off if we die
            self.flash.on(flash_level, FLASH_PHOTO_TIMEOUT_MS)
        if self.still.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
            self.finish_photo(None, "Camera not available")

    def on_still_buffer(self, pad, info):
        """let through the STILL_BURST frames after the settle frames"""
        self.still_frames += 1
        if (self.still_frames <= self.still_settle or
                self.still_frames > self.still_settle + STILL_BURST):
            return Gst.PadProbeReturn.DROP
        return Gst.PadProbeReturn.OK

    def on_still_sample(self, sink):
        """the still's streaming thread: score each burst frame for
        sharpness (shake blurs the whole frame; the focus region is where it
        matters), keep a copy of the best, and when the burst is in, stop the
        camera and encode that one"""
        sample = sink.emit("pull-sample")
        if self.still_done:
            return Gst.FlowReturn.OK
        st = sample.get_caps().get_structure(0)
        buf = sample.get_buffer()
        ok, info = buf.map(Gst.MapFlags.READ)
        if ok:
            try:
                score = sharpness(info.data, st.get_value("width"), st.get_value("height"),
                                  self.still_region)
                self.still_scores.append(score)
                if score > self.still_best[0]:
                    self.still_best = (score, bytes(info.data), sample.get_caps())
            finally:
                buf.unmap(info)
        if len(self.still_scores) >= STILL_BURST:
            self.still_done = True
            GLib.idle_add(self.still_collected, priority=GLib.PRIORITY_DEFAULT)
        return Gst.FlowReturn.OK

    def still_collected(self):
        """main thread: the burst is in; free the camera and the flash now,
        encode the sharpest frame off the main thread"""
        if not self.busy:
            return False
        if self.still:
            self.still.set_state(Gst.State.NULL)
            self.still.get_bus().remove_signal_watch()
            self.still = None
        if self.flash_mode != "torch":
            self.flash.off()
        sc = self.still_scores
        print("still: sharpness %s, kept %d (%.0f%% of the burst's worst)" % (
            " ".join("%.3f" % x for x in sc), sc.index(max(sc)),
            100.0 * max(sc) / max(min(sc), 1e-9)), file=sys.stderr, flush=True)
        _, data, caps = self.still_best
        self.still_best = (-1.0, None, None)
        self.set_status("Saving…")
        threading.Thread(target=self.encode_still, args=(data, caps, self.still_direction),
                         daemon=True).start()
        return False

    def encode_still(self, data, caps, direction):
        """worker thread: rotate and JPEG-encode one raw frame"""
        jpeg = None
        try:
            p = Gst.parse_launch(
                "appsrc name=src ! videoflip video-direction=%s ! videoconvert ! "
                "jpegenc quality=%d ! appsink name=out sync=false" % (direction, JPEG_QUALITY))
            src = p.get_by_name("src")
            src.set_property("caps", caps)
            src.set_property("format", Gst.Format.TIME)
            p.set_state(Gst.State.PLAYING)
            src.emit("push-buffer", Gst.Buffer.new_wrapped(data))
            src.emit("end-of-stream")
            sample = p.get_by_name("out").emit("try-pull-sample", 15 * Gst.SECOND)
            if sample:
                buf = sample.get_buffer()
                ok, info = buf.map(Gst.MapFlags.READ)
                if ok:
                    jpeg = bytes(info.data)
                    buf.unmap(info)
            p.set_state(Gst.State.NULL)
        except GLib.Error as e:
            print("still: encode failed: %s" % e, file=sys.stderr, flush=True)
        GLib.idle_add(self.save_photo, jpeg, priority=GLib.PRIORITY_DEFAULT)

    def save_photo(self, data):
        if not self.busy:
            return False
        if data is None:
            self.finish_photo(None, "Photo failed")
            return False
        path, err = None, None
        try:
            os.makedirs(PHOTO_DIR, exist_ok=True)
            path = os.path.join(PHOTO_DIR, time.strftime("IMG_%Y%m%d_%H%M%S.jpg"))
            n = 1
            while os.path.exists(path):
                path = path[:-4].split("-")[0] + "-%d.jpg" % n
                n += 1
            with open(path, "wb") as f:
                f.write(data)
        except (OSError, TypeError) as e:
            path, err = None, "Save failed: %s" % e
        self.finish_photo(path, err)
        return False

    def on_still_error(self, bus, msg):
        err, dbg = msg.parse_error()
        self.finish_photo(None, "Photo failed: %s" % err.message)

    def on_still_timeout(self):
        self.still_timeout = 0
        self.finish_photo(None, "Photo timed out")
        return False

    def finish_photo(self, path, err):
        if not self.busy:
            return
        if self.still_timeout:
            GLib.source_remove(self.still_timeout)
            self.still_timeout = 0
        if self.still:
            self.still.set_state(Gst.State.NULL)
            self.still.get_bus().remove_signal_watch()
            self.still = None
        if self.flash_mode != "torch":
            self.flash.off()
        self.busy = False
        self.shutter.set_sensitive(True)
        if path:
            self.last_photo = path
            self.save_state()
            self.update_thumb()
            self.set_status("Saved " + os.path.basename(path), 1500)
        else:
            self.set_status(err, 3000)
        # keep the focus: no new sweep after a photo
        self.start_preview(refocus=False)
        if CAMERAS[self.cam]["focus"] and self.af_before_photo not in ("off", "manual", "hold"):
            self.af.resume()

    # ---- QR codes ----

    def on_qr_sample(self, sink):
        """the QR branch's streaming thread: scan, hand codes to the main
        thread (ctypes drops the GIL while zbar runs)"""
        sample = sink.emit("pull-sample")
        if self.busy:
            return Gst.FlowReturn.OK
        if self.qr_scanner is None:
            self.qr_scanner = QrScanner()
        buf = sample.get_buffer()
        ok, info = buf.map(Gst.MapFlags.READ)
        if not ok:
            return Gst.FlowReturn.OK
        try:
            codes = self.qr_scanner.scan(info.data, QR_SIZE[0], QR_SIZE[1])
        finally:
            buf.unmap(info)
        for text in codes:
            if text:
                GLib.idle_add(self.qr_found, text, priority=GLib.PRIORITY_DEFAULT)
        return Gst.FlowReturn.OK

    @staticmethod
    def qr_describe(text):
        """(kind, what to show, URL to open or None)"""
        t = text.strip()
        if re.match(r"(?i)https?://\S+$", t):
            u = urlsplit(t)
            return "LINK", (u.netloc + u.path.rstrip("/") +
                            ("?" + u.query if u.query else "")), t
        if t[:5].upper() == "WIFI:":
            m = re.search(r"(?:^WIFI:|;)S:((?:\\.|[^;])*)", t, re.I)
            ssid = re.sub(r"\\(.)", r"\1", m.group(1)) if m else "?"
            return "WI-FI", "Network \u201c%s\u201d" % ssid, None
        for prefix, kind in (("mailto:", "EMAIL"), ("tel:", "PHONE"), ("geo:", "PLACE"),
                             ("BEGIN:VCARD", "CONTACT"), ("BEGIN:VEVENT", "EVENT")):
            if t[:len(prefix)].lower() == prefix.lower():
                return kind, t[len(prefix):].strip() if ":" in prefix else t, None
        return "TEXT", " ".join(t.split()), None

    def qr_found(self, text):
        chip = self.qr_chips.get(text)
        if chip is None:
            chip = self.qr_chip(text)
            self.qr_chips[text] = chip
            self.qr_box.prepend(chip)                       # newest at the top
            while len(self.qr_chips) > QR_MAX:
                self.qr_dismiss(self.qr_box.get_last_child())       # the oldest
            vibrate(QR_BUZZ)
        chip.add_css_class("fresh")
        if getattr(chip, "fresh_timer", 0):
            GLib.source_remove(chip.fresh_timer)
        chip.fresh_timer = GLib.timeout_add(QR_FRESH_MS, self.qr_unfresh, chip)
        return False

    def qr_unfresh(self, chip):
        chip.fresh_timer = 0
        chip.remove_css_class("fresh")
        return False

    def qr_chip(self, text):
        kind, shown, url = self.qr_describe(text)
        chip = Gtk.Box(spacing=8)
        chip.add_css_class("qr")
        chip.qr_text = text
        chip.fresh_timer = 0
        badge = ui.label("QR \u00b7 " + kind, "qrkind")
        badge.set_valign(Gtk.Align.CENTER)
        chip.append(badge)
        lab = ui.label(shown, "qrtext", wrap=True, ellipsize=True)
        lab.set_lines(2)
        lab.set_tooltip_text(text)
        lab.set_hexpand(True)
        chip.append(lab)
        if url:
            b = ui.GlassButton("Open", height=42, size=15, kind="suggested")
            b.set_valign(Gtk.Align.CENTER)
            b.connect("clicked", lambda b: self.qr_open(url))
            chip.append(b)
        b = ui.GlassButton("Copy", height=42, size=15)
        b.set_valign(Gtk.Align.CENTER)
        b.connect("clicked", lambda b: self.qr_copy(text))
        chip.append(b)
        b = ui.GlassButton(icon=ui.ICONS["close"], height=42)
        b.set_valign(Gtk.Align.CENTER)
        b.connect("clicked", lambda b: self.qr_dismiss(chip))
        chip.append(b)
        return chip

    def qr_dismiss(self, chip):
        if chip.fresh_timer:
            GLib.source_remove(chip.fresh_timer)
        self.qr_chips.pop(chip.qr_text, None)
        self.qr_box.remove(chip)

    def qr_copy(self, text):
        self.get_clipboard().set_content(Gdk.ContentProvider.new_for_bytes(
            "text/plain;charset=utf-8", GLib.Bytes.new(text.encode())))
        self.set_status("Copied", 1000)

    def qr_open(self, url):
        try:
            subprocess.Popen([BROWSER, url], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            self.set_status("Opening link…", 1500)
        except OSError as e:
            self.set_status("Can't open: %s" % e, 2500)

    # ---- last photo ----

    def update_thumb(self):
        pix = None
        if self.last_photo and os.path.exists(self.last_photo):
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(self.last_photo, 60, 60, True)
            except GLib.Error:
                pix = None
        if pix:
            pic = Gtk.Picture.new_for_paintable(Gdk.Texture.new_for_pixbuf(pix))
            pic.set_content_fit(Gtk.ContentFit.COVER)
            pic.set_size_request(60, 60)
            pic.set_overflow(Gtk.Overflow.HIDDEN)
            self.thumb.set_child(pic)
            self.thumb.set_sensitive(True)
        else:
            self.thumb.set_child(Gtk.Image.new_from_icon_name("image-x-generic-symbolic"))
            self.thumb.set_sensitive(False)

    def on_thumb(self, btn):
        if self.busy or not self.last_photo:
            return
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                self.last_photo, self.get_width(), self.get_height(), True)
        except GLib.Error:
            return
        self.photo_img.set_paintable(Gdk.Texture.new_for_pixbuf(pix))
        self.stop_preview()
        self.view.clear()
        self.stack.set_visible_child_name("photo")

    def show_camera(self):
        self.stack.set_visible_child_name("camera")
        GLib.idle_add(self.start_preview)
        return True

    # ---- keys, quit ----

    def on_key(self, ctl, keyval, code, state):
        name = Gdk.keyval_name(keyval) or ""
        if self.stack.get_visible_child_name() == "photo":
            self.show_camera()
            return True
        if name in ("space", "Return", "KP_Enter"):
            self.take_photo()
        elif name in ("f", "F"):
            self.switch_camera()
        elif name in ("r", "R"):
            self.rotate()
        elif name in ("t", "T"):
            self.cycle_flash()
        elif name in ("a", "A"):
            self.autofocus((0.5, 0.5))
        else:
            return False
        return True

    def on_quit(self, *a):
        self.flash.off()
        if self.still:
            self.still.set_state(Gst.State.NULL)
        if self.preview:
            self.preview.set_state(Gst.State.NULL)
        return False


def build(app):
    win = CameraApp(app)
    for sig in (2, 15, 1):      # SIGINT, SIGTERM, SIGHUP: release the camera
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda w=win: w.close() or False)
    return win


if __name__ == "__main__":
    Gst.init(None)
    sys.exit(ui.run("org.titanpocket.camera", build, lock="titan-camera-gui"))
