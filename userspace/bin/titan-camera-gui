SYSDEV = "/sys/devices/platform/1a050000.camsv1/"
CAMERAS = [
    # libcamera id, label, mirrored preview, still size, sensor device,
    # focus motor, fallback rotation (clockwise)
    {"id": "platform/1a050000.camsv1/rear ov16880", "label": "Rear",
     "mirror": False, "still": (4668, 3504), "sysdir": SYSDEV + "rear",
     "focus": True, "rotation": 90},
    {"id": "platform/1a050000.camsv1/front ov8865", "label": "Front",
     "mirror": True, "still": (3260, 2448), "sysdir": SYSDEV + "front",
     "focus": False, "rotation": 270},
]
PREVIEW = (960, 720)
SETTLE_FRAMES = 15          # auto exposure settles in ~8 frames
QR_RATE = 5                 # preview frames a second the QR decoder looks at
QR_SIZE = (640, 480)        # ...scaled to this, grayscale
QR_DENSITY = 2              # zbar reads every 2nd line and column
QR_MAX = 3                  # QR chips kept on screen
QR_FRESH_MS = 1200          # a chip stays outlined this long after its code was seen
BROWSER = "/usr/local/bin/titan-chromium"
VIBRATOR = "/sys/class/leds/vibrator"
QR_BUZZ = (40, 90, 40)      # ms on, off, on: a new QR code was found
JPEG_QUALITY = 92

STATE_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or
                         os.path.expanduser("~/.config"), "titan-camera")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
PHOTO_DIR = os.path.expanduser("~/Pictures/Camera")

VIDIOC_G_CTRL = 0xc008561b
VIDIOC_S_CTRL = 0xc008561c
V4L2_CID_FOCUS_ABSOLUTE = 0x009a090a
V4L2_CID_ANALOGUE_GAIN = 0x009e0903
V4L2_CID_EXPOSURE = 0x00980911

# MediaTek flashlight-core ioctls (flashlight.h): struct {type_id, ct_id, arg},
# 1-based ids; type 1 = rear; ct 1 = white LED, ct 2 = warm LED
_FL = ord("S")
FLASH_SET_DRIVER = (3 << 30) | (4 << 16) | (_FL << 8) | 30
FLASH_SET_TIMEOUT = (2 << 30) | (4 << 16) | (_FL << 8) | 100
FLASH_SET_DUTY = (2 << 30) | (4 << 16) | (_FL << 8) | 110
FLASH_SET_ONOFF = (2 << 30) | (4 << 16) | (_FL << 8) | 115
FLASH_SET_SCENARIO = (3 << 30) | (4 << 16) | (_FL << 8) | 215
FLASH_SCENARIO_CAMERA = 1           # coupled (both channels together)
FLASH_PHOTO_LEVEL = 15              # 400 mA per LED (torch maximum)
FLASH_TORCH_LEVEL = 6               # 175 mA per LED
FLASH_PHOTO_TIMEOUT_MS = 6000    # a full-resolution capture takes ~4 s
FLASH_AUTO_GAIN = 512               # analogue gain code, 128 = 1x
FLASH_MODES = ["off", "auto", "on", "torch"]
AF_ASSIST_LEVEL = FLASH_TORCH_LEVEL
# flash metering, in units of the AF statistics' pixel sums (word 3 per
# block, over STAT_NPIX pixels): raw/8, black ~8, clipping at ~119
STAT_NPIX = 146 * 146       # pixels per statistics block (2336x1752 mode)
STAT_BLACK = 8.0
STAT_CLIP = 110.0           # a block above this is (nearly) clipped
# measured against the software ISP's output: block level s maps to about
# 303 x (s / 111) ^ (1 / 2.2) in the photo (its gamma and AWB gains); its own
# AE settles near a centre-weighted 40 with the highlights clipped
METER_TARGET = 32.0         # centre-weighted mean above black (photo ~80)...
METER_HIGHLIGHT = 66.0      # ...with the 97th-percentile block at most this (~240)
METER_START_US = 400        # first pre-flash exposure (gain 1x)
METER_MIN_US = 40
METER_MAX_US = 25600
METER_SETTLE = 3            # frames after the sensor has the new exposure
METER_TIMEOUT_MS = 2500
LINE_US = 2512 / 288.0      # line time of both rear modes (HTS / pixel rate)
FLASH_MIN_LINES = 4         # the sensor's shortest exposure
FLASH_MAX_LINES = 3800      # longest flash exposure (~1/30 s), then gain
FLASH_MAX_GAIN = 8.0
FLASH_SETTLE_FRAMES = 6     # still frames skipped with a metered exposure
AF_ASSIST_GAIN = FLASH_AUTO_GAIN    # dark: auto exposure is at 4x or more
AF_ASSIST_WAIT_MS = 500             # auto exposure settles on the lit scene
AF_ASSIST_DARK_S = 2.0              # gain is low this long after the light


def vibrate(pattern):
    """the vibration motor: on, off, on, ... (ms), without blocking. The
    BSP driver's LED-class node: a duration, then activate; it stops by
    itself (docs/hardware.md)"""
    def pulse(ms):
        try:
            with open(VIBRATOR + "/duration", "w") as f:
                f.write(str(ms))
            with open(VIBRATOR + "/activate", "w") as f:
                f.write("1")
        except OSError:
            pass
        return False
    t = 0
    for i, ms in enumerate(pattern):
        if i % 2 == 0:
            if t:
                GLib.timeout_add(t, pulse, ms)
            else:
                pulse(ms)
        t += ms


class QrScanner:
    """libzbar (ctypes), QR codes only; one per decoding thread"""
    Y800 = 0x30303859
    QRCODE = 64
    CFG_ENABLE, CFG_X_DENSITY, CFG_Y_DENSITY = 0, 0x100, 0x101
    lib = None

    @classmethod
    def load(cls):
        if cls.lib is None:
            try:
                z = ctypes.CDLL("libzbar.so.0")
            except OSError:
                cls.lib = False
                return False
            vp, ui, ul = ctypes.c_void_p, ctypes.c_uint, ctypes.c_ulong
            for name, res, args in (
                    ("zbar_image_scanner_create", vp, []),
                    ("zbar_image_scanner_set_config", ctypes.c_int, [vp, ctypes.c_int, ctypes.c_int, ctypes.c_int]),
                    ("zbar_image_create", vp, []),
                    ("zbar_image_destroy", None, [vp]),
                    ("zbar_image_set_format", None, [vp, ul]),
                    ("zbar_image_set_size", None, [vp, ui, ui]),
                    ("zbar_image_set_data", None, [vp, vp, ul, vp]),
                    ("zbar_scan_image", ctypes.c_int, [vp, vp]),
                    ("zbar_image_first_symbol", vp, [vp]),
                    ("zbar_symbol_next", vp, [vp]),
                    ("zbar_symbol_get_type", ctypes.c_int, [vp]),
                    ("zbar_symbol_get_data", vp, [vp]),
                    ("zbar_symbol_get_data_length", ui, [vp])):
                f = getattr(z, name)
                f.restype, f.argtypes = res, args
            cls.lib = z
        return bool(cls.lib)

    def __init__(self):
        z = self.lib
        self.sc = z.zbar_image_scanner_create()
        z.zbar_image_scanner_set_config(self.sc, 0, self.CFG_ENABLE, 0)
        z.zbar_image_scanner_set_config(self.sc, self.QRCODE, self.CFG_ENABLE, 1)
        z.zbar_image_scanner_set_config(self.sc, 0, self.CFG_X_DENSITY, QR_DENSITY)
        z.zbar_image_scanner_set_config(self.sc, 0, self.CFG_Y_DENSITY, QR_DENSITY)

    def scan(self, gray, w, h):
        """the QR codes in a w x h 8-bit image (bytes-like), as text"""
        z = self.lib
        buf = (ctypes.c_char * len(gray)).from_buffer_copy(gray)
        im = z.zbar_image_create()
        z.zbar_image_set_format(im, self.Y800)
        z.zbar_image_set_size(im, w, h)
        z.zbar_image_set_data(im, ctypes.addressof(buf), len(gray), None)
        found = []
        if z.zbar_scan_image(self.sc, im) > 0:
            sym = z.zbar_image_first_symbol(im)
            while sym:
                if z.zbar_symbol_get_type(sym) == self.QRCODE:
                    data = ctypes.string_at(z.zbar_symbol_get_data(sym),
                                            z.zbar_symbol_get_data_length(sym))
                    found.append(data.decode("utf-8", "replace"))
                sym = z.zbar_symbol_next(sym)
        z.zbar_image_destroy(im)
        return found


class Flash:
    """both rear flash LEDs through /dev/flashlight"""

    def __init__(self):
        self.fd = None

    def _io(self, req, ct, arg):
        fcntl.ioctl(self.fd, req, struct.pack("=iii", 1, ct, arg))

    def on(self, level, timeout_ms=0):
        self.off()
        try:
            self.fd = os.open("/dev/flashlight", os.O_RDWR | os.O_CLOEXEC)
            self._io(FLASH_SET_DRIVER, 1, 1)
            self._io(FLASH_SET_SCENARIO, 1, FLASH_SCENARIO_CAMERA)
            for ct in (1, 2):
                self._io(FLASH_SET_TIMEOUT, ct, timeout_ms)
                self._io(FLASH_SET_DUTY, ct, level)
            for ct in (1, 2):
                self._io(FLASH_SET_ONOFF, ct, 1)
            return True
        except OSError:
            self.off()
            return False

    def off(self):
        if self.fd is None:
            return
        try:
            for ct in (1, 2):
                self._io(FLASH_SET_ONOFF, ct, 0)
            self._io(FLASH_SET_SCENARIO, 1, 0)
            self._io(FLASH_SET_DRIVER, 1, 0)
        except OSError:
            pass
        os.close(self.fd)
        self.fd = None
V4L2_CID_CAMERA_SENSOR_ROTATION = 0x009a0923   # degrees, counter-clockwise
FOCUS_MAX = 1023

# autofocus
AF_COARSE_STEP = 64
AF_FINE_STEP = 16
AF_SETTLE_NS = 15_000_000   # lens settling after a move
AF_FRAME_NS = 40_000_000    # longest exposure + readout we wait out
AF_REGION = 0.3             # focus region: this fraction of width and height
AF_FRAMES_PER_POS = 2       # frames averaged per lens position: coarse...
AF_FINE_FRAMES = 4          # ...and fine (noisy in dim light)
AF_MIN_RATIO = 1.25         # best/worst sharpness below this: low contrast
AF_HW_MIN_RATIO = 1.15      # the same for the hardware statistics
AF_HW_POLL_MS = 33          # hardware statistics: one frame
AF_HW_SETTLE = 3            # frames after a lens move before a set counts
AF_BASELINE_FRAMES = 8      # frames measured at the focused position
AF_TRACK_FRAMES = 15        # median window while tracking (measured frames)
AF_TRACK_EVERY = 3          # while tracking, measure every third frame
AF_DROP = 0.6               # refocus when sharpness falls below this share...
AF_DROP_FRAMES = 30         # ...for this many frames in a row...
AF_MIN_GAP_S = 3.0          # ...and the last focus is this old
AF_IDLE = ("off", "manual", "hold", "wait")     # states that take no samples


def video_direction(rotation, mirror):
    """GstVideoOrientationMethod nick for a clockwise rotation, then an
    optional horizontal mirror"""
    if not mirror:
        return {0: "identity", 90: "90r", 180: "180", 270: "90l"}[rotation]
    return {0: "horiz", 90: "ul-lr", 180: "vert", 270: "ur-ll"}[rotation]


def read_af_stats(path):
    """(frame, running, words[12][16][10], SGG1 gain) from the driver's
    af_stats, or None"""
    try:
        with open(path, "rb") as f:
            d = f.read()
    except OSError:
        return None
    if len(d) < 32:
        return None
    magic, frame, running, nx, ny, blk, stride, pgn = struct.unpack_from("<8I", d)
    if magic != 0x31464154 or blk != 40 or len(d) < 32 + stride * ny:
        return None
    rows = [np.frombuffer(d, np.uint32, nx * 10, 32 + y * stride).reshape(nx, 10)
            for y in range(ny)]
    return frame, running, np.stack(rows), pgn


def hw_sharpness(words, region, pgn):
    """H0 filter energy (w1) over pixel sum (w3) of the region's blocks. The
    filter energy scales with 1/SGG1 gain (which the driver adjusts to the
    scene brightness), so it is multiplied by the gain"""
    ny, nx = words.shape[:2]
    bw, bh = max(1, round(nx * AF_REGION)), max(1, round(ny * AF_REGION))
    x0 = min(max(int(region[0] * nx - bw / 2 + 0.5), 0), nx - bw)
    y0 = min(max(int(region[1] * ny - bh / 2 + 0.5), 0), ny - bh)
    r = words[y0:y0 + bh, x0:x0 + bw].astype(np.float64)
    light = r[:, :, 3].sum()
    return r[:, :, 1].sum() * pgn / light if light else 0.0


def subdev_node(sysdir):
    """/dev/v4l-subdevN under a sensor's device directory"""
    try:
        for name in os.listdir(os.path.join(sysdir, "video4linux")):
            if name.startswith("v4l-subdev"):
                return "/dev/" + name
    except OSError:
        pass
    return None


def subdev_ctrl(sysdir, cid, value=None):
    """read (value None) or write a control on a sensor subdev; None on error"""
    node = subdev_node(sysdir)
    if not node:
        return None
    try:
        fd = os.open(node, os.O_RDWR)
        try:
            buf = bytearray(struct.pack("=Ii", cid, value or 0))
            fcntl.ioctl(fd, VIDIOC_G_CTRL if value is None else VIDIOC_S_CTRL, buf, True)
            return struct.unpack("=Ii", buf)[1]
        finally:
            os.close(fd)
    except OSError:
        return None


def sharpness(data, w, h, region):
    """gradient energy of the focus region of a BGRx frame: its green
    channel, binned 2x2 against noise, normalised by brightness so auto
    exposure changes don't look like focus changes. Only the region is
    touched, straight in the buffer."""
    stride = len(data) // h
    a = np.frombuffer(data, np.uint8).reshape(h, stride)
    cx, cy = region
    rw, rh = int(w * AF_REGION) & ~1, int(h * AF_REGION) & ~1
    x0 = min(max(int(cx * w) - rw // 2, 0), w - rw) & ~1
    y0 = min(max(int(cy * h) - rh // 2, 0), h - rh) & ~1
    g = a[y0:y0 + rh, 4 * x0 + 1:4 * (x0 + rw):4].astype(np.int32)
    g = g[0::2, 0::2] + g[1::2, 0::2] + g[0::2, 1::2] + g[1::2, 1::2]
    gx = g[:, 1:] - g[:, :-1]
    gy = g[1:, :] - g[:-1, :]
    energy = float((gx * gx).mean() + (gy * gy).mean())
    mean = float(g.mean())
    return energy / (mean * mean + 1024.0)


class AutoFocus:
    """contrast-detect autofocus, driven by sharpness samples (main thread)

    states: off, wait (AF assist light on, exposure settling), sweep
    (coarse), fine, settle (measuring the focused level), track (refocus when
    it drops), hold (low contrast or focused in the dark: no tracking), manual
    """

    def __init__(self, app):
        self.app = app
        self.state = "off"
        self.region = (0.5, 0.5)
        self.pos = app.focus
        self.start_pos = self.pos
        self.moved_at = 0       # pipeline running time of the last move
        self.moved_frame = 0    # the ISP's frame counter then (hardware statistics)
        self.frames = []        # valid samples at the current position
        self.samples = {}       # position -> sharpness
        self.queue = []         # positions still to measure
        self.baseline = None
        self.recent = []
        self.low = 0
        self.focused_at = 0.0

    def start(self, region=None):
        if region:
            self.region = region
        self.start_pos = self.pos
        self.samples = {}
        self.queue = list(range(0, FOCUS_MAX + 1, AF_COARSE_STEP)) + [FOCUS_MAX]
        self.state = "sweep"
        self.app.set_status("Focusing…")
        self.move(self.queue.pop(0))

    def stop(self, manual=False):
        self.state = "manual" if manual else "off"

    def resume(self):
        """keep the lens where it is and watch sharpness from now on"""
        self.frames = []
        self.state = "settle"
        self.moved_at = self.app.running_time()
        self.moved_frame = self.app.af_frame()

    def move(self, pos):
        self.pos = pos
        self.frames = []
        self.app.set_lens(pos)
        self.moved_at = self.app.running_time()
        self.moved_frame = self.app.af_frame()

    def valid(self, pts):
        """a frame whose capture started after the lens settled: a pipeline
        timestamp, or ("hw", ISP frame counter) for the hardware statistics"""
        if isinstance(pts, tuple):
            return (pts[1] - self.moved_frame) & 0xff >= AF_HW_SETTLE
        return pts is not None and pts >= self.moved_at + AF_SETTLE_NS + AF_FRAME_NS

    def on_sample(self, pts, value):
        if self.state in AF_IDLE:
            return
        if self.state == "track":
            self.track(value)
            return
        if not self.valid(pts):
            return
        self.frames.append(value)
        if self.state == "settle":
            if len(self.frames) >= AF_BASELINE_FRAMES:
                self.baseline = float(np.median(self.frames))
                self.recent = []
                self.low = 0
                self.state = "track"
            return
        if len(self.frames) < (AF_FINE_FRAMES if self.state == "fine" else AF_FRAMES_PER_POS):
            return
        value = sum(self.frames) / len(self.frames)
        self.samples[self.pos] = value
        if self.state == "sweep":
            best = max(self.samples, key=self.samples.get)
            past_peak = (self.pos - best >= 3 * AF_COARSE_STEP and
                         value < 0.6 * self.samples[best])
            if self.queue and not past_peak:
                self.move(self.queue.pop(0))
                return
            self.state = "fine"
            self.queue = [p for p in range(best - 3 * AF_FINE_STEP,
                                           best + 3 * AF_FINE_STEP + 1, AF_FINE_STEP)
                          if 0 <= p <= FOCUS_MAX and p not in self.samples]
        if self.queue:
            self.move(self.queue.pop(0))
            return
        # done
        best = max(self.samples, key=self.samples.get)
        ratio = AF_HW_MIN_RATIO if self.app.hw_af else AF_MIN_RATIO
        if self.samples[best] < ratio * min(self.samples.values()):
            self.move(self.start_pos)        # nothing to focus on here
            self.state = "hold"
            self.app.focus_done(None)
            return
        self.move(best)
        self.state = "settle"
        self.focused_at = time.monotonic()
        self.app.focus_done(best)

    def track(self, value):
        self.recent = (self.recent + [value])[-AF_TRACK_FRAMES:]
        if len(self.recent) < AF_TRACK_FRAMES:
            return
        level = float(np.median(self.recent))
        if level > self.baseline:
            self.baseline = 0.95 * self.baseline + 0.05 * level
        if level < AF_DROP * self.baseline:
            self.low += 1
            if self.low >= AF_DROP_FRAMES and time.monotonic() - self.focused_at > AF_MIN_GAP_S:
                self.app.autofocus()
        else:
            self.low = 0


CSS = b"""
