#!/bin/sh
# titan-radio [MHZ] [GAIN]: FM radio on the loudspeaker.
#
# Holds the FM I2S link (CONNSYS I2S -> HW gain -> I2S3) open and runs
# titan-fm interactively (type a frequency, u/d, su/sd, q). titan-speakerd
# powers the speaker (I2S clock + amp) while the link is open; the speaker
# volume is the one set with the volume keys (titan-powerkey).
#
#   GAIN: AFE FM gain, 0..524288 (0x80000 = 0 dB); default 32768 (-24 dB).
FREQ=${1:-99.5}
GAIN=${2:-32768}

modprobe fmradio_drv || exit 1
for i in $(seq 25); do [ -e /dev/fm ] && break; sleep 0.2; done

tinymix -D 0 set "Audio FM I2S Volume" "$GAIN" >/dev/null

pid=
cleanup() {
	[ -n "$pid" ] && kill $pid 2>/dev/null
	wait 2>/dev/null
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# hostless link, held prepared: device 21 (FM_I2S_Playback)
spk-hold 0 21 48000 & pid=$!

titan-fm "$FREQ"
