"""

STAR = "M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8z"
POWER = "M12 3.5v8M7.2 6.6a7 7 0 1 0 9.6 0"
SEEK_DOWN = "M6.5 6v12M18 6.5l-8 5.5 8 5.5z"
SEEK_UP = "M17.5 6v12M6 6.5l8 5.5-8 5.5z"


class RadioApp(ui.AppWindow):
    def __init__(self, app):
        # the header, the favourite star its action
        self.fav = ui.GlassButton(icon=STAR, height=46)
        self.fav.connect("clicked", self.on_fav)
        super().__init__(app, "Radio", "FM", actions=[self.fav])
        ui.add_css(self.get_display(), CSS)
        self.connect("close-request", self.on_quit)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        self.tuner = Tuner()
        self.hold = None            # spk-hold process: the FM audio route
        self.stream = []            # 6.12: arecord | pw-cat, the FM audio
        self.worker = None          # scan / seek thread
        self.cancel = threading.Event()
        self.dial_timer = 0
        self.gain_timer = 0

        st = self.load_state()
        self.freq = clamp_freq(st.get("freq", FREQ_DEFAULT))
        self.gain_db = max(GAIN_DB_MIN, min(GAIN_DB_MAX, st.get("gain_db", GAIN_DB_DEFAULT)))
        self.favorites = sorted({clamp_freq(f) for f in st.get("favorites", [])})
        self.stations = [(clamp_freq(f), r) for f, r in st.get("stations", [])]
        self.names = {int(f): n for f, n in st.get("names", {}).items()}
        self.rbds = rbds_region()
        self.rds = {}
        self.rows = []

        self.build()
        self.show_freq()
        self.refresh_list()
        GLib.timeout_add(STATUS_MS, self.on_status_timer)
        GLib.idle_add(self.power_on)

    # ---- layout ----

    def build(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.set_margin_bottom(18)
        self.body.append(ui.scroll(page))

        # the frequency, RDS, the signal
        p = water.panel((8, 18, 12, 18), spacing=4)
        freqbox = Gtk.Box(spacing=8)
        freqbox.set_halign(Gtk.Align.CENTER)
        self.freq_label = ui.label("", "freq")
        freqbox.append(self.freq_label)
        unit = ui.label("MHz", "unit")
        unit.set_valign(Gtk.Align.END)
        unit.set_margin_bottom(12)
        freqbox.append(unit)
        p.inner.append(freqbox)
        line = Gtk.Box(spacing=10)
        line.set_halign(Gtk.Align.CENTER)
        self.ps_label = ui.label("", "ps")
        line.append(self.ps_label)
        self.pty_label = ui.label("", "detail")
        line.append(self.pty_label)
        p.inner.append(line)
        self.rt_label = ui.label("", "rt", xalign=0.5, ellipsize=True)
        self.rt_label.set_max_width_chars(48)
        p.inner.append(self.rt_label)
        sig = Gtk.Box(spacing=10)
        sig.set_margin_top(6)
        self.meter = Gtk.LevelBar()
        self.meter.set_mode(Gtk.LevelBarMode.DISCRETE)
        self.meter.set_min_value(0)
        self.meter.set_max_value(5)
        self.meter.remove_offset_value(Gtk.LEVEL_BAR_OFFSET_LOW)
        self.meter.remove_offset_value(Gtk.LEVEL_BAR_OFFSET_HIGH)
        self.meter.add_offset_value("low", 1)
        self.meter.set_size_request(150, -1)
        self.meter.set_valign(Gtk.Align.CENTER)
        sig.append(self.meter)
        self.stereo = ui.label("STEREO", "badge")
        sig.append(self.stereo)
        self.rssi_label = ui.label("", "detail")
        sig.append(self.rssi_label)
        self.state = ui.label("", "state", xalign=1, ellipsize=True)
        self.state.set_hexpand(True)
        sig.append(self.state)
        p.inner.append(sig)
        page.append(p)

        # the dial and the volume (the FM gain; the speaker level stays with
        # the volume keys): water sliders
        p = water.panel((6, 18, 8, 18))
        self.dial = water.WaterSlider("Dial", self.freq / 100, lo=FREQ_MIN / 100,
                                      hi=FREQ_MAX / 100, step=0.1, fmt=lambda v: "%.1f MHz" % v)
        self.dial.connect("value-changed", self.on_dial)
        p.inner.append(self.dial)
        self.volume = water.WaterSlider("Volume", self.gain_db, lo=GAIN_DB_MIN, hi=GAIN_DB_MAX,
                                        fmt=lambda v: "%d dB" % v)
        self.volume.connect("value-changed", self.on_volume)
        p.inner.append(self.volume)
        page.append(p)

        # transport: seek down, step down, power, step up, seek up
        nav = Gtk.Box(spacing=10)
        nav.set_halign(Gtk.Align.CENTER)
        for icon, cb, arg in ((SEEK_DOWN, self.on_seek, -1), (ui.ICONS["back"], self.on_step, -1)):
            b = ui.GlassButton(icon=icon, height=64)
            b.connect("clicked", cb, arg)
            nav.append(b)
        self.power = ui.GlassButton(icon=POWER, height=64, toggle=True)
        self.power.set_size_request(104, -1)
        self.power.connect("clicked", self.on_power)
        nav.append(self.power)
        for icon, cb, arg in ((ui.ICONS["forward"], self.on_step, 1), (SEEK_UP, self.on_seek, 1)):
            b = ui.GlassButton(icon=icon, height=64)
            b.connect("clicked", cb, arg)
            nav.append(b)
        page.append(nav)

        # stations
        hdr = Gtk.Box(spacing=10)
        hdr.set_margin_top(4)
        sec = ui.section("Stations")
        sec.set_valign(Gtk.Align.CENTER)
        hdr.append(sec)
        self.progress = Gtk.ProgressBar()
        self.progress.set_valign(Gtk.Align.CENTER)
        self.progress.set_hexpand(True)
        self.progress.set_visible(False)
        hdr.append(self.progress)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        hdr.append(spacer)
        self.scan_btn = ui.GlassButton("Scan", icon=ui.ICONS["search"], height=46, size=17)
        self.scan_btn.connect("clicked", self.on_scan)
        hdr.append(self.scan_btn)
        page.append(hdr)

        p = water.panel((4, 0, 4, 0))
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.set_activate_on_single_click(True)
        self.listbox.connect("row-activated", self.on_row)
        empty = ui.label("Tap Scan to find stations", "empty", xalign=0.5)
        empty.set_margin_top(18)
        empty.set_margin_bottom(18)
        self.listbox.set_placeholder(empty)
        p.inner.append(self.listbox)
        page.append(p)

    # ---- state file ----

    def load_state(self):
        try:
            with open(STATE_FILE) as f:
                st = json.load(f)
            return st if isinstance(st, dict) else {}
        except (OSError, ValueError):
            return {}

    def save_state(self):
        st = {"freq": self.freq, "gain_db": self.gain_db,
              "favorites": self.favorites, "stations": self.stations,
              "names": {str(f): n for f, n in self.names.items()}}
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            tmp = STATE_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(st, f)
            os.replace(tmp, STATE_FILE)
        except OSError:
            pass

    # ---- display ----

    def set_state(self, text, err=False):
        self.state.set_text(text)
        (self.state.add_css_class if err else self.state.remove_css_class)("err")

    def show_freq(self):
        self.freq_label.set_text(mhz(self.freq))
        (self.freq_label.remove_css_class if self.tuner.is_open
         else self.freq_label.add_css_class)("off")
        if not self.dial.held():
            self.dial.set_value(self.freq / 100, notify=False)
        self.fav.set_kind("lit" if self.freq in self.favorites else "")
        for row in self.rows:
            (row.name_label.add_css_class if row.freq == self.freq
             else row.name_label.remove_css_class)("current")

    def clear_rds(self):
        self.rds = {}
        self.show_rds()

    def show_rds(self):
        r = self.rds
        self.ps_label.set_text(r.get("ps", ""))
        extra = []
        if r.get("pi") and self.rbds:
            cl = call_letters(r["pi"])
            if cl:
                extra.append(cl)
        pty = r.get("pty", 0)
        names = PTY_RBDS if self.rbds else PTY_RDS
        if 0 < pty < len(names) and names[pty]:
            extra.append(names[pty])
        self.pty_label.set_text(" · ".join(extra))
        self.rt_label.set_text(r.get("rt", ""))

    def poll_rds(self):
        data = self.tuner.read_rds()
        if not data:
            return
        ev = struct.unpack_from("=H", data, RDS_EVENT)[0]
        pi = struct.unpack_from("=H", data, RDS_PI)[0]
        changed = False
        if pi and (ev & RDS_EV_PI or "pi" not in self.rds):
            self.rds["pi"] = pi
            changed = True
        if ev & RDS_EV_PTY or ("pty" not in self.rds and data[RDS_PTY]):
            self.rds["pty"] = data[RDS_PTY] & 0x1f
            changed = True
        ps = rds_text(data[RDS_PS:RDS_PS + 8])
        if ps and (ev & RDS_EV_PS or "ps" not in self.rds):
            self.rds["ps"] = ps
            changed = True
            if self.names.get(self.freq) != ps:
                self.names[self.freq] = ps
                self.save_state()
                self.refresh_list()
        if ev & RDS_EV_RT:
            n = min(data[RDS_RT_LEN], 64)
            rt = rds_text(data[RDS_RT:RDS_RT + n])
            if rt:
                self.rds["rt"] = rt
                changed = True
        if changed:
            self.show_rds()

    def show_signal(self, rssi, stereo):
        self.rssi_label.set_text("" if rssi is None else "%d dBm" % rssi)
        if rssi is None:
            self.meter.set_value(0)
        else:
            frac = (rssi - RSSI_LOW) / (RSSI_HIGH - RSSI_LOW)
            self.meter.set_value(round(max(0, min(1, frac)) * 5))
        (self.stereo.add_css_class if stereo else self.stereo.remove_css_class)("on")
        self.stereo.set_text("STEREO" if stereo else "MONO")

    def refresh_list(self):
        for row in self.rows:
            self.listbox.remove(row)
        self.rows = []
        rssi = dict(self.stations)
        favs = set(self.favorites)
        for f in self.favorites + [f for f, _ in self.stations if f not in favs]:
            row = self.make_row(f, rssi.get(f), f in favs)
            self.rows.append(row)
            self.listbox.append(row)
        self.show_freq()

    def make_row(self, freq, rssi, fav):
        row = Gtk.ListBoxRow()
        row.freq = freq
        box = Gtk.Box(spacing=12)
        row.set_child(box)
        name = ui.label(mhz(freq) + " MHz", "station")
        name.set_valign(Gtk.Align.CENTER)
        box.append(name)
        row.name_label = name
        if self.names.get(freq):
            ps = ui.label(self.names[freq], "rowps")
            ps.set_valign(Gtk.Align.CENTER)
            box.append(ps)
        d = ui.label("%d dBm" % rssi if rssi is not None else "", "detail")
        d.set_valign(Gtk.Align.CENTER)
        d.set_hexpand(True)
        box.append(d)
        star = ui.GlassButton(icon=STAR, height=48, kind="lit" if fav else "")
        star.connect("clicked", lambda b, f=freq: self.toggle_favorite(f))
        box.append(star)
        return row

    # ---- power / audio ----

    def power_on(self):
        if self.tuner.is_open:
            return False
        self.set_state("Starting…")
        ctx = GLib.MainContext.default()
        while ctx.pending():
            ctx.iteration(False)
        try:
            if not os.path.exists(FM_DEV):
                subprocess.run(["modprobe", "fmradio_drv"], timeout=10, check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                for _ in range(25):
                    if os.path.exists(FM_DEV):
                        break
                    time.sleep(0.2)
            if ON_612:
                self.start_stream()
            else:
                self.apply_gain()
                # the FM route first, then power up the tuner (as titan-radio)
                self.hold = subprocess.Popen(SPK_HOLD, stdout=subprocess.DEVNULL,
                                             stderr=subprocess.DEVNULL,
                                             preexec_fn=die_with_parent)
            self.tuner.open()
            self.tuner.power_up(self.freq)
            chip = self.tuner.chip_id()
            try:
                self.tuner.rds_on()
            except OSError:
                pass        # no RDS: the radio still plays
        except (OSError, subprocess.SubprocessError) as e:
            self.power_off()
            msg = getattr(e, "strerror", None) or str(e)
            self.set_state("FM unavailable: %s" % msg, err=True)
            self.sync_power(False)
            return False
        self.set_state("MT%04x" % chip if chip else "")
        self.sync_power(True)
        self.show_freq()
        self.on_status_timer()
        return False

    def power_off(self):
        self.cancel.set()
        if self.worker:
            self.worker.join(timeout=15)
            self.worker = None
        self.tuner.close()
        for proc in ([self.hold] if self.hold else []) + self.stream:
            proc.terminate()
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
        self.hold = None
        self.stream = []
        self.show_signal(None, False)
        self.clear_rds()
        self.show_freq()

    def sync_power(self, on):
        self.power.set_active(on)

    def start_stream(self):
        """6.12: the FM capture into a PipeWire stream at the slider's level"""
        rec = subprocess.Popen(FM_CAPTURE, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, preexec_fn=die_with_parent)
        play = subprocess.Popen(
            ["pw-cat", "--playback", "--volume", "%.4f" % (10 ** (self.gain_db / 20)),
             "-P", '{ media.name = "%s" application.name = "%s" }' % (FM_STREAM, FM_APP), "-"],
            stdin=rec.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            env=PIPEWIRE_ENV, preexec_fn=die_with_parent)
        rec.stdout.close()          # pw-cat owns the pipe now
        self.stream = [rec, play]

    def stream_volume(self):
        """6.12: set the playing FM stream's volume to the slider. pw-cat's
        --volume is the node's "volume" (linear), which this sets again; the
        channel volumes (what pactl and the mixer change, and WirePlumber
        restores) stay at 1.0, as they multiply with it. The stream is found
        by application.name: pw-cat sets media.name to its file, "-"."""
        try:
            out = subprocess.run(["pactl", "-f", "json", "list", "sink-inputs"],
                                 capture_output=True, text=True, timeout=5,
                                 env=PIPEWIRE_ENV).stdout
            for si in json.loads(out or "[]"):
                props = si.get("properties", {})
                if props.get("application.name") == FM_APP and "object.id" in props:
                    subprocess.run(["pw-cli", "set-param", str(props["object.id"]), "Props",
                                    "{ volume: %.4f channelVolumes: [ 1.0 1.0 ] }"
                                    % 10 ** (self.gain_db / 20)],
                                   timeout=5, env=PIPEWIRE_ENV,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, ValueError, subprocess.SubprocessError):
            pass

    def apply_gain(self):
        if ON_612:
            if self.stream:
                self.stream_volume()
            return
        gain = int(GAIN_0DB * 10 ** (self.gain_db / 20))
        subprocess.Popen(["tinymix", "-D", "0", "set", GAIN_CONTROL, str(gain)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).wait()

    # ---- tuning ----

    def tune_to(self, freq):
        freq = clamp_freq(freq)
        if freq != self.freq:
            self.clear_rds()
        self.freq = freq
        self.show_freq()
        self.save_state()
        if self.tuner.is_open and not self.busy():
            try:
                self.tuner.tune(freq)
            except OSError as e:
                self.set_state("Tune failed: %s" % e.strerror, err=True)
                return
            self.on_status_timer()

    def busy(self):
        return self.worker is not None and self.worker.is_alive()

    def run_worker(self, target, done):
        """run target(cancel) on a thread, then done(result) on the GTK thread"""
        self.cancel.clear()

        def body():
            try:
                res = target(self.cancel)
            except OSError as e:
                res = e
            GLib.idle_add(finish, res)

        def finish(res):
            self.worker = None
            self.scan_btn.set_label("Scan")
            self.progress.set_visible(False)
            if isinstance(res, OSError):
                self.set_state("FM error: %s" % res.strerror, err=True)
            else:
                done(res)
            self.on_status_timer()
            return False

        self.worker = threading.Thread(target=body, daemon=True)
        self.worker.start()

    # ---- callbacks ----

    def on_power(self, btn):
        if btn.get_active():
            self.power_on()
        else:
            self.power_off()
            self.set_state("Off")

    def on_step(self, btn, direction):
        if not self.busy():
            self.tune_to(wrap_freq(self.freq + direction * STEP))

    def on_seek(self, btn, direction):
        if self.busy():
            return
        if not self.tuner.is_open:
            self.power_on()
            if not self.tuner.is_open:
                return
        self.set_state("Seeking…")
        start = self.freq

        def done(found):
            self.clear_rds()
            if found:
                self.freq = found
                self.set_state("")
            else:
                self.set_state("No station found")
            self.show_freq()
            self.save_state()

        self.run_worker(lambda c: self.tuner.seek(start, direction, c), done)

    def on_scan(self, btn):
        if self.busy():
            self.cancel.set()           # the button reads "Stop" while scanning
            return
        if not self.tuner.is_open:
            self.power_on()
            if not self.tuner.is_open:
                return
        self.scan_btn.set_label("Stop")
        self.progress.set_fraction(0)
        self.progress.set_visible(True)
        self.set_state("Scanning…")
        current = self.freq

        def progress(frac, f, n):
            GLib.idle_add(self.on_scan_progress, frac, f, n)

        def done(stations):
            if self.cancel.is_set():
                self.set_state("Scan stopped")
                return
            self.stations = stations
            self.set_state("%d station%s" % (len(stations), "" if len(stations) == 1 else "s"))
            self.save_state()
            self.refresh_list()

        self.run_worker(lambda c: self.tuner.scan(current, progress, c), done)

    def on_scan_progress(self, frac, f, n):
        if self.busy():
            self.progress.set_fraction(frac)
            self.set_state("Scanning %s · %d found" % (mhz(f), n))
        return False

    def on_dial(self, slider, value):
        self.freq_label.set_text(mhz(clamp_freq(round(value * 100))))
        if self.dial_timer:
            GLib.source_remove(self.dial_timer)
        self.dial_timer = GLib.timeout_add(DIAL_DELAY_MS, self.on_dial_settled)

    def on_dial_settled(self):
        self.dial_timer = 0
        if self.busy():
            self.show_freq()
        else:
            self.tune_to(round(self.dial.real() * 100))
        return False

    def on_volume(self, slider, value):
        self.gain_db = int(round(value))
        if self.gain_timer:
            GLib.source_remove(self.gain_timer)
        self.gain_timer = GLib.timeout_add(DIAL_DELAY_MS, self.on_volume_settled)

    def on_volume_settled(self):
        self.gain_timer = 0
        self.apply_gain()
        self.save_state()
        return False

    def on_fav(self, btn):
        self.toggle_favorite(self.freq)

    def toggle_favorite(self, freq):
        if freq in self.favorites:
            self.favorites.remove(freq)
        else:
            self.favorites = sorted(self.favorites + [freq])
        self.save_state()
        self.refresh_list()

    def on_row(self, listbox, row):
        if not self.busy():
            if not self.tuner.is_open:
                self.freq = row.freq
                self.power_on()
            self.tune_to(row.freq)

    def on_status_timer(self):
        if self.tuner.is_open:
            try:
                st = self.tuner.status()
            except OSError:
                st = None
            if st:
                self.show_signal(*st)
            if not self.busy():
                self.poll_rds()
        return True

    def on_key(self, ctl, keyval, code, state):
        name = Gdk.keyval_name(keyval) or ""
        if name in ("Left", "Right"):
            self.on_step(None, 1 if name == "Right" else -1)
        elif name in ("Up", "Down"):
            self.on_seek(None, 1 if name == "Up" else -1)
        elif name == "space":
            self.power.activate_button()
        elif name in ("f", "F"):
            self.toggle_favorite(self.freq)
        else:
            return False
        return True

    def on_quit(self, *a):
        self.save_state()
        self.power_off()
        return False


def build(app):
    win = RadioApp(app)
    # however it's told to stop, the FM route is let go (power_off)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda w=win: w.close() or False)
    return win


if __name__ == "__main__":
    sys.exit(ui.run("org.titanpocket.radio", build, lock="titan-radio-gui"))
