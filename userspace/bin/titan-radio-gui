class RadioApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Radio")
        self.set_default_size(720, 680)
        self.connect("destroy", self.on_quit)
        self.connect("key-press-event", self.on_key)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.tuner = Tuner()
        self.hold = None            # spk-hold process: the FM audio route
        self.worker = None          # scan / seek thread
        self.cancel = threading.Event()
        self.dial_timer = 0
        self.gain_timer = 0
        self.syncing = False        # setting widgets from code, not the user

        st = self.load_state()
        self.freq = clamp_freq(st.get("freq", FREQ_DEFAULT))
        self.gain_db = max(GAIN_DB_MIN, min(GAIN_DB_MAX, st.get("gain_db", GAIN_DB_DEFAULT)))
        self.favorites = sorted({clamp_freq(f) for f in st.get("favorites", [])})
        self.stations = [(clamp_freq(f), r) for f, r in st.get("stations", [])]
        self.names = {int(f): n for f, n in st.get("names", {}).items()}
        self.rbds = rbds_region()
        self.rds = {}

        self.build()
        self.show_freq()
        self.refresh_list()
        GLib.timeout_add(STATUS_MS, self.on_status_timer)
        GLib.idle_add(self.power_on)

    # ---- layout ----

    def build(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        root.set_border_width(10)
        self.add(root)

        # frequency + favorite
        top = Gtk.Box(spacing=8)
        root.pack_start(top, False, False, 0)
        self.fav = icon_button("non-starred-symbolic", "fav", toggle=True, size=40)
        self.fav.set_valign(Gtk.Align.CENTER)
        self.fav.connect("toggled", self.on_fav)
        top.pack_end(self.fav, False, False, 0)
        freqbox = Gtk.Box(spacing=8)
        freqbox.set_halign(Gtk.Align.CENTER)
        top.pack_start(freqbox, True, True, 0)
        self.freq_label = Gtk.Label()
        self.freq_label.get_style_context().add_class("freq")
        freqbox.pack_start(self.freq_label, False, False, 0)
        unit = Gtk.Label(label="MHz")
        unit.get_style_context().add_class("unit")
        unit.set_valign(Gtk.Align.END)
        unit.set_margin_bottom(12)
        freqbox.pack_start(unit, False, False, 0)

        # signal meter, stereo badge, state
        # RDS: station name, call letters / programme type, radio text
        rdsbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        root.pack_start(rdsbox, False, False, 0)
        line = Gtk.Box(spacing=10)
        line.set_halign(Gtk.Align.CENTER)
        rdsbox.pack_start(line, False, False, 0)
        self.ps_label = Gtk.Label()
        self.ps_label.get_style_context().add_class("ps")
        line.pack_start(self.ps_label, False, False, 0)
        self.pty_label = Gtk.Label()
        self.pty_label.get_style_context().add_class("detail")
        line.pack_start(self.pty_label, False, False, 0)
        self.rt_label = Gtk.Label()
        self.rt_label.get_style_context().add_class("rt")
        self.rt_label.set_ellipsize(Pango.EllipsizeMode.END)
        self.rt_label.set_max_width_chars(48)
        rdsbox.pack_start(self.rt_label, False, False, 0)

        sig = Gtk.Box(spacing=10)
        root.pack_start(sig, False, False, 0)
        self.meter = Gtk.LevelBar()
        self.meter.set_mode(Gtk.LevelBarMode.DISCRETE)
        self.meter.set_min_value(0)
        self.meter.set_max_value(5)
        self.meter.remove_offset_value(Gtk.LEVEL_BAR_OFFSET_LOW)
        self.meter.remove_offset_value(Gtk.LEVEL_BAR_OFFSET_HIGH)
        self.meter.add_offset_value("low", 1)
        self.meter.set_size_request(150, -1)
        self.meter.set_valign(Gtk.Align.CENTER)
        sig.pack_start(self.meter, False, False, 0)
        self.stereo = Gtk.Label(label="STEREO")
        self.stereo.get_style_context().add_class("badge")
        sig.pack_start(self.stereo, False, False, 0)
        self.rssi_label = Gtk.Label()
        self.rssi_label.get_style_context().add_class("detail")
        sig.pack_start(self.rssi_label, False, False, 0)
        self.state = Gtk.Label(xalign=1)
        self.state.get_style_context().add_class("state")
        self.state.set_ellipsize(Pango.EllipsizeMode.END)
        sig.pack_end(self.state, True, True, 0)

        # dial
        self.dial = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,
                                             FREQ_MIN / 100, FREQ_MAX / 100, 0.1)
        self.dial.set_digits(1)
        self.dial.set_draw_value(False)
        for f in range(88, 109, 4):
            self.dial.add_mark(f, Gtk.PositionType.BOTTOM, str(f))
        self.dial.connect("value-changed", self.on_dial)
        root.pack_start(self.dial, False, False, 0)

        # transport: seek down, step down, power, step up, seek up
        nav = Gtk.Box(spacing=8, homogeneous=False)
        nav.set_halign(Gtk.Align.CENTER)
        root.pack_start(nav, False, False, 0)
        for icon, cb, arg in (("media-skip-backward-symbolic", self.on_seek, -1),
                              ("go-previous-symbolic", self.on_step, -1)):
            b = icon_button(icon, "nav")
            b.connect("clicked", cb, arg)
            nav.pack_start(b, False, False, 0)
        self.power = icon_button("system-shutdown-symbolic", "power", toggle=True, size=40)
        self.power.connect("toggled", self.on_power)
        nav.pack_start(self.power, False, False, 0)
        for icon, cb, arg in (("go-next-symbolic", self.on_step, 1),
                              ("media-skip-forward-symbolic", self.on_seek, 1)):
            b = icon_button(icon, "nav")
            b.connect("clicked", cb, arg)
            nav.pack_start(b, False, False, 0)

        # volume (the FM gain; the speaker level stays with the volume keys)
        vol = Gtk.Box(spacing=10)
        root.pack_start(vol, False, False, 0)
        icon = Gtk.Image.new_from_icon_name("audio-volume-medium-symbolic", Gtk.IconSize.BUTTON)
        icon.set_pixel_size(32)
        vol.pack_start(icon, False, False, 0)
        self.volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,
                                               GAIN_DB_MIN, GAIN_DB_MAX, 1)
        self.volume.set_draw_value(False)
        self.volume.set_value(self.gain_db)
        self.volume.connect("value-changed", self.on_volume)
        vol.pack_start(self.volume, True, True, 0)
        self.vol_label = Gtk.Label()
        self.vol_label.get_style_context().add_class("detail")
        self.vol_label.set_width_chars(7)
        vol.pack_start(self.vol_label, False, False, 0)
        self.show_volume()

        # stations
        hdr = Gtk.Box(spacing=10)
        root.pack_start(hdr, False, False, 6)
        sec = Gtk.Label(label="STATIONS", xalign=0)
        sec.get_style_context().add_class("section")
        hdr.pack_start(sec, False, False, 0)
        self.scan_btn = Gtk.Button(label="Scan")
        self.scan_btn.connect("clicked", self.on_scan)
        hdr.pack_end(self.scan_btn, False, False, 0)
        self.progress = Gtk.ProgressBar()
        self.progress.set_valign(Gtk.Align.CENTER)
        self.progress.set_no_show_all(True)
        hdr.pack_start(self.progress, True, True, 0)

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_vexpand(True)
        root.pack_start(sw, True, True, 0)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.set_activate_on_single_click(True)
        self.listbox.connect("row-activated", self.on_row)
        empty = Gtk.Label(label="Tap Scan to find stations")
        empty.get_style_context().add_class("empty")
        empty.set_margin_top(24)
        empty.show()
        self.listbox.set_placeholder(empty)
        sw.add(self.listbox)

    # ---- state file ----

    def load_state(self):
        try:
            with open(STATE_FILE) as f:
                st = json.load(f)
            return st if isinstance(st, dict) else {}
        except (OSError, ValueError):
            return {}

    def save_state(self):
        st = {"freq": self.freq, "gain_db": self.gain_db,
              "favorites": self.favorites, "stations": self.stations,
              "names": {str(f): n for f, n in self.names.items()}}
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            tmp = STATE_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(st, f)
            os.replace(tmp, STATE_FILE)
        except OSError:
            pass

    # ---- display ----

    def set_state(self, text, err=False):
        self.state.set_text(text)
        ctx = self.state.get_style_context()
        (ctx.add_class if err else ctx.remove_class)("err")

    def show_freq(self):
        self.freq_label.set_text(mhz(self.freq))
        ctx = self.freq_label.get_style_context()
        (ctx.remove_class if self.tuner.is_open else ctx.add_class)("off")
        self.syncing = True
        self.dial.set_value(self.freq / 100)
        self.fav.set_active(self.freq in self.favorites)
        set_icon(self.fav, "starred-symbolic" if self.freq in self.favorites
                 else "non-starred-symbolic")
        self.syncing = False
        for row in self.listbox.get_children():
            ctx = row.name_label.get_style_context()
            (ctx.add_class if row.freq == self.freq else ctx.remove_class)("current")

    def clear_rds(self):
        self.rds = {}
        self.show_rds()

    def show_rds(self):
        r = self.rds
        self.ps_label.set_text(r.get("ps", ""))
        extra = []
        if r.get("pi") and self.rbds:
            cl = call_letters(r["pi"])
            if cl:
                extra.append(cl)
        pty = r.get("pty", 0)
        names = PTY_RBDS if self.rbds else PTY_RDS
        if 0 < pty < len(names) and names[pty]:
            extra.append(names[pty])
        self.pty_label.set_text(" · ".join(extra))
        self.rt_label.set_text(r.get("rt", ""))

    def poll_rds(self):
        data = self.tuner.read_rds()
        if not data:
            return
        ev = struct.unpack_from("=H", data, RDS_EVENT)[0]
        pi = struct.unpack_from("=H", data, RDS_PI)[0]
        changed = False
        if pi and (ev & RDS_EV_PI or "pi" not in self.rds):
            self.rds["pi"] = pi
            changed = True
        if ev & RDS_EV_PTY or ("pty" not in self.rds and data[RDS_PTY]):
            self.rds["pty"] = data[RDS_PTY] & 0x1f
            changed = True
        ps = rds_text(data[RDS_PS:RDS_PS + 8])
        if ps and (ev & RDS_EV_PS or "ps" not in self.rds):
            self.rds["ps"] = ps
            changed = True
            if self.names.get(self.freq) != ps:
                self.names[self.freq] = ps
                self.save_state()
                self.refresh_list()
        if ev & RDS_EV_RT:
            n = min(data[RDS_RT_LEN], 64)
            rt = rds_text(data[RDS_RT:RDS_RT + n])
            if rt:
                self.rds["rt"] = rt
                changed = True
        if changed:
            self.show_rds()

    def show_signal(self, rssi, stereo):
        self.rssi_label.set_text("" if rssi is None else "%d dBm" % rssi)
        if rssi is None:
            self.meter.set_value(0)
        else:
            frac = (rssi - RSSI_LOW) / (RSSI_HIGH - RSSI_LOW)
            self.meter.set_value(round(max(0, min(1, frac)) * 5))
        ctx = self.stereo.get_style_context()
        (ctx.add_class if stereo else ctx.remove_class)("on")
        self.stereo.set_text("STEREO" if stereo else "MONO")

    def show_volume(self):
        self.vol_label.set_text("%d dB" % self.gain_db)

    def refresh_list(self):
        for row in self.listbox.get_children():
            self.listbox.remove(row)
        rssi = dict(self.stations)
        favs = set(self.favorites)
        for f in self.favorites + [f for f, _ in self.stations if f not in favs]:
            self.listbox.add(self.make_row(f, rssi.get(f), f in favs))
        self.listbox.show_all()
        self.show_freq()

    def make_row(self, freq, rssi, fav):
        row = Gtk.ListBoxRow()
        row.freq = freq
        box = Gtk.Box(spacing=12)
        row.add(box)
        name = Gtk.Label(label=mhz(freq) + " MHz", xalign=0)
        name.get_style_context().add_class("station")
        box.pack_start(name, False, False, 0)
        row.name_label = name
        if self.names.get(freq):
            ps = Gtk.Label(label=self.names[freq], xalign=0)
            ps.get_style_context().add_class("rowps")
            box.pack_start(ps, False, False, 0)
        if rssi is not None:
            d = Gtk.Label(label="%d dBm" % rssi, xalign=0)
            d.get_style_context().add_class("detail")
            box.pack_start(d, True, True, 0)
        star = icon_button("starred-symbolic" if fav else "non-starred-symbolic", "rowfav")
        star.set_relief(Gtk.ReliefStyle.NONE)
        star.connect("clicked", lambda b, f=freq: self.toggle_favorite(f))
        box.pack_end(star, False, False, 0)
        return row

    # ---- power / audio ----

    def power_on(self):
        if self.tuner.is_open:
            return False
        self.set_state("Starting…")
        while Gtk.events_pending():
            Gtk.main_iteration()
        try:
            if not os.path.exists(FM_DEV):
                subprocess.run(["modprobe", "fmradio_drv"], timeout=10, check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                for _ in range(25):
                    if os.path.exists(FM_DEV):
                        break
                    time.sleep(0.2)
            self.apply_gain()
            # the FM route first, then power up the tuner (as titan-radio)
            self.hold = subprocess.Popen(SPK_HOLD, stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL,
                                         preexec_fn=die_with_parent)
            self.tuner.open()
            self.tuner.power_up(self.freq)
            chip = self.tuner.chip_id()
            try:
                self.tuner.rds_on()
            except OSError:
                pass        # no RDS: the radio still plays
        except (OSError, subprocess.SubprocessError) as e:
            self.power_off()
            msg = getattr(e, "strerror", None) or str(e)
            self.set_state("FM unavailable: %s" % msg, err=True)
            self.sync_power(False)
            return False
        self.set_state("MT%04x" % chip if chip else "")
        self.sync_power(True)
        self.show_freq()
        self.on_status_timer()
        return False

    def power_off(self):
        self.cancel.set()
        if self.worker:
            self.worker.join(timeout=15)
            self.worker = None
        self.tuner.close()
        if self.hold:
            self.hold.terminate()
            try:
                self.hold.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.hold.kill()
            self.hold = None
        self.show_signal(None, False)
        self.clear_rds()
        self.show_freq()

    def sync_power(self, on):
        self.syncing = True
        self.power.set_active(on)
        self.syncing = False

    def apply_gain(self):
        gain = int(GAIN_0DB * 10 ** (self.gain_db / 20))
        subprocess.Popen(["tinymix", "-D", "0", "set", GAIN_CONTROL, str(gain)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).wait()

    # ---- tuning ----

    def tune_to(self, freq):
        freq = clamp_freq(freq)
        if freq != self.freq:
            self.clear_rds()
        self.freq = freq
        self.show_freq()
        self.save_state()
        if self.tuner.is_open and not self.busy():
            try:
                self.tuner.tune(freq)
            except OSError as e:
                self.set_state("Tune failed: %s" % e.strerror, err=True)
                return
            self.on_status_timer()

    def busy(self):
        return self.worker is not None and self.worker.is_alive()

    def run_worker(self, target, done):
        """run target(cancel) on a thread, then done(result) on the GTK thread"""
        self.cancel.clear()

        def body():
            try:
                res = target(self.cancel)
            except OSError as e:
                res = e
            GLib.idle_add(finish, res)

        def finish(res):
            self.worker = None
            self.scan_btn.set_label("Scan")
            self.progress.hide()
            if isinstance(res, OSError):
                self.set_state("FM error: %s" % res.strerror, err=True)
            else:
                done(res)
            self.on_status_timer()
            return False

        self.worker = threading.Thread(target=body, daemon=True)
        self.worker.start()

    # ---- callbacks ----

    def on_power(self, btn):
        if self.syncing:
            return
        if btn.get_active():
            self.power_on()
        else:
            self.power_off()
            self.set_state("Off")

    def on_step(self, btn, direction):
        if not self.busy():
            self.tune_to(wrap_freq(self.freq + direction * STEP))

    def on_seek(self, btn, direction):
        if self.busy():
            return
        if not self.tuner.is_open:
            self.power_on()
            if not self.tuner.is_open:
                return
        self.set_state("Seeking…")
        start = self.freq

        def done(found):
            self.clear_rds()
            if found:
                self.freq = found
                self.set_state("")
            else:
                self.set_state("No station found")
            self.show_freq()
            self.save_state()

        self.run_worker(lambda c: self.tuner.seek(start, direction, c), done)

    def on_scan(self, btn):
        if self.busy():
            self.cancel.set()           # the button reads "Stop" while scanning
            return
        if not self.tuner.is_open:
            self.power_on()
            if not self.tuner.is_open:
                return
        self.scan_btn.set_label("Stop")
        self.progress.set_fraction(0)
        self.progress.show()
        self.set_state("Scanning…")
        current = self.freq

        def progress(frac, f, n):
            GLib.idle_add(self.on_scan_progress, frac, f, n)

        def done(stations):
            if self.cancel.is_set():
                self.set_state("Scan stopped")
                return
            self.stations = stations
            self.set_state("%d station%s" % (len(stations), "" if len(stations) == 1 else "s"))
            self.save_state()
            self.refresh_list()

        self.run_worker(lambda c: self.tuner.scan(current, progress, c), done)

    def on_scan_progress(self, frac, f, n):
        if self.busy():
            self.progress.set_fraction(frac)
            self.set_state("Scanning %s · %d found" % (mhz(f), n))
        return False

    def on_dial(self, scale):
        if self.syncing:
            return
        self.freq_label.set_text(mhz(clamp_freq(scale.get_value() * 100)))
        if self.dial_timer:
            GLib.source_remove(self.dial_timer)
        self.dial_timer = GLib.timeout_add(DIAL_DELAY_MS, self.on_dial_settled)

    def on_dial_settled(self):
        self.dial_timer = 0
        if self.busy():
            self.show_freq()
        else:
            self.tune_to(self.dial.get_value() * 100)
        return False

    def on_volume(self, scale):
        self.gain_db = int(round(scale.get_value()))
        self.show_volume()
        if self.gain_timer:
            GLib.source_remove(self.gain_timer)
        self.gain_timer = GLib.timeout_add(DIAL_DELAY_MS, self.on_volume_settled)

    def on_volume_settled(self):
        self.gain_timer = 0
        self.apply_gain()
        self.save_state()
        return False

    def on_fav(self, btn):
        if not self.syncing:
            self.toggle_favorite(self.freq)

    def toggle_favorite(self, freq):
        if freq in self.favorites:
            self.favorites.remove(freq)
        else:
            self.favorites = sorted(self.favorites + [freq])
        self.save_state()
        self.refresh_list()

    def on_row(self, listbox, row):
        if not self.busy():
            if not self.tuner.is_open:
                self.freq = row.freq
                self.power_on()
            self.tune_to(row.freq)

    def on_status_timer(self):
        if self.tuner.is_open:
            try:
                st = self.tuner.status()
            except OSError:
                st = None
            if st:
                self.show_signal(*st)
            if not self.busy():
                self.poll_rds()
        return True

    def on_key(self, win, ev):
        name = Gdk.keyval_name(ev.keyval) or ""
        if name in ("Left", "Right"):
            self.on_step(None, 1 if name == "Right" else -1)
        elif name in ("Up", "Down"):
            self.on_seek(None, 1 if name == "Up" else -1)
        elif name == "space":
            self.power.set_active(not self.power.get_active())
        elif name in ("f", "F"):
            self.toggle_favorite(self.freq)
        else:
            return False
        return True

    def on_quit(self, *a):
        self.save_state()
        self.power_off()
        Gtk.main_quit()


def main():
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "titan-radio-gui.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    win = RadioApp()
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda w=win: w.destroy() or False)
    win.show_all()
    win.maximize()
    Gtk.main()


if __name__ == "__main__":
    main()
