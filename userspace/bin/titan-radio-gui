#!/usr/bin/python3
"""
titan-radio-gui: touch-friendly FM radio for the Titan Pocket (GTK 4, titan_ui4).

Tunes the MT6631 through /dev/fm (fmradio_drv) with the same ioctls as
titan-fm, and plays it on the loudspeaker the way titan-radio does: the AFE's
FM gain ("Audio FM I2S Volume") is set with tinymix and the hostless FM
route (PCM device 21) is held open with spk-hold; titan-speakerd powers the
speaker amp while it is open. FM bypasses PipeWire.

On Linux 6.12 (card titanpocket) FM plays through PipeWire instead: the
CONNSYS I2S is captured on UL2 (hw:0,3, routed by
/etc/udev/rules.d/91-titan-audio.rules) and piped from arecord into pw-cat,
a playback stream "FM radio" on the default sink (the limiter, then the
speaker). Capture and playback run on the AFE's clock, so they don't drift.
The volume slider sets that stream's volume.

The driver powers the FM function down when the last handle on /dev/fm
closes, so the radio plays while this window is open (or until the power
button is tapped) and stops when it closes.

Station scan and seek use the soft-mute tune ioctl, which measures a channel
without unmuting it; a channel counts as a station at a raw RSSI of -296 or
above (FM_RX_RSSI_TH_LONG, see docs/drivers/fm.md). GETRSSI, used for the
signal meter, reports raw * 6 / 16 (the driver's conversion, shown as dBm by
MediaTek's app), so the threshold is about -111 there; scan results are
converted the same way.

RDS: the driver parses RDS itself (FM_IOCTL_RDS_ONOFF turns it on); read()
on /dev/fm returns its struct rds_t (688 bytes on arm64, offsets below) when
something changed, else nothing, so the status timer polls it. Shown: the
station name (PS, the twice-confirmed copy PS_Data.PS[3]), the radio text
(RT_Data.TextData[3], TextLength), the programme type (RBDS names in the
Americas, RDS names elsewhere) and, for North American stations whose PI
code follows NRSC-4, the call letters.

The last frequency, the volume, the favorites, the last scan and the station
names RDS reported are kept in ~/.config/titan-radio/state.json.

Keys: Left/Right step 100 kHz, Up/Down seek, Space power, F favorite.
"""
import ctypes
import fcntl
import json
import os
import signal
import struct
import subprocess
import sys
import threading
import time

import titan_ui4 as ui
import titan_water4 as water
from gi.repository import Gdk, GLib, Gtk

FM_DEV = "/dev/fm"
SPK_HOLD = ["spk-hold", "0", "21", "48000"]     # hostless FM_I2S_Playback
GAIN_CONTROL = "Audio FM I2S Volume"
ON_612 = os.path.exists("/proc/asound/titanpocket")
FM_CAPTURE = ["arecord", "-q", "-D", "hw:CARD=titanpocket,DEV=3", "-f", "S16_LE",
              "-r", "48000", "-c", "2", "-t", "wav"]
FM_STREAM = "FM radio"
FM_APP = "Radio"           # the stream's application.name
PIPEWIRE_ENV = dict(os.environ, XDG_RUNTIME_DIR="/run/user/0")
GAIN_0DB = 0x80000
GAIN_DB_MIN, GAIN_DB_MAX, GAIN_DB_DEFAULT = -48, 0, -24

STATE_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or
                         os.path.expanduser("~/.config"), "titan-radio")
STATE_FILE = os.path.join(STATE_DIR, "state.json")

# frequencies in 10 kHz units, as in the ioctls (9950 = 99.5 MHz)
FREQ_MIN, FREQ_MAX, STEP = 8750, 10800, 10
FREQ_DEFAULT = 9950

# signal in GETRSSI units (raw * 6 / 16, ~dBm): the meter's range, from the
# station threshold (raw -296 = -111) up to a strong station
RSSI_LOW, RSSI_HIGH = -112, -72

STATUS_MS = 1000            # signal / stereo refresh
DIAL_DELAY_MS = 150         # coalesce dial drags into tune ioctls


# fm_ioctl.h: magic 0xf5; the ioctls are declared with pointer types, so the
# encoded size is sizeof(void *) = 8, except PRE/RESTORE_SEARCH (int)
def _iowr(nr, size=8):
    return (3 << 30) | (size << 16) | (0xf5 << 8) | nr


FM_IOCTL_POWERUP = _iowr(0)
FM_IOCTL_TUNE = _iowr(2)
FM_IOCTL_GETRSSI = _iowr(7)
FM_IOCTL_GETCHIPID = _iowr(10)
FM_IOCTL_GETMONOSTERO = _iowr(13)
FM_IOCTL_PRE_SEARCH = _iowr(45, 4)
FM_IOCTL_RESTORE_SEARCH = _iowr(46, 4)
FM_IOCTL_SOFT_MUTE_TUNE = _iowr(63)
FM_IOCTL_RDS_ONOFF = _iowr(18)

# struct rds_t (fm_rds.h) on arm64
RDS_SIZE = 688
RDS_PI, RDS_PTY = 24, 27
RDS_PS = 248 + 3 * 8            # PS_Data.PS[3]
RDS_RT = 290 + 3 * 64           # RT_Data.TextData[3]
RDS_RT_LEN = 548                # RT_Data.TextLength
RDS_EVENT = 554                 # event_status
RDS_EV_PI, RDS_EV_PTY, RDS_EV_PS, RDS_EV_RT = 0x2, 0x4, 0x8, 0x40

PTY_RBDS = ["", "News", "Information", "Sports", "Talk", "Rock", "Classic Rock",
            "Adult Hits", "Soft Rock", "Top 40", "Country", "Oldies", "Soft",
            "Nostalgia", "Jazz", "Classical", "R&B", "Soft R&B", "Language",
            "Religious Music", "Religious Talk", "Personality", "Public", "College",
            "Spanish Talk", "Spanish Music", "Hip Hop", "", "", "Weather",
            "Emergency Test", "Emergency"]
PTY_RDS = ["", "News", "Current Affairs", "Information", "Sport", "Education",
           "Drama", "Culture", "Science", "Varied", "Pop Music", "Rock Music",
           "Easy Listening", "Light Classical", "Serious Classical", "Other Music",
           "Weather", "Finance", "Children's", "Social Affairs", "Religion",
           "Phone-In", "Travel", "Leisure", "Jazz", "Country", "National Music",
           "Oldies", "Folk", "Documentary", "Alarm Test", "Alarm"]


def rbds_region():
    """North America uses RBDS programme types (and PI call letters)"""
    try:
        tz = os.path.realpath("/etc/localtime")
    except OSError:
        return False
    return "/America/" in tz or "/US/" in tz or "/Canada/" in tz


def call_letters(pi):
    """NRSC-4 call letters from a North American PI code, or None"""
    if 0x1000 <= pi <= 0x54a7:
        prefix, n = "K", pi - 0x1000
    elif 0x54a8 <= pi <= 0x994f:
        prefix, n = "W", pi - 0x54a8
    else:
        return None
    return prefix + chr(65 + n // 676) + chr(65 + n % 676 // 26) + chr(65 + n % 26)


def rds_text(raw):
    """RDS characters (basic set ~ ASCII) to a clean string"""
    t = "".join(chr(b) if 0x20 <= b < 0x7f else " " for b in raw)
    return " ".join(t.split())

FM_BAND_UE, FM_SPACE_100K = 1, 1
TUNE_PARM = "=BBBBBxH"      # err, band, space, hilo, deemphasis, freq
SOFTMUTE = "=iHxxi"         # rssi, freq, valid


def die_with_parent():
    """preexec_fn: SIGTERM the child when this app dies, however it dies,
    so spk-hold never keeps the FM route open on its own"""
    PR_SET_PDEATHSIG = 1
    ctypes.CDLL(None, use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGTERM)


def dbm(raw):
    """soft-mute (raw) RSSI in GETRSSI units, as the driver converts it"""
    return (raw * 6) >> 4


def mhz(freq):
    return "%d.%d" % (freq // 100, freq // 10 % 10)


def clamp_freq(f):
    return max(FREQ_MIN, min(FREQ_MAX, int(round(f / STEP)) * STEP))


def wrap_freq(f):
    if f > FREQ_MAX:
        return FREQ_MIN
    if f < FREQ_MIN:
        return FREQ_MAX
    return f


class Tuner:
    """/dev/fm. Every ioctl goes through self.lock: the status timer runs on
    the GTK thread, scan and seek on a worker thread."""

    def __init__(self):
        self.fd = None
        self.lock = threading.Lock()

    @property
    def is_open(self):
        return self.fd is not None

    def open(self):
        if self.fd is None:
            self.fd = os.open(FM_DEV, os.O_RDWR)

    def close(self):
        if self.fd is not None:
            os.close(self.fd)       # last close powers FM down
            self.fd = None

    def _tune(self, req, freq):
        buf = bytearray(struct.pack(TUNE_PARM, 0, FM_BAND_UE, FM_SPACE_100K, 0, 0, freq))
        fcntl.ioctl(self.fd, req, buf, True)

    def power_up(self, freq):
        with self.lock:
            self._tune(FM_IOCTL_POWERUP, freq)

    def tune(self, freq):
        with self.lock:
            self._tune(FM_IOCTL_TUNE, freq)

    def rds_on(self, on=True):
        with self.lock:
            buf = bytearray(struct.pack("=H", 1 if on else 0)) + bytearray(6)
            fcntl.ioctl(self.fd, FM_IOCTL_RDS_ONOFF, buf, True)

    def read_rds(self):
        """the driver's struct rds_t if something changed, else None"""
        if not self.lock.acquire(blocking=False):
            return None
        try:
            data = os.read(self.fd, RDS_SIZE)
        except OSError:
            data = b""
        finally:
            self.lock.release()
        return data if len(data) == RDS_SIZE else None

    def chip_id(self):
        with self.lock:
            buf = bytearray(8)
            fcntl.ioctl(self.fd, FM_IOCTL_GETCHIPID, buf, True)
            return struct.unpack_from("=H", buf)[0]

    def status(self):
        """(rssi, stereo), or None while a scan or seek holds the tuner"""
        if not self.lock.acquire(blocking=False):
            return None
        try:
            rssi, stereo = bytearray(8), bytearray(8)
            fcntl.ioctl(self.fd, FM_IOCTL_GETRSSI, rssi, True)
            fcntl.ioctl(self.fd, FM_IOCTL_GETMONOSTERO, stereo, True)
            return struct.unpack_from("=i", rssi)[0], struct.unpack_from("=H", stereo)[0] != 0
        finally:
            self.lock.release()

    def _probe(self, freq):
        buf = bytearray(struct.pack(SOFTMUTE, 0, freq, 0))
        fcntl.ioctl(self.fd, FM_IOCTL_SOFT_MUTE_TUNE, buf, True)
        rssi, _, valid = struct.unpack(SOFTMUTE, buf)
        return rssi, valid != 0

    def seek(self, start, direction, cancel):
        """next station from start in direction (+1/-1), or None; ends tuned
        to the result (or back on start)"""
        with self.lock:
            fcntl.ioctl(self.fd, FM_IOCTL_PRE_SEARCH, 0)
            found, f = None, start
            try:
                for _ in range((FREQ_MAX - FREQ_MIN) // STEP):
                    if cancel.is_set():
                        break
                    f = wrap_freq(f + direction * STEP)
                    if self._probe(f)[1]:
                        found = f
                        break
            finally:
                fcntl.ioctl(self.fd, FM_IOCTL_RESTORE_SEARCH, 0)
                self._tune(FM_IOCTL_TUNE, found or start)
            return found

    def scan(self, current, progress, cancel):
        """[(freq, rssi)] of every station in the band; ends back on current"""
        stations = []
        with self.lock:
            fcntl.ioctl(self.fd, FM_IOCTL_PRE_SEARCH, 0)
            try:
                for f in range(FREQ_MIN, FREQ_MAX + STEP, STEP):
                    if cancel.is_set():
                        break
                    rssi, valid = self._probe(f)
                    if valid:
                        stations.append((f, dbm(rssi)))
                    progress((f - FREQ_MIN) / (FREQ_MAX - FREQ_MIN), f, len(stations))
            finally:
                fcntl.ioctl(self.fd, FM_IOCTL_RESTORE_SEARCH, 0)
                self._tune(FM_IOCTL_TUNE, current)
        return stations


CSS = """
.freq { font-size: 72px; font-weight: bold; }
.freq.off { color: rgba(255, 255, 255, 0.45); }
.unit { font-size: 30px; color: rgba(255, 255, 255, 0.78); }
.badge { font-size: 17px; }
.state { font-size: 17px; color: rgba(255, 255, 255, 0.78); }
.state.err { color: #FF6B7A; }
.station { font-size: 24px; font-weight: bold; }
.station.current { color: #FFD24A; }
.detail { font-size: 16px; color: rgba(255, 255, 255, 0.78); }
.ps { font-size: 24px; font-weight: bold; }
.rt { font-size: 17px; color: rgba(255, 255, 255, 0.78); }
.rowps { font-size: 20px; color: #FFD24A; font-weight: bold; }
.empty { font-size: 18px; color: rgba(255, 255, 255, 0.78); }
